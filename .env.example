# -----------------------------------------------------------------------------
# Email Monitoring System - Environment Configuration
# Copy this file to .env and customize values for your local environment.
# NEVER commit real secrets or .env files to version control.
# -----------------------------------------------------------------------------

# Application
APP_ENV=development
DEBUG=true
PROJECT_NAME="Email Monitoring System"
API_V1_STR=/api/v1

# Security & Tokens
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=change-this-insecure-secret-key-for-development-only-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Encryption key for sensitive credentials (AES-256 requires 32 bytes base64-encoded or 32-char key)
ENCRYPTION_KEY=super-secret-encryption-key-32ch

# CORS (comma-separated list of origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=email_monitoring
# DATABASE_URL can be auto-assembled or overridden
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/email_monitoring
DATABASE_SYNC_URL=postgresql+psycopg://postgres:postgres@localhost:5432/email_monitoring

# Redis & Celery
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false
SYNC_INTERVAL_MINUTES=5

# Storage
UPLOAD_DIR=./uploads
MAX_ATTACHMENT_SIZE_BYTES=26214400  # 25 MB

# Email Engagement Tracking (Groundwork for tracking URLs; MUST use HTTPS in production)
# TRACKING_BASE_URL=https://track.example.com

# Cross-Backend Tracking Alignment (T1.5: Server-to-server authenticated issuance)
# TRACKING_INTERNAL_SECRET=generate-a-secure-32-char-secret-key-for-internal-auth
# TRACKING_SERVICE_URL=https://email-monitoring.onrender.com
# TRACKING_CLIENT_TIMEOUT_SECONDS=3.0
