/* ─── Layout ─── */
const AW=148, AH=64, AGAP=42, LANE_Y=96, STEP_H=54, PAD_L=28, PAD_R=44, PAD_B=80;
function cx(i){ return PAD_L + i*(AW+AGAP) + AW/2; }
function sy(si){ return LANE_Y + AH + si*STEP_H + STEP_H/2; }
function ai(id){ return ACTORS.findIndex(a=>a.id===id); }

let filter='all', highlight=null, zoom=1.0;

function bColor(b){
  if(b==='error') return '#f87171';
  if(b==='warn')  return '#f59e0b';
  if(b==='happy') return '#34d399';
  return '#94a3b8';
}

function visSteps(){
  if(filter==='happy') return STEPS.filter(s=>s.branch==='happy'||s.branch==='both');
  if(filter==='error') return STEPS.filter(s=>s.branch==='error'||s.branch==='both');
  return STEPS;
}

function render(){
  const steps=visSteps();
  const W=PAD_L+ACTORS.length*(AW+AGAP)-AGAP+PAD_R;
  const H=LANE_Y+AH+steps.length*STEP_H+PAD_B;
  let p=[];

  /* defs */
  let defs='<defs>';
  ACTORS.forEach(a=>{
    defs+=`<marker id="a-${a.id}" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="${a.color}"/></marker>`;
    defs+=`<linearGradient id="g-${a.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${a.color}" stop-opacity="0.22"/><stop offset="100%" stop-color="${a.color}" stop-opacity="0.07"/></linearGradient>`;
  });
  defs+=`<marker id="a-ret" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#64748b"/></marker>`;
  defs+='</defs>';
  p.push(defs);

  p.push(`<rect width="${W}" height="${H}" fill="#0d0f17"/>`);

  /* lifelines */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), op=highlight&&highlight!==a.id?0.15:1;
    p.push(`<line x1="${x}" y1="${LANE_Y+AH}" x2="${x}" y2="${H-PAD_B}" stroke="${a.color}" stroke-width="1.5" stroke-dasharray="4 5" opacity="${op*0.35}"/>`);
  });

  /* actor boxes top */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), bx=x-AW/2, op=highlight&&highlight!==a.id?0.25:1;
    p.push(`<g class="actor-g" data-actor="${a.id}" style="cursor:pointer" opacity="${op}">
      <rect x="${bx}" y="${LANE_Y}" width="${AW}" height="${AH}" rx="8" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1.5" stroke-opacity="0.6"/>
      <text x="${x}" y="${LANE_Y+24}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="11" font-weight="600" fill="${a.color}">${a.label}</text>
      <text x="${x}" y="${LANE_Y+42}" text-anchor="middle" font-family="Inter,sans-serif" font-size="9" fill="#64748b">${a.sub}</text>
    </g>`);
  });

  /* actor boxes bottom */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), bx=x-AW/2, by=H-PAD_B, op=highlight&&highlight!==a.id?0.2:1;
    p.push(`<rect x="${bx}" y="${by}" width="${AW}" height="${AH}" rx="8" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1" stroke-opacity="0.4" opacity="${op}"/>
      <text x="${x}" y="${by+24}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="11" font-weight="600" fill="${a.color}" opacity="${op}">${a.label}</text>`);
  });

  /* steps */
  steps.forEach((s,si)=>{
    const y=sy(si), col=bColor(s.branch);

    if(s.type==='alt_start'||s.type==='alt_else'||s.type==='alt_end'){
      const maxW=W-PAD_L-PAD_R, lblW=Math.min(s.label.length*6.4+24,maxW);
      p.push(`<line x1="${PAD_L}" y1="${y}" x2="${W-PAD_R}" y2="${y}" stroke="${col}" stroke-width="1" stroke-dasharray="5 4" opacity="0.35"/>
        <rect x="${PAD_L}" y="${y-11}" width="${lblW}" height="18" rx="4" fill="${col}" fill-opacity="0.1" stroke="${col}" stroke-width="0.8" stroke-opacity="0.5"/>
        <text x="${PAD_L+8}" y="${y+4}" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="${col}" opacity="0.9">${s.label}</text>`);
      return;
    }

    if(s.type==='note'){
      const lblW=Math.min(s.label.length*7+28, W-PAD_L-80);
      p.push(`<rect x="${PAD_L+4}" y="${y-14}" width="${lblW}" height="22" rx="5" fill="rgba(99,102,241,0.1)" stroke="#6366f1" stroke-width="1" stroke-dasharray="3 2"/>
        <text x="${PAD_L+16}" y="${y+4}" font-family="Inter,sans-serif" font-size="10.5" font-weight="600" fill="#818cf8" class="stxt" data-step="${s.id}" style="cursor:pointer">&#128204; ${s.label}</text>`);
      return;
    }

    const fi=ai(s.from), ti=ai(s.to);
    if(fi<0||ti<0) return;
    const fx=cx(fi), tx=cx(ti), isRet=s.type==='return';
    const markId=isRet?'a-ret':`a-${s.from}`;
    const lnCol=isRet?'#64748b':col;

    /* step index badge */
    p.push(`<circle cx="${PAD_L-8}" cy="${y}" r="9" fill="rgba(99,102,241,0.12)" stroke="#6366f1" stroke-width="1"/>
      <text x="${PAD_L-8}" y="${y+3.5}" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="#a5b4fc">${s.id}</text>`);

    if(fi===ti){
      /* self-arrow */
      const rx=fx+AW/2-10, lw=30, ty2=y-12, by2=y+10;
      p.push(`<path d="M${fx},${ty2} Q${rx+lw},${ty2} ${rx+lw},${y} Q${rx+lw},${by2} ${fx},${by2}" fill="none" stroke="${lnCol}" stroke-width="1.5" stroke-dasharray="${isRet?'4 3':'none'}" marker-end="url(#${markId})" opacity="0.85" class="aline" data-step="${s.id}" style="cursor:pointer"/>
        <text x="${fx+8}" y="${ty2-2}" font-family="JetBrains Mono,monospace" font-size="9.5" fill="${lnCol}" class="stxt" data-step="${s.id}" style="cursor:pointer">${s.label}</text>`);
    } else {
      /* regular arrow */
      const midX=(fx+tx)/2;
      p.push(`<line x1="${fx}" y1="${y}" x2="${tx}" y2="${y}" stroke="${lnCol}" stroke-width="1.8" stroke-dasharray="${isRet?'5 4':'none'}" marker-end="url(#${markId})" opacity="0.9" class="aline" data-step="${s.id}" style="cursor:pointer"/>
        <text x="${midX}" y="${y-6}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9.5" fill="${lnCol}" class="stxt" data-step="${s.id}" style="cursor:pointer">${s.label}</text>`);
    }
  });

  const svg=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" style="transform-origin:top left;transform:scale(${zoom});transition:transform .2s;display:block">${p.join('')}</svg>`;
  document.getElementById('seq-diagram').innerHTML=svg;

  document.querySelectorAll('.stxt,.aline').forEach(el=>{
    el.addEventListener('mouseenter',onHover);
    el.addEventListener('mousemove',onMove);
    el.addEventListener('mouseleave',onLeave);
  });
  document.querySelectorAll('.actor-g').forEach(el=>{
    el.addEventListener('click',onActorClick);
  });
}

/* sidebar */
function buildLegend(){
  const c=document.getElementById('legend-actors'); c.innerHTML='';
  ACTORS.forEach(a=>{
    const el=document.createElement('div'); el.className='legend-item'; el.dataset.actor=a.id;
    el.innerHTML=`<div class="legend-dot" style="background:${a.color}"></div><div class="legend-info"><div class="legend-name">${a.label}</div><div class="legend-desc">${a.sub}</div></div>`;
    el.addEventListener('click',()=>{ highlight=highlight===a.id?null:a.id; document.querySelectorAll('.legend-item').forEach(li=>li.classList.remove('active')); if(highlight) el.classList.add('active'); render(); });
    c.appendChild(el);
  });
}

function buildNav(){
  const c=document.getElementById('step-nav'); c.innerHTML='';
  STEPS.filter(s=>s.type==='call'||s.type==='return'||s.type==='note').forEach(s=>{
    const el=document.createElement('div'); el.className='step-pill'; el.dataset.step=s.id;
    const col=bColor(s.branch);
    el.innerHTML=`<div class="step-num" style="border-color:${col};color:${col}">${s.id}</div><div class="step-label">${s.label}</div>`;
    el.addEventListener('mouseenter',()=>{ showTip(s,310,130); el.classList.add('highlighted'); });
    el.addEventListener('mouseleave',()=>{ hideTip(); el.classList.remove('highlighted'); });
    c.appendChild(el);
  });
}

/* tooltip */
const TT=document.getElementById('tooltip');
function showTip(s,x,y){
  document.getElementById('tt-step').textContent=`Step ${s.id} \u00b7 ${s.type.toUpperCase()}`;
  document.getElementById('tt-title').textContent=s.fn||s.label;
  document.getElementById('tt-body').textContent=s.detail||'';
  document.getElementById('tt-file').textContent=s.file||'';
  TT.style.left=(x+16)+'px'; TT.style.top=(y-8)+'px';
  TT.classList.add('visible');
}
function hideTip(){ TT.classList.remove('visible'); }
function getStep(id){ return STEPS.find(s=>s.id===Number(id)); }
function onHover(e){ const s=getStep(e.currentTarget.dataset.step); if(s) showTip(s,e.clientX,e.clientY); }
function onMove(e){ if(TT.classList.contains('visible')){ TT.style.left=(e.clientX+16)+'px'; TT.style.top=(e.clientY-8)+'px'; } }
function onLeave(){ hideTip(); }
function onActorClick(e){ const a=e.currentTarget.dataset.actor; highlight=highlight===a?null:a; document.querySelectorAll('.legend-item').forEach(li=>li.classList.toggle('active',li.dataset.actor===highlight)); render(); }

/* filter */
document.querySelectorAll('.filter-btn').forEach(btn=>{
  btn.addEventListener('click',()=>{ filter=btn.dataset.filter; document.querySelectorAll('.filter-btn').forEach(b=>b.classList.remove('active')); btn.classList.add('active'); render(); buildNav(); });
});

/* zoom */
document.getElementById('btn-zoom-in').addEventListener('click',()=>{ zoom=Math.min(zoom+0.15,2); render(); });
document.getElementById('btn-zoom-out').addEventListener('click',()=>{ zoom=Math.max(zoom-0.15,0.4); render(); });

buildLegend(); buildNav(); render();
</script>
</body>
</html>
