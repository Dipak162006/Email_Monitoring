@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 210 40% 98%;
    --foreground: 222 47% 11%;

    --card: 0 0% 100%;
    --card-foreground: 222 47% 11%;

    --popover: 0 0% 100%;
    --popover-foreground: 222 47% 11%;

    --primary: 243 75% 59%;
    --primary-foreground: 210 40% 98%;

    --secondary: 210 40% 96.1%;
    --secondary-foreground: 222 47% 11%;

    --muted: 210 40% 96.1%;
    --muted-foreground: 215.4 16.3% 46.9%;

    --accent: 210 40% 96.1%;
    --accent-foreground: 222 47% 11%;

    --destructive: 0 84.2% 60.2%;
    --destructive-foreground: 210 40% 98%;

    --border: 214.3 31.8% 91.4%;
    --input: 214.3 31.8% 91.4%;
    --ring: 221 83% 53%;

    --radius: 0.5rem;
  }

  .dark {
    --background: 224 71% 4%;
    --foreground: 213 31% 91%;

    --card: 224 71% 7%;
    --card-foreground: 213 31% 91%;

    --popover: 224 71% 7%;
    --popover-foreground: 213 31% 91%;

    --primary: 217 91% 60%;
    --primary-foreground: 222 47% 11%;

    --secondary: 222 47% 11%;
    --secondary-foreground: 210 40% 98%;

    --muted: 223 47% 14%;
    --muted-foreground: 215 20% 65%;

    --accent: 216 34% 17%;
    --accent-foreground: 210 40% 98%;

    --destructive: 0 62.8% 30.6%;
    --destructive-foreground: 210 40% 98%;

    --border: 216 34% 17%;
    --input: 216 34% 17%;
    --ring: 224 76% 48%;
  }

  * {
    @apply border-border;
  }

  html,
  body,
  #root {
    height: 100%;
    width: 100%;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  body {
    font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background-color: hsl(var(--background));
    color: hsl(var(--foreground));
  }

  code, pre {
    font-family: 'JetBrains Mono', monospace;
  }
}

@layer utilities {
  /* Global scrollbar visual suppression while preserving mouse-wheel, keyboard, and touch scrolling */
  * {
    scrollbar-width: none !important; /* Firefox */
    -ms-overflow-style: none !important; /* IE and Edge */
  }

  *::-webkit-scrollbar {
    display: none !important; /* Chrome, Safari, Edge, Opera */
    width: 0px !important;
    height: 0px !important;
  }

  /* Utility classes */
  .no-scrollbar::-webkit-scrollbar {
    display: none !important;
    width: 0px !important;
    height: 0px !important;
  }

  .no-scrollbar {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
  }

  /* Make row actions accessible on touch devices without hover */
  @media (hover: none) {
    .campaign-row-actions {
      opacity: 1 !important;
      pointer-events: auto !important;
    }
  }

  /* Scoped styles for email editor and preview canvases to prevent Gmail/Uber clipping & table borders */
  .pulsemail-editor-canvas table,
  .pulsemail-preview-canvas table {
    max-width: 100% !important;
    border-collapse: collapse;
  }
  .pulsemail-editor-canvas td,
  .pulsemail-editor-canvas th,
  .pulsemail-preview-canvas td,
  .pulsemail-preview-canvas th {
    border-color: transparent;
    box-sizing: border-box;
  }
  .pulsemail-editor-canvas img,
  .pulsemail-preview-canvas img {
    max-width: 100%;
    height: auto;
  }
}
