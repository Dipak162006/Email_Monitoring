      let node: Node | null = sel.anchorNode;
      if (node?.nodeType === Node.TEXT_NODE) node = node.parentNode;
      const block = (node as HTMLElement)?.closest("h1, h2, h3, p, div, td, [data-email-block]") as HTMLElement | null;
