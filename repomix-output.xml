}
.node.fe   {background:var(--fe-bg);  border-color:var(--fe-bdr);  color:var(--fe);}
.node.api  {background:var(--api-bg); border-color:var(--api-bdr); color:var(--api);}
.node.auth {background:var(--auth-bg);border-color:var(--auth-bdr);color:var(--auth);}
.node.svc  {background:var(--svc-bg); border-color:var(--svc-bdr); color:var(--svc);}
.node.smtp {background:var(--smtp-bg);border-color:var(--smtp-bdr);color:var(--smtp);}
.node.db   {background:var(--db-bg);  border-color:var(--db-bdr);  color:var(--db);}

.node:hover,
.node.active{filter:brightness(1.25);box-shadow:0 0 0 2px currentColor, 0 8px 24px rgba(0,0,0,.5);}

/* diamond decision node */
.node.diamond{transform:rotate(45deg);width:52px;height:52px;padding:0;display:flex;align-items:center;justify-content:center;border-radius:4px;}
.node.diamond span{transform:rotate(-45deg);font-size:.65rem;display:block;text-align:center;line-height:1.1;}

/* ── ARROWS SVG OVERLAY ── */
#arrow-layer{position:absolute;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:2;}

/* ── DETAIL PANEL ── */
.detail-panel{
  width:340px;flex-shrink:0;
  background:var(--surface);
  border-left:1px solid var(--border);
  display:flex;flex-direction:column;
  overflow-y:auto;
}
.detail-panel::-webkit-scrollbar{width:6px;}
.detail-panel::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

.panel-header{
  padding:1.25rem 1.25rem .75rem;
  border-bottom:1px solid var(--border);
  position:sticky;top:0;background:var(--surface);z-index:1;
}
.panel-header .step-label{font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--dim);margin-bottom:.35rem;}
.panel-header h2{font-size:1rem;font-weight:700;color:var(--text);line-height:1.35;}
.panel-header .layer-chip{display:inline-block;font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;padding:.18rem .55rem;border-radius:9999px;margin-top:.4rem;}

.panel-body{padding:1.25rem;display:flex;flex-direction:column;gap:1rem;}

.meta-row{display:flex;flex-direction:column;gap:.2rem;}
.meta-row label{font-size:.68rem;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--muted);}
.meta-row .val{font-size:.84rem;color:var(--dim);}
.meta-row code{font-family:'Fira Code',monospace;font-size:.78rem;background:var(--surface2);padding:.12rem .4rem;border-radius:4px;color:#a5d6ff;display:inline-block;margin:.05rem 0;}

.detail-divider{height:1px;background:var(--border);margin:.25rem 0;}

.detail-desc{font-size:.87rem;color:var(--dim);line-height:1.65;}
.detail-desc strong{color:var(--text);}
.detail-desc ul{list-style:disc;padding-left:1.25rem;margin-top:.4rem;}
.detail-desc ul li{margin-bottom:.3rem;}

.panel-placeholder{flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.75rem;padding:2rem;text-align:center;color:var(--muted);}
.panel-placeholder .ph-icon{font-size:2.5rem;opacity:.3;}
.panel-placeholder p{font-size:.85rem;line-height:1.55;}

/* ── LEGEND ── */
.legend{display:flex;flex-wrap:wrap;gap:.5rem;padding:.75rem 1.5rem;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;}
.leg-item{display:flex;align-items:center;gap:.4rem;font-size:.72rem;color:var(--dim);}
