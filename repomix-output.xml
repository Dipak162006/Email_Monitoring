    });

    expect(
      screen.getByRole("button", { name: /add suppressed email/i })
    ).toBeDefined();

    const unsuppressButtons = screen.getAllByRole("button", { name: /unsuppress/i });
    expect(unsuppressButtons.length).toBeGreaterThan(0);

    unmount();

