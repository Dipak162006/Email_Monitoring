import sys
from logging.config import fileConfig
from pathlib import Path
from alembic import context
from sqlalchemy import engine_from_config, pool

# Ensure backend root is on sys.path
backend_dir = Path(__file__).resolve().parent.parent
if str(backend_dir) not in sys.path:
    sys.path.insert(0, str(backend_dir))

from app.core.config import settings
from app.core.database import Base
import app.modules.auth.models  # noqa: F401 - ensure models are registered
import app.modules.companies.models  # noqa: F401 - ensure models are registered
import app.modules.email_accounts.models  # noqa: F401 - ensure models are registered
import app.modules.emails.models  # noqa: F401 - ensure models are registered

config = context.config

if config.config_file_name is not None:
    fileConfig(config.config_file_name)

target_metadata = Base.metadata

# Use the sync URL from app settings
config.set_main_option("sqlalchemy.url", settings.DATABASE_SYNC_URL)


def run_migrations_offline() -> None:
    """Run migrations in 'offline' mode."""
    url = config.get_main_option("sqlalchemy.url")
    context.configure(
        url=url,
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
    )

    with context.begin_transaction():
        context.run_migrations()


def run_migrations_online() -> None:
    """Run migrations in 'online' mode."""
    connectable = engine_from_config(
        config.get_section(config.config_ini_section, {}),
        prefix="sqlalchemy.",
        poolclass=pool.NullPool,
    )

    with connectable.connect() as connection:
        context.configure(
            connection=connection,
            target_metadata=target_metadata,
        )

        with context.begin_transaction():
            context.run_migrations()


if context.is_offline_mode():
    run_migrations_offline()
else:
    run_migrations_online()
</file>

<file path="backend/app/main.py">
from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.core.config import settings
from app.core.redis import get_redis_client
from app.modules.auth.routes import router as auth_router
from app.modules.companies.routes import router as companies_router
from app.modules.email_accounts.routes import router as email_accounts_router
from app.modules.emails.routes import router as emails_router
from app.modules.health.routes import router as health_router


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application startup and shutdown events."""
    # Startup
    yield
    # Shutdown: cleanly close Redis connection pool if initialized
    redis = get_redis_client()
    await redis.aclose()


def create_application() -> FastAPI:
    """Application factory."""
    app = FastAPI(
        title=settings.PROJECT_NAME,
        version="0.1.0",
        description="Standalone Email Monitoring and Management Platform",
        docs_url="/docs",
        redoc_url="/redoc",
        openapi_url=f"{settings.API_V1_STR}/openapi.json",
        lifespan=lifespan,
    )

    # Configure CORS
    if settings.BACKEND_CORS_ORIGINS:
        app.add_middleware(
            CORSMiddleware,
            allow_origins=[str(origin) for origin in settings.BACKEND_CORS_ORIGINS],
            allow_credentials=True,
            allow_methods=["*"],
            allow_headers=["*"],
        )

    # Include application routes
    app.include_router(auth_router, prefix=settings.API_V1_STR)
    app.include_router(companies_router, prefix=settings.API_V1_STR)
    app.include_router(email_accounts_router, prefix=settings.API_V1_STR)
    app.include_router(emails_router, prefix=settings.API_V1_STR)
    app.include_router(health_router, prefix=settings.API_V1_STR)
    app.include_router(health_router)

    @app.get("/", tags=["Root"])
    async def root():
        return {
            "name": settings.PROJECT_NAME,
            "version": "0.1.0",
            "environment": settings.APP_ENV,
            "docs": "/docs",
            "health": f"{settings.API_V1_STR}/health",
        }

    return app


app = create_application()
</file>

<file path="frontend/src/components/mailbox/EmailRow.tsx">
import {
  Star,
  Paperclip,
  Mail,
  MailOpen,
  Trash2,
  RotateCcw,
} from "lucide-react";
import type { EmailItem } from "../../types/emails";
import { EmailStatusBadge } from "./EmailStatusBadge";

interface EmailRowProps {
  email: EmailItem;
  isSelected: boolean;
  onToggleSelect: (id: number) => void;
  onToggleStar: (id: number, currentStarred: boolean) => void;
  onToggleRead: (id: number, currentRead: boolean) => void;
  onDelete?: (id: number) => void;
  onMoveToTrash?: (id: number) => void;
  onPermanentDelete?: (id: number) => void;
  onRestore?: (id: number) => void;
  onClick: (email: EmailItem) => void;
}

function getSenderInitials(sender: string): string {
  if (!sender) return "EM";
  const clean = sender.replace(/<.*?>/, "").trim();
  const parts = clean.split(/\s+/).filter(Boolean);
  if (parts.length >= 2) {
    return `${parts[0][0]}${parts[1][0]}`.toUpperCase();
  }
  return clean.slice(0, 2).toUpperCase();
}

function getAvatarColor(sender: string): string {
  const hash = sender.split("").reduce((acc, char) => acc + char.charCodeAt(0), 0);
  const colors = [
    "bg-indigo-100 text-indigo-700",
    "bg-purple-100 text-purple-700",
    "bg-sky-100 text-sky-700",
    "bg-emerald-100 text-emerald-700",
    "bg-amber-100 text-amber-700",
    "bg-rose-100 text-rose-700",
  ];
  return colors[hash % colors.length];
}

function formatTimestamp(dateStr?: string | null): string {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  const now = new Date();
  const isToday =
    date.getDate() === now.getDate() &&
    date.getMonth() === now.getMonth() &&
    date.getFullYear() === now.getFullYear();

  if (isToday) {
    return date.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
  }

  const isThisYear = date.getFullYear() === now.getFullYear();
  if (isThisYear) {
    return date.toLocaleDateString([], { month: "short", day: "numeric" });
  }

  return date.toLocaleDateString([], { month: "short", day: "numeric", year: "2-digit" });
}

export const EmailRow: React.FC<EmailRowProps> = ({
  email,
  isSelected,
  onToggleSelect,
  onToggleStar,
  onToggleRead,
  onDelete,
  onMoveToTrash,
  onPermanentDelete,
  onRestore,
  onClick,
}) => {
  const isUnread = !email.is_read;
  const isBounced = email.status === "BOUNCED";
  const isOutgoing = email.direction === "OUTGOING";
  const initials = getSenderInitials(email.sender);
  const avatarColor = getAvatarColor(email.sender);
  const formattedTime = formatTimestamp(email.received_at || email.sent_at || email.created_at);

  const cleanSnippet = email.body_text
    ? email.body_text.replace(/\s+/g, " ").trim().slice(0, 110)
    : "";

  return (
    <div
      onClick={() => onClick(email)}
      className={`email-row group relative flex flex-col lg:grid lg:grid-cols-12 lg:items-center gap-2 lg:gap-4 px-5 py-3 transition-colors cursor-pointer border-b border-slate-100/80 ${
        isSelected
          ? "bg-indigo-50/50"
          : isUnread
          ? "bg-indigo-50/15 hover:bg-indigo-50/30"
          : "bg-white hover:bg-slate-50/80"
      }`}
    >
      {/* 1. State Column: Selection, Star, Unread Indicator */}
      <div
        className="col-span-1 flex items-center gap-2.5"
        onClick={(e) => e.stopPropagation()}
      >
        <input
          type="checkbox"
          checked={isSelected}
          onChange={() => onToggleSelect(email.id)}
          className="row-selector w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500 accent-indigo-600 cursor-pointer"
          aria-label={`Select email from ${email.sender}`}
        />

        <button
          type="button"
          onClick={() => onToggleStar(email.id, email.is_starred)}
          className={`transition-colors p-0.5 rounded cursor-pointer ${
            email.is_starred ? "text-amber-500 hover:text-amber-600" : "text-slate-300 hover:text-amber-400"
          }`}
          title={email.is_starred ? "Unstar" : "Star"}
          aria-label={email.is_starred ? "Unstar email" : "Star email"}
        >
          <Star className="h-4 w-4" fill={email.is_starred ? "currentColor" : "none"} />
        </button>

        <span
          className={`w-2 h-2 rounded-full shrink-0 ${isUnread ? "bg-indigo-600" : "bg-transparent"}`}
          title={isUnread ? "Unread Message" : undefined}
        />
      </div>

      {/* 2. Sender Column: Avatar, Sender Name & Gateway */}
      <div className="col-span-3 flex items-center gap-2.5 min-w-0">
        <div
          className={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-semibold shrink-0 shadow-2xs ${avatarColor}`}
        >
          {initials}
        </div>
        <div className="flex flex-col min-w-0">
          <span
            className={`text-xs truncate ${
              isUnread ? "font-bold text-slate-900" : "font-medium text-slate-700"
            }`}
          >
            {email.sender}
          </span>
          <div className="flex items-center gap-1 mt-0.5">
            <span className="px-1.5 py-0.2 rounded text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200 truncate">
              {isOutgoing ? "Outgoing" : "Incoming"}
            </span>
          </div>
        </div>
      </div>

      {/* 3. Subject & Snippet Column */}
      <div className="col-span-5 flex items-center gap-2 min-w-0">
        <div className="flex flex-col min-w-0 w-full">
          <div className="flex items-center gap-1.5 min-w-0">
            <span
              className={`text-xs truncate ${
                isUnread ? "font-bold text-slate-900" : "font-medium text-slate-700"
              }`}
            >
              {email.subject || "(No Subject)"}
            </span>
            {(email.attachment_count ?? 0) > 0 && (
              <span className="flex items-center text-slate-400 text-xs shrink-0 ml-1">
                <Paperclip className="h-3 w-3" />
              </span>
            )}
          </div>
          {cleanSnippet && (
            <span className="text-[11px] text-slate-500 truncate mt-0.5">
              {cleanSnippet}
            </span>
          )}
        </div>
      </div>

      {/* 4. Telemetry Status Badges Column */}
      <div className="col-span-2 flex items-center justify-center gap-1.5 flex-wrap">
        {isBounced && <EmailStatusBadge status="Hard Bounce" />}
        {!isBounced && isOutgoing && <EmailStatusBadge status="Sent" />}
        {!isBounced && !isOutgoing && isUnread && <EmailStatusBadge status="Unread" />}
        {!isBounced && !isOutgoing && !isUnread && <EmailStatusBadge status="Delivered" />}
      </div>

      {/* 5. Timestamp Column */}
      <div className="col-span-1 flex items-center justify-end">
        <span className="text-xs text-slate-500 font-medium whitespace-nowrap">
          {formattedTime}
        </span>
      </div>

      {/* Floating Quick Actions on Hover */}
      <div
        className="row-actions absolute right-4 top-1/2 -translate-y-1/2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto flex items-center gap-1 bg-white border border-slate-200 px-2 py-1 rounded-lg shadow-md z-10 transition-opacity"
        onClick={(e) => e.stopPropagation()}
      >
        <button
          type="button"
          onClick={() => onToggleStar(email.id, email.is_starred)}
          className={`p-1 rounded transition-colors ${
            email.is_starred ? "text-amber-500 hover:text-amber-600" : "text-slate-400 hover:text-amber-500 hover:bg-slate-100"
          }`}
          title={email.is_starred ? "Unstar" : "Star"}
          aria-label="Toggle star"
        >
          <Star className="h-4 w-4" fill={email.is_starred ? "currentColor" : "none"} />
        </button>

        <button
          type="button"
          onClick={() => onToggleRead(email.id, email.is_read)}
          className="p-1 rounded text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition-colors"
          title={email.is_read ? "Mark Unread" : "Mark Read"}
          aria-label={email.is_read ? "Mark unread" : "Mark read"}
        >
          {email.is_read ? <Mail className="h-4 w-4" /> : <MailOpen className="h-4 w-4" />}
        </button>

        {email.is_deleted ? (
          <>
            {onRestore && (
              <button
                type="button"
                onClick={() => onRestore(email.id)}
                className="p-1 rounded text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 transition-colors cursor-pointer"
                title="Restore to Inbox"
                aria-label="Restore email"
              >
                <RotateCcw className="h-4 w-4" />
              </button>
            )}
            <button
              type="button"
              onClick={() => (onPermanentDelete ? onPermanentDelete(email.id) : onDelete?.(email.id))}
              className="p-1 rounded text-rose-600 hover:text-rose-800 hover:bg-rose-50 transition-colors cursor-pointer"
              title="Delete Permanently"
              aria-label="Delete email permanently"
            >
              <Trash2 className="h-4 w-4" />
            </button>
          </>
        ) : (
          <button
            type="button"
            onClick={() => (onMoveToTrash ? onMoveToTrash(email.id) : onDelete?.(email.id))}
            className="p-1 rounded text-slate-500 hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer"
            title="Move to Trash"
            aria-label="Move email to trash"
          >
            <Trash2 className="h-4 w-4" />
          </button>
        )}
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/mailbox/MailboxToolbar.tsx">
import React from "react";
import {
  Star,
  Mail,
  MailOpen,
  Trash2,
  Search,
  ChevronLeft,
  ChevronRight,
  ChevronDown,
  RotateCcw,
  Loader2,
} from "lucide-react";
import type { AuthorizedEmailAccount } from "../../types/emails";

interface MailboxToolbarProps {
  // Selection
  isAllSelected: boolean;
  isSomeSelected: boolean;
  selectedCount: number;
  totalVisibleCount: number;
  onToggleSelectAll: () => void;
  // Bulk Actions
  onBulkStar: () => void;
  isAllSelectedStarred?: boolean;
  onBulkMarkRead: (read: boolean) => void;
  onBulkMoveToTrash?: () => void;
  // Trash folder actions
  isTrash?: boolean;
  onRestore?: () => void;
  isRestoring?: boolean;
  onBulkPermanentDelete?: () => void;
  isPermanentDeleting?: boolean;
  // Account filter
  accounts: AuthorizedEmailAccount[];
  selectedAccountId?: number;
  onAccountChange: (accountId?: number) => void;
  // Sorting
  sortBy?: "newest" | "oldest";
  onSortChange?: (sort: "newest" | "oldest") => void;
  // Search
  searchQuery: string;
  onSearchChange: (query: string) => void;
  folderTitle?: string;
  // Pagination
  currentPage: number;
  pageSize: number;
  totalCount: number;
  onPageChange: (newPage: number) => void;
  onPageSizeChange?: (newPageSize: number) => void;
}

export const MailboxToolbar: React.FC<MailboxToolbarProps> = ({
  isAllSelected,
  isSomeSelected,
  selectedCount,
  totalVisibleCount,
  onToggleSelectAll,
  onBulkStar,
  isAllSelectedStarred = false,
  onBulkMarkRead,
  onBulkMoveToTrash,
  isTrash = false,
  onRestore,
  isRestoring = false,
  onBulkPermanentDelete,
  isPermanentDeleting = false,
  accounts,
  selectedAccountId,
  onAccountChange,
  sortBy = "newest",
  onSortChange,
  searchQuery,
  onSearchChange,
  folderTitle,
  currentPage,
  pageSize,
  totalCount,
  onPageChange,
  onPageSizeChange,
}) => {
  const startItem = totalCount === 0 ? 0 : (currentPage - 1) * pageSize + 1;
  const endItem = Math.min(currentPage * pageSize, totalCount);
  const totalPages = Math.ceil(totalCount / pageSize) || 1;
  const canGoPrev = currentPage > 1;
  const canGoNext = currentPage < totalPages;

  const hasSelection = selectedCount > 0;

  return (
    <div className="flex items-center justify-between gap-2.5 sm:gap-3 px-4 sm:px-5 py-2.5 border-b border-slate-200/80 bg-white select-none flex-wrap md:flex-nowrap">
      {/* 1. Left: Selection & Conditional Bulk Actions */}
      <div className="flex items-center gap-2 shrink-0">
        {/* Select All Checkbox */}
        <label className="flex items-center gap-2 cursor-pointer py-1 text-slate-700 hover:text-slate-900">
          <input
            type="checkbox"
            checked={isAllSelected}
            ref={(el) => {
              if (el) el.indeterminate = isSomeSelected && !isAllSelected;
            }}
            onChange={onToggleSelectAll}
            className="w-4 h-4 rounded text-indigo-600 border-slate-300 focus:ring-indigo-500 accent-indigo-600 cursor-pointer"
            aria-label="Select all visible emails"
          />
          <span className="text-xs font-medium whitespace-nowrap">
            {hasSelection ? (
              <span className="font-semibold text-indigo-600">
                {selectedCount} of {totalVisibleCount}
              </span>
            ) : (
              "Select All"
            )}
          </span>
        </label>

        {/* Conditional Bulk Actions - Only visible when 1 or more emails are selected */}
        {hasSelection && (
          <>
            <div className="h-4 w-px bg-slate-200 mx-0.5" />
            <div className="flex items-center gap-1 text-slate-500 animate-in fade-in duration-150">
              {isTrash ? (
                <>
                  <button
                    type="button"
                    disabled={isRestoring}
                    onClick={onRestore}
                    className="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-indigo-50 border border-indigo-200 text-indigo-700 hover:bg-indigo-100 hover:text-indigo-800 transition-all cursor-pointer shadow-2xs"
                    title={`Restore ${selectedCount} selected email(s) to Inbox`}
                    aria-label="Restore selected emails"
                  >
                    {isRestoring ? (
                      <Loader2 className="h-3.5 w-3.5 animate-spin" />
                    ) : (
                      <RotateCcw className="h-3.5 w-3.5" />
                    )}
                    <span className="hidden sm:inline">Restore</span>
                  </button>

                  <button
                    type="button"
                    onClick={onBulkStar}
                    className={`p-1.5 rounded-md hover:bg-slate-100 transition-colors cursor-pointer ${
                      isAllSelectedStarred ? "text-amber-500 hover:text-amber-600" : "text-slate-500 hover:text-amber-500"
                    }`}
                    title={isAllSelectedStarred ? "Unstar selected" : "Star selected"}
                    aria-label={isAllSelectedStarred ? "Unstar selected emails" : "Star selected emails"}
                  >
                    <Star className="h-4 w-4" fill={isAllSelectedStarred ? "currentColor" : "none"} />
                  </button>

                  <button
                    type="button"
                    onClick={() => onBulkMarkRead(true)}
                    className="p-1.5 rounded-md hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer text-slate-500"
                    title="Mark as Read"
                    aria-label="Mark selected emails as read"
                  >
                    <MailOpen className="h-4 w-4" />
                  </button>

                  <button
                    type="button"
                    onClick={() => onBulkMarkRead(false)}
                    className="p-1.5 rounded-md hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer text-slate-500"
                    title="Mark as Unread"
                    aria-label="Mark selected emails as unread"
                  >
                    <Mail className="h-4 w-4" />
                  </button>

                  <button
                    type="button"
                    disabled={isPermanentDeleting}
                    onClick={onBulkPermanentDelete}
                    className="inline-flex items-center gap-1 px-2.5 py-1 rounded-md text-xs font-semibold bg-rose-50 border border-rose-200 text-rose-700 hover:bg-rose-100 hover:text-rose-800 transition-all cursor-pointer shadow-2xs ml-0.5"
                    title={`Permanently delete ${selectedCount} selected email(s)`}
                    aria-label="Permanently delete selected emails"
                  >
                    {isPermanentDeleting ? (
                      <Loader2 className="h-3.5 w-3.5 animate-spin" />
                    ) : (
                      <Trash2 className="h-3.5 w-3.5" />
                    )}
                    <span className="hidden sm:inline">Delete</span>
                  </button>
                </>
              ) : (
                <>
                  <button
                    type="button"
                    onClick={onBulkStar}
                    className={`p-1.5 rounded-md hover:bg-slate-100 transition-colors cursor-pointer ${
                      isAllSelectedStarred ? "text-amber-500 hover:text-amber-600" : "text-slate-500 hover:text-amber-500"
                    }`}
                    title={isAllSelectedStarred ? "Unstar selected" : "Star selected"}
                    aria-label={isAllSelectedStarred ? "Unstar selected emails" : "Star selected emails"}
                  >
                    <Star className="h-4 w-4" fill={isAllSelectedStarred ? "currentColor" : "none"} />
                  </button>

                  <button
                    type="button"
                    onClick={() => onBulkMarkRead(true)}
                    className="p-1.5 rounded-md hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer text-slate-500"
                    title="Mark as Read"
                    aria-label="Mark selected emails as read"
                  >
                    <MailOpen className="h-4 w-4" />
                  </button>

                  <button
                    type="button"
                    onClick={() => onBulkMarkRead(false)}
                    className="p-1.5 rounded-md hover:text-indigo-600 hover:bg-slate-100 transition-colors cursor-pointer text-slate-500"
                    title="Mark as Unread"
                    aria-label="Mark selected emails as unread"
                  >
                    <Mail className="h-4 w-4" />
                  </button>

                  <button
                    type="button"
                    onClick={onBulkMoveToTrash}
                    className="p-1.5 rounded-md hover:text-rose-600 hover:bg-rose-50 transition-colors cursor-pointer text-slate-500"
                    title="Move to Trash"
                    aria-label="Move selected emails to trash"
                  >
                    <Trash2 className="h-4 w-4" />
                  </button>
                </>
              )}
            </div>
          </>
        )}
      </div>

      {/* 2. Middle: Account Filter, Sort & Flexible Search */}
      <div className="flex items-center gap-2 flex-1 min-w-0">
        {/* Account Filter Dropdown */}
        <div className="relative shrink-0">
          <select
            value={selectedAccountId ?? ""}
            onChange={(e) => {
              const val = e.target.value;
              onAccountChange(val ? Number(val) : undefined);
            }}
            className="appearance-none bg-slate-50 border border-slate-200 text-slate-700 text-xs font-medium py-1.5 pl-2.5 pr-7 rounded-lg shadow-2xs hover:border-slate-300 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 cursor-pointer transition-colors max-w-[150px] sm:max-w-[180px] truncate"
            aria-label="Filter by email account"
          >
            <option value="">All Accounts ({accounts.length})</option>
            {accounts.map((acc) => (
              <option key={acc.id} value={acc.id}>
                {acc.email_address} ({acc.provider})
              </option>
            ))}
          </select>
          <ChevronDown className="h-3.5 w-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" />
        </div>

        {/* Sort Dropdown */}
        {onSortChange && (
          <div className="relative shrink-0">
            <select
              value={sortBy}
              onChange={(e) => onSortChange(e.target.value as "newest" | "oldest")}
              className="appearance-none bg-slate-50 border border-slate-200 text-slate-700 text-xs font-medium py-1.5 pl-2.5 pr-6 rounded-lg shadow-2xs hover:border-slate-300 focus:bg-white focus:outline-none focus:ring-1 focus:ring-indigo-600 focus:border-indigo-600 cursor-pointer transition-colors"
              aria-label="Sort order"
            >
              <option value="newest">Newest</option>
              <option value="oldest">Oldest</option>
            </select>
            <ChevronDown className="h-3 w-3 text-slate-400 absolute right-1.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          </div>
        )}

        {/* Flexible Search Input */}
        <div className="relative flex-1 min-w-[110px] max-w-xs">
          <Search className="h-3.5 w-3.5 text-slate-400 absolute left-2.5 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => onSearchChange(e.target.value)}
            placeholder={folderTitle ? `Search ${folderTitle.toLowerCase()}...` : "Search messages..."}
            className="w-full bg-slate-50 border border-slate-200 text-slate-800 placeholder-slate-400 rounded-lg pl-8 pr-2.5 py-1.5 text-xs focus:bg-white focus:border-indigo-600 focus:ring-1 focus:ring-indigo-600 outline-none transition-all"
          />
        </div>
      </div>

      {/* 3. Right: Rows per page, Range Counter & Compact Previous/Next Controls */}
      <div className="flex items-center gap-2 sm:gap-2.5 shrink-0 text-xs text-slate-500 whitespace-nowrap">
        {/* Rows per page selector */}
        {onPageSizeChange && (
          <div className="flex items-center gap-1.5">
            <span className="hidden sm:inline text-slate-400">Per page:</span>
            <select
              id="mailbox-page-size-select"
              value={pageSize}
              onChange={(e) => onPageSizeChange(Number(e.target.value))}
              className="bg-slate-50 border border-slate-200 text-slate-700 font-medium rounded-md px-1.5 py-1 text-xs focus:bg-white focus:border-indigo-600 focus:outline-none cursor-pointer shadow-2xs"
              aria-label="Emails per page"
            >
              {[25, 50, 100, 200].map((size) => (
                <option key={size} value={size}>
                  {size}
                </option>
              ))}
            </select>
          </div>
        )}

        <div className="h-4 w-px bg-slate-200 hidden sm:block" />

        {/* Range display */}
        <span>
          <strong className="text-slate-900 font-medium">{startItem}–{endItem}</strong> of{" "}
          <strong className="text-slate-900 font-medium">{totalCount.toLocaleString()}</strong>
        </span>

        {/* Compact Gmail-style < > icon navigation */}
        <div className="flex items-center gap-0.5 ml-1">
          <button
            type="button"
            disabled={!canGoPrev}
            onClick={() => onPageChange(currentPage - 1)}
            className="p-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-slate-600 cursor-pointer"
            title={canGoPrev ? "Previous page" : "First page"}
            aria-label="Previous page"
          >
            <ChevronLeft className="h-4 w-4" />
          </button>

          <button
            type="button"
            disabled={!canGoNext}
            onClick={() => onPageChange(currentPage + 1)}
            className="p-1.5 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors disabled:opacity-30 disabled:cursor-not-allowed disabled:hover:bg-transparent disabled:hover:text-slate-600 cursor-pointer"
            title={canGoNext ? "Next page" : "Last page"}
            aria-label="Next page"
          >
            <ChevronRight className="h-4 w-4" />
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/pages/DashboardPage.tsx">
import { useState, useMemo } from "react";
import { Link, useNavigate } from "react-router-dom";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import {
  ArrowRight,
  Calendar,
  RefreshCw,
  TrendingUp,
  AlertTriangle,
  Send,
  CornerDownLeft,
  AlertCircle,
  Mail,
  ChevronRight,
  PenSquare,
  PlusCircle,
  FileText,
  ShieldAlert,
  Inbox,
} from "lucide-react";
import { Card, CardContent, CardHeader, CardTitle, CardDescription } from "../components/ui/Card";
import { Button } from "../components/ui/Button";
import { Badge } from "../components/ui/Badge";
import { LoadingSpinner } from "../components/ui/LoadingState";
import { ErrorState } from "../components/ui/ErrorState";
import { EmptyState } from "../components/ui/EmptyState";
import { ActivityTrendChart } from "../components/dashboard/ActivityTrendChart";
import { dashboardApi, emailsApi, emailAccountsApi, RequestError } from "../services/api";

import { DATE_RANGE_PRESETS } from "../types/dashboard";
import type { DateRangePreset } from "../types/dashboard";
import type { EmailItem } from "../types/emails";

function formatRelativeTime(dateStr?: string | null): string {
  if (!dateStr) return "Never";
  const date = new Date(dateStr);
  const now = new Date();
  const diffMs = now.getTime() - date.getTime();
  const diffSec = Math.floor(diffMs / 1000);
  const diffMin = Math.floor(diffSec / 60);
  const diffHr = Math.floor(diffMin / 60);
  const diffDay = Math.floor(diffHr / 24);

  if (diffSec < 60) return "Just now";
  if (diffMin < 60) return `${diffMin}m ago`;
  if (diffHr < 24) return `${diffHr}h ago`;
  if (diffDay === 1) return "Yesterday";
  if (diffDay < 30) return `${diffDay}d ago`;
  return date.toLocaleDateString(undefined, { month: "short", day: "numeric" });
}

function getProviderDisplayName(provider?: string): string {
  switch (provider?.toUpperCase()) {
    case "GOOGLE":
      return "Google Workspace";
    case "ZOHO":
      return "Zoho Mail";
    case "YAHOO":
      return "Yahoo Business";
    case "CUSTOM":
      return "Custom IMAP";
    default:
      return provider || "Custom IMAP";
  }
}

export function DashboardPage() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const [datePreset, setDatePreset] = useState<DateRangePreset>("7d");
  const [isSyncing, setIsSyncing] = useState(false);
  const [syncFeedback, setSyncFeedback] = useState<string | null>(null);

  // Compute UTC date boundaries for selected preset
  const { dateFrom, dateTo, allTime } = useMemo(() => {
    const config = DATE_RANGE_PRESETS[datePreset] || DATE_RANGE_PRESETS["7d"];
    return config.computeRange(new Date());
  }, [datePreset]);

  // 1. Primary Stats Query
  const {
    data: stats,
    isLoading: isStatsLoading,
    isError: isStatsError,
    error: statsError,
    refetch: refetchStats,
  } = useQuery({
    queryKey: ["dashboard-stats", datePreset, dateFrom, dateTo, allTime],
    queryFn: () => dashboardApi.getStats({ dateFrom, dateTo, allTime }),
  });

  // 2. Activity Trends Query
  const { data: activityData, isLoading: isActivityLoading } = useQuery({
    queryKey: ["dashboard-activity", datePreset, dateFrom, dateTo, allTime],
    queryFn: () => dashboardApi.getActivity({ dateFrom, dateTo, allTime }),
  });

  // 3. Account Health Query
  const { data: accountHealth, isLoading: isHealthLoading } = useQuery({
    queryKey: ["dashboard-account-health"],
    queryFn: () => dashboardApi.getAccountHealth(),
  });

  // 4. Recent Emails Query
  const { data: recentEmailsData, isLoading: isRecentLoading } = useQuery({
    queryKey: ["dashboard-recent-emails"],
    queryFn: () => emailsApi.getRecentEmails(7),
  });

  // Map email accounts for quick provider lookup
  const accountsMap = useMemo(() => {
    const map = new Map<number, { name: string; provider: string; email: string }>();
    if (accountHealth?.accounts) {
      for (const acc of accountHealth.accounts) {
        map.set(acc.id, { name: acc.name, provider: acc.provider, email: acc.email_address });
      }
    }
    return map;
  }, [accountHealth]);

  // Manual Refresh Handler
  const handleRefresh = async () => {
    await Promise.all([
      queryClient.invalidateQueries({ queryKey: ["dashboard-stats"] }),
      queryClient.invalidateQueries({ queryKey: ["dashboard-activity"] }),
      queryClient.invalidateQueries({ queryKey: ["dashboard-account-health"] }),
      queryClient.invalidateQueries({ queryKey: ["dashboard-recent-emails"] }),
    ]);
  };

  // Sync Now Handler
  const handleSyncNow = async () => {
    if (!accountHealth?.accounts || accountHealth.accounts.length === 0) {
      navigate("/email-accounts");
      return;
    }

    try {
      setIsSyncing(true);
      setSyncFeedback(null);
      // Trigger sync for active accounts
      const activeAccounts = accountHealth.accounts.filter((a) => a.is_active);
      const targetAccounts = activeAccounts.length > 0 ? activeAccounts : [accountHealth.accounts[0]];

      const results = await Promise.allSettled(
        targetAccounts.map((acc) => emailAccountsApi.triggerSync(acc.id, false))
      );
      const fulfilled = results.filter((r) => r.status === "fulfilled");
      const rejected = results.filter((r) => r.status === "rejected");

      if (rejected.length === 0) {
        setSyncFeedback("Sync completed successfully");
      } else if (fulfilled.length > 0) {
        setSyncFeedback(`Sync completed with ${rejected.length} account failure(s)`);
      } else {
        const firstErr = (rejected[0] as PromiseRejectedResult).reason;
        const msg = firstErr?.message || firstErr?.detail || "Sync failed";
        setSyncFeedback(msg);
      }

      await handleRefresh();
      setTimeout(() => {
        setSyncFeedback(null);
      }, 3500);
    } catch {
      setSyncFeedback("Sync failed");
      setTimeout(() => setSyncFeedback(null), 3000);
    } finally {
      setIsSyncing(false);
    }
  };

  return (
    <div className="space-y-6">
      {/* ===================================================================== */}
      {/* SECTION A: Dashboard Header */}
      {/* ===================================================================== */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold tracking-tight text-slate-900">Dashboard Overview</h1>
          <p className="text-xs sm:text-sm text-slate-500 mt-1">
            Monitor email delivery, engagement, and account health.
          </p>
        </div>

        <div className="flex items-center space-x-2.5 self-start sm:self-auto">
          {/* Date Range Selector */}
          <div className="relative inline-flex items-center bg-white border border-slate-200 rounded-lg px-3 py-1.5 shadow-2xs hover:border-slate-300 transition-colors">
            <Calendar className="h-3.5 w-3.5 text-slate-400 mr-2 shrink-0" />
            <select
              id="date-range-select"
              value={datePreset}
              onChange={(e) => setDatePreset(e.target.value as DateRangePreset)}
              className="bg-transparent text-xs font-medium text-slate-700 focus:outline-none cursor-pointer pr-1"
            >
              {Object.values(DATE_RANGE_PRESETS).map((preset) => (
                <option key={preset.id} value={preset.id}>
                  {preset.label}
                </option>
              ))}
            </select>
          </div>

          {/* Refresh Button */}
          <Button
            variant="outline"
            size="sm"
            onClick={handleRefresh}
            title="Refresh dashboard data"
            className="h-9 px-3 text-slate-600 hover:text-slate-900 border-slate-200"
          >
            <RefreshCw
              className={`h-3.5 w-3.5 ${isStatsLoading || isActivityLoading ? "animate-spin text-indigo-600" : ""}`}
            />
          </Button>
        </div>
      </div>

      {/* Stats Error Banner: Compact & professional, only shown for non-auth errors */}
      {isStatsError && (statsError as RequestError)?.status !== 401 && (
        <ErrorState
          compact
          title="Unable to load dashboard statistics."
          message={(statsError as Error)?.message || "Failed to retrieve metrics from the server."}
          onRetry={refetchStats}
        />
      )}


      {/* ===================================================================== */}
      {/* SECTION B: Primary Statistics Cards (Equal width & height) */}
      {/* ===================================================================== */}
      <div className="grid grid-cols-1 md:grid-cols-3 gap-5">
        {/* Card 1: TOTAL SENT */}
        <Card className="flex flex-col justify-between border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
          <CardHeader className="p-5 pb-3">
            <div className="flex items-center justify-between">
              <span className="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Total Sent
              </span>
              {stats?.sent_change_percent !== null && stats?.sent_change_percent !== undefined ? (
                <div
                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border ${
                    stats.sent_change_percent >= 0
                      ? "bg-emerald-50 text-emerald-700 border-emerald-200"
                      : "bg-rose-50 text-rose-700 border-rose-200"
                  }`}
                >
                  <TrendingUp className="h-3 w-3" />
                  <span>
                    {stats.sent_change_percent >= 0 ? "+" : ""}
                    {stats.sent_change_percent}% vs {DATE_RANGE_PRESETS[datePreset]?.comparisonLabel || "previous period"}
                  </span>
                </div>
              ) : (
                <div className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                  No prior data
                </div>
              )}
            </div>
            <div className="mt-2.5">
              <div className="text-3xl font-bold tracking-tight text-slate-900">
                {isStatsLoading ? (
                  <div className="h-9 w-28 bg-slate-100 animate-pulse rounded" />
                ) : (
                  (stats?.sent_count ?? 0).toLocaleString()
                )}
              </div>
              <p className="text-xs text-slate-500 mt-1">Emails sent during this period</p>
            </div>
          </CardHeader>
          <CardContent className="p-5 pt-0">
            <hr className="border-slate-100 mb-3" />
            <Link
              to="/mailbox?folder=sent"
              className="text-xs font-semibold text-indigo-600 hover:text-indigo-700 inline-flex items-center gap-1 group"
            >
              <span>View Sent Emails</span>
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </Link>
          </CardContent>
        </Card>

        {/* Card 2: BOUNCED EMAILS */}
        <Card className="flex flex-col justify-between border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
          <CardHeader className="p-5 pb-3">
            <div className="flex items-center justify-between">
              <span className="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Bounced Emails
              </span>
              <div className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold bg-amber-50 text-amber-700 border border-amber-200">
                <AlertTriangle className="h-3 w-3" />
                <span>{(stats?.bounce_rate ?? 0.0).toFixed(2)}% bounce rate</span>
              </div>
            </div>
            <div className="mt-2.5">
              <div className="text-3xl font-bold tracking-tight text-slate-900">
                {isStatsLoading ? (
                  <div className="h-9 w-24 bg-slate-100 animate-pulse rounded" />
                ) : (
                  (stats?.bounced_count ?? 0).toLocaleString()
                )}
              </div>
              <p className="text-xs text-slate-500 mt-1">Emails that failed delivery</p>
            </div>
          </CardHeader>
          <CardContent className="p-5 pt-0">
            <hr className="border-slate-100 mb-3" />
            <Link
              to="/mailbox?folder=bounced"
              className="text-xs font-semibold text-indigo-600 hover:text-indigo-700 inline-flex items-center gap-1 group"
            >
              <span>View Bounced Emails</span>
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </Link>
          </CardContent>
        </Card>

        {/* Card 3: CUSTOMER RESPONSES */}
        <Card className="flex flex-col justify-between border-slate-200/80 shadow-xs hover:shadow-sm transition-shadow">
          <CardHeader className="p-5 pb-3">
            <div className="flex items-center justify-between">
              <span className="text-[11px] font-bold uppercase tracking-wider text-slate-500">
                Customer Responses
              </span>
              {stats?.response_change_percent !== null && stats?.response_change_percent !== undefined ? (
                <div
                  className={`inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-semibold border ${
                    stats.response_change_percent >= 0
                      ? "bg-indigo-50 text-indigo-700 border-indigo-200"
                      : "bg-rose-50 text-rose-700 border-rose-200"
                  }`}
                >
                  <TrendingUp className="h-3 w-3" />
                  <span>
                    {stats.response_change_percent >= 0 ? "+" : ""}
                    {stats.response_change_percent}% response volume
                  </span>
                </div>
              ) : (
                <div className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                  No prior data
                </div>
              )}
            </div>
            <div className="mt-2.5">
              <div className="text-3xl font-bold tracking-tight text-slate-900">
                {isStatsLoading ? (
                  <div className="h-9 w-24 bg-slate-100 animate-pulse rounded" />
                ) : (
                  (stats?.response_count ?? 0).toLocaleString()
                )}
              </div>
              <p className="text-xs text-slate-500 mt-1">Replies received during this period</p>
            </div>
          </CardHeader>
          <CardContent className="p-5 pt-0">
            <hr className="border-slate-100 mb-3" />
            <Link
              to="/mailbox?folder=responses"
              className="text-xs font-semibold text-indigo-600 hover:text-indigo-700 inline-flex items-center gap-1 group"
            >
              <span>View Responses</span>
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </Link>
          </CardContent>
        </Card>
      </div>

      {/* ===================================================================== */}
      {/* SECTION C: Email Activity Trends Chart */}
      {/* ===================================================================== */}
      <Card className="border-slate-200/80 shadow-xs">
        <CardHeader className="p-5 pb-3 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
          <div>
            <CardTitle className="text-base font-bold text-slate-900">Email Activity Trends</CardTitle>
            <CardDescription className="text-xs text-slate-500 mt-0.5">
              Daily volume dispatches, inbound replies, and delivery failures
            </CardDescription>
          </div>

          {/* Legend */}
          <div className="flex items-center space-x-4 text-xs font-medium text-slate-600">
            <div className="flex items-center space-x-1.5">
              <span className="h-2.5 w-2.5 rounded-full bg-indigo-600" />
              <span>Sent</span>
            </div>
            <div className="flex items-center space-x-1.5">
              <span className="h-2.5 w-2.5 rounded-full bg-sky-500" />
              <span>Customer Responses</span>
            </div>
            <div className="flex items-center space-x-1.5">
              <span className="h-2.5 w-2.5 rounded-full bg-rose-500" />
              <span>Bounced</span>
            </div>
          </div>
        </CardHeader>
        <CardContent className="p-5 pt-2">
          <ActivityTrendChart
            points={activityData?.points || []}
            isLoading={isActivityLoading}
          />
        </CardContent>
      </Card>

      {/* ===================================================================== */}
      {/* SECTION D: Lower Two-Column Layout */}
      {/* ===================================================================== */}
      <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
        {/* LEFT COLUMN: Recent Email Activity (approx 8/12) */}
        <Card className="lg:col-span-8 flex flex-col justify-between border-slate-200/80 shadow-xs h-full">
          <CardHeader className="p-5 pb-3 flex flex-row items-center justify-between shrink-0">
            <div>
              <CardTitle className="text-base font-bold text-slate-900">Recent Email Activity</CardTitle>
              <CardDescription className="text-xs text-slate-500 mt-0.5">
                Latest dispatches, customer replies, and delivery events
              </CardDescription>
            </div>
            <Link
              to="/mailbox"
              className="text-xs font-semibold text-indigo-600 hover:text-indigo-700 inline-flex items-center gap-1 group"
            >
              <span>View All in Mailbox</span>
              <ArrowRight className="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5" />
            </Link>
          </CardHeader>

          <CardContent className="p-0 flex-1 flex flex-col justify-between">
            {isRecentLoading ? (
              <div className="p-8 flex-1 flex items-center justify-center">
                <LoadingSpinner message="Loading recent email events..." />
              </div>
            ) : !recentEmailsData?.emails || recentEmailsData.emails.length === 0 ? (
              <div className="p-8 flex-1 flex items-center justify-center">
                <EmptyState
                  icon={<Inbox className="h-6 w-6 text-indigo-500" />}
                  title="No email activity yet"
                  description="Sent emails, incoming customer replies, and delivery events will appear here once connected."
                  actionLabel="Compose an Email"
                  onAction={() => navigate("/compose")}
                  className="py-12 w-full"
                />
              </div>
            ) : (
              <div className="divide-y divide-slate-100 flex-1 flex flex-col">
                {recentEmailsData.emails.slice(0, 7).map((email: EmailItem) => {
                  const isSent = email.direction === "OUTGOING" && email.status === "SENT";
                  const isBounced = email.status === "BOUNCED";
                  const isResponse =
                    email.direction === "INCOMING" &&
                    email.subject.trim().toLowerCase().startsWith("re:");

                  // Resolve provider from account mapping
                  const accountInfo = accountsMap.get(email.email_account_id);
                  const providerLabel = getProviderDisplayName(accountInfo?.provider);

                  // Row icon and status pill
                  let rowIcon = <Mail className="h-4 w-4 text-slate-500" />;
                  let iconBg = "bg-slate-100 text-slate-600";
                  let statusLabel = email.status.charAt(0) + email.status.slice(1).toLowerCase();
                  let statusVariant: "default" | "secondary" | "success" | "warning" | "destructive" | "outline" =
                    "secondary";

                  if (isBounced) {
                    rowIcon = <AlertCircle className="h-4 w-4 text-rose-600" />;
                    iconBg = "bg-rose-50 text-rose-700";
                    statusLabel = "Bounced";
                    statusVariant = "destructive";
                  } else if (isResponse) {
                    rowIcon = <CornerDownLeft className="h-4 w-4 text-sky-600" />;
                    iconBg = "bg-sky-50 text-sky-700";
                    statusLabel = "Response";
                    statusVariant = "default";
                  } else if (isSent) {
                    rowIcon = <Send className="h-4 w-4 text-indigo-600" />;
                    iconBg = "bg-indigo-50 text-indigo-700";
                    statusLabel = "Sent";
                    statusVariant = "default";
                  } else if (email.direction === "INCOMING") {
                    statusLabel = email.is_read ? "Read" : "New";
                    statusVariant = email.is_read ? "secondary" : "default";
                  }

                  const relativeTime = formatRelativeTime(
                    email.sent_at || email.received_at || email.created_at
                  );

                  return (
                    <div
                      key={email.id}
                      onClick={() => navigate(`/emails/${email.id}`)}
                      className="px-5 py-3.5 hover:bg-slate-50/80 cursor-pointer transition-colors flex items-center justify-between gap-3 group"
                    >
                      {/* Left: Direction icon + Contact & Snippet */}
                      <div className="flex items-center space-x-3.5 min-w-0 flex-1">
                        <div
                          className={`h-9 w-9 rounded-xl flex items-center justify-center shrink-0 shadow-2xs ${iconBg}`}
                        >
                          {rowIcon}
                        </div>

                        <div className="min-w-0 flex-1">
                          <div className="flex items-center space-x-2">
                            <p className="text-xs font-semibold text-slate-900 truncate">
                              {email.direction === "OUTGOING" ? (
                                <>
                                  <span className="text-slate-800 font-bold">{email.sender}</span>
                                  <span className="text-slate-400 font-normal mx-1">to</span>
                                  <span className="text-slate-600">
                                    {email.recipients?.join(", ") || "Recipient"}
                                  </span>
                                </>
                              ) : (
                                <>
                                  <span className="text-slate-800 font-bold">{email.sender}</span>
                                </>
                              )}
                            </p>
                            {/* Provider Badge */}
                            <span className="hidden sm:inline-flex items-center px-2 py-0.5 rounded text-[10px] font-medium bg-slate-100 text-slate-600 shrink-0">
                              {providerLabel}
                            </span>
                          </div>

                          <p className="text-xs text-slate-500 truncate mt-0.5">
                            <span className="font-medium text-slate-700">{email.subject || "(No Subject)"}</span>
                            {email.body_text && (
                              <span className="text-slate-400 ml-1.5">— {email.body_text.slice(0, 75)}</span>
                            )}
                          </p>
                        </div>
                      </div>

                      {/* Right: Status badge & timestamp */}
                      <div className="flex items-center space-x-3 shrink-0">
                        <Badge variant={statusVariant} className="text-[11px] px-2 py-0.5">
                          {statusLabel}
                        </Badge>
                        <span className="text-[11px] text-slate-400 font-medium min-w-[50px] text-right">
                          {relativeTime}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </CardContent>
        </Card>

        {/* RIGHT COLUMN: Account Health & Quick Actions (approx 4/12) */}
        <div className="lg:col-span-4 flex flex-col gap-6">
          {/* Card 1: Account Health & Sync */}
          <Card className="border-slate-200/80 shadow-xs">
            <CardHeader className="p-5 pb-4">
              <div className="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
                <div className="min-w-0 flex-1">
                  <CardTitle className="text-base font-bold text-slate-900 leading-tight">
                    Account Health & Sync
                  </CardTitle>
                  <CardDescription className="text-xs text-slate-500 mt-1">
                    Monitor connected email accounts and synchronization.
                  </CardDescription>
                </div>
                <Button
                  variant="outline"
                  size="sm"
                  onClick={handleSyncNow}
                  disabled={isSyncing}
                  className="h-8 px-3 shrink-0 text-xs font-medium text-indigo-600 hover:text-indigo-700 border-indigo-200 hover:bg-indigo-50/60 gap-1.5 self-start sm:self-auto"
                >
                  <RefreshCw className={`h-3 w-3 ${isSyncing ? "animate-spin" : ""}`} />
                  <span>{isSyncing ? "Syncing..." : "Sync Now"}</span>
                </Button>
              </div>
            </CardHeader>

            <CardContent className="p-5 pt-0 space-y-4">
              {syncFeedback && (
                <div className="p-2 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-medium text-center border border-indigo-100">
                  {syncFeedback}
                </div>
              )}

              {/* Summary Section: Responsive 2-column grid */}
              <div className="grid grid-cols-2 gap-2.5 p-3 rounded-xl bg-slate-50/80 border border-slate-100">
                <div className="p-2.5 rounded-lg bg-white border border-slate-200/60 shadow-2xs">
                  <span className="text-[11px] font-medium text-slate-500 block">Connected</span>
                  <span className="text-base font-bold text-slate-900 mt-0.5 block">
                    {accountHealth?.total_accounts ?? 0}
                  </span>
                </div>
                <div className="p-2.5 rounded-lg bg-white border border-slate-200/60 shadow-2xs">
                  <div className="flex items-center space-x-1.5">
                    <span className="h-2 w-2 rounded-full bg-emerald-500 shrink-0" />
                    <span className="text-[11px] font-medium text-slate-500 truncate">Operational</span>
                  </div>
                  <span className="text-base font-bold text-slate-900 mt-0.5 block">
                    {accountHealth?.active_accounts ?? 0}
                  </span>
                </div>
                <div className="p-2.5 rounded-lg bg-white border border-slate-200/60 shadow-2xs">
                  <div className="flex items-center space-x-1.5">
                    <span className="h-2 w-2 rounded-full bg-amber-400 shrink-0" />
                    <span className="text-[11px] font-medium text-slate-500 truncate">Syncing</span>
                  </div>
                  <span className="text-base font-bold text-slate-900 mt-0.5 block">
                    {accountHealth?.syncing_accounts ?? 0}
                  </span>
                </div>
                <div className="p-2.5 rounded-lg bg-white border border-slate-200/60 shadow-2xs">
                  <span className="text-[11px] font-medium text-slate-500 block">Last Synced</span>
                  <span className="text-xs font-semibold text-slate-700 mt-1 block truncate">
                    {formatRelativeTime(accountHealth?.last_synced_at)}
                  </span>
                </div>
              </div>

              {/* Account Profiles List / Empty State */}
              {isHealthLoading ? (
                <div className="py-4">
                  <LoadingSpinner message="Checking account status..." />
                </div>
              ) : !accountHealth?.accounts || accountHealth.accounts.length === 0 ? (
                <div className="py-6 px-4 flex flex-col items-center justify-center text-center rounded-xl border border-dashed border-slate-200 bg-slate-50/40">
                  <p className="text-xs font-medium text-slate-600 mb-3">No email accounts connected.</p>
                  <Link to="/email-accounts">
                    <Button size="sm" variant="outline" className="text-xs font-semibold gap-1.5 bg-white border-slate-300 hover:bg-slate-50 text-slate-800 shadow-2xs">
                      <PlusCircle className="h-3.5 w-3.5 text-indigo-600" />
                      <span>Connect Account</span>
                    </Button>
                  </Link>
                </div>
              ) : (
                <div className="space-y-2 pt-1">
                  {accountHealth.accounts.map((acc) => {
                    const avatarLetter = acc.name ? acc.name.charAt(0).toUpperCase() : "E";
                    const isHealthy = acc.is_active;

                    return (
                      <div
                        key={acc.id}
                        className="flex items-center justify-between p-2.5 rounded-lg border border-slate-100 hover:bg-slate-50 transition-colors"
                      >
                        <div className="flex items-center space-x-2.5 min-w-0">
                          <div className="h-7 w-7 rounded-lg bg-slate-100 border border-slate-200 text-slate-700 flex items-center justify-center font-bold text-xs shrink-0">
                            {avatarLetter}
                          </div>
                          <div className="min-w-0">
                            <p className="text-xs font-semibold text-slate-900 truncate">{acc.name}</p>
                            <p className="text-[10px] text-slate-400 truncate">{acc.email_address}</p>
                          </div>
                        </div>

                        <div className="shrink-0 ml-2">
                          {isHealthy ? (
                            <span className="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
                              • Healthy
                            </span>
                          ) : (
                            <span className="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-medium bg-slate-100 text-slate-600 border border-slate-200">
                              • Idle
                            </span>
                          )}
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </CardContent>
          </Card>

          {/* Card 2: Quick Actions */}
          <Card className="border-slate-200/80 shadow-xs">
            <CardHeader className="p-5 pb-3">
              <CardTitle className="text-base font-bold text-slate-900">Quick Actions</CardTitle>
              <CardDescription className="text-xs text-slate-500 mt-0.5">
                Operational triggers and configurations
              </CardDescription>
            </CardHeader>

            <CardContent className="p-3 space-y-1">
              {/* Action 1: Compose Email */}
              <Link
                to="/compose"
                className="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="h-8 w-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
                    <PenSquare className="h-4 w-4" />
                  </div>
                  <div>
                    <p className="text-xs font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors">
                      Compose Email
                    </p>
                    <p className="text-[11px] text-slate-500">Draft and dispatch outbound message</p>
                  </div>
                </div>
                <ChevronRight className="h-4 w-4 text-slate-400 group-hover:text-slate-600 group-hover:translate-x-0.5 transition-all" />
              </Link>

              {/* Action 2: Connect Email Account */}
              <Link
                to="/email-accounts"
                className="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="h-8 w-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
                    <PlusCircle className="h-4 w-4" />
                  </div>
                  <div>
                    <p className="text-xs font-semibold text-slate-900 group-hover:text-emerald-600 transition-colors">
                      Connect Email Account
                    </p>
                    <p className="text-[11px] text-slate-500">Add SMTP/IMAP, Google or Zoho</p>
                  </div>
                </div>
                <ChevronRight className="h-4 w-4 text-slate-400 group-hover:text-slate-600 group-hover:translate-x-0.5 transition-all" />
              </Link>

              {/* Action 3: Create Template */}
              <Link
                to="/templates"
                className="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="h-8 w-8 rounded-lg bg-purple-50 text-purple-600 flex items-center justify-center shrink-0">
                    <FileText className="h-4 w-4" />
                  </div>
                  <div>
                    <p className="text-xs font-semibold text-slate-900 group-hover:text-purple-600 transition-colors">
                      Create Template
                    </p>
                    <p className="text-[11px] text-slate-500">Design reusable company email layouts</p>
                  </div>
                </div>
                <ChevronRight className="h-4 w-4 text-slate-400 group-hover:text-slate-600 group-hover:translate-x-0.5 transition-all" />
              </Link>

              {/* Action 4: View Bounced Emails */}
              <Link
                to="/mailbox?folder=bounced"
                className="flex items-center justify-between p-2.5 rounded-lg hover:bg-slate-50 transition-colors group"
              >
                <div className="flex items-center space-x-3">
                  <div className="h-8 w-8 rounded-lg bg-rose-50 text-rose-600 flex items-center justify-center shrink-0">
                    <ShieldAlert className="h-4 w-4" />
                  </div>
                  <div>
                    <p className="text-xs font-semibold text-slate-900 group-hover:text-rose-600 transition-colors">
                      View Bounced Emails
                    </p>
                    <p className="text-[11px] text-slate-500">Audit suppression lists & delivery failures</p>
                  </div>
                </div>
                <ChevronRight className="h-4 w-4 text-slate-400 group-hover:text-slate-600 group-hover:translate-x-0.5 transition-all" />
              </Link>
            </CardContent>
          </Card>
        </div>
      </div>
    </div>
  );
}
