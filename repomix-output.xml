<file path="frontend/src/components/templates/StarterTemplatesModal.tsx">
import React, { useState } from "react";
import { X, Sparkles, Megaphone, Newspaper, Tag, Receipt, ArrowRight, Check, Eye } from "lucide-react";
import { STARTER_TEMPLATES, type StarterTemplate } from "./starterTemplatesData";

export interface StarterTemplatesModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSelectTemplate: (template: StarterTemplate) => void;
}

export const StarterTemplatesModal: React.FC<StarterTemplatesModalProps> = ({
  isOpen,
  onClose,
  onSelectTemplate,
}) => {
  const [selectedCategory, setSelectedCategory] = useState<string>("ALL");
  const [previewTemplate, setPreviewTemplate] = useState<StarterTemplate | null>(null);

  if (!isOpen) return null;

  const categories = ["ALL", "Onboarding", "Marketing", "Newsletter", "Promotional", "Transactional"];

  const filteredTemplates = selectedCategory === "ALL"
    ? STARTER_TEMPLATES
    : STARTER_TEMPLATES.filter((t) => t.category === selectedCategory);

  const getTemplateIcon = (iconName: string) => {
    switch (iconName) {
      case "Sparkles": return <Sparkles className="h-5 w-5 text-indigo-600" />;
      case "Megaphone": return <Megaphone className="h-5 w-5 text-blue-600" />;
      case "Newspaper": return <Newspaper className="h-5 w-5 text-amber-600" />;
      case "Tag": return <Tag className="h-5 w-5 text-pink-600" />;
      case "Receipt": return <Receipt className="h-5 w-5 text-emerald-600" />;
      default: return <Sparkles className="h-5 w-5 text-indigo-600" />;
    }
  };

  return (
    <div className="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs flex items-center justify-center p-4">
      <div className="bg-white border border-slate-200 rounded-2xl shadow-2xl max-w-4xl w-full max-h-[90vh] overflow-hidden flex flex-col animate-in fade-in zoom-in-95 duration-150">
        {/* Modal Header */}
        <div className="px-6 py-4 border-b border-slate-200 flex items-center justify-between bg-slate-50/70">
          <div className="flex items-center gap-2.5">
            <div className="p-2 bg-indigo-50 text-indigo-700 rounded-lg">
              <Sparkles className="h-5 w-5" />
            </div>
            <div>
              <h3 className="font-bold text-base text-slate-900">Industry Starter Templates</h3>
              <p className="text-xs text-slate-500">
                Choose a pre-designed, bulletproof responsive email layout to kickstart your template.
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            className="text-slate-400 hover:text-slate-700 rounded-lg p-1.5 transition-colors"
            title="Close"
          >
            <X className="h-5 w-5" />
          </button>
        </div>

        {/* Category Filter Pills */}
        <div className="px-6 py-2.5 bg-white border-b border-slate-100 flex items-center gap-1.5 overflow-x-auto text-xs">
          {categories.map((cat) => (
            <button
              key={cat}
              type="button"
              onClick={() => setSelectedCategory(cat)}
              className={`px-3 py-1 rounded-full font-medium transition-colors shrink-0 ${
                selectedCategory === cat
                  ? "bg-indigo-600 text-white shadow-2xs"
                  : "bg-slate-100 text-slate-600 hover:bg-slate-200"
              }`}
            >
              {cat === "ALL" ? "All Templates" : cat}
            </button>
          ))}
        </div>

        {/* Templates Grid Content */}
        <div className="p-6 overflow-y-auto flex-1 bg-slate-50/50">
          <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
            {filteredTemplates.map((template) => (
              <div
                key={template.id}
                className="bg-white border border-slate-200 hover:border-indigo-300 rounded-xl p-5 shadow-2xs hover:shadow-md transition-all flex flex-col justify-between group"
              >
                <div>
                  <div className="flex items-start justify-between gap-3 mb-3">
                    <div className="flex items-center gap-2.5">
                      <div className="p-2.5 bg-slate-50 rounded-lg border border-slate-100 group-hover:bg-indigo-50 group-hover:border-indigo-100 transition-colors">
                        {getTemplateIcon(template.iconName)}
                      </div>
                      <div>
                        <span className="text-[10px] font-bold text-indigo-600 uppercase tracking-wider block">
                          {template.category}
                        </span>
                        <h4 className="font-bold text-sm text-slate-900 group-hover:text-indigo-600 transition-colors">
                          {template.name}
                        </h4>
                      </div>
                    </div>
                  </div>

                  <p className="text-xs text-slate-600 line-clamp-2 mb-3 leading-relaxed">
                    {template.description}
                  </p>

                  <div className="bg-slate-50 p-2.5 rounded-lg border border-slate-100 mb-4">
                    <span className="text-[10px] font-semibold text-slate-400 uppercase tracking-wider block mb-0.5">
                      Sample Subject Line:
                    </span>
                    <p className="text-xs font-mono text-slate-700 truncate">
                      {template.subject}
                    </p>
                  </div>
                </div>

                <div className="flex items-center gap-2 pt-2 border-t border-slate-100">
                  <button
                    type="button"
                    onClick={() => setPreviewTemplate(template)}
                    className="flex-1 px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-semibold transition-colors flex items-center justify-center gap-1.5"
                  >
                    <Eye className="h-3.5 w-3.5 text-slate-400" />
                    <span>Quick Preview</span>
                  </button>

                  <button
                    type="button"
                    onClick={() => {
                      onSelectTemplate(template);
                      onClose();
                    }}
                    className="flex-1 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold transition-all flex items-center justify-center gap-1.5 shadow-2xs"
                  >
                    <span>Use Template</span>
                    <ArrowRight className="h-3.5 w-3.5" />
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Mini Preview Dialog */}
      {previewTemplate && (
        <div className="fixed inset-0 z-60 bg-slate-950/60 backdrop-blur-xs flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl shadow-2xl max-w-2xl w-full max-h-[85vh] overflow-hidden flex flex-col">
            <div className="px-5 py-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50">
              <span className="font-bold text-sm text-slate-900">{previewTemplate.name} Preview</span>
              <button
                type="button"
                onClick={() => setPreviewTemplate(null)}
                className="text-slate-400 hover:text-slate-700 p-1"
              >
                <X className="h-4 w-4" />
              </button>
            </div>
            <div className="p-6 overflow-y-auto bg-slate-100 flex-1">
              <div
                className="bg-white rounded-xl shadow-xs border border-slate-200 p-4 sm:p-6 text-xs max-w-[660px] mx-auto overflow-x-auto pulsemail-preview-canvas"
                dangerouslySetInnerHTML={{ __html: previewTemplate.bodyHtml }}
              />
            </div>
            <div className="px-5 py-3 border-t border-slate-200 bg-white flex items-center justify-end gap-2">
              <button
                type="button"
                onClick={() => setPreviewTemplate(null)}
                className="px-3 py-1.5 rounded-lg border border-slate-200 text-slate-700 text-xs font-semibold"
              >
                Back
              </button>
              <button
                type="button"
                onClick={() => {
                  onSelectTemplate(previewTemplate);
                  setPreviewTemplate(null);
                  onClose();
                }}
                className="px-4 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold flex items-center gap-1.5"
              >
                <Check className="h-3.5 w-3.5" />
                <span>Use This Template</span>
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
};
</file>

<file path="frontend/src/components/templates/TemplateBlocksPalette.tsx">
import React, { useState } from "react";
import {
  MousePointerClick,
  Heading,
  Image as ImageIcon,
  Columns,
  Info,
  Minus,
  Share2,
  ShieldCheck,
  Plus,
  GripVertical,
  Layers,
  Sparkles,
  Tag,
} from "lucide-react";
import { EMAIL_BLOCKS, type EmailBlockItem } from "./emailBlocksData";
import { STARTER_TEMPLATES, type StarterTemplate } from "./starterTemplatesData";

export interface TemplateBlocksPaletteProps {
  onInsertHtml: (html: string) => void;
  onInsertVariable: (variable: string) => void;
  onApplyTemplate: (template: StarterTemplate) => void;
  onOpenStarterModal: () => void;
}

const DYNAMIC_VARIABLES = [
  { tag: "{{customer_name}}", label: "Customer Name", desc: "Recipient's display or first name" },
  { tag: "{{customer_email}}", label: "Customer Email", desc: "Recipient's email address" },
  { tag: "{{company_name}}", label: "Company Name", desc: "Your workspace / brand name" },
  { tag: "{{sender_name}}", label: "Sender Name", desc: "Display name of dispatch mailbox" },
  { tag: "{{login_url}}", label: "Login URL", desc: "Secure dashboard sign-in link" },
  { tag: "{{unsubscribe_url}}", label: "Unsubscribe URL", desc: "Opt-out link placeholder" },
  { tag: "{{ticket_id}}", label: "Ticket / Order ID", desc: "Reference transaction identifier" },
];

export const TemplateBlocksPalette: React.FC<TemplateBlocksPaletteProps> = ({
  onInsertHtml,
  onInsertVariable,
  onApplyTemplate,
  onOpenStarterModal,
}) => {
  const [activeTab, setActiveTab] = useState<"blocks" | "tags" | "templates">("blocks");

  const getBlockIcon = (iconName: string) => {
    switch (iconName) {
      case "MousePointerClick": return <MousePointerClick className="h-4 w-4 text-indigo-600" />;
      case "Heading": return <Heading className="h-4 w-4 text-blue-600" />;
      case "Image": return <ImageIcon className="h-4 w-4 text-emerald-600" />;
      case "Columns": return <Columns className="h-4 w-4 text-amber-600" />;
      case "Info": return <Info className="h-4 w-4 text-sky-600" />;
      case "Minus": return <Minus className="h-4 w-4 text-slate-500" />;
      case "Share2": return <Share2 className="h-4 w-4 text-purple-600" />;
      case "ShieldCheck": return <ShieldCheck className="h-4 w-4 text-teal-600" />;
      default: return <Layers className="h-4 w-4 text-indigo-600" />;
    }
  };

  const handleDragStart = (e: React.DragEvent, block: EmailBlockItem) => {
    e.dataTransfer.setData("application/x-email-block-html", block.html);
    e.dataTransfer.setData("text/html", block.html);
    e.dataTransfer.effectAllowed = "copy";
  };

  return (
    <div className="bg-white border border-slate-200 rounded-xl shadow-xs flex flex-col h-full overflow-hidden">
      {/* Palette Navigation Tabs */}
      <div className="flex border-b border-slate-200 bg-slate-50/70 p-1 gap-1 text-xs font-semibold">
        <button
          type="button"
          onClick={() => setActiveTab("blocks")}
          className={`flex-1 py-1.5 px-2 rounded-lg flex items-center justify-center gap-1.5 transition-all ${
            activeTab === "blocks"
              ? "bg-white text-indigo-600 shadow-2xs font-bold"
              : "text-slate-600 hover:text-slate-900"
          }`}
        >
          <Layers className="h-3.5 w-3.5" />
          <span>Blocks</span>
        </button>

        <button
          type="button"
          onClick={() => setActiveTab("tags")}
          className={`flex-1 py-1.5 px-2 rounded-lg flex items-center justify-center gap-1.5 transition-all ${
            activeTab === "tags"
              ? "bg-white text-indigo-600 shadow-2xs font-bold"
              : "text-slate-600 hover:text-slate-900"
          }`}
        >
          <Tag className="h-3.5 w-3.5" />
          <span>Variables</span>
        </button>

        <button
          type="button"
          onClick={() => setActiveTab("templates")}
          className={`flex-1 py-1.5 px-2 rounded-lg flex items-center justify-center gap-1.5 transition-all ${
            activeTab === "templates"
              ? "bg-white text-indigo-600 shadow-2xs font-bold"
              : "text-slate-600 hover:text-slate-900"
          }`}
        >
          <Sparkles className="h-3.5 w-3.5" />
          <span>Presets</span>
        </button>
      </div>

      {/* Tab Panels */}
      <div className="p-3.5 overflow-y-auto flex-1 space-y-2.5 max-h-[620px]">
        {/* Tab 1: Layout Blocks */}
        {activeTab === "blocks" && (
          <div className="space-y-2">
            <div className="px-1 pb-1 flex items-center justify-between text-[11px] text-slate-400 font-medium">
              <span>Drag block into canvas or click &apos;+&apos;</span>
              <span className="font-mono">{EMAIL_BLOCKS.length} blocks</span>
            </div>

            {EMAIL_BLOCKS.map((block) => (
              <div
                key={block.id}
                draggable
                onDragStart={(e) => handleDragStart(e, block)}
                className="group border border-slate-200/90 hover:border-indigo-300 bg-white hover:bg-indigo-50/30 p-2.5 rounded-lg transition-all cursor-grab active:cursor-grabbing shadow-2xs flex items-center justify-between gap-2"
              >
                <div className="flex items-center gap-2.5 min-w-0">
                  <div className="text-slate-300 group-hover:text-indigo-400 shrink-0">
                    <GripVertical className="h-3.5 w-3.5" />
                  </div>
                  <div className="p-1.5 bg-slate-50 border border-slate-100 rounded-md group-hover:bg-white group-hover:border-indigo-100 transition-colors shrink-0">
                    {getBlockIcon(block.iconName)}
                  </div>
                  <div className="min-w-0">
                    <div className="flex items-center gap-1.5">
                      <h4 className="text-xs font-bold text-slate-800 group-hover:text-indigo-900 truncate">
                        {block.title}
                      </h4>
                      {block.badge && (
                        <span className="text-[9px] font-semibold px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 shrink-0">
                          {block.badge}
                        </span>
                      )}
                    </div>
                    <p className="text-[11px] text-slate-500 truncate leading-snug">
                      {block.description}
                    </p>
                  </div>
                </div>

                <button
                  type="button"
                  onClick={() => onInsertHtml(block.html)}
                  title={`Insert ${block.title}`}
                  className="p-1.5 rounded-md border border-slate-200 hover:border-indigo-400 bg-slate-50 hover:bg-indigo-600 text-slate-600 hover:text-white transition-colors shrink-0 cursor-pointer"
                >
                  <Plus className="h-3.5 w-3.5" />
                </button>
              </div>
            ))}
          </div>
        )}

        {/* Tab 2: Merge Tags */}
        {activeTab === "tags" && (
          <div className="space-y-2">
            <div className="px-1 pb-1 text-[11px] text-slate-400 font-medium">
              Click to insert dynamic variable tag into template:
            </div>

            {DYNAMIC_VARIABLES.map((v) => (
              <div
                key={v.tag}
                onClick={() => onInsertVariable(v.tag)}
                className="group border border-slate-200/90 hover:border-indigo-300 bg-white hover:bg-indigo-50/40 p-2.5 rounded-lg transition-all cursor-pointer shadow-2xs flex items-center justify-between gap-2"
              >
                <div className="min-w-0">
                  <div className="flex items-center gap-1.5 mb-0.5">
