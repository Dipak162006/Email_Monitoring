          >
            {isLoading ? (
              <>
                <Loader2 className="h-4 w-4 animate-spin" />
                <span className="truncate">Adding...</span>
              </>
            ) : (
              <>
                <Plus className="h-4 w-4" />
                <span className="truncate">Add Recipient</span>
              </>
            )}
          </button>
