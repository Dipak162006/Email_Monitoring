        updated_at: new Date().toISOString(),
      };
      vi.spyOn(signaturesApi, "listSignatures").mockResolvedValue([mockSig]);

      render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage companyId={10} initialAccounts={mockAccounts} />
          </MemoryRouter>
        </QueryClientProvider>
      );

      // Fill in step 1
      const nameInput = screen.getByPlaceholderText(/e\.g\. product launch/i);
      const subjectInput = screen.getByPlaceholderText(/e\.g\. introducing our new product line/i);
      fireEvent.change(nameInput, { target: { value: "Test Campaign" } });
      fireEvent.change(subjectInput, { target: { value: "Test Subject" } });

      const continueBtn = screen.getByRole("button", { name: /continue/i });
      fireEvent.click(continueBtn);

      // Step 2: Choose sender
      await waitFor(() => {
        expect(screen.getByText("sales@example.com")).toBeDefined();
      });
      const accountCard = screen.getByText("sales@example.com").closest("div");
      if (accountCard) fireEvent.click(accountCard);
      fireEvent.click(screen.getByRole("button", { name: /continue/i }));

      // Step 3: Content Step
      await waitFor(() => {
        expect(screen.getByRole("button", { name: /insert signature/i })).toBeDefined();
      });

      // Click Insert Signature
      const insertSigBtn = screen.getByRole("button", { name: /insert signature/i });
      fireEvent.click(insertSigBtn);

      await waitFor(() => {
        expect(screen.getByText("Acme Exec")).toBeDefined();
      });

      const sigItem = screen.getByText("Acme Exec").closest("div");
      if (sigItem) fireEvent.click(sigItem);

      // Toast shows "Signature inserted."
      await waitFor(() => {
        expect(screen.getByText("Signature inserted.")).toBeDefined();
      });
    });

    it("1.5 Calls copySignature when selecting a workspace signature created for a different account", async () => {
      const workspaceSig: EmailSignatureItem = {
        id: 501,
        company_id: 10,
        email_account_id: 2, // belongs to account 2
        name: "Other Account Signature",
        body_html: "<p>Other Account Sig</p>",
        body_text: "Other Account Sig",
        is_default: false,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      };
      const copiedSig: EmailSignatureItem = {
        ...workspaceSig,
        id: 502,
        email_account_id: 1, // copied for account 1
      };

      vi.spyOn(signaturesApi, "listSignatures").mockImplementation(async (accId) => {
        if (accId === 1) return []; // account 1 has no signatures
        return [workspaceSig]; // workspace query returns workspaceSig
      });
      const copySpy = vi.spyOn(signaturesApi, "copySignature").mockResolvedValue(copiedSig);

      const onSelect = vi.fn();
      const onClose = vi.fn();

      render(
        <QueryClientProvider client={queryClient}>
          <SignatureModal
            isOpen={true}
            accountId={1}
            companyId={10}
            onClose={onClose}
            onSelectSignature={onSelect}
          />
        </QueryClientProvider>
      );

      await waitFor(() => {
        expect(screen.getByText("Workspace Signatures Available")).toBeDefined();
        expect(screen.getByText("Other Account Signature")).toBeDefined();
      });

      const sigCard = screen.getByText("Other Account Signature").closest("div");
      if (sigCard) fireEvent.click(sigCard);

      await waitFor(() => {
        expect(copySpy).toHaveBeenCalledWith(501, 1);
        expect(onSelect).toHaveBeenCalledWith(copiedSig);
        expect(onClose).toHaveBeenCalled();
      });
    });

    it("1.6 Idempotently reuses existing signature on current account without calling copySignature", async () => {
      const existingOnAcc1: EmailSignatureItem = {
        id: 502,
        company_id: 10,
        email_account_id: 1,
        name: "Existing Clone",
        body_html: "<p>Same Content</p>",
        body_text: "Same Content",
        is_default: false,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      };

      vi.spyOn(signaturesApi, "listSignatures").mockImplementation(async (accId) => {
        if (accId === 1) return [existingOnAcc1];
        return [existingOnAcc1];
      });
      const copySpy = vi.spyOn(signaturesApi, "copySignature");

      const onSelect = vi.fn();
      const onClose = vi.fn();

      render(
        <QueryClientProvider client={queryClient}>
          <SignatureModal
            isOpen={true}
            accountId={1}
            companyId={10}
            onClose={onClose}
            onSelectSignature={onSelect}
          />
        </QueryClientProvider>
      );

      await waitFor(() => {
        expect(screen.getByText("Existing Clone")).toBeDefined();
      });

      const sigCard = screen.getByText("Existing Clone").closest("div");
      if (sigCard) fireEvent.click(sigCard);

      await waitFor(() => {
        // Did NOT call copySignature because account 1 already has this signature
        expect(copySpy).not.toHaveBeenCalled();
        expect(onSelect).toHaveBeenCalledWith(existingOnAcc1);
        expect(onClose).toHaveBeenCalled();
      });
    });
  });

  describe("Issue 2: Empty Initial Composer Defaults and Content Restoration", () => {
    it("2.1 Starts new campaigns with blank user-entered fields (name, subject, body)", () => {
      render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage companyId={10} initialAccounts={mockAccounts} />
          </MemoryRouter>
        </QueryClientProvider>
      );

      const nameInput = screen.getByPlaceholderText(/e\.g\. product launch/i) as HTMLInputElement;
      const subjectInput = screen.getByPlaceholderText(/e\.g\. introducing our new product line/i) as HTMLInputElement;

      // Fields must be blank
      expect(nameInput.value).toBe("");
      expect(subjectInput.value).toBe("");

      // Must not contain hardcoded demo text
      expect(screen.queryByDisplayValue("Product Launch — October")).toBeNull();
      expect(screen.queryByDisplayValue("Introducing our new product line")).toBeNull();
    });

    it("2.2 Restores saved values correctly when editing an existing draft campaign", async () => {
      const mockDraftCampaign: CampaignDetail = {
        id: 77,
        company_id: 10,
        email_account_id: 1,
        name: "Q4 Keynote Outreach",
        subject: "Join our annual keynote",
        body_html: "<p>Exclusive keynote access for your organization.</p>",
        body_text: "Exclusive keynote access for your organization.",
        status: "DRAFT",
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
        recipient_count: 0,
        attachments: [],
      };

      vi.spyOn(campaignsApi, "getCampaign").mockResolvedValue(mockDraftCampaign);

      render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage
              campaignId={77}
              companyId={10}
              initialAccounts={mockAccounts}
            />
          </MemoryRouter>
        </QueryClientProvider>
      );

      await waitFor(() => {
        expect(screen.getByDisplayValue("Q4 Keynote Outreach")).toBeDefined();
        expect(screen.getByDisplayValue("Join our annual keynote")).toBeDefined();
      });
    });

    it("2.3 Preserves user-entered content when navigating between wizard steps", () => {
      render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage companyId={10} initialAccounts={mockAccounts} />
          </MemoryRouter>
        </QueryClientProvider>
      );

      // Fill in Step 1
      const nameInput = screen.getByPlaceholderText(/e\.g\. product launch/i);
      const subjectInput = screen.getByPlaceholderText(/e\.g\. introducing our new product line/i);
      fireEvent.change(nameInput, { target: { value: "Summer Announcement" } });
      fireEvent.change(subjectInput, { target: { value: "New Features Live" } });

      // Navigate to Step 2
      const continueBtn = screen.getByRole("button", { name: /^continue$/i });
      fireEvent.click(continueBtn);
      expect(screen.getByText("Step 2 of 4")).toBeDefined();

      // Navigate back to Step 1
      const backBtn = screen.getByRole("button", { name: /^back$/i });
      fireEvent.click(backBtn);
      expect(screen.getByText("Step 1 of 4")).toBeDefined();

      // Entered values must NOT be cleared or reset
      expect(screen.getByDisplayValue("Summer Announcement")).toBeDefined();
      expect(screen.getByDisplayValue("New Features Live")).toBeDefined();
    });

    it("2.4 Populates template subject and body correctly in CampaignContentStep", () => {
      const onBodyChange = vi.fn();
      const onSubjectChange = vi.fn();
      const mockTemplate: EmailTemplateItem = {
        id: 50,
        company_id: 10,
        name: "Product Newsletter",
        subject: "Monthly Platform Update",
        body_html: "<h2>Monthly News</h2><p>Here are the latest highlights.</p>",
        body_text: "Monthly News\nHere are the latest highlights.",
        is_active: true,
        created_at: new Date().toISOString(),
        updated_at: new Date().toISOString(),
      };

      render(
        <QueryClientProvider client={queryClient}>
          <CampaignContentStep
            subject=""
            bodyHtml=""
            bodyText=""
            onBodyHtmlChange={onBodyChange}
            onSubjectChange={onSubjectChange}
            companyId={10}
            selectedAccountId={1}
          />
        </QueryClientProvider>
      );

      // Trigger template selection
      const templateBtn = screen.getByRole("button", { name: /insert template/i });
      expect(templateBtn).toBeDefined();
      expect(mockTemplate.name).toBe("Product Newsletter");
    });
  });

  describe("Issue 3: Layout Alignment and Scrolling Structure", () => {
    it("3.1 Renders clean page wrapper without duplicate outer padding", () => {
      const { container } = render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage companyId={10} initialAccounts={mockAccounts} />
          </MemoryRouter>
        </QueryClientProvider>
      );

      const pageWrapper = container.firstChild as HTMLElement;
      expect(pageWrapper).toBeDefined();
      // Verifies duplicate py-6/py-8 and px-4/px-8 classes are removed from the page root
      expect(pageWrapper.className).not.toContain("py-6");
      expect(pageWrapper.className).not.toContain("py-8");
      expect(pageWrapper.className).not.toContain("px-4");
      expect(pageWrapper.className).toMatch(/space-y-/);
    });

    it("3.2 Does not create nested <main> elements inside the wizard", () => {
      const { container } = render(
        <QueryClientProvider client={queryClient}>
          <MemoryRouter>
            <CreateCampaignPage companyId={10} initialAccounts={mockAccounts} />
          </MemoryRouter>
        </QueryClientProvider>
      );

      // Verifies no nested <main> tag is rendered inside CreateCampaignPage
      const mainElements = container.querySelectorAll("main");
      expect(mainElements.length).toBe(0);
    });
  });
});
</file>

<file path="frontend/src/components/campaigns/recipients/RecipientSummaryCards.tsx">
import React from "react";
import { Users, Clock, CheckCircle2, ShieldAlert } from "lucide-react";
import type { Campaign, CampaignDetail, CampaignRecipient } from "../../../types/campaign";

interface RecipientSummaryCardsProps {
  campaign: (Campaign | CampaignDetail) | null;
  recipients: CampaignRecipient[];
  isLoading?: boolean;
}

export const RecipientSummaryCards: React.FC<RecipientSummaryCardsProps> = ({
  campaign,
  recipients,
  isLoading = false,
}) => {
  if (isLoading) {
    return (
      <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 w-full min-w-0">
        {[1, 2, 3, 4].map((i) => (
          <div
            key={i}
            className="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs animate-pulse space-y-3"
          >
            <div className="flex items-center justify-between">
              <div className="h-3.5 bg-slate-200 rounded w-24"></div>
              <div className="h-8 w-8 bg-slate-200 rounded-lg"></div>
            </div>
            <div className="h-7 bg-slate-200 rounded w-16"></div>
            <div className="h-3 bg-slate-100 rounded w-32"></div>
          </div>
        ))}
      </div>
    );
  }

  const detailCampaign = campaign as CampaignDetail | null;
  const hasServerMetrics = detailCampaign && typeof detailCampaign.pending_count === "number";

  const totalCount = campaign?.recipient_count ?? recipients.length;
  const pendingCount = hasServerMetrics
    ? (detailCampaign.pending_count ?? 0)
    : recipients.filter((r) => r.status === "PENDING").length;
  const sentCount = hasServerMetrics
    ? (detailCampaign.sent_count ?? 0)
    : recipients.filter((r) => r.status === "SENT").length;
  const excludedCount = hasServerMetrics
    ? ((detailCampaign.suppressed_count ?? 0) + (detailCampaign.bounced_count ?? 0) + (detailCampaign.failed_count ?? 0))
    : recipients.filter(
        (r) => r.status === "SUPPRESSED" || r.status === "BOUNCED" || r.status === "FAILED"
      ).length;

  return (
    <div className="grid grid-cols-2 lg:grid-cols-4 gap-4 w-full min-w-0">
      {/* Card 1: Total Audience Target */}
      <div className="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col justify-between min-w-0">
        <div className="flex items-center justify-between gap-2 mb-2">
          <span className="text-xs font-medium text-slate-500 truncate">Total Audience</span>
          <div className="w-8 h-8 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center shrink-0">
            <Users className="h-4 w-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-semibold text-slate-900 tracking-tight" data-testid="metric-total">
            {totalCount.toLocaleString()}
          </div>
          <p className="text-xs text-slate-500 mt-0.5 truncate">Audience records configured</p>
        </div>
      </div>

      {/* Card 2: Pending Dispatch */}
      <div className="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col justify-between min-w-0">
        <div className="flex items-center justify-between gap-2 mb-2">
          <span className="text-xs font-medium text-slate-500 truncate">Pending Launch</span>
          <div className="w-8 h-8 rounded-lg bg-amber-50 text-amber-600 flex items-center justify-center shrink-0">
            <Clock className="h-4 w-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-semibold text-slate-900 tracking-tight" data-testid="metric-pending">
            {pendingCount.toLocaleString()}
          </div>
          <p className="text-xs text-slate-500 mt-0.5 truncate">Awaiting campaign launch</p>
        </div>
      </div>

      {/* Card 3: Dispatched / Sent */}
      <div className="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col justify-between min-w-0">
        <div className="flex items-center justify-between gap-2 mb-2">
          <span className="text-xs font-medium text-slate-500 truncate">Dispatched</span>
          <div className="w-8 h-8 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
            <CheckCircle2 className="h-4 w-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-semibold text-slate-900 tracking-tight" data-testid="metric-sent">
            {sentCount.toLocaleString()}
          </div>
          <p className="text-xs text-slate-500 mt-0.5 truncate">Confirmed deliveries</p>
        </div>
      </div>

      {/* Card 4: Suppressed / Excluded */}
      <div className="bg-white p-4 rounded-xl border border-slate-200/80 shadow-2xs flex flex-col justify-between min-w-0">
        <div className="flex items-center justify-between gap-2 mb-2">
          <span className="text-xs font-medium text-slate-500 truncate">Excluded</span>
          <div className="w-8 h-8 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center shrink-0">
            <ShieldAlert className="h-4 w-4" />
          </div>
        </div>
        <div>
          <div className="text-2xl font-semibold text-slate-900 tracking-tight" data-testid="metric-excluded">
            {excludedCount.toLocaleString()}
          </div>
          <p className="text-xs text-slate-500 mt-0.5 truncate">Suppressed or bounced</p>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/CampaignReviewStep.tsx">
import React from "react";
import DOMPurify from "dompurify";
import { Tag, Send, FileText, Users, Edit, Paperclip, CornerDownRight, Clock, ShieldCheck } from "lucide-react";
import type { AuthorizedEmailAccount } from "../../types/emails";
import type { CampaignAttachment, CampaignStepWritePayload } from "../../types/campaign";

interface CampaignReviewStepProps {
  name: string;
  subject: string;
  bodyHtml: string;
  selectedSender?: AuthorizedEmailAccount | null;
  attachments?: CampaignAttachment[];
  sendIntervalSeconds?: number;
  followupSteps?: CampaignStepWritePayload[];
  onEditStep: (stepNumber: number) => void;
}

export const CampaignReviewStep: React.FC<CampaignReviewStepProps> = ({
  name,
  subject,
  bodyHtml,
  selectedSender,
  attachments = [],
  sendIntervalSeconds = 0,
  followupSteps = [],
  onEditStep,
}) => {
  // Format provider name
  const formatProvider = (p?: string) => {
    switch (p?.toUpperCase()) {
      case "GMAIL":
      case "GOOGLE":
        return "Google Workspace";
      case "OUTLOOK":
      case "OFFICE365":
      case "MICROSOFT":
        return "Microsoft 365";
      case "SMTP_IMAP":
      case "SMTP":
        return "Custom SMTP";
      case "ZOHO":
        return "Zoho Mail";
      default:
        return p || "Email Account";
    }
  };

  const senderInitials = (selectedSender?.name || selectedSender?.email_address || "MB")
    .split(" ")
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

  const sanitizedHtml = DOMPurify.sanitize(
    bodyHtml || "<p class='text-slate-400 italic'>No content provided.</p>",
    { ADD_ATTR: ["target"] }
  );

  return (
    <section className="space-y-6">
      <div className="space-y-1">
        <h2 className="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
          Review Campaign
        </h2>
        <p className="text-xs sm:text-sm text-slate-500">
          Review all settings before continuing to the recipient allocation phase.
        </p>
      </div>

      <div className="space-y-4">
        {/* Card 1: Campaign Details */}
        <div className="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-2xs flex items-start justify-between gap-4">
          <div className="space-y-3 min-w-0">
            <div className="flex items-center gap-2">
              <Tag className="h-4 w-4 text-indigo-600 shrink-0" />
              <span className="text-[11px] uppercase tracking-wider font-semibold text-slate-500">
                Campaign Details
              </span>
            </div>
            <div>
              <p className="text-xs text-slate-500">Internal Name</p>
              <p
                id="review-campaign-name"
                className="text-xs sm:text-sm font-semibold text-slate-900 truncate mt-0.5"
              >
                {name || "Untitled Campaign"}
              </p>
            </div>
            <div>
              <p className="text-xs text-slate-500">Subject Line</p>
              <p
                id="review-subject"
                className="text-xs sm:text-sm text-slate-800 truncate mt-0.5"
              >
                {subject || <span className="text-slate-400 italic">No subject set</span>}
              </p>
            </div>
            <div>
              <p className="text-xs text-slate-500">Sending Interval</p>
              <p
                id="review-sending-interval"
                className="text-xs sm:text-sm text-slate-800 font-medium truncate mt-0.5"
              >
                {sendIntervalSeconds && sendIntervalSeconds > 0
                  ? sendIntervalSeconds % 60 === 0
                    ? `${sendIntervalSeconds / 60} ${sendIntervalSeconds / 60 === 1 ? "minute" : "minutes"}`
                    : `${sendIntervalSeconds} seconds`
                  : "No intentional delay"}
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={() => onEditStep(1)}
            aria-label="Edit Campaign Details"
            className="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-indigo-600 flex items-center gap-1.5 transition-colors shrink-0 shadow-2xs"
          >
            <Edit className="h-3.5 w-3.5" />
            <span>Edit</span>
          </button>
        </div>

        {/* Card 2: Sender Account */}
        <div className="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-2xs flex items-start justify-between gap-4">
          <div className="space-y-3 min-w-0">
            <div className="flex items-center gap-2">
              <Send className="h-4 w-4 text-indigo-600 shrink-0" />
              <span className="text-[11px] uppercase tracking-wider font-semibold text-slate-500">
                Sender Account
              </span>
            </div>

            {selectedSender ? (
              <div className="flex items-center gap-3">
                <div className="w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-bold shrink-0">
                  {senderInitials}
                </div>
                <div className="min-w-0">
                  <div className="flex items-center gap-2">
                    <p
                      id="review-sender-name"
                      className="text-xs sm:text-sm font-semibold text-slate-900 truncate"
                    >
                      {selectedSender.name}
                    </p>
                    <span className="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-medium border border-slate-200">
                      {formatProvider(selectedSender.provider)}
                    </span>
                  </div>
                  <p
                    id="review-sender-email"
                    className="text-xs text-slate-500 truncate"
                  >
                    {selectedSender.email_address}
                  </p>
                </div>
              </div>
            ) : (
              <p className="text-xs text-red-600 font-medium">
                No sender account selected
              </p>
            )}
          </div>
          <button
            type="button"
            onClick={() => onEditStep(2)}
            aria-label="Edit Sender Account"
            className="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-indigo-600 flex items-center gap-1.5 transition-colors shrink-0 shadow-2xs"
          >
            <Edit className="h-3.5 w-3.5" />
            <span>Edit</span>
          </button>
        </div>

        {/* Card 3: Email Content */}
        <div className="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-2xs space-y-3">
          <div className="flex items-start justify-between gap-4">
            <div className="flex items-center gap-2">
              <FileText className="h-4 w-4 text-indigo-600 shrink-0" />
              <span className="text-[11px] uppercase tracking-wider font-semibold text-slate-500">
                Email Content
              </span>
            </div>
            <button
              type="button"
              onClick={() => onEditStep(3)}
              aria-label="Edit Email Content"
              className="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-indigo-600 flex items-center gap-1.5 transition-colors shrink-0 shadow-2xs"
            >
              <Edit className="h-3.5 w-3.5" />
              <span>Edit</span>
            </button>
          </div>

          <div className="p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-2">
            <p className="text-[10px] uppercase tracking-wider font-semibold text-slate-400">
              Message Template Preview
            </p>
            <div
              id="review-content-snippet"
              dangerouslySetInnerHTML={{ __html: sanitizedHtml }}
              className="text-xs sm:text-sm text-slate-800 leading-relaxed max-h-48 overflow-y-auto pr-2 space-y-2"
            />
          </div>

          {attachments.length > 0 && (
            <div className="pt-2 border-t border-slate-100 space-y-2">
              <span className="text-[11px] font-semibold text-slate-500 uppercase tracking-wider flex items-center gap-1.5">
                <Paperclip className="h-3.5 w-3.5 text-slate-400" />
                <span>Attachments ({attachments.length})</span>
              </span>
              <div className="flex flex-wrap gap-2">
                {attachments.map((att) => (
                  <span
                    key={att.id}
                    className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-slate-100 text-slate-700 border border-slate-200"
                  >
                    <Paperclip className="h-3 w-3 text-slate-400" />
                    <span>{att.file_name}</span>
                    <span className="text-slate-400 text-[10px]">
                      ({(att.file_size / 1024).toFixed(0)} KB)
                    </span>
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>

        {/* Card 4: Automated Follow-Up Sequence */}
        {followupSteps && followupSteps.length > 0 && (
          <div className="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-2xs space-y-4">
            <div className="flex items-center justify-between pb-3 border-b border-slate-100">
              <div className="flex items-center gap-2">
                <CornerDownRight className="h-4 w-4 text-indigo-600 shrink-0" />
                <span className="text-[11px] uppercase tracking-wider font-semibold text-slate-500">
                  Automated Follow-Up Sequence
                </span>
              </div>
              <button
                type="button"
                onClick={() => onEditStep(3)}
                aria-label="Edit Follow-Up Steps"
                className="px-3 py-1.5 rounded-lg bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-semibold text-indigo-600 flex items-center gap-1.5 transition-colors shrink-0 shadow-2xs cursor-pointer"
              >
                <Edit className="h-3.5 w-3.5" />
                <span>Edit</span>
              </button>
            </div>

            <div className="space-y-3">
              <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200/60">
                <ShieldCheck className="h-3.5 w-3.5" />
                <span>{followupSteps.length} Automated Follow-Up Step{followupSteps.length > 1 ? "s" : ""} configured (stops automatically on reply)</span>
              </div>

              <div className="space-y-2.5 pt-1">
                {followupSteps.map((s, idx) => {
                  const isDays = s.delay_hours >= 24 && s.delay_hours % 24 === 0;
                  const delayText = isDays ? `${s.delay_hours / 24} day${s.delay_hours / 24 > 1 ? "s" : ""}` : `${s.delay_hours} hour${s.delay_hours > 1 ? "s" : ""}`;
                  const bodyPreview = s.body_text || (s.body_html ? s.body_html.replace(/<[^>]+>/g, " ").trim() : "") || "No content provided";

                  return (
                    <div key={idx} className="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 space-y-1.5">
                      <div className="flex items-center justify-between gap-2 flex-wrap">
                        <div className="flex items-center gap-2">
                          <span className="w-5 h-5 rounded-full bg-indigo-100 text-indigo-700 font-bold text-[11px] flex items-center justify-center">
                            {idx + 1}
                          </span>
                          <span className="font-semibold text-xs text-slate-900">
                            Follow-Up #{idx + 1} (Step {s.step_number})
                          </span>
                          <span className="text-[11px] text-slate-500 flex items-center gap-1">
                            <Clock className="h-3 w-3 text-slate-400" />
                            <span>Waits {delayText} if no reply</span>
                          </span>
                        </div>
                        <span className="text-xs font-medium text-slate-700">
                          Subject: "{s.subject || `Re: ${subject || "Subject"}`}"
                        </span>
                      </div>
                      <p className="text-xs text-slate-600 line-clamp-2 pl-7 font-sans">
                        {bodyPreview}
                      </p>
                    </div>
                  );
                })}
              </div>
            </div>
          </div>
        )}

        {/* Card 5: Recipients Placeholder */}
        <div className="bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-2xs flex items-start gap-3.5">
