    @classmethod
    async def delete_draft_attachment(
        cls,
        db: AsyncSession,
        current_user: User,
        draft_id: int,
        attachment_id: int,
        company_id: Optional[int] = None,
    ) -> None:
        """Delete an attachment from an editable draft and clean up storage on disk."""
        draft = await db.get(Email, draft_id)
        if not draft:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        if company_id is not None and draft.company_id != company_id:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        # Check membership before draft status check to prevent draft enumeration
        membership = await CompanyService.get_user_membership(
            db=db,
            company_id=draft.company_id,
            user_id=current_user.id,
        )
        if not membership:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        if draft.is_deleted:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Cannot delete attachments from a deleted draft.",
            )

        if draft.status != EmailStatus.DRAFT.value:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Cannot delete attachments from an email with status '{draft.status}'. Only DRAFT emails support attachment removal.",
            )

        attachment = await cls.get_attachment(
            db=db,
            current_user=current_user,
            attachment_id=attachment_id,
            email_id=draft_id,
            company_id=company_id,
            for_update=True,
        )

        storage_path = attachment.storage_path
        await db.delete(attachment)
        await db.commit()

        # Delete physical file from disk if no other record references it
        ref_stmt = select(func.count(EmailAttachment.id)).where(EmailAttachment.storage_path == storage_path)
        ref_count = (await db.execute(ref_stmt)).scalar() or 0
        if ref_count == 0:
            if not await AttachmentStorageService.delete_file(storage_path):
                logger.warning("Physical file deletion failed or file missing for path: %s", storage_path)
        else:
            logger.info("Retaining physical file %s: referenced by %d other record(s)", storage_path, ref_count)

        logger.info(
            "Deleted attachment id=%d from draft id=%d by user id=%d",
            attachment_id,
            draft_id,
            current_user.id,
        )

    @classmethod
