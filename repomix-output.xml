/* ================================================================
   LAYOUT
   ================================================================ */
const AW=132,AH=70,AG=32,LANE=100,SH=54,PL=30,PR=42,PB=90;
function cx(i){return PL+i*(AW+AG)+AW/2;}
function sy(si){return LANE+AH+si*SH+SH/2;}
function ai(id){return ACTORS.findIndex(a=>a.id===id);}

let cf='all',hl=null,zm=1;

function bc(sec){
  if(sec==='a'||sec==='both') return '#34d399';
  if(sec==='b') return '#f59e0b';
  if(sec==='err') return '#f87171';
  if(sec==='rbac') return '#fb923c';
  return '#94a3b8';
}

function vis(){
  if(cf==='a') return STEPS.filter(s=>s.sec==='a'||s.sec==='both');
  if(cf==='b') return STEPS.filter(s=>s.sec==='b'||s.sec==='rbac'||s.sec==='both');
  if(cf==='err') return STEPS.filter(s=>s.sec==='err'||s.sec==='rbac');
  return STEPS;
}

/* ================================================================
   RENDER
   ================================================================ */
function render(){
  const steps=vis();
  const W=PL+ACTORS.length*(AW+AG)-AG+PR;
  const H=LANE+AH+steps.length*SH+PB;
  let p=[];

  /* defs */
  let d='<defs>';
  ACTORS.forEach(a=>{
    d+=`<marker id="m-${a.id}" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="${a.color}"/></marker>`;
    d+=`<linearGradient id="g-${a.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${a.color}" stop-opacity="0.24"/><stop offset="100%" stop-color="${a.color}" stop-opacity="0.07"/></linearGradient>`;
  });
  d+=`<marker id="m-ret" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#64748b"/></marker>`;
  d+='</defs>';
  p.push(d);

  /* bg */
  p.push(`<rect width="${W}" height="${H}" fill="#0a0c14"/>`);

  /* lifelines */
  ACTORS.forEach((a,i)=>{
    const x=cx(i),op=hl&&hl!==a.id?0.09:1;
    p.push(`<line x1="${x}" y1="${LANE+AH}" x2="${x}" y2="${H-PB}" stroke="${a.color}" stroke-width="1.5" stroke-dasharray="4 6" opacity="${op*0.3}"/>`);
  });

  /* actor boxes top */
  ACTORS.forEach((a,i)=>{
    const x=cx(i),bx=x-AW/2,op=hl&&hl!==a.id?0.18:1;
    p.push(`<g class="ag" data-a="${a.id}" style="cursor:pointer" opacity="${op}">
      <rect x="${bx}" y="${LANE}" width="${AW}" height="${AH}" rx="9" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1.5" stroke-opacity="0.6"/>
      <text x="${x}" y="${LANE+26}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10" font-weight="600" fill="${a.color}">${a.label}</text>
      <text x="${x}" y="${LANE+50}" text-anchor="middle" font-family="Inter,sans-serif" font-size="8" fill="#64748b">${a.sub.split('·')[0].trim()}</text>
    </g>`);
  });

  /* actor boxes bottom */
  ACTORS.forEach((a,i)=>{
    const x=cx(i),bx=x-AW/2,by=H-PB,op=hl&&hl!==a.id?0.13:1;
    p.push(`<rect x="${bx}" y="${by}" width="${AW}" height="${AH}" rx="9" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1" stroke-opacity="0.4" opacity="${op}"/>
      <text x="${x}" y="${by+26}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10" font-weight="600" fill="${a.color}" opacity="${op}">${a.label}</text>`);
  });

  /* steps */
  steps.forEach((s,si)=>{
    const y=sy(si),col=bc(s.sec);

    if(s.type==='div'){
      const lw=Math.min(s.label.length*7.6+24,W-PL-PR);
      p.push(`<line x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}" stroke="${col}" stroke-width="2" opacity="0.22"/>
        <rect x="${PL}" y="${y-14}" width="${lw}" height="24" rx="5" fill="${col}" fill-opacity="0.11" stroke="${col}" stroke-width="1" stroke-opacity="0.45"/>
        <text x="${PL+10}" y="${y+5}" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="${col}" letter-spacing="0.04em">${s.label}</text>`);
      return;
    }

    if(s.type==='rbac'){
      const lw=Math.min(s.label.length*6.4+20,W-PL-PR);
      p.push(`<line x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}" stroke="#fb923c" stroke-width="1.5" stroke-dasharray="6 3" opacity="0.4"/>
        <rect x="${PL}" y="${y-12}" width="${lw}" height="21" rx="4" fill="rgba(251,146,60,0.09)" stroke="#fb923c" stroke-width="1" stroke-opacity="0.5"/>
        <text x="${PL+8}" y="${y+4}" font-family="Inter,sans-serif" font-size="10" font-weight="700" fill="#fb923c" opacity="0.9">${s.label}</text>`);
      return;
    }

    if(s.type==='alt'||s.type==='end'){
      const lw=Math.min(s.label.length*6.3+20,W-PL-PR);
      p.push(`<line x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}" stroke="${col}" stroke-width="1" stroke-dasharray="5 4" opacity="0.35"/>
        <rect x="${PL}" y="${y-11}" width="${lw}" height="19" rx="4" fill="${col}" fill-opacity="0.09" stroke="${col}" stroke-width="0.8" stroke-opacity="0.5"/>
        <text x="${PL+7}" y="${y+4}" font-family="Inter,sans-serif" font-size="9.5" font-weight="600" fill="${col}" opacity="0.9">${s.label}</text>`);
      return;
    }

    if(s.type==='note'){
      const lw=Math.min(s.label.length*7+28,W-PL-100);
      p.push(`<rect x="${PL+4}" y="${y-15}" width="${lw}" height="24" rx="5" fill="rgba(99,102,241,0.09)" stroke="#6366f1" stroke-width="1" stroke-dasharray="3 2"/>
        <text x="${PL+15}" y="${y+4}" font-family="Inter,sans-serif" font-size="10.5" font-weight="600" fill="#818cf8" class="st" data-s="${s.id}" style="cursor:pointer">&#128204; ${s.label}</text>`);
      return;
    }

    const fi=ai(s.from),ti=ai(s.to);
    if(fi<0||ti<0) return;
    const fx=cx(fi),tx=cx(ti),isR=s.type==='ret';
    const mk=isR?'m-ret':`m-${s.from}`,lc=isR?'#64748b':col;

    /* step badge */
    p.push(`<circle cx="${PL-10}" cy="${y}" r="10" fill="rgba(99,102,241,0.1)" stroke="#6366f1" stroke-width="1"/>
      <text x="${PL-10}" y="${y+3.5}" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="#a5b4fc">${s.id}</text>`);

    if(fi===ti){
      const rx2=fx+AW/2-10,lw=30,ty2=y-13,by2=y+11;
      p.push(`<path d="M${fx},${ty2} Q${rx2+lw},${ty2} ${rx2+lw},${y} Q${rx2+lw},${by2} ${fx},${by2}" fill="none" stroke="${lc}" stroke-width="1.5" stroke-dasharray="${isR?'4 3':'none'}" marker-end="url(#${mk})" opacity="0.85" class="al" data-s="${s.id}" style="cursor:pointer"/>
        <text x="${fx+6}" y="${ty2-2}" font-family="JetBrains Mono,monospace" font-size="8.5" fill="${lc}" class="st" data-s="${s.id}" style="cursor:pointer">${s.label}</text>`);
    } else {
      const mx=(fx+tx)/2;
      p.push(`<line x1="${fx}" y1="${y}" x2="${tx}" y2="${y}" stroke="${lc}" stroke-width="1.8" stroke-dasharray="${isR?'5 4':'none'}" marker-end="url(#${mk})" opacity="0.9" class="al" data-s="${s.id}" style="cursor:pointer"/>
        <text x="${mx}" y="${y-6}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="8.5" fill="${lc}" class="st" data-s="${s.id}" style="cursor:pointer">${s.label}</text>`);
    }
  });

  const sv=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" style="transform-origin:top left;transform:scale(${zm});transition:transform .2s;display:block">${p.join('')}</svg>`;
  document.getElementById('dw').innerHTML=sv;

  document.querySelectorAll('.st,.al').forEach(el=>{
    el.addEventListener('mouseenter',onH);
    el.addEventListener('mousemove',onM);
    el.addEventListener('mouseleave',onL);
  });
  document.querySelectorAll('.ag').forEach(el=>el.addEventListener('click',onAC));
}

/* ── sidebar ── */
function buildLeg(){
  const c=document.getElementById('leg');c.innerHTML='';
  ACTORS.forEach(a=>{
    const el=document.createElement('div');el.className='li';el.dataset.a=a.id;
    el.innerHTML=`<div class="ld" style="background:${a.color}"></div><div><div class="ln">${a.label}</div><div class="lx">${a.sub}</div></div>`;
    el.addEventListener('click',()=>{hl=hl===a.id?null:a.id;document.querySelectorAll('.li').forEach(l=>l.classList.remove('active'));if(hl)el.classList.add('active');render();});
    c.appendChild(el);
  });
}

function buildNav(){
  const c=document.getElementById('snav');c.innerHTML='';
  STEPS.filter(s=>s.type==='call'||s.type==='ret'||s.type==='note').forEach(s=>{
    const el=document.createElement('div');el.className='sp';el.dataset.s=s.id;
    const col=bc(s.sec);
    el.innerHTML=`<div class="sn" style="border-color:${col};color:${col}">${s.id}</div><div class="slb">${s.label}</div>`;
    el.addEventListener('mouseenter',()=>{showTT(s,310,140);el.classList.add('hl');});
    el.addEventListener('mouseleave',()=>{hideTT();el.classList.remove('hl');});
    c.appendChild(el);
  });
}

/* ── tooltip ── */
const TT=document.getElementById('tt');
function showTT(s,x,y){
  const col=bc(s.sec);
  const tn=document.getElementById('ttn');tn.style.cssText=`background:${col}22;border:1px solid ${col}55;color:${col}`;tn.textContent=s.id;
  document.getElementById('tty').textContent=`${s.type.toUpperCase()} · ${s.sec.toUpperCase()}`;
  document.getElementById('ttf').textContent=s.fn||s.label;
  document.getElementById('ttb').textContent=s.detail||'';
  document.getElementById('ttl').textContent=s.file||'';
  TT.style.left=(x+16)+'px';TT.style.top=(y-8)+'px';
  TT.classList.add('vis');
}
function hideTT(){TT.classList.remove('vis');}
function gs(id){return STEPS.find(s=>s.id===Number(id));}
function onH(e){const s=gs(e.currentTarget.dataset.s);if(s)showTT(s,e.clientX,e.clientY);}
function onM(e){if(TT.classList.contains('vis')){TT.style.left=(e.clientX+16)+'px';TT.style.top=(e.clientY-8)+'px';}}
function onL(){hideTT();}
function onAC(e){const a=e.currentTarget.dataset.a;hl=hl===a?null:a;document.querySelectorAll('.li').forEach(l=>l.classList.toggle('active',l.dataset.a===hl));render();}

/* ── filters ── */
document.querySelectorAll('.ft').forEach(btn=>{
  btn.addEventListener('click',()=>{
    cf=btn.dataset.f;
    document.querySelectorAll('.ft').forEach(b=>{b.classList.remove('active','fa','fb2');});
    btn.classList.add('active');
    if(cf==='a') btn.classList.add('fa');
    if(cf==='b') btn.classList.add('fb2');
    render();buildNav();
  });
});

/* ── zoom ── */
document.getElementById('bzi').addEventListener('click',()=>{zm=Math.min(zm+0.15,2);render();});
document.getElementById('bzo').addEventListener('click',()=>{zm=Math.max(zm-0.15,0.4);render();});

buildLeg();buildNav();render();
</script>
</body>
</html>
</file>

