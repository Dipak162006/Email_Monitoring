    .route-probe[hidden] { display: none; }
    /* Picking needs one line of guidance, not a wide empty card; the panel
       widens only when there is a traced route to show. */
    .route-probe:not([data-state="result"]) { width: min(22rem, calc(100% - 2rem)); min-width: 0; }
    .route-probe-path:has(> .route-probe-placeholder:only-child) { display: none; }
