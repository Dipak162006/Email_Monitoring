from email.message import EmailMessage
import logging
from pathlib import Path
from typing import List, Optional, Sequence, Tuple
from fastapi import HTTPException, UploadFile, status
from sqlalchemy import func, select
from sqlalchemy.ext.asyncio import AsyncSession

from app.core.config import settings
from app.core.storage import AttachmentStorageService
from app.modules.auth.models import User
from app.modules.companies.service import CompanyService
from app.modules.email_accounts.service import EmailAccountService
from app.modules.emails.models import Email, EmailAttachment, EmailStatus

logger = logging.getLogger(__name__)


class AttachmentService:
    """Service layer managing email attachments: upload, validation, storage,
    authorization, listing, download, and deletion.
    """

    @classmethod
    async def upload_draft_attachment(
        cls,
        db: AsyncSession,
        current_user: User,
        draft_id: int,
        upload_file: UploadFile,
        company_id: Optional[int] = None,
    ) -> EmailAttachment:
        """Upload and associate an attachment with an authorized draft."""
        draft = await db.get(Email, draft_id)
        if not draft:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        if company_id is not None and draft.company_id != company_id:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        # 1. Authorization: verify company membership first so foreign users cannot enumerate drafts or status
        membership = await CompanyService.get_user_membership(
            db=db,
            company_id=draft.company_id,
            user_id=current_user.id,
        )
        if not membership:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Draft not found.",
            )

        if draft.is_deleted:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Cannot add attachments to a deleted draft. Restore it first.",
            )

        if draft.status != EmailStatus.DRAFT.value:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Cannot add attachments to an email with status '{draft.status}'. Only DRAFT emails support adding attachments.",
            )

        account = await EmailAccountService.get_email_account(db, draft.email_account_id)
        if not account:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Associated email account not found.",
            )

        has_access = await EmailAccountService.check_user_access(
            db=db,
            account=account,
            user_id=current_user.id,
            user_role=membership.role,
        )
        if not has_access:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="You do not have permission to access this draft's email account.",
            )

        # 2. Store file on filesystem with safety validation
        try:
            safe_name, content_type, file_size, rel_path = await AttachmentStorageService.save_upload_file(
                company_id=draft.company_id,
                account_id=draft.email_account_id,
                upload_file=upload_file,
            )
        except ValueError as e:
            err_msg = str(e)
            if "exceeds maximum limit" in err_msg:
                raise HTTPException(
                    status_code=status.HTTP_413_CONTENT_TOO_LARGE,
                    detail=err_msg,
                )
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=err_msg,
            )

        # 3. Create database record
        attachment = EmailAttachment(
            company_id=draft.company_id,
            email_account_id=draft.email_account_id,
            email_id=draft.id,
            file_name=safe_name,
            content_type=content_type,
            file_size=file_size,
            storage_path=rel_path,
        )
        db.add(attachment)
        await db.commit()
        await db.refresh(attachment)

        logger.info(
            "Uploaded attachment id=%d (name='%s', size=%d) to draft id=%d by user id=%d",
            attachment.id,
            attachment.file_name,
            attachment.file_size,
            draft.id,
            current_user.id,
        )
        return attachment

    @classmethod
    async def create_incoming_attachment(
        cls,
        db: AsyncSession,
        company_id: int,
        email_account_id: int,
        email_id: int,
        file_name: str,
        content_type: str,
        content_bytes: bytes,
    ) -> Optional[EmailAttachment]:
        """Save an incoming attachment extracted from an IMAP email idempotently."""
        safe_name = AttachmentStorageService.sanitize_filename(file_name)
        file_size = len(content_bytes)

        # Idempotency check: verify if attachment already exists for this email
        dup_stmt = select(EmailAttachment).where(
            EmailAttachment.email_id == email_id,
            EmailAttachment.file_name == safe_name,
            EmailAttachment.file_size == file_size,
        )
        dup_res = await db.execute(dup_stmt)
        existing = dup_res.scalars().first()
        if existing:
            logger.info(
                "Attachment '%s' (size=%d) already exists on email id=%d; skipping duplicate creation.",
                safe_name,
                file_size,
                email_id,
            )
            return existing

        try:
            safe_name, c_type, file_size, rel_path = AttachmentStorageService.save_attachment_bytes(
                company_id=company_id,
                account_id=email_account_id,
                raw_filename=file_name,
                content_type=content_type,
                content_bytes=content_bytes,
            )
        except ValueError as exc:
            logger.warning("Skipping incoming attachment '%s' for email %d: %s", file_name, email_id, exc)
            return None
        except Exception as exc:
            logger.error("Failed to save incoming attachment '%s' for email %d: %s", file_name, email_id, exc)
            return None

        attachment = EmailAttachment(
            company_id=company_id,
            email_account_id=email_account_id,
            email_id=email_id,
            file_name=safe_name,
            content_type=c_type,
            file_size=file_size,
            storage_path=rel_path,
        )
        db.add(attachment)
        logger.info(
            "Created incoming attachment '%s' (size=%d bytes, path=%s) for email id=%d",
            safe_name,
            file_size,
            rel_path,
            email_id,
        )
        return attachment

    @classmethod
    async def list_draft_attachments(
        cls,
        db: AsyncSession,
        current_user: User,
        draft_id: int,
        company_id: Optional[int] = None,
    ) -> Tuple[List[EmailAttachment], int]:
        """List all attachments associated with a draft."""
        return await cls.list_email_attachments(
            db=db,
            current_user=current_user,
            email_id=draft_id,
            company_id=company_id,
            require_draft=True,
        )

    @classmethod
    async def list_email_attachments(
        cls,
        db: AsyncSession,
        current_user: User,
        email_id: int,
        company_id: Optional[int] = None,
        require_draft: bool = False,
    ) -> Tuple[List[EmailAttachment], int]:
        """List all attachments for an authorized email message (draft, sent, or received)."""
        email = await db.get(Email, email_id)
        not_found_detail = "Draft not found." if require_draft else "Email not found."
        if not email:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=not_found_detail,
            )

        if company_id is not None and email.company_id != company_id:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=not_found_detail,
            )

        # Verify access before revealing email status
        membership = await CompanyService.get_user_membership(
            db=db,
            company_id=email.company_id,
            user_id=current_user.id,
        )
        if not membership:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=not_found_detail,
            )

        if require_draft and email.status != EmailStatus.DRAFT.value:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Specified email is not a draft.",
            )

        account = await EmailAccountService.get_email_account(db, email.email_account_id)
        if not account:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Associated email account not found.",
            )

        has_access = await EmailAccountService.check_user_access(
            db=db,
            account=account,
            user_id=current_user.id,
            user_role=membership.role,
        )
        if not has_access:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="You do not have permission to access attachments for this email account.",
            )

        stmt = select(EmailAttachment).where(EmailAttachment.email_id == email_id).order_by(EmailAttachment.created_at.asc())
        res = await db.execute(stmt)
        items = list(res.scalars().all())
        return items, len(items)

    @classmethod
    async def get_attachment(
        cls,
        db: AsyncSession,
        current_user: User,
        attachment_id: int,
        email_id: Optional[int] = None,
        company_id: Optional[int] = None,
        for_update: bool = False,
    ) -> EmailAttachment:
        """Retrieve attachment metadata and verify company/account authorization."""
        if for_update:
            stmt = select(EmailAttachment).where(EmailAttachment.id == attachment_id).with_for_update()
            res = await db.execute(stmt)
            attachment = res.scalars().first()
        else:
            attachment = await db.get(EmailAttachment, attachment_id)
        if not attachment:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Attachment not found.",
            )

        if email_id is not None and attachment.email_id != email_id:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Attachment not found.",
            )

        if company_id is not None and attachment.company_id != company_id:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Attachment not found.",
            )

        # Verify authorization: return uniform 404 for cross-company requests to prevent ID enumeration
        membership = await CompanyService.get_user_membership(
            db=db,
            company_id=attachment.company_id,
            user_id=current_user.id,
        )
        if not membership:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Attachment not found.",
            )

        account = await EmailAccountService.get_email_account(db, attachment.email_account_id)
        if not account:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail="Associated email account not found.",
            )

        has_access = await EmailAccountService.check_user_access(
            db=db,
            account=account,
            user_id=current_user.id,
            user_role=membership.role,
        )
        if not has_access:
            raise HTTPException(
                status_code=status.HTTP_403_FORBIDDEN,
                detail="You do not have permission to access this attachment.",
            )

        return attachment

    @classmethod
    async def get_attachment_for_download(
        cls,
        db: AsyncSession,
        current_user: User,
        attachment_id: int,
        email_id: Optional[int] = None,
        company_id: Optional[int] = None,
    ) -> Tuple[Path, str, str]:
        """Verify access and return resolved physical file path, filename, and content type."""
        attachment = await cls.get_attachment(
