            <AlertCircle className="h-4 w-4" />
          </div>
          <div className="min-w-0">
            <h4 className="text-xs font-semibold text-rose-900 leading-tight">{title}</h4>
            <p className="text-[11px] text-rose-700 truncate mt-0.5">{message}</p>
          </div>
        </div>
        {onRetry && (
          <Button
            size="sm"
            variant="outline"
