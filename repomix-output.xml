    ['n8','n9',{}],
    ['n9','n9b',{}],
    ['n9b','n9',{dashed:true,label:'thread'}],
    ['n9','n10',{}],
    ['n10','n11',{}],
    ['n11','n11b',{}],
    ['n11b','n12',{}],
    ['n12','n13',{}],
    ['n13','n14',{label:'success'}],
    ['n14','n14b',{}],
    ['n14b','n15',{dashed:true}],
    ['n15','n15b',{dashed:true}],
  ];

  pairs.forEach(([a,b,opts])=>{
    const pa=getCenter(a), pb=getCenter(b);
    if(pa&&pb) drawArrow(svg,pa.x,pa.y,pb.x,pb.y,opts);
  });
}

window.addEventListener('load',()=>{
  setTimeout(drawAllArrows,200);
});
window.addEventListener('resize',drawAllArrows);
document.getElementById('canvas-wrap').addEventListener('scroll',drawAllArrows);
</script>
</body>
</html>
</file>

