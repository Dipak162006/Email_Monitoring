<file path="frontend/src/components/domains/EditDkimDialog.tsx">
import React, { useState, useEffect } from "react";
import { createPortal } from "react-dom";
import { X, Loader2, AlertCircle, Lock, Key, Check } from "lucide-react";
import { Button } from "../ui/Button";
import { domainsApi } from "../../services/api";
import type { Domain } from "../../types/domains";

interface EditDkimDialogProps {
  isOpen: boolean;
  onClose: () => void;
  domain: Domain | null;
  companyId: number;
  onSuccess: (updatedDomain: Domain) => void;
}

export const EditDkimDialog: React.FC<EditDkimDialogProps> = ({
  isOpen,
  onClose,
  domain,
  companyId,
  onSuccess,
}) => {
  const [dkimSelector, setDkimSelector] = useState("");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  useEffect(() => {
    if (domain) {
      setDkimSelector(domain.dkim_selector || "");
      setErrorMessage(null);
    }
  }, [domain, isOpen]);

  if (!isOpen || !domain) return null;

  const handleClose = () => {
    if (isSubmitting) return;
    setErrorMessage(null);
    onClose();
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMessage(null);
    setIsSubmitting(true);

    try {
      const trimmed = dkimSelector.trim();
      const payload = {
        dkim_selector: trimmed ? trimmed : null,
      };

      const result = await domainsApi.updateDomain(companyId, domain.id, payload);
      setErrorMessage(null);
      onSuccess(result);
    } catch (err: unknown) {
      const errorObj = err as { detail?: string; message?: string };
      setErrorMessage(
        errorObj.detail || errorObj.message || "Failed to update DKIM selector. Please try again."
      );
    } finally {
      setIsSubmitting(false);
    }
  };

  const previewSelector = dkimSelector.trim() || "default";

  return createPortal(
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150"
      role="dialog"
      aria-modal="true"
      aria-labelledby="edit-dkim-title"
    >
      <div className="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden animate-in zoom-in-95 duration-150">
        {/* Header */}
        <div className="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/50">
          <div>
            <h3 id="edit-dkim-title" className="text-base font-bold text-slate-900 flex items-center gap-2">
              <Key className="w-4 h-4 text-indigo-600" />
              <span>Edit DKIM Configuration</span>
            </h3>
            <p className="text-xs text-slate-500 mt-0.5">
              Update the DKIM selector prefix for DNS public key discovery.
            </p>
          </div>
          <button
            type="button"
            disabled={isSubmitting}
            onClick={handleClose}
            aria-label="Close dialog"
            className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors disabled:opacity-50 cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Form Body */}
        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          {errorMessage && (
            <div
              className="p-3.5 rounded-xl border border-rose-200 bg-rose-50/70 text-rose-800 text-xs flex items-start gap-2.5"
              role="alert"
            >
              <AlertCircle className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
              <span className="leading-relaxed">{errorMessage}</span>
            </div>
          )}

          {/* Domain Name (Strictly READ ONLY) */}
          <div className="space-y-1.5">
            <div className="flex items-center justify-between">
              <label
                htmlFor="edit-domain-name"
                className="block text-xs font-semibold text-slate-800"
              >
                Domain Name
              </label>
              <span className="inline-flex items-center gap-1 text-[11px] font-medium text-slate-400">
                <Lock className="w-3 h-3 text-slate-400" />
                Read-only
              </span>
            </div>
            <input
              id="edit-domain-name"
              type="text"
              readOnly
              disabled
              value={domain.domain_name}
              className="w-full px-3.5 py-2 text-xs font-mono bg-slate-100/80 border border-slate-200 rounded-xl text-slate-600 cursor-not-allowed select-none outline-none"
            />
            <p className="text-[11px] text-slate-500">
              The domain name itself cannot be changed after creation.
            </p>
          </div>

          {/* DKIM Selector (Editable) */}
          <div className="space-y-1.5">
            <label
              htmlFor="edit-dkim-selector"
              className="block text-xs font-semibold text-slate-800"
            >
              DKIM Selector
            </label>
            <input
              id="edit-dkim-selector"
              type="text"
              disabled={isSubmitting}
              value={dkimSelector}
              onChange={(e) => setDkimSelector(e.target.value)}
              placeholder="e.g. pm2024 or default"
              className="w-full px-3.5 py-2 text-xs font-mono bg-white border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all disabled:opacity-50"
            />
            <p className="text-[11px] text-slate-500">
              Host will resolve to:{" "}
              <code className="font-mono text-indigo-600 font-semibold">
                {previewSelector}._domainkey.{domain.domain_name}
              </code>
            </p>
          </div>

          {/* Warning note about status reset */}
          <div className="p-3 bg-amber-50/80 border border-amber-200/80 rounded-xl text-[11px] text-amber-900 leading-relaxed">
            Note: Changing the DKIM selector will reset its verification status to pending until the next verification check.
          </div>

          {/* Actions */}
          <div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <Button
              type="button"
              variant="outline"
              size="sm"
              disabled={isSubmitting}
              onClick={handleClose}
              className="cursor-pointer"
            >
              Cancel
            </Button>
            <Button
              type="submit"
              size="sm"
              disabled={isSubmitting}
              className="gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer"
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="w-3.5 h-3.5 animate-spin" />
                  <span>Saving...</span>
                </>
              ) : (
                <>
                  <Check className="w-3.5 h-3.5" />
                  <span>Save Changes</span>
                </>
              )}
            </Button>
          </div>
        </form>
      </div>
    </div>,
    document.body
  );
};
</file>

<file path="frontend/src/components/mailbox/__tests__/EmailBodyViewer.test.tsx">
import { describe, it, expect } from "vitest";
import { render, screen, fireEvent } from "@testing-library/react";
import { EmailBodyViewer } from "../EmailBodyViewer";

describe("EmailBodyViewer - Industry Standard Implementation", () => {
  const sampleHtml = `
    <div>
      <h1>Dear Customer</h1>
      <p>Here is your promotional email offer.</p>
    </div>
  `;
  const sampleText = "Dear Customer\n\nHere is your promotional email offer.";

  it("renders sandboxed iframe with scrolling='no' to prevent inner scrollbars", () => {
    render(<EmailBodyViewer html={sampleHtml} text={sampleText} />);

    const iframe = screen.getByTitle("Email Message Body");
    expect(iframe).toBeTruthy();
    expect(iframe.getAttribute("scrolling")).toBe("no");
    expect(iframe.getAttribute("sandbox")).toBe(
      "allow-popups allow-popups-to-escape-sandbox allow-same-origin"
    );
  });

  it("injects overflow-y: hidden and height resets in iframe srcDoc to prevent vertical scrollbars and locked height", () => {
    render(<EmailBodyViewer html={sampleHtml} text={sampleText} />);

    const iframe = screen.getByTitle("Email Message Body") as HTMLIFrameElement;
    const srcDoc = iframe.getAttribute("srcdoc") || "";

    expect(srcDoc.includes("overflow-y: hidden !important;")).toBe(true);
    expect(srcDoc.includes("height: auto !important;")).toBe(true);
    expect(srcDoc.includes("min-height: 0 !important;")).toBe(true);
    expect(srcDoc.includes("::-webkit-scrollbar")).toBe(true);
    expect(srcDoc.includes("Dear Customer")).toBe(true);
  });

  it("renders a skeleton loading state with pulse animation while initial layout is resolving", () => {
    const { container } = render(<EmailBodyViewer html={sampleHtml} text={sampleText} />);

    const pulseSkeleton = container.querySelector(".animate-pulse");
    expect(pulseSkeleton).toBeTruthy();
  });

  it("allows switching between Formatted HTML and Plain Text views", () => {
    render(<EmailBodyViewer html={sampleHtml} text={sampleText} />);

    // Initially in Formatted view
    expect(screen.getByTitle("Email Message Body")).toBeTruthy();

    // Click Plain Text button
    const plainTextBtn = screen.getByRole("button", { name: /plain text/i });
    fireEvent.click(plainTextBtn);

    // Formatted iframe is removed, text is visible
    expect(screen.queryByTitle("Email Message Body")).toBeNull();
    expect(screen.getByText(/Here is your promotional email offer/i)).toBeTruthy();

    // Click Formatted button
    const formattedBtn = screen.getByRole("button", { name: /formatted/i });
    fireEvent.click(formattedBtn);

    expect(screen.getByTitle("Email Message Body")).toBeTruthy();
  });

  it("preserves email head style tags and media queries so responsive desktop/mobile alternate images are not duplicated", () => {
    const responsiveEmailHtml = `
      <!doctype html>
      <html>
      <head>
        <style type="text/css">
          @media only screen and (min-width: 720px) {
            .desktop-hide { display: none !important; }
          }
          @media only screen and (max-width: 719px) {
            .m-hide { display: none !important; }
          }
        </style>
      </head>
      <body>
        <img src="https://example.com/mobile-banner.png" class="desktop-hide" alt="Mobile Banner">
        <img src="https://example.com/desktop-banner.png" class="m-hide" alt="Desktop Banner">
      </body>
      </html>
    `;

    render(<EmailBodyViewer html={responsiveEmailHtml} />);

    const iframe = screen.getByTitle("Email Message Body") as HTMLIFrameElement;
    const srcDoc = iframe.getAttribute("srcdoc") || "";

    // Verify original style rules and media queries are preserved inside srcDoc
    expect(srcDoc.includes(".desktop-hide { display: none !important; }")).toBe(true);
    expect(srcDoc.includes(".m-hide { display: none !important; }")).toBe(true);
    expect(srcDoc.includes("@media only screen and (min-width: 720px)")).toBe(true);
    expect(srcDoc.includes("@media only screen and (max-width: 719px)")).toBe(true);
  });

  it("renders formatted plain text directly when only text content is provided", () => {
    render(<EmailBodyViewer text={sampleText} />);

    expect(screen.queryByTitle("Email Message Body")).toBeNull();
    expect(screen.getByText(/Here is your promotional email offer/i)).toBeTruthy();
  });
});
</file>

