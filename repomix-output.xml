function midPoint(el){
  const r=el.getBoundingClientRect();
  const cr=document.getElementById('canvas').getBoundingClientRect();
  return{x:(r.left+r.right)/2-cr.left, y:(r.top+r.bottom)/2-cr.top};
}
function getCenter(id){
  const el=document.getElementById(id);
  if(!el)return null;
  return midPoint(el);
}

function drawArrow(svg,x1,y1,x2,y2,opts={}){
  const{dashed=false,color='#58a6ff',label='',err=false}=opts;
  const mc=err?'#ff7b72':dashed?'#8b949e':color;
  const mId=err?'ah-err':dashed?'ah-resp':'ah';

  const path=document.createElementNS('http://www.w3.org/2000/svg','path');
  // curved path
  const dx=x2-x1, dy=y2-y1;
  const cx=x1+dx*0.5, cy=y1+dy*0.1;
  const d=`M${x1},${y1} Q${cx},${cy} ${x2},${y2}`;
  path.setAttribute('d',d);
  path.setAttribute('fill','none');
  path.setAttribute('stroke',mc);
  path.setAttribute('stroke-width','1.5');
  if(dashed||err) path.setAttribute('stroke-dasharray','5 3');
  path.setAttribute('marker-end',`url(#${mId})`);
  svg.appendChild(path);

  if(label){
    const t=document.createElementNS('http://www.w3.org/2000/svg','text');
    t.setAttribute('x',(x1+x2)/2+4);
    t.setAttribute('y',(y1+y2)/2-5);
    t.setAttribute('fill',mc);
    t.setAttribute('font-size','9');
    t.setAttribute('font-family','Inter,sans-serif');
    t.textContent=label;
    svg.appendChild(t);
  }
}

