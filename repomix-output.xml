}) => {
  const senderName =
    senderAccount?.name || campaign.email_account_name || "Assigned Account";
  const senderEmail =
    senderAccount?.email_address ||
    campaign.email_account_address ||
    `Account #${campaign.email_account_id}`;

  const recipientCount = campaign.recipient_count;
  const scheduled = formatDateTime(campaign.scheduled_at);
  const created = formatDateTime(campaign.created_at);

  const status = (campaign.status || "").toUpperCase();
  const isDraft = status === "DRAFT";
  const isDeletable = ["DRAFT", "COMPLETED", "CANCELLED", "FAILED"].includes(status);

  return (
    <tr className="group transition-colors duration-150 hover:bg-slate-50/80 border-b border-slate-100/90 last:border-b-0">
      {/* 1. Campaign Identity & Subject */}
      <td className="py-3 px-4 min-w-[200px] max-w-[320px]">
        <div className="flex items-center gap-3 min-w-0">
          {getStatusIcon(campaign.status)}
          <div className="flex flex-col min-w-0 flex-1">
            <button
              type="button"
              onClick={(e) => {
                e.stopPropagation();
                onView(campaign);
              }}
              title={campaign.name}
              className="font-semibold text-slate-900 truncate hover:text-indigo-600 text-sm leading-snug text-left focus:outline-none focus:ring-2 focus:ring-indigo-500 rounded-xs block w-full"
            >
              {campaign.name}
            </button>
            <span
              title={campaign.subject || undefined}
              className={`text-xs truncate mt-0.5 ${
                campaign.subject ? "text-slate-500" : "text-slate-400 italic"
              }`}
            >
              {campaign.subject || "No subject"}
            </span>
          </div>
        </div>
      </td>

      {/* 2. Sender */}
      <td className="py-3 px-4 text-xs max-w-[180px]">
        <span className="font-medium text-slate-800 block truncate" title={senderName}>
          {senderName}
        </span>
        <span className="text-slate-400 text-[11px] block truncate mt-0.5" title={senderEmail}>
          {senderEmail}
        </span>
      </td>

      {/* 3. Target Size */}
      <td className="py-3 px-4 text-xs whitespace-nowrap">
        {recipientCount !== undefined && recipientCount !== null ? (
          <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100/70 text-slate-600 text-xs font-normal border border-slate-200/50">
            <Users className="h-3.5 w-3.5 text-slate-400 shrink-0" />
            <span>
              {recipientCount.toLocaleString()} {recipientCount === 1 ? "recipient" : "recipients"}
            </span>
          </span>
        ) : (
          <span className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-slate-100/50 text-slate-400 text-xs font-normal border border-slate-200/40">
            <Users className="h-3.5 w-3.5 text-slate-400 shrink-0" />
            <span>— recipients</span>
          </span>
        )}
      </td>

      {/* 4. Status */}
      <td className="py-3 px-4 whitespace-nowrap">
        <CampaignStatusBadge status={campaign.status} />
      </td>

      {/* 5. Scheduled Date */}
      <td className="py-3 px-4 text-xs whitespace-nowrap">
        {scheduled ? (
          <div className="flex flex-col min-w-0">
            <span className="font-medium text-slate-700 whitespace-nowrap">
              {scheduled.date}
            </span>
            <span className="text-[11px] text-slate-400 whitespace-nowrap mt-0.5">
              {scheduled.time}
            </span>
          </div>
        ) : (
          <span className="text-slate-400">—</span>
        )}
      </td>

      {/* 6. Created Date + Contextual Action Buttons */}
      <td className="py-3 px-4 text-xs text-slate-500 relative whitespace-nowrap">
        {/* Default View: Created Timestamp */}
        {created ? (
          <div className="flex flex-col min-w-0 transition-opacity duration-150">
            <span className="font-medium text-slate-700 whitespace-nowrap" title={campaign.created_at}>
              {created.date}
            </span>
            <span className="text-[11px] text-slate-400 whitespace-nowrap mt-0.5">
              {created.time}
            </span>
          </div>
        ) : (
          <span className="text-slate-400">—</span>
        )}

        {/* Floating Quick Action Icons on Hover / Focus */}
        <div
          className="campaign-row-actions absolute right-3 top-1/2 -translate-y-1/2 opacity-0 pointer-events-none group-hover:opacity-100 group-hover:pointer-events-auto focus-within:opacity-100 focus-within:pointer-events-auto flex items-center gap-1 bg-white border border-slate-200/90 px-1.5 py-1 rounded-lg shadow-md z-10 transition-opacity"
          onClick={(e) => e.stopPropagation()}
        >
          {isMutating ? (
            <div className="p-1.5 text-slate-400">
              <Loader2 className="h-4 w-4 animate-spin" />
            </div>
          ) : (
            <>
              {/* 1. View Campaign */}
              <Tooltip content="View campaign" side="top">
                <button
                  type="button"
                  onClick={() => onView(campaign)}
                  aria-label="View campaign"
                  className="p-1 rounded text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer"
                >
                  <Eye className="h-4 w-4" />
                </button>
              </Tooltip>

              {/* 2. Edit Draft (only for DRAFT campaigns) */}
              {isDraft && onEdit && (
                <Tooltip content="Edit draft" side="top">
                  <button
                    type="button"
                    onClick={() => onEdit(campaign)}
                    aria-label="Edit draft"
                    className="p-1 rounded text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer"
                  >
                    <Edit className="h-4 w-4" />
                  </button>
                </Tooltip>
              )}

              {/* 3. Manage Recipients */}
              {onManageRecipients && (
                <Tooltip content="Manage recipients" side="top">
                  <button
                    type="button"
                    onClick={() => onManageRecipients(campaign)}
                    aria-label="Manage recipients"
                    className="p-1 rounded text-slate-500 hover:text-indigo-600 hover:bg-slate-100 transition-colors focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer"
                  >
                    <Users className="h-4 w-4" />
                  </button>
                </Tooltip>
              )}

              {/* 4. Delete Campaign (only for permitted statuses) */}
              {isDeletable && onDelete && (
                <Tooltip content="Delete campaign" side="top">
                  <button
                    type="button"
                    onClick={() => onDelete(campaign)}
                    aria-label="Delete campaign"
                    className="p-1 rounded text-slate-400 hover:text-rose-600 hover:bg-rose-50 transition-colors focus:outline-none focus:ring-1 focus:ring-rose-500 cursor-pointer"
                  >
                    <Trash2 className="h-4 w-4" />
                  </button>
                </Tooltip>
              )}
            </>
          )}
        </div>
      </td>
    </tr>
  );
};
</file>

<file path="frontend/src/components/campaigns/CampaignToolbar.tsx">
import React from "react";
import { Search, X, RotateCcw, Mail, Filter } from "lucide-react";
import type { AuthorizedEmailAccount } from "../../types/emails";

interface CampaignToolbarProps {
  searchQuery: string;
  onSearchChange: (query: string) => void;
  statusFilter: string;
  onStatusFilterChange: (status: string) => void;
  senderFilter: string;
  onSenderFilterChange: (senderId: string) => void;
  emailAccounts: AuthorizedEmailAccount[];
  onClearFilters: () => void;
  hasActiveFilters: boolean;
}

const CAMPAIGN_STATUSES: { label: string; value: string }[] = [
  { label: "All Statuses", value: "ALL" },
  { label: "DRAFT", value: "DRAFT" },
  { label: "SCHEDULED", value: "SCHEDULED" },
  { label: "QUEUED", value: "QUEUED" },
  { label: "RUNNING", value: "RUNNING" },
  { label: "PAUSED", value: "PAUSED" },
  { label: "COMPLETED", value: "COMPLETED" },
  { label: "CANCELLED", value: "CANCELLED" },
  { label: "FAILED", value: "FAILED" },
];

export const CampaignToolbar: React.FC<CampaignToolbarProps> = ({
  searchQuery,
  onSearchChange,
  statusFilter,
  onStatusFilterChange,
  senderFilter,
  onSenderFilterChange,
  emailAccounts,
  onClearFilters,
  hasActiveFilters,
}) => {
  return (
    <div className="bg-white p-3 rounded-xl border border-slate-200/80 shadow-2xs flex flex-wrap items-center justify-between gap-3 w-full">
      {/* Search Input */}
      <div className="relative w-full sm:w-72 md:w-80 flex items-center">
        <Search className="absolute left-3 h-4 w-4 text-slate-400 pointer-events-none" />
        <input
          type="text"
          value={searchQuery}
          onChange={(e) => onSearchChange(e.target.value)}
          placeholder="Filter loaded campaigns..."
          aria-label="Filter loaded campaigns"
          title="Filter loaded campaigns on current page by name or subject"
          className="w-full h-9 pl-9 pr-8 rounded-lg bg-slate-50/70 hover:bg-slate-50 focus:bg-white border border-slate-200/80 text-slate-900 placeholder-slate-400 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all shadow-2xs"
        />
        {searchQuery.length > 0 && (
          <button
            type="button"
            onClick={() => onSearchChange("")}
            title="Clear search"
            aria-label="Clear search"
            className="absolute right-2.5 p-1 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        )}
      </div>

      {/* Filter Controls */}
      <div className="flex flex-wrap items-center gap-2 w-full sm:w-auto">
        {/* Status Filter */}
        <div className="relative flex items-center">
          <Filter className="absolute left-2.5 h-3.5 w-3.5 text-slate-400 pointer-events-none" />
          <select
            value={statusFilter}
            onChange={(e) => onStatusFilterChange(e.target.value)}
            aria-label="Filter by campaign status"
            className="h-9 pl-8 pr-7 rounded-lg bg-slate-50/70 hover:bg-slate-50 text-slate-800 text-xs font-medium border border-slate-200/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors cursor-pointer appearance-none shadow-2xs"
          >
            {CAMPAIGN_STATUSES.map((status) => (
              <option key={status.value} value={status.value}>
                {status.label}
              </option>
            ))}
          </select>
        </div>

        {/* Sender Filter */}
        <div className="relative flex items-center">
          <Mail className="absolute left-2.5 h-3.5 w-3.5 text-slate-400 pointer-events-none" />
          <select
            value={senderFilter}
            onChange={(e) => onSenderFilterChange(e.target.value)}
            aria-label="Filter by sender email account"
            className="h-9 pl-8 pr-7 rounded-lg bg-slate-50/70 hover:bg-slate-50 text-slate-800 text-xs font-medium border border-slate-200/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-colors cursor-pointer appearance-none max-w-[200px] truncate shadow-2xs"
          >
            <option value="ALL">All Senders</option>
            {emailAccounts.map((account) => (
              <option key={account.id} value={String(account.id)}>
                {account.name || account.email_address}
              </option>
            ))}
          </select>
        </div>

        {/* Clear Filters Action */}
        {hasActiveFilters && (
          <button
            type="button"
            onClick={onClearFilters}
            className="h-9 px-3 rounded-lg text-slate-500 hover:bg-slate-100/80 hover:text-slate-900 text-xs font-medium flex items-center gap-1.5 transition-colors border border-transparent hover:border-slate-200"
            title="Reset active filters"
          >
            <RotateCcw className="h-3.5 w-3.5" />
            <span>Clear filters</span>
          </button>
        )}
      </div>
    </div>
  );
};
