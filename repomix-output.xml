        f"/api/v1/companies/{comp_id}/campaigns/{camp_id}/schedule",
        headers={"Authorization": f"Bearer {token}"},
        json={"scheduled_at": (datetime.now(timezone.utc) + timedelta(minutes=10)).isoformat()},
