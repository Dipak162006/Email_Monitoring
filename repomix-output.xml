  <title>Archify — Company Creation &amp; Team Invites</title>
  <meta name="description" content="Interactive sequence diagram for Company Creation and Team Member Invite workflows — Email Monitoring project, generated by Archify."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:#0a0c14;--bg-s:#101320;--bg-c:#161828;--bg-h:#1c1f36;
      --bd:rgba(99,102,241,.16);--bd-hi:rgba(99,102,241,.48);
      --ac:#6366f1;--acg:rgba(99,102,241,.28);--ac2:#818cf8;
      /* section colours */
      --sa:#34d399;--sa-d:rgba(52,211,153,.13);   /* Flow A – creation  */
      --sb:#f59e0b;--sb-d:rgba(245,158,11,.13);    /* Flow B – invite    */
      --se:#f87171;--se-d:rgba(248,113,113,.13);   /* Error branches     */
      --sw:#fb923c;--sw-d:rgba(251,146,60,.13);    /* RBAC/warn          */
      /* actor colours */
      --c0:#818cf8;  /* Team UI              */
      --c1:#f59e0b;  /* api.ts               */
      --c2:#38bdf8;  /* routes.py            */
      --c3:#a78bfa;  /* auth_dep.py          */
      --c4:#c084fc;  /* comp_dep.py          */
      --c5:#34d399;  /* company_service.py   */
      --c6:#fb923c;  /* auth_service.py      */
      --c7:#60a5fa;  /* Postgres             */
      --t1:#e2e8f0;--t2:#94a3b8;--t3:#64748b;--tc:#a5b4fc;
      --fn:'Inter',system-ui,sans-serif;--mo:'JetBrains Mono',monospace;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--fn);background:var(--bg);color:var(--t1);min-height:100vh;overflow-x:hidden}

    /* ── TOOLBAR ── */
    .tb{position:sticky;top:0;z-index:120;background:rgba(10,12,20,.9);backdrop-filter:blur(18px);border-bottom:1px solid var(--bd);display:flex;align-items:center;justify-content:space-between;padding:0 24px;height:58px;gap:16px}
    .tbb{display:flex;align-items:center;gap:10px}
    .tbl{width:34px;height:34px;border-radius:9px;background:linear-gradient(135deg,#6366f1,#818cf8);display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:800;color:#fff;box-shadow:0 0 0 1px rgba(99,102,241,.4),0 4px 14px rgba(99,102,241,.3)}
    .tbt{font-size:14px;font-weight:700;color:var(--t1)}
    .tbs{font-size:11px;color:var(--t3);font-family:var(--mo)}
    .tba{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .btn{display:inline-flex;align-items:center;gap:6px;padding:6px 14px;border-radius:6px;font-size:12px;font-weight:500;cursor:pointer;border:1px solid transparent;transition:all .14s;white-space:nowrap}
    .bg{background:transparent;border-color:var(--bd);color:var(--t2)}.bg:hover{background:var(--bg-h);border-color:var(--bd-hi);color:var(--t1)}
    .bp{background:var(--ac);color:#fff;border-color:var(--ac)}.bp:hover{background:#4f46e5;box-shadow:0 0 0 3px var(--acg)}

    /* ── LAYOUT ── */
    .lay{display:grid;grid-template-columns:270px 1fr;min-height:calc(100vh - 58px)}

    /* ── SIDEBAR ── */
    .sb{background:var(--bg-s);border-right:1px solid var(--bd);padding:18px 14px;display:flex;flex-direction:column;gap:20px;position:sticky;top:58px;height:calc(100vh - 58px);overflow-y:auto}
    .sh{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:8px}
    .li{display:flex;align-items:flex-start;gap:9px;padding:7px 9px;border-radius:6px;cursor:pointer;transition:background .12s;border:1px solid transparent}
    .li:hover,.li.active{background:var(--bg-c);border-color:var(--bd)}
    .ld{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:3px}
    .ln{font-size:12px;font-weight:600;color:var(--t1);font-family:var(--mo);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .lx{font-size:10px;color:var(--t3);margin-top:2px;line-height:1.4}
    .sl{display:flex;flex-direction:column;gap:3px}
    .sp{display:flex;align-items:flex-start;gap:8px;padding:6px 9px;border-radius:6px;cursor:pointer;transition:background .12s;border:1px solid transparent}
    .sp:hover,.sp.hl{background:var(--bg-c);border-color:var(--bd)}
    .sn{width:20px;height:20px;border-radius:50%;background:var(--bg-h);border:1px solid var(--bd);display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;color:var(--t2);flex-shrink:0;margin-top:1px}
    .slb{font-size:11px;color:var(--t2);line-height:1.35}
    .ib{background:var(--bg-c);border:1px solid var(--bd);border-radius:10px;padding:12px 14px}
    .ib p{font-size:11px;color:var(--t2);line-height:1.65}

    /* ── CANVAS ── */
    .cv{padding:28px 34px;overflow-x:auto}
    .cvt{font-size:21px;font-weight:800;color:var(--t1);letter-spacing:-.025em;margin-bottom:5px}
    .cvd{font-size:13px;color:var(--t2);line-height:1.6;margin-bottom:20px;max-width:740px}
    .spl{display:flex;gap:9px;flex-wrap:wrap;margin-bottom:18px}
    .spi{display:flex;align-items:center;gap:6px;padding:5px 13px;border-radius:999px;font-size:11.5px;font-weight:600;border:1px solid}
    .sa-p{background:var(--sa-d);border-color:var(--sa);color:var(--sa)}
    .sb-p{background:var(--sb-d);border-color:var(--sb);color:var(--sb)}
    .se-p{background:var(--se-d);border-color:var(--se);color:var(--se)}
    .sw-p{background:var(--sw-d);border-color:var(--sw);color:var(--sw)}
    .fb{display:flex;align-items:center;gap:8px;margin-bottom:20px;flex-wrap:wrap}
    .fl{font-size:11px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.06em}
    .ft{padding:5px 13px;border-radius:999px;font-size:11px;font-weight:500;cursor:pointer;border:1px solid var(--bd);background:transparent;color:var(--t2);transition:all .12s}
    .ft:hover{background:var(--bg-c);color:var(--t1)}
    .ft.active{border-color:var(--ac);background:rgba(99,102,241,.12);color:var(--ac2)}
    .ft.active.fa{border-color:var(--sa);background:var(--sa-d);color:var(--sa)}
    .ft.active.fb2{border-color:var(--sb);background:var(--sb-d);color:var(--sb)}

    /* ── TOOLTIP ── */
    #tt{position:fixed;z-index:300;background:var(--bg-c);border:1px solid var(--bd-hi);border-radius:12px;padding:14px 17px;max-width:390px;min-width:250px;pointer-events:none;opacity:0;transform:translateY(6px);transition:opacity .15s,transform .15s;box-shadow:0 12px 40px rgba(0,0,0,.6)}
    #tt.vis{opacity:1;transform:translateY(0)}
    .tth{display:flex;align-items:center;gap:8px;margin-bottom:7px}
    .ttn{width:22px;height:22px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:10px;font-weight:700;flex-shrink:0}
    .tty{font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.08em}
    .ttf{font-size:13px;font-weight:600;color:var(--t1);margin-bottom:6px;font-family:var(--mo);line-height:1.4;word-break:break-all}
    .ttb{font-size:12px;color:var(--t2);line-height:1.6}
    .ttl{margin-top:8px;font-size:10px;color:var(--tc);font-family:var(--mo);padding:4px 9px;background:rgba(99,102,241,.1);border-radius:5px;display:inline-block}

    /* ── RBAC PANEL ── */
    .rbac{margin-top:28px;background:var(--bg-s);border:1px solid var(--bd);border-radius:14px;overflow:hidden}
    .rbac-hd{display:flex;align-items:center;gap:10px;padding:15px 20px;border-bottom:1px solid var(--bd);background:var(--bg-c)}
    .rbac-t{font-size:13px;font-weight:700;color:var(--t1)}
    .rbac-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:22px}
    .rbac-ct{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
    .ri{margin-bottom:15px}
    .ri-hd{display:flex;align-items:center;gap:7px;margin-bottom:5px}
    .rb{padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700;font-family:var(--mo);white-space:nowrap}
    .ri-body{font-size:11.5px;color:var(--t2);line-height:1.65;padding-left:2px}
    .ri-code{margin-top:5px;font-family:var(--mo);font-size:11px;color:var(--tc);background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.15);border-radius:6px;padding:7px 10px;line-height:1.55}

    ::-webkit-scrollbar{width:6px;height:6px}::-webkit-scrollbar-track{background:transparent}::-webkit-scrollbar-thumb{background:#22253c;border-radius:3px}::-webkit-scrollbar-thumb:hover{background:#2e3250}

    @media(max-width:860px){.lay{grid-template-columns:1fr}.sb{position:static;height:auto;border-right:none;border-bottom:1px solid var(--bd)}.cv{padding:20px 14px}.rbac-body{grid-template-columns:1fr}}
  </style>
</head>
<body>

<header class="tb">
  <div class="tbb">
    <div class="tbl">&#9113;</div>
    <div>
      <div class="tbt">Archify Sequence Diagram</div>
      <div class="tbs">Company Creation &amp; Team Invites &nbsp;·&nbsp; POST /companies/ &nbsp;|&nbsp; POST /companies/{id}/members</div>
    </div>
  </div>
  <div class="tba">
    <span style="background:rgba(52,211,153,.12);color:#34d399;border:1px solid rgba(52,211,153,.3);padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600">&#9679; Live</span>
    <button class="btn bg" id="bzo">&#8722; Zoom</button>
    <button class="btn bg" id="bzi">&#43; Zoom</button>
    <button class="btn bp" onclick="window.print()">&#8595; Export</button>
  </div>
</header>

<div class="lay">
  <!-- SIDEBAR -->
  <aside class="sb">
    <div><div class="sh">Actors / Columns</div><div id="leg"></div></div>
    <div><div class="sh">Step Navigator</div><div class="sl" id="snav"></div></div>
    <div class="ib"><p><strong style="color:var(--t1)">Tip:</strong> Hover any arrow for function name, detail &amp; file:line. Click an actor to highlight its lifeline. Use filter tabs to isolate flows.</p></div>
  </aside>

  <!-- CANVAS -->
  <div class="cv">
    <div class="cvt">Company Creation &amp; Team Invites</div>
    <div class="cvd">Two-flow multi-tenant diagram. Flow A traces workspace bootstrap — a single HTTP call creates two rows inside an atomic transaction. Flow B traces the RBAC-gated colleague-invite with three cascading authorization layers before data is written.</div>

    <div class="spl">
      <div class="spi sa-p">&#9632; Flow A — Workspace Creation (POST /companies/)</div>
      <div class="spi sb-p">&#9632; Flow B — Direct Member Add (POST /companies/{id}/members)</div>
      <div class="spi se-p">&#10005; Error Branches — 403 RBAC · 404 User Not Found · 409 Duplicate</div>
      <div class="spi sw-p">&#9650; RBAC — require_company_admin_or_owner dependency stack</div>
    </div>

    <div class="fb">
      <span class="fl">Show:</span>
      <button class="ft active" data-f="all">All Steps</button>
      <button class="ft fa" data-f="a">Flow A — Creation</button>
      <button class="ft fb2" data-f="b">Flow B — Invites</button>
      <button class="ft" data-f="err">Error Branches</button>
    </div>

    <div id="dw"></div>

    <!-- RBAC DEEP-DIVE PANEL -->
    <div class="rbac">
      <div class="rbac-hd">
        <span style="font-size:16px">&#128274;</span>
        <div class="rbac-t">RBAC Deep-Dive: Dependency Stack &amp; Privilege Escalation Prevention</div>
      </div>
      <div class="rbac-body">
        <div>
          <div class="rbac-ct" style="color:var(--sw)">&#9650; Flow A — Workspace Creation</div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sa-d);color:var(--sa);border:1px solid rgba(52,211,153,.3)">AUTH</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">get_current_user() — JWT validation only</span></div>
            <div class="ri-body">POST /companies/ only requires a valid JWT. <em>Any</em> authenticated user can create a new workspace — no pre-existing company membership needed. The creator is automatically bootstrapped as OWNER.</div>
            <div class="ri-code">create_company(current_user: User = Depends(get_current_user))<br>routes.py:36–40</div>
          </div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sa-d);color:var(--sa);border:1px solid rgba(52,211,153,.3)">ATOMIC</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">Two-phase DB write in one transaction</span></div>
            <div class="ri-body"><code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">db.flush()</code> after INSERT companies forces Postgres to allocate <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">company.id</code> without committing, so <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">CompanyUser</code> FK can reference it. A single <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">db.commit()</code> then persists both rows atomically — crash mid-operation leaves zero orphan rows.</div>
            <div class="ri-code">db.add(company); await db.flush()  # allocate ID<br>db.add(membership)  # role='OWNER'<br>await db.commit()  # single atomic write<br>service.py:26–38</div>
          </div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sa-d);color:var(--sa);border:1px solid rgba(52,211,153,.3)">ROLE</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">Automatic OWNER assignment</span></div>
            <div class="ri-body">The creator's <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">user.id</code> is hardcoded as <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">owner_user_id</code>. Role is set to <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">CompanyRole.OWNER.value</code>. The client cannot submit a role for this endpoint — no privilege escalation is possible at creation time.</div>
            <div class="ri-code">membership = CompanyUser(company_id=company.id,<br>&nbsp;&nbsp;user_id=owner_user_id,<br>&nbsp;&nbsp;role=CompanyRole.OWNER.value)<br>service.py:30–34</div>
          </div>
        </div>

        <div>
          <div class="rbac-ct" style="color:var(--sw)">&#9650; Flow B — Member Invite RBAC Layers</div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sw-d);color:var(--sw);border:1px solid rgba(251,146,60,.3)">LAYER 1</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">get_current_user() — JWT valid?</span></div>
            <div class="ri-body">First layer: standard JWT validation. All 401 branches from <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">auth/dependencies.py</code> apply — expired token, malformed token, user not found. Identical to the /auth/me diagram.</div>
            <div class="ri-code">auth/dependencies.py:15–64</div>
          </div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sw-d);color:var(--sw);border:1px solid rgba(251,146,60,.3)">LAYER 2</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">get_company_membership() — Is caller a member?</span></div>
            <div class="ri-body">Second layer: verifies the caller <em>belongs</em> to the target company. Returns <strong>404</strong> (not 403) even if the company exists but the caller isn't a member — this prevents membership enumeration (attacker can't distinguish "company doesn't exist" from "you're not a member").</div>
            <div class="ri-code">if not company: raise 404 "Company not found"<br>if not membership: raise 404 "Company not found"<br># Same message — no info disclosure<br>comp_dep.py:22–34</div>
          </div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--se-d);color:var(--se);border:1px solid rgba(248,113,113,.3)">LAYER 3</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">require_company_admin_or_owner() — Role ≥ ADMIN?</span></div>
            <div class="ri-body"><strong>The RBAC gate.</strong> Checks <code style="font-family:var(--mo);font-size:10.5px;color:var(--tc)">membership.role not in [OWNER, ADMIN]</code>. A MEMBER attempting to add colleagues hits a <strong>403 Forbidden</strong> here. This prevents horizontal privilege escalation — a regular member cannot bootstrap their own teammates.</div>
            <div class="ri-code">if membership.role not in [CompanyRole.OWNER.value,<br>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;CompanyRole.ADMIN.value]:<br>&nbsp;&nbsp;raise HTTPException(403, "Owner or Administrator<br>&nbsp;&nbsp;&nbsp;&nbsp;privileges required for this action")<br>comp_dep.py:45–54</div>
          </div>

          <div class="ri">
            <div class="ri-hd"><span class="rb" style="background:var(--sb-d);color:var(--sb);border:1px solid rgba(245,158,11,.3)">ROLE CAP</span><span style="font-size:11.5px;font-weight:600;color:var(--t1)">Invitable roles: MEMBER or ADMIN only</span></div>
            <div class="ri-body">The AddMemberModal role selector only exposes "MEMBER" and "ADMIN". The OWNER role is UI-blocked and schema-validated on the backend (Pydantic enum). No path for a non-OWNER to create another OWNER.</div>
            <div class="ri-code">AddMemberModal.tsx:224–226<br># Only MEMBER / ADMIN selectable in UI</div>
          </div>
        </div>
      </div>
    </div>
  </div><!-- /cv -->
</div><!-- /lay -->

<!-- TOOLTIP -->
<div id="tt">
  <div class="tth"><div class="ttn" id="ttn"></div><div class="tty" id="tty"></div></div>
  <div class="ttf" id="ttf"></div>
  <div class="ttb" id="ttb"></div>
  <div class="ttl" id="ttl"></div>
</div>

<script>
/* ================================================================
   ACTORS
   ================================================================ */
const ACTORS=[
  {id:'ui',    label:'Team UI',            sub:'OnboardingPage · AddMemberModal · TeamPage', color:'#818cf8'},
  {id:'api',   label:'api.ts',             sub:'companiesApi.createCompany() · addMember()', color:'#f59e0b'},
  {id:'rt',    label:'routes.py',          sub:'create_company() · add_company_member()',    color:'#38bdf8'},
  {id:'ad',    label:'auth_dep.py',        sub:'get_current_user() · JWT decode',            color:'#a78bfa'},
  {id:'cd',    label:'comp_dep.py',        sub:'get_company_membership() · require_admin_or_owner()', color:'#c084fc'},
  {id:'cs',    label:'company_service.py', sub:'create_company() · add_member()',            color:'#34d399'},
  {id:'as',    label:'auth_service.py',    sub:'get_user_by_email()',                        color:'#fb923c'},
  {id:'pg',    label:'Postgres',           sub:'companies · company_users · users',          color:'#60a5fa'},
];

/* ================================================================
   STEPS — sec: 'a'|'b'|'err'|'rbac'|'both'
   ================================================================ */
const STEPS=[

  /* ════════════════════════════════════════════════════
     FLOW A — WORKSPACE CREATION
  ════════════════════════════════════════════════════ */
  {id:1,type:'div',   label:'FLOW A — WORKSPACE CREATION  ·  POST /api/v1/companies/', sec:'a'},

  {id:2,type:'note',  sec:'a',from:null,to:null,
   label:'User submits workspace name on OnboardingPage',
   fn:'handleWorkspaceSubmit(e: FormEvent)',
   detail:'OnboardingPage.handleWorkspaceSubmit() trims the workspace name, validates non-empty, sets isCreating=true, then awaits companiesApi.createCompany(trimmed).',
   file:'OnboardingPage.tsx:70–97'},

  {id:3,type:'call',  sec:'a',from:'ui',to:'api',
   label:'companiesApi.createCompany(name)',
   fn:'companiesApi.createCompany(trimmed: string)',
   detail:'api.ts companiesApi.createCompany() calls apiClient.post<CompanyWithRole>("/api/v1/companies/", { name }). JWT automatically attached via Authorization: Bearer header from tokenStorage.',
   file:'api.ts:587–589'},

  {id:4,type:'call',  sec:'a',from:'api',to:'rt',
   label:'POST /api/v1/companies/  { name }',
   fn:'fetch("/api/v1/companies/", { method:"POST", body: JSON.stringify({ name }) })',
   detail:'HTTP POST with JSON body {name: "Acme Corp"}. FastAPI validates CompanyCreate Pydantic schema. Route resolves dependencies before executing body.',
   file:'api.ts:138–141'},

  {id:5,type:'call',  sec:'a',from:'rt',to:'ad',
   label:'Depends(get_current_user)',
   fn:'current_user: User = Depends(get_current_user)',
   detail:'FastAPI resolves get_current_user from auth/dependencies.py — decodes JWT, extracts sub claim (email), queries users table. Full flow documented in Diagram 01.',
   file:'routes.py:38'},

  {id:6,type:'ret',   sec:'a',from:'ad',to:'rt',
   label:'User object (authenticated creator)',
   fn:'return user  # from get_current_user()',
   detail:'auth/dependencies.py returns the validated User ORM object. current_user.id is used as owner_user_id in the next step.',
   file:'auth_dep.py:64'},

  {id:7,type:'call',  sec:'a',from:'rt',to:'cs',
   label:'CompanyService.create_company(db, name, owner_user_id)',
   fn:'company, membership = await CompanyService.create_company(db=db, name=company_in.name, owner_user_id=current_user.id)',
   detail:'Route delegates company creation to CompanyService. Passes the validated name and current_user.id as the designated owner.',
   file:'routes.py:42–46'},

  {id:8,type:'call',  sec:'a',from:'cs',to:'pg',
   label:'INSERT INTO companies (name, is_active=True)',
   fn:'company = Company(name=name.strip(), is_active=True); db.add(company); await db.flush()',
   detail:'Creates Company ORM object. db.flush() — NOT commit — forces Postgres to allocate company.id from the sequence without ending the transaction. The FK from company_users can now reference this ID.',
   file:'service.py:26–28'},

  {id:9,type:'ret',   sec:'a',from:'pg',to:'cs',
   label:'company.id allocated (row not yet committed)',
   fn:'# Postgres sequences are allocated on flush, not commit',
   detail:'Postgres allocates the primary key integer from the companies_id_seq sequence. The row exists in the transaction\'s "dirty pages" but is invisible to other sessions until COMMIT.',
   file:'service.py:28'},

