  onRetry?: () => void;
  compact?: boolean;
}

export function ErrorState({
  className,
  title = "An error occurred",
  message,
  onRetry,
  compact = false,
  ...props
}: ErrorStateProps) {
  if (compact) {
    return (
      <div
        className={cn(
          "flex flex-col sm:flex-row sm:items-center justify-between gap-3 p-3.5 rounded-xl border border-rose-200 bg-rose-50/60 text-slate-800 shadow-2xs",
          className
        )}
