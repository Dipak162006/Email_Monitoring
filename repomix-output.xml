async def create_email_record(
    db: AsyncSession,
    company_id: int,
    email_account_id: int,
    direction: str = EmailDirection.INCOMING.value,
    status: str = EmailStatus.RECEIVED.value,
    subject: str = "Test Subject",
    sender: str = "sender@example.com",
    recipients: list = None,
    is_read: bool = False,
    is_starred: bool = False,
    is_deleted: bool = False,
    deleted_at: datetime = None,
    thread_id: int = None,
    sent_at: datetime = None,
    received_at: datetime = None,
    body_text: str = "Test body",
) -> Email:
    """Insert an Email record directly for test setup."""
    email = Email(
        company_id=company_id,
        email_account_id=email_account_id,
        direction=direction,
        status=status,
        subject=subject,
        sender=sender,
        recipients=recipients or ["recipient@example.com"],
        is_read=is_read,
        is_starred=is_starred,
        is_deleted=is_deleted,
        deleted_at=deleted_at,
        thread_id=thread_id,
        sent_at=sent_at,
        received_at=received_at,
        body_text=body_text,
    )
    db.add(email)
    await db.commit()
    await db.refresh(email)
    return email


async def create_thread_record(
    db: AsyncSession,
    company_id: int,
    email_account_id: int,
    subject: str = "Test Thread",
    has_reply: bool = False,
    is_read: bool = False,
    message_count: int = 1,
) -> EmailThread:
    """Insert an EmailThread record directly for test setup."""
    thread = EmailThread(
        company_id=company_id,
        email_account_id=email_account_id,
        subject=subject,
        has_reply=has_reply,
        is_read=is_read,
        message_count=message_count,
        last_message_at=datetime.now(timezone.utc),
    )
    db.add(thread)
    await db.commit()
    await db.refresh(thread)
    return thread


