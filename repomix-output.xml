  // Compute UTC date boundaries for selected preset
  const { dateFrom, dateTo, allTime } = useMemo(() => {
    const config = DATE_RANGE_PRESETS[datePreset] || DATE_RANGE_PRESETS["7d"];
    return config.computeRange(new Date());
  }, [datePreset]);

  // 1. Primary Stats Query
  const {
    data: stats,
    isLoading: isStatsLoading,
    isError: isStatsError,
    error: statsError,
    refetch: refetchStats,
  } = useQuery({
    queryKey: ["dashboard-stats", currentCompanyId, datePreset, dateFrom, dateTo, allTime],
    queryFn: () =>
      dashboardApi.getStats({
        companyId: currentCompanyId ?? undefined,
        dateFrom,
        dateTo,
        allTime,
      }),
  });

  // 2. Activity Trends Query
  const { data: activityData, isLoading: isActivityLoading } = useQuery({
    queryKey: ["dashboard-activity", currentCompanyId, datePreset, dateFrom, dateTo, allTime],
    queryFn: () =>
      dashboardApi.getActivity({
        companyId: currentCompanyId ?? undefined,
        dateFrom,
        dateTo,
        allTime,
      }),
  });

  // 3. Account Health Query
