<file path="frontend/src/context/AuthContext.tsx">
import { createContext, useCallback, useEffect, useState, type ReactNode } from "react";
import type { LoginCredentials, RegisterCredentials, User } from "../types/auth";
import { authApi, tokenStorage, onUnauthorized } from "../services/api";

export interface AuthContextType {
  user: User | null;
  token: string | null;
  isAuthenticated: boolean;
  isLoading: boolean;
  login: (credentials: LoginCredentials) => Promise<void>;
  register: (credentials: RegisterCredentials) => Promise<void>;
  logout: () => void;
  refreshUser: () => Promise<void>;
}

export const AuthContext = createContext<AuthContextType | undefined>(undefined);

export function AuthProvider({ children }: { children: ReactNode }) {
  const [user, setUser] = useState<User | null>(null);
  const [token, setToken] = useState<string | null>(tokenStorage.get());
  const [isLoading, setIsLoading] = useState<boolean>(true);

  const handleUnauthorized = useCallback(() => {
    tokenStorage.clear();
    setToken(null);
    setUser(null);
  }, []);

  useEffect(() => {
    onUnauthorized(handleUnauthorized);
    return () => {
      onUnauthorized(null);
    };
  }, [handleUnauthorized]);

  const refreshUser = useCallback(async () => {
    const currentToken = tokenStorage.get();
    if (!currentToken) {
      setUser(null);
      setToken(null);
      setIsLoading(false);
      return;
    }

    try {
      const profile = await authApi.getMe();
      setUser(profile);
      setToken(currentToken);
    } catch {
      // Token expired or invalid
      tokenStorage.clear();
      setUser(null);
      setToken(null);
    } finally {
      setIsLoading(false);
    }
  }, []);

  useEffect(() => {
    refreshUser();
  }, [refreshUser]);


  const login = async (credentials: LoginCredentials) => {
    const tokenRes = await authApi.login(credentials);
    tokenStorage.set(tokenRes.access_token);
    setToken(tokenRes.access_token);
    const profile = await authApi.getMe();
    setUser(profile);
  };

  const register = async (credentials: RegisterCredentials) => {
    await authApi.register(credentials);
    // Automatically log in after registration
    await login({
      email: credentials.email,
      password: credentials.password,
    });
  };

  const logout = () => {
    tokenStorage.clear();
    setToken(null);
    setUser(null);
  };

  return (
    <AuthContext.Provider
      value={{
        user,
        token,
        isAuthenticated: !!user && !!token,
        isLoading,
        login,
        register,
        logout,
        refreshUser,
      }}
    >
      {children}
    </AuthContext.Provider>
  );
}
</file>

<file path="frontend/src/context/WorkspaceContext.tsx">
import {
  createContext,
  useCallback,
  useEffect,
  useMemo,
  useState,
  type ReactNode,
} from "react";
import { useQuery, useQueryClient } from "@tanstack/react-query";
import type { CompanyRole, CompanyWithRole } from "../types/auth";
import { companiesApi } from "../services/api";
import { useAuth } from "../hooks/useAuth";

export const ACTIVE_COMPANY_STORAGE_KEY = "pulsemail_active_company_id";

export interface WorkspaceContextType {
  currentCompany: CompanyWithRole | null;
  currentCompanyId: number | null;
  currentRole: CompanyRole | null;
  companies: CompanyWithRole[];
  memberships: CompanyWithRole[];
  isLoading: boolean;
  isError: boolean;
  error: Error | null;
  setActiveCompanyId: (companyId: number) => void;
  refreshWorkspaces: () => Promise<void>;
  refetch: () => Promise<unknown>;
}

export const WorkspaceContext = createContext<WorkspaceContextType | undefined>(undefined);

export function WorkspaceProvider({ children }: { children: ReactNode }) {
  const { isAuthenticated, isLoading: isAuthLoading } = useAuth();
  const queryClient = useQueryClient();

  // Internal state tracking the user's explicitly selected active company ID
  const [selectedCompanyId, setSelectedCompanyId] = useState<number | null>(() => {
    try {
      const stored = localStorage.getItem(ACTIVE_COMPANY_STORAGE_KEY);
      if (stored) {
        const parsed = parseInt(stored, 10);
        return isNaN(parsed) ? null : parsed;
      }
    } catch {
      // LocalStorage access may fail in certain environments
    }
    return null;
  });

  // Query authenticated user's company memberships
  const {
    data: companies = [],
    isSuccess: isCompaniesSuccess,
    isError,
    error,
    refetch,
  } = useQuery<CompanyWithRole[], Error>({
    queryKey: ["my-companies"],
    queryFn: () => companiesApi.getMyCompanies(),
    enabled: isAuthenticated,
    staleTime: 30000,
  });

  // Clear workspace state when logged out
  useEffect(() => {
    if (!isAuthenticated && !isAuthLoading) {
      setSelectedCompanyId(null);
      try {
        localStorage.removeItem(ACTIVE_COMPANY_STORAGE_KEY);
      } catch {
        // Ignore storage errors
      }
    }
  }, [isAuthenticated, isAuthLoading]);

  // Deterministic resolution of active workspace:
  // 1. Zero memberships -> null
  // 2. Exactly one membership -> that company
  // 3. Multiple memberships -> match selectedCompanyId or localStorage if valid; otherwise fallback to companies[0]
  const currentCompany = useMemo<CompanyWithRole | null>(() => {
    if (!companies || companies.length === 0) {
      return null;
    }

    if (companies.length === 1) {
      return companies[0];
    }

    // Check if selectedCompanyId matches a valid membership
    if (selectedCompanyId !== null) {
      const match = companies.find((c) => c.id === selectedCompanyId);
      if (match) return match;
    }

    // Check persisted localStorage if state hasn't updated or was reset
    try {
      const stored = localStorage.getItem(ACTIVE_COMPANY_STORAGE_KEY);
      if (stored) {
        const parsed = parseInt(stored, 10);
        const match = companies.find((c) => c.id === parsed);
        if (match) return match;
      }
    } catch {
      // Ignore storage errors
    }

    // Deterministic fallback for multiple memberships: select first company returned
    return companies[0];
  }, [companies, selectedCompanyId]);

  // Synchronize state and persistence with resolved active company
  useEffect(() => {
    if (currentCompany) {
      if (selectedCompanyId !== currentCompany.id) {
        setSelectedCompanyId(currentCompany.id);
      }
      try {
        localStorage.setItem(ACTIVE_COMPANY_STORAGE_KEY, String(currentCompany.id));
      } catch {
        // Ignore storage errors
      }
    } else if (isAuthenticated && !isAuthLoading && isCompaniesSuccess && companies.length === 0) {
      // Only clear active workspace selection if the query has definitively resolved zero company memberships
      if (selectedCompanyId !== null) {
        setSelectedCompanyId(null);
      }
      try {
        localStorage.removeItem(ACTIVE_COMPANY_STORAGE_KEY);
      } catch {
        // Ignore storage errors
      }
    }
  }, [
    currentCompany,
    companies.length,
    isAuthenticated,
    isAuthLoading,
    isCompaniesSuccess,
    selectedCompanyId,
  ]);

  // Method to safely switch active company (only allows setting authorized companies)
  const setActiveCompanyId = useCallback(
    (companyId: number) => {
      const match = companies.find((c) => c.id === companyId);
      if (match) {
        setSelectedCompanyId(companyId);
        try {
          localStorage.setItem(ACTIVE_COMPANY_STORAGE_KEY, String(companyId));
        } catch {
          // Ignore storage errors
        }
      } else {
        console.warn(
          `Cannot switch to company ${companyId}: User is not an authorized member of this workspace.`
        );
      }
    },
    [companies]
  );

  // Method to refresh memberships after creation, invitation acceptance, or role change
  const refreshWorkspaces = useCallback(async () => {
    await queryClient.invalidateQueries({ queryKey: ["my-companies"] });
    await refetch();
  }, [queryClient, refetch]);

  // Unified loading state:
  // Still loading if auth check is in flight, or if user is authenticated and membership query has not yet resolved
  const isLoading = isAuthLoading || (isAuthenticated && !isCompaniesSuccess && !isError);

  const value = useMemo<WorkspaceContextType>(
    () => ({
      currentCompany,
      currentCompanyId: currentCompany ? currentCompany.id : null,
      currentRole: currentCompany ? currentCompany.role : null,
      companies,
      memberships: companies,
      isLoading,
      isError: isAuthenticated ? isError : false,
      error: isAuthenticated ? error : null,
      setActiveCompanyId,
      refreshWorkspaces,
      refetch,
    }),
    [
      currentCompany,
      companies,
      isLoading,
      isAuthenticated,
      isError,
      error,
      setActiveCompanyId,
      refreshWorkspaces,
      refetch,
    ]
  );

  return <WorkspaceContext.Provider value={value}>{children}</WorkspaceContext.Provider>;
}
</file>

<file path="frontend/src/hooks/usePermissions.ts">
import { useMemo } from "react";
import { useWorkspace } from "./useWorkspace";
import { useAuth } from "./useAuth";
import type { CompanyRole, CompanyMember } from "../types/auth";

export interface PermissionsResult {
  // Active role and company context
  role: CompanyRole | null;
  companyId: number | null;
  isLoading: boolean;
  hasWorkspace: boolean;

  // Basic role flags
  isOwner: boolean;
  isAdmin: boolean;
  isMember: boolean;
  isAdminOrOwner: boolean;

  // Page-level access flags
  canAccessDashboard: boolean;
  canAccessMailbox: boolean;
  canAccessCompose: boolean;
  canAccessEmailAccounts: boolean;
  canAccessTemplates: boolean;
  canAccessSignatures: boolean;
  canAccessTeam: boolean;
  canAccessDiagnostics: boolean;
  canAccessSettings: boolean;

  // Route path check
  canAccessRoute: (pathname: string) => boolean;

  // High-level management capabilities
  canManageTeam: boolean;
  canInviteMembers: boolean;
  canAddMember: boolean;
  canManageEmailAccounts: boolean;
  canGrantEmailAccess: boolean;

  // Granular member-level target checks (respecting self-protection & owner-protection)
  canChangeMemberRole: (targetMember?: CompanyMember | null) => boolean;
  canRemoveMember: (targetMember?: CompanyMember | null) => boolean;
  canManageMemberAccess: (targetMember?: CompanyMember | null) => boolean;
}

export function usePermissions(): PermissionsResult {
  const { user } = useAuth();
  const { currentCompany, currentRole, isLoading } = useWorkspace();

  return useMemo<PermissionsResult>(() => {
    const hasWorkspace = Boolean(currentCompany);
    const role = hasWorkspace ? currentRole : null;

    const isOwner = role === "OWNER";
    const isAdmin = role === "ADMIN";
    const isMember = role === "MEMBER";
    const isAdminOrOwner = isOwner || isAdmin;

    // Page access definitions:
    // Dashboard, Mailbox, Compose, Templates, Signatures: accessible by all active company members.
    // Team & Permissions, Connected Accounts, Diagnostics: restricted to ADMIN and OWNER.
    const canAccessDashboard = hasWorkspace;
    const canAccessMailbox = hasWorkspace;
    const canAccessCompose = hasWorkspace;
    const canAccessTemplates = hasWorkspace;
    const canAccessSignatures = hasWorkspace;
    const canAccessTeam = hasWorkspace && isAdminOrOwner;
    const canAccessEmailAccounts = hasWorkspace && isAdminOrOwner;
    const canAccessDiagnostics = hasWorkspace && isAdminOrOwner;
    const canAccessSettings = hasWorkspace && isAdminOrOwner;

    const canAccessRoute = (pathname: string): boolean => {
      if (!hasWorkspace) return false;
      const cleanPath = pathname.split("?")[0].replace(/\/$/, "");

      if (cleanPath === "/team") return canAccessTeam;
      if (cleanPath === "/email-accounts") return canAccessEmailAccounts;
      if (cleanPath === "/diagnostics") return canAccessDiagnostics;
      if (cleanPath === "/settings") return canAccessSettings;

      // All other application routes are accessible to all valid workspace roles
      return true;
    };

    // Management capabilities
    const canManageTeam = hasWorkspace && isAdminOrOwner;
    const canInviteMembers = hasWorkspace && isAdminOrOwner;
    const canAddMember = hasWorkspace && isAdminOrOwner;
    const canManageEmailAccounts = hasWorkspace && isAdminOrOwner;
    const canGrantEmailAccess = hasWorkspace && isAdminOrOwner;

    // Granular member checks
    const canChangeMemberRole = (targetMember?: CompanyMember | null): boolean => {
      if (!hasWorkspace || !isAdminOrOwner) return false;
      if (!targetMember) return true;
      // Cannot modify self
      if (user && targetMember.user_id === user.id) return false;
      // Cannot modify the OWNER
      if (targetMember.role === "OWNER") return false;
      return true;
    };

    const canRemoveMember = (targetMember?: CompanyMember | null): boolean => {
      if (!hasWorkspace || !isAdminOrOwner) return false;
      if (!targetMember) return true;
      // Cannot remove self
      if (user && targetMember.user_id === user.id) return false;
      // Cannot remove the OWNER
      if (targetMember.role === "OWNER") return false;
      return true;
    };

    const canManageMemberAccess = (targetMember?: CompanyMember | null): boolean => {
      if (!hasWorkspace || !isAdminOrOwner) return false;
      if (!targetMember) return true;
      // Only regular MEMBERs receive explicit account access grants; OWNER and ADMIN have global access
      return targetMember.role === "MEMBER";
    };

    return {
      role,
      companyId: currentCompany ? currentCompany.id : null,
      isLoading,
      hasWorkspace,

      isOwner,
      isAdmin,
      isMember,
      isAdminOrOwner,

      canAccessDashboard,
      canAccessMailbox,
      canAccessCompose,
      canAccessEmailAccounts,
      canAccessTemplates,
      canAccessSignatures,
      canAccessTeam,
      canAccessDiagnostics,
      canAccessSettings,

      canAccessRoute,

      canManageTeam,
      canInviteMembers,
      canAddMember,
      canManageEmailAccounts,
      canGrantEmailAccess,

      canChangeMemberRole,
      canRemoveMember,
      canManageMemberAccess,
    };
  }, [user, currentCompany, currentRole, isLoading]);
}
