      expect(mockSig.name).toBe("Director Signoff");

      // Re-render as if signature was inserted once
      rerender(
        <QueryClientProvider client={queryClient}>
          <CampaignContentStep
            subject="Welcome"
            bodyHtml="<p>Hello team,</p><p><b>Jane Doe</b><br/>Director</p>"
            bodyText="Hello team,\n\nJane Doe\nDirector"
            onBodyHtmlChange={onBodyChange}
            selectedAccountId={1}
            companyId={10}
          />
        </QueryClientProvider>
      );

      // The signature is already present in bodyHtml
      expect(screen.getByText("Welcome")).toBeDefined();
    });

    it("1.4b Appends signature HTML and plain text in CreateCampaignPage without duplication", async () => {
      const mockSig: EmailSignatureItem = {
        id: 301,
        company_id: 10,
        email_account_id: 1,
        name: "Acme Exec",
        body_html: "<p>Best regards,<br/>Acme Exec</p>",
        body_text: "Best regards,\nAcme Exec",
