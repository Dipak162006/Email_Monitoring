/* ================================================================
   LAYOUT
   ================================================================ */
const AW=148, AH=68, AGAP=38, LANE=100, SH=56, PL=30, PR=44, PB=90;
function cx(i){ return PL + i*(AW+AGAP) + AW/2; }
function sy(si){ return LANE + AH + si*SH + SH/2; }
function ai(id){ return ACTORS.findIndex(a=>a.id===id); }

let curFilter='all', hilite=null, zoom=1.0;

function bc(sec){
  if(sec==='reg') return '#34d399';
  if(sec==='log') return '#f59e0b';
  if(sec==='err') return '#f87171';
  return '#94a3b8';
}

function vis(){
  if(curFilter==='reg') return STEPS.filter(s=>s.sec==='reg'||s.sec==='both');
  if(curFilter==='log') return STEPS.filter(s=>s.sec==='log'||s.sec==='both');
  if(curFilter==='err') return STEPS.filter(s=>s.sec==='err'||s.sec==='reg'||s.sec==='log');
  return STEPS;
}

/* ================================================================
   RENDER
   ================================================================ */
function render(){
  const steps=vis();
  const W=PL+ACTORS.length*(AW+AGAP)-AGAP+PR;
  const H=LANE+AH+steps.length*SH+PB;
  let p=[];

  /* defs */
  let defs='<defs>';
  ACTORS.forEach(a=>{
    defs+=`<marker id="m-${a.id}" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="${a.color}"/></marker>`;
    defs+=`<linearGradient id="g-${a.id}" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="${a.color}" stop-opacity="0.25"/><stop offset="100%" stop-color="${a.color}" stop-opacity="0.07"/></linearGradient>`;
  });
  defs+=`<marker id="m-ret" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0,0 L0,6 L8,3 z" fill="#64748b"/></marker>`;
  defs+='</defs>';
  p.push(defs);

  /* bg */
  p.push(`<rect width="${W}" height="${H}" fill="#0b0d15"/>`);

  /* lifelines */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), op=hilite&&hilite!==a.id?0.1:1;
    p.push(`<line x1="${x}" y1="${LANE+AH}" x2="${x}" y2="${H-PB}" stroke="${a.color}" stroke-width="1.5" stroke-dasharray="4 6" opacity="${op*0.3}"/>`);
  });

  /* actor boxes top */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), bx=x-AW/2, op=hilite&&hilite!==a.id?0.2:1;
    const lines=a.label.split('\n');
    const firstLine=lines[0], secondLine=lines[1]||'';
    p.push(`<g class="ag" data-a="${a.id}" style="cursor:pointer" opacity="${op}">
      <rect x="${bx}" y="${LANE}" width="${AW}" height="${AH}" rx="9" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1.5" stroke-opacity="0.6"/>
      <text x="${x}" y="${LANE+24}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10.5" font-weight="600" fill="${a.color}">${firstLine}</text>
      ${secondLine?`<text x="${x}" y="${LANE+38}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10.5" font-weight="600" fill="${a.color}">${secondLine}</text>`:''}
      <text x="${x}" y="${LANE+55}" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" fill="#64748b">${a.sub.split('·')[0].trim()}</text>
    </g>`);
  });

  /* actor boxes bottom */
  ACTORS.forEach((a,i)=>{
    const x=cx(i), bx=x-AW/2, by=H-PB, op=hilite&&hilite!==a.id?0.15:1;
    const lines=a.label.split('\n');
    p.push(`<rect x="${bx}" y="${by}" width="${AW}" height="${AH}" rx="9" fill="url(#g-${a.id})" stroke="${a.color}" stroke-width="1" stroke-opacity="0.4" opacity="${op}"/>
      <text x="${x}" y="${by+24}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10.5" font-weight="600" fill="${a.color}" opacity="${op}">${lines[0]}</text>
      ${lines[1]?`<text x="${x}" y="${by+38}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="10.5" font-weight="600" fill="${a.color}" opacity="${op}">${lines[1]}</text>`:''}
    `);
  });

  /* steps */
  steps.forEach((s,si)=>{
    const y=sy(si), col=bc(s.sec);

    if(s.type==='divider'){
      const lw=Math.min(s.label.length*7.8+28, W-PL-PR);
      p.push(`
        <line x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}" stroke="${col}" stroke-width="1.5" stroke-dasharray="none" opacity="0.2"/>
        <rect x="${PL}" y="${y-14}" width="${lw}" height="24" rx="5" fill="${col}" fill-opacity="0.12" stroke="${col}" stroke-width="1" stroke-opacity="0.45"/>
        <text x="${PL+10}" y="${y+5}" font-family="Inter,sans-serif" font-size="11" font-weight="700" fill="${col}" letter-spacing="0.04em">${s.label}</text>
      `);
      return;
    }

    if(s.type==='alt_start'||s.type==='alt_else'||s.type==='alt_end'){
      const maxW=W-PL-PR, lw=Math.min(s.label.length*6.5+24, maxW);
      p.push(`
        <line x1="${PL}" y1="${y}" x2="${W-PR}" y2="${y}" stroke="${col}" stroke-width="1" stroke-dasharray="5 4" opacity="0.35"/>
        <rect x="${PL}" y="${y-12}" width="${lw}" height="20" rx="4" fill="${col}" fill-opacity="0.09" stroke="${col}" stroke-width="0.8" stroke-opacity="0.5"/>
        <text x="${PL+8}" y="${y+4}" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="${col}" opacity="0.9">${s.label}</text>
      `);
      return;
    }

    if(s.type==='note'){
      const lw=Math.min(s.label.length*7.2+32, W-PL-100);
      p.push(`
        <rect x="${PL+4}" y="${y-15}" width="${lw}" height="24" rx="5" fill="rgba(99,102,241,0.09)" stroke="#6366f1" stroke-width="1" stroke-dasharray="3 2"/>
        <text x="${PL+16}" y="${y+5}" font-family="Inter,sans-serif" font-size="10.5" font-weight="600" fill="#818cf8" class="st" data-s="${s.id}" style="cursor:pointer">&#128204; ${s.label}</text>
      `);
      return;
    }

    const fi=ai(s.from), ti=ai(s.to);
    if(fi<0||ti<0) return;
    const fx=cx(fi), tx=cx(ti), isRet=s.type==='ret';
    const mk=isRet?'m-ret':`m-${s.from}`, lc=isRet?'#64748b':col;

    /* step badge */
    p.push(`<circle cx="${PL-10}" cy="${y}" r="10" fill="rgba(99,102,241,0.1)" stroke="#6366f1" stroke-width="1"/>
      <text x="${PL-10}" y="${y+3.5}" text-anchor="middle" font-family="Inter,sans-serif" font-size="8.5" font-weight="700" fill="#a5b4fc">${s.id}</text>`);

    if(fi===ti){
      const rx=fx+AW/2-10, lw=32, ty2=y-14, by2=y+12;
      p.push(`<path d="M${fx},${ty2} Q${rx+lw},${ty2} ${rx+lw},${y} Q${rx+lw},${by2} ${fx},${by2}" fill="none" stroke="${lc}" stroke-width="1.5" stroke-dasharray="${isRet?'4 3':'none'}" marker-end="url(#${mk})" opacity="0.85" class="al" data-s="${s.id}" style="cursor:pointer"/>
        <text x="${fx+8}" y="${ty2-2}" font-family="JetBrains Mono,monospace" font-size="9" fill="${lc}" class="st" data-s="${s.id}" style="cursor:pointer">${s.label}</text>`);
    } else {
      const mx=(fx+tx)/2;
      p.push(`<line x1="${fx}" y1="${y}" x2="${tx}" y2="${y}" stroke="${lc}" stroke-width="1.8" stroke-dasharray="${isRet?'5 4':'none'}" marker-end="url(#${mk})" opacity="0.9" class="al" data-s="${s.id}" style="cursor:pointer"/>
        <text x="${mx}" y="${y-6}" text-anchor="middle" font-family="JetBrains Mono,monospace" font-size="9" fill="${lc}" class="st" data-s="${s.id}" style="cursor:pointer">${s.label}</text>`);
    }
  });

  const svgStr=`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${W} ${H}" width="${W}" height="${H}" style="transform-origin:top left;transform:scale(${zoom});transition:transform .2s;display:block">${p.join('')}</svg>`;
  document.getElementById('diag-wrap').innerHTML=svgStr;

  document.querySelectorAll('.st,.al').forEach(el=>{
    el.addEventListener('mouseenter',onHov);
    el.addEventListener('mousemove',onMov);
    el.addEventListener('mouseleave',onLv);
  });
  document.querySelectorAll('.ag').forEach(el=>el.addEventListener('click',onAC));
}

/* sidebar */
function buildLeg(){
  const c=document.getElementById('leg'); c.innerHTML='';
  ACTORS.forEach(a=>{
    const el=document.createElement('div'); el.className='leg-item'; el.dataset.a=a.id;
    el.innerHTML=`<div class="leg-dot" style="background:${a.color}"></div><div class="leg-info"><div class="leg-name">${a.label.replace('\n',' / ')}</div><div class="leg-desc">${a.sub}</div></div>`;
    el.addEventListener('click',()=>{ hilite=hilite===a.id?null:a.id; document.querySelectorAll('.leg-item').forEach(li=>li.classList.remove('active')); if(hilite) el.classList.add('active'); render(); });
    c.appendChild(el);
  });
}

function buildNav(){
  const c=document.getElementById('snav'); c.innerHTML='';
  STEPS.filter(s=>s.type==='call'||s.type==='ret'||s.type==='note').forEach(s=>{
    const el=document.createElement('div'); el.className='step-pill'; el.dataset.s=s.id;
    const col=bc(s.sec);
    el.innerHTML=`<div class="sp-num" style="border-color:${col};color:${col}">${s.id}</div><div class="sp-lbl">${s.label}</div>`;
    el.addEventListener('mouseenter',()=>{ showTT(s,310,140); el.classList.add('hl'); });
    el.addEventListener('mouseleave',()=>{ hideTT(); el.classList.remove('hl'); });
    c.appendChild(el);
  });
}

/* tooltip */
const TT=document.getElementById('tt');
function showTT(s,x,y){
  const col=bc(s.sec);
  document.getElementById('tt-num').style.cssText=`background:${col}22;border:1px solid ${col}55;color:${col}`;
  document.getElementById('tt-num').textContent=s.id;
  document.getElementById('tt-type').textContent=`${s.type.toUpperCase()} · ${s.sec.toUpperCase()}`;
  document.getElementById('tt-fn').textContent=s.fn||s.label;
  document.getElementById('tt-body').textContent=s.detail||'';
  document.getElementById('tt-file').textContent=s.file||'';
  TT.style.left=(x+16)+'px'; TT.style.top=(y-8)+'px';
  TT.classList.add('vis');
}
function hideTT(){ TT.classList.remove('vis'); }
function gs(id){ return STEPS.find(s=>s.id===Number(id)); }
function onHov(e){ const s=gs(e.currentTarget.dataset.s); if(s) showTT(s,e.clientX,e.clientY); }
function onMov(e){ if(TT.classList.contains('vis')){ TT.style.left=(e.clientX+16)+'px'; TT.style.top=(e.clientY-8)+'px'; } }
function onLv(){ hideTT(); }
function onAC(e){ const a=e.currentTarget.dataset.a; hilite=hilite===a?null:a; document.querySelectorAll('.leg-item').forEach(li=>li.classList.toggle('active',li.dataset.a===hilite)); render(); }

/* filter */
document.querySelectorAll('.fb').forEach(btn=>{
  btn.addEventListener('click',()=>{
    curFilter=btn.dataset.f;
    document.querySelectorAll('.fb').forEach(b=>{b.classList.remove('active','reg-t','log-t');});
    btn.classList.add('active');
    if(curFilter==='reg') btn.classList.add('reg-t');
    if(curFilter==='log') btn.classList.add('log-t');
    render(); buildNav();
  });
});

/* zoom */
document.getElementById('btn-zi').addEventListener('click',()=>{ zoom=Math.min(zoom+0.15,2); render(); });
document.getElementById('btn-zo').addEventListener('click',()=>{ zoom=Math.max(zoom-0.15,0.4); render(); });

buildLeg(); buildNav(); render();
</script>
</body>
</html>
