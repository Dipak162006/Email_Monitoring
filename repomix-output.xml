<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Archify — Registration &amp; Login Sequence Diagram</title>
  <meta name="description" content="Interactive sequence diagram for the Registration and Login workflows in the Email Monitoring project — generated by Archify."/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet"/>
  <style>
    :root {
      --bg:          #0b0d15;
      --bg-surf:     #111320;
      --bg-card:     #171929;
      --bg-hover:    #1d2038;
      --bd:          rgba(99,102,241,.16);
      --bd-hi:       rgba(99,102,241,.5);
      --accent:      #6366f1;
      --accent-g:    rgba(99,102,241,.3);
      --accent2:     #818cf8;
      /* section palette */
      --reg:         #34d399;   /* registration = emerald  */
      --reg-dim:     rgba(52,211,153,.13);
      --log:         #f59e0b;   /* login = amber            */
      --log-dim:     rgba(245,158,11,.13);
      --err:         #f87171;
      --err-dim:     rgba(248,113,113,.13);
      --warn:        #fb923c;
      --warn-dim:    rgba(251,146,60,.13);
      /* text */
      --t1: #e2e8f0; --t2: #94a3b8; --t3: #64748b;
      --tcode: #a5b4fc;
      /* actors */
      --ca: #818cf8;   /* RegisterPage / LoginPage  */
      --cb: #34d399;   /* AuthContext.tsx            */
      --cc: #f59e0b;   /* api.ts                     */
      --cd: #38bdf8;   /* routes.py                  */
      --ce: #c084fc;   /* service.py                 */
      --cf: #fb923c;   /* security.py                */
      --cg: #60a5fa;   /* Postgres                   */
      --font: 'Inter',system-ui,sans-serif;
      --mono: 'JetBrains Mono',monospace;
    }
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{font-family:var(--font);background:var(--bg);color:var(--t1);min-height:100vh;overflow-x:hidden}

    /* ── TOOLBAR ─────────────────────────────────────────────── */
    .toolbar{
      position:sticky;top:0;z-index:120;
      background:rgba(11,13,21,.9);backdrop-filter:blur(18px);
      border-bottom:1px solid var(--bd);
      display:flex;align-items:center;justify-content:space-between;
      padding:0 24px;height:58px;gap:16px;
    }
    .tb-brand{display:flex;align-items:center;gap:10px}
    .tb-logo{
      width:34px;height:34px;border-radius:9px;
      background:linear-gradient(135deg,#6366f1,#818cf8);
      display:flex;align-items:center;justify-content:center;
      font-size:17px;font-weight:800;color:#fff;
      box-shadow:0 0 0 1px rgba(99,102,241,.45),0 4px 14px rgba(99,102,241,.35);
    }
    .tb-info{display:flex;flex-direction:column;gap:1px}
    .tb-title{font-size:14px;font-weight:700;color:var(--t1);letter-spacing:-.01em}
    .tb-sub{font-size:11px;color:var(--t3);font-family:var(--mono)}
    .tb-acts{display:flex;align-items:center;gap:8px;flex-shrink:0}
    .btn{
      display:inline-flex;align-items:center;gap:6px;
      padding:6px 14px;border-radius:6px;font-size:12px;font-weight:500;
      cursor:pointer;border:1px solid transparent;transition:all .14s;white-space:nowrap;
    }
    .btn-ghost{background:transparent;border-color:var(--bd);color:var(--t2)}
    .btn-ghost:hover{background:var(--bg-hover);border-color:var(--bd-hi);color:var(--t1)}
    .btn-pri{background:var(--accent);color:#fff;border-color:var(--accent)}
    .btn-pri:hover{background:#4f46e5;box-shadow:0 0 0 3px var(--accent-g)}

    /* ── LAYOUT ──────────────────────────────────────────────── */
    .layout{display:grid;grid-template-columns:272px 1fr;min-height:calc(100vh - 58px)}

    /* ── SIDEBAR ─────────────────────────────────────────────── */
    .sidebar{
      background:var(--bg-surf);border-right:1px solid var(--bd);
      padding:20px 16px;display:flex;flex-direction:column;gap:22px;
      position:sticky;top:58px;height:calc(100vh - 58px);overflow-y:auto;
    }
    .sb-hd{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--t3);margin-bottom:10px}
    .leg-item{
      display:flex;align-items:flex-start;gap:10px;padding:8px 10px;
      border-radius:6px;cursor:pointer;transition:background .12s;border:1px solid transparent;
    }
    .leg-item:hover,.leg-item.active{background:var(--bg-card);border-color:var(--bd)}
    .leg-dot{width:10px;height:10px;border-radius:50%;flex-shrink:0;margin-top:3px}
    .leg-info{flex:1;min-width:0}
    .leg-name{font-size:12px;font-weight:600;color:var(--t1);font-family:var(--mono);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
    .leg-desc{font-size:10px;color:var(--t3);margin-top:2px;line-height:1.4}
    .step-list{display:flex;flex-direction:column;gap:3px}
    .step-pill{
      display:flex;align-items:flex-start;gap:8px;padding:6px 10px;
      border-radius:6px;cursor:pointer;transition:background .12s;border:1px solid transparent;
    }
    .step-pill:hover,.step-pill.hl{background:var(--bg-card);border-color:var(--bd)}
    .sp-num{
      width:20px;height:20px;border-radius:50%;background:var(--bg-hover);border:1px solid var(--bd);
      display:flex;align-items:center;justify-content:center;
      font-size:10px;font-weight:700;color:var(--t2);flex-shrink:0;margin-top:1px;
    }
    .sp-lbl{font-size:11px;color:var(--t2);line-height:1.38}
    .info-box{background:var(--bg-card);border:1px solid var(--bd);border-radius:10px;padding:12px 14px}
    .info-box p{font-size:11px;color:var(--t2);line-height:1.65}

    /* ── CANVAS ──────────────────────────────────────────────── */
    .canvas{padding:30px 36px;overflow-x:auto}
    .c-title{font-size:21px;font-weight:800;color:var(--t1);letter-spacing:-.025em;margin-bottom:6px}
    .c-desc{font-size:13px;color:var(--t2);line-height:1.6;margin-bottom:22px;max-width:720px}

    /* section legend pills */
    .sec-pills{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px}
    .sec-pill{display:flex;align-items:center;gap:7px;padding:6px 14px;border-radius:999px;font-size:11.5px;font-weight:600;border:1px solid}
    .sec-pill.reg{background:var(--reg-dim);border-color:var(--reg);color:var(--reg)}
    .sec-pill.log{background:var(--log-dim);border-color:var(--log);color:var(--log)}
    .sec-pill.err{background:var(--err-dim);border-color:var(--err);color:var(--err)}

    /* filter tabs */
    .filter-bar{display:flex;align-items:center;gap:8px;margin-bottom:22px;flex-wrap:wrap}
    .fl{font-size:11px;color:var(--t3);font-weight:700;text-transform:uppercase;letter-spacing:.06em}
    .fb{
      padding:5px 14px;border-radius:999px;font-size:11px;font-weight:500;
      cursor:pointer;border:1px solid var(--bd);background:transparent;color:var(--t2);transition:all .12s;
    }
    .fb:hover{background:var(--bg-card);color:var(--t1)}
    .fb.active{border-color:var(--accent);background:rgba(99,102,241,.12);color:var(--accent2)}
    .fb.active.reg-t{border-color:var(--reg);background:var(--reg-dim);color:var(--reg)}
    .fb.active.log-t{border-color:var(--log);background:var(--log-dim);color:var(--log)}

    /* diagram wrap */
    #diag-wrap{width:100%;overflow-x:auto}

    /* ── TOOLTIP ─────────────────────────────────────────────── */
    #tt{
      position:fixed;z-index:300;
      background:var(--bg-card);border:1px solid var(--bd-hi);
      border-radius:12px;padding:14px 17px;max-width:380px;min-width:240px;
      pointer-events:none;opacity:0;transform:translateY(6px);
      transition:opacity .15s,transform .15s;
      box-shadow:0 12px 40px rgba(0,0,0,.6),0 0 0 1px rgba(99,102,241,.08);
    }
    #tt.vis{opacity:1;transform:translateY(0)}
    .tt-hd{display:flex;align-items:center;gap:8px;margin-bottom:8px}
    .tt-num{
      width:22px;height:22px;border-radius:50%;
      display:flex;align-items:center;justify-content:center;
      font-size:10px;font-weight:700;flex-shrink:0;
    }
    .tt-type{font-size:10px;font-weight:700;color:var(--t3);text-transform:uppercase;letter-spacing:.08em}
    .tt-fn{font-size:13px;font-weight:600;color:var(--t1);margin-bottom:7px;font-family:var(--mono);line-height:1.4;word-break:break-all}
    .tt-body{font-size:12px;color:var(--t2);line-height:1.6}
    .tt-file{
      margin-top:9px;font-size:10px;color:var(--tcode);font-family:var(--mono);
      padding:4px 9px;background:rgba(99,102,241,.1);border-radius:5px;display:inline-block;
    }

    /* ── DETAIL PANEL ────────────────────────────────────────── */
    .detail-panel{
      margin-top:32px;background:var(--bg-surf);border:1px solid var(--bd);
      border-radius:14px;overflow:hidden;
    }
    .dp-header{
      display:flex;align-items:center;gap:10px;padding:16px 20px;
      border-bottom:1px solid var(--bd);background:var(--bg-card);
    }
    .dp-title{font-size:13px;font-weight:700;color:var(--t1)}
    .dp-body{padding:20px;display:grid;grid-template-columns:1fr 1fr;gap:20px}
    .dp-col-title{font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;margin-bottom:12px}
    .dp-item{margin-bottom:14px}
    .dp-item-hd{display:flex;align-items:center;gap:7px;margin-bottom:5px}
    .dp-badge{
      padding:2px 8px;border-radius:999px;font-size:10px;font-weight:700;
      font-family:var(--mono);white-space:nowrap;
    }
    .dp-item-body{font-size:11.5px;color:var(--t2);line-height:1.65;padding-left:2px}
    .dp-item-code{
      margin-top:6px;font-family:var(--mono);font-size:11px;color:var(--tcode);
      background:rgba(99,102,241,.08);border:1px solid rgba(99,102,241,.15);
      border-radius:6px;padding:7px 10px;line-height:1.55;
    }

    /* scrollbar */
    ::-webkit-scrollbar{width:6px;height:6px}
    ::-webkit-scrollbar-track{background:transparent}
    ::-webkit-scrollbar-thumb{background:#23263b;border-radius:3px}
    ::-webkit-scrollbar-thumb:hover{background:#30344f}

    @media(max-width:860px){
      .layout{grid-template-columns:1fr}
      .sidebar{position:static;height:auto;border-right:none;border-bottom:1px solid var(--bd)}
      .canvas{padding:20px 16px}
      .dp-body{grid-template-columns:1fr}
    }
  </style>
</head>
<body>

<!-- TOOLBAR -->
<header class="toolbar">
  <div class="tb-brand">
    <div class="tb-logo">&#9113;</div>
    <div class="tb-info">
      <div class="tb-title">Archify Sequence Diagram</div>
      <div class="tb-sub">Registration &amp; Login &nbsp;·&nbsp; POST /auth/register &nbsp;|&nbsp; POST /auth/login</div>
    </div>
  </div>
  <div class="tb-acts">
    <span style="background:rgba(52,211,153,.12);color:#34d399;border:1px solid rgba(52,211,153,.3);padding:3px 10px;border-radius:999px;font-size:11px;font-weight:600">&#9679; Live</span>
    <button class="btn btn-ghost" id="btn-zo">&#8722; Zoom</button>
    <button class="btn btn-ghost" id="btn-zi">&#43; Zoom</button>
    <button class="btn btn-pri" onclick="window.print()">&#8595; Export</button>
  </div>
</header>

<div class="layout">
  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div>
      <div class="sb-hd">Actors / Columns</div>
      <div id="leg"></div>
    </div>
    <div>
      <div class="sb-hd">Step Navigator</div>
      <div class="step-list" id="snav"></div>
    </div>
    <div class="info-box">
      <p><strong style="color:var(--t1)">Tip:</strong> Hover any arrow to inspect function name, detail, and source file. Click an actor in the legend to highlight its lifeline. Use the filter tabs to focus on one workflow.</p>
    </div>
  </aside>

  <!-- CANVAS -->
  <div class="canvas">
    <div class="c-title">Registration &amp; Login Workflows</div>
    <div class="c-desc">
      Two-section diagram tracing how new users create an account (bcrypt password hashing → DB insert → auto-login) and how returning users exchange credentials for a signed JWT session token. Each step maps to the exact function call and source file line.
    </div>
    <!-- section legend -->
    <div class="sec-pills">
      <div class="sec-pill reg">&#9632; Section A — Registration (POST /auth/register)</div>
      <div class="sec-pill log">&#9632; Section B — Login (POST /auth/login)</div>
      <div class="sec-pill err">&#10005; Error Branches — 409 Conflict &amp; 401 Unauthorized</div>
    </div>
    <!-- filter bar -->
    <div class="filter-bar">
      <span class="fl">Show:</span>
      <button class="fb active" data-f="all">All Steps</button>
      <button class="fb reg-t" data-f="reg">Section A — Registration</button>
      <button class="fb log-t" data-f="log">Section B — Login</button>
      <button class="fb" data-f="err">Error Branches</button>
    </div>
    <div id="diag-wrap"></div>

    <!-- DETAIL EXPLANATION PANEL -->
    <div class="detail-panel">
      <div class="dp-header">
        <span style="font-size:16px">&#128203;</span>
        <div class="dp-title">Deep-Dive: Security Implementation Details</div>
      </div>
      <div class="dp-body">
        <div>
          <div class="dp-col-title" style="color:var(--reg)">&#9632; Section A — Registration</div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--reg-dim);color:var(--reg);border:1px solid rgba(52,211,153,.3)">STEP 1</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">Form Submission</span>
            </div>
            <div class="dp-item-body">User fills email, full_name (optional), and password (min 8 chars). <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">handleSubmit()</code> calls <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">register()</code> from AuthContext, which chains internally to <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">authApi.register()</code>.</div>
            <div class="dp-item-code">RegisterPage.tsx:26 → AuthContext.tsx:72–79 → api.ts:205–207</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--err-dim);color:var(--err);border:1px solid rgba(248,113,113,.3)">GUARD</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">409 Duplicate Email Check</span>
            </div>
            <div class="dp-item-body">Before creating a user, <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">get_user_by_email()</code> queries Postgres. If a row exists → <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">HTTPException(409, "A user with this email already exists")</code>. This prevents silent overwrites of existing accounts.</div>
            <div class="dp-item-code">routes.py:33–38</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--reg-dim);color:var(--reg);border:1px solid rgba(52,211,153,.3)">CRYPTO</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">get_password_hash() — bcrypt</span>
            </div>
            <div class="dp-item-body">Password is encoded to UTF-8 bytes, then hashed via <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">bcrypt.gensalt(rounds=12)</code> + <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">bcrypt.hashpw()</code>. 12 rounds = 2¹² = 4,096 bcrypt iterations. The salt is embedded in the output hash string — no separate column needed.</div>
            <div class="dp-item-code">security.py:11–16</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--reg-dim);color:var(--reg);border:1px solid rgba(52,211,153,.3)">DB</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">INSERT users + Auto-Login</span>
            </div>
            <div class="dp-item-body">User row inserted with <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">is_active=True, is_superuser=False</code>. After 201 response, AuthContext immediately calls <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">login()</code> to avoid a double-form UX — the user lands on dashboard already authenticated.</div>
            <div class="dp-item-code">service.py:26–41 → AuthContext.tsx:74–78</div>
          </div>
        </div>

        <div>
          <div class="dp-col-title" style="color:var(--log)">&#9632; Section B — Login</div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--log-dim);color:var(--log);border:1px solid rgba(245,158,11,.3)">LOOKUP</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">authenticate_user() — two-phase check</span>
            </div>
            <div class="dp-item-body">First fetches the user by email. If no row → return None → 401. If row exists, calls <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">verify_password()</code>. If hash mismatch → return None → 401. If <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">is_active=False</code> → return None → 401. Both failures surface the same generic 401 message to prevent user enumeration.</div>
            <div class="dp-item-code">service.py:43–57</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--log-dim);color:var(--log);border:1px solid rgba(245,158,11,.3)">CRYPTO</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">verify_password() — constant-time bcrypt</span>
            </div>
            <div class="dp-item-body"><code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">bcrypt.checkpw(password_bytes, hashed_bytes)</code> is timing-safe: it always runs all 4,096 bcrypt rounds regardless of where a mismatch occurs, preventing timing-based user enumeration attacks.</div>
            <div class="dp-item-code">security.py:19–26</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--log-dim);color:var(--log);border:1px solid rgba(245,158,11,.3)">JWT</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">create_access_token() — HS256 signed JWT</span>
            </div>
            <div class="dp-item-body">Builds payload: <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">{sub: user.email, iat: now, exp: now+ACCESS_TOKEN_EXPIRE_MINUTES, type: "access"}</code>. Signs with <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">SECRET_KEY</code> using HS256 algorithm via PyJWT. The <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">sub</code> claim is later extracted in <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">get_current_user()</code> to identify the caller.</div>
            <div class="dp-item-code">security.py:29–52</div>
          </div>

          <div class="dp-item">
            <div class="dp-item-hd">
              <span class="dp-badge" style="background:var(--log-dim);color:var(--log);border:1px solid rgba(245,158,11,.3)">STORE</span>
              <span style="font-size:11.5px;font-weight:600;color:var(--t1)">tokenStorage.set() + authApi.getMe()</span>
            </div>
            <div class="dp-item-body">Token stored in <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">localStorage["email_mon_auth_token"]</code> via <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">tokenStorage.set()</code>. AuthContext then calls <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">authApi.getMe()</code> to fetch and hydrate the user profile — same flow as app initialization — setting <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">user</code> state and enabling <code style="font-family:var(--mono);font-size:10.5px;color:var(--tcode)">isAuthenticated=true</code>.</div>
            <div class="dp-item-code">AuthContext.tsx:64–70 → api.ts:208–210</div>
          </div>
        </div>
      </div>
    </div>

  </div><!-- /canvas -->
</div><!-- /layout -->

<!-- TOOLTIP -->
<div id="tt">
  <div class="tt-hd">
    <div class="tt-num" id="tt-num"></div>
    <div class="tt-type" id="tt-type"></div>
  </div>
  <div class="tt-fn" id="tt-fn"></div>
  <div class="tt-body" id="tt-body"></div>
  <div class="tt-file" id="tt-file"></div>
</div>

<script>
/* ================================================================
   DATA
   ================================================================ */
const ACTORS = [
  { id:'page',    label:'RegisterPage\n/ LoginPage', short:'Page',        sub:'handleSubmit() · register() · login()',  color:'#818cf8' },
  { id:'authctx', label:'AuthContext.tsx',           short:'AuthCtx',     sub:'register() · login() · setUser()',        color:'#34d399' },
  { id:'api',     label:'api.ts',                    short:'api.ts',      sub:'authApi.register() · authApi.login()',    color:'#f59e0b' },
  { id:'routes',  label:'routes.py',                 short:'routes.py',   sub:'POST /register · POST /login',            color:'#38bdf8' },
  { id:'service', label:'service.py',                short:'service.py',  sub:'AuthService.create_user() · authenticate_user()', color:'#c084fc' },
  { id:'sec',     label:'security.py',               short:'security.py', sub:'get_password_hash() · verify_password() · create_access_token()', color:'#fb923c' },
  { id:'pg',      label:'Postgres',                  short:'Postgres',    sub:'users table · INSERT · SELECT',           color:'#60a5fa' },
];

// section: 'reg'|'log'|'err'|'both'
const STEPS = [

  /* ═══════════════════════════════════════
     SECTION A — REGISTRATION
  ═══════════════════════════════════════ */
  { id:1, type:'divider', label:'SECTION A — REGISTRATION  ·  POST /api/v1/auth/register', sec:'reg' },

  { id:2, type:'note', sec:'reg',
    label:'User fills form (email, full_name, password)',
    fn:'handleSubmit(e: FormEvent)',
    detail:'User submits the registration form. handleSubmit() calls e.preventDefault(), sets isLoading=true, then awaits register({email, password, full_name}).',
    file:'RegisterPage.tsx:19–41', from:null, to:null },

  { id:3, type:'call', sec:'reg',
    label:'register({email, password, full_name})',
    fn:'register(credentials: RegisterCredentials)',
    detail:'AuthContext.register() calls authApi.register(userData) and then immediately chains to login() to auto-authenticate after successful creation.',
    file:'AuthContext.tsx:72–79', from:'page', to:'authctx' },

  { id:4, type:'call', sec:'reg',
    label:'authApi.register(userData)',
    fn:'apiClient.post<User>("/api/v1/auth/register", userData)',
    detail:'api.ts sends POST /api/v1/auth/register with JSON body: {email, password, full_name}. No Authorization header is attached for this unauthenticated endpoint.',
    file:'api.ts:205–207', from:'authctx', to:'api' },

  { id:5, type:'call', sec:'reg',
    label:'POST /api/v1/auth/register  {email, password, full_name}',
    fn:'fetch("/api/v1/auth/register", { method:"POST", body: JSON.stringify({…}) })',
    detail:'HTTP POST request reaches FastAPI. Pydantic validates UserRegister schema: email format, password min length. Invalid input raises 422 Unprocessable Entity before the route body runs.',
    file:'api.ts:138–141', from:'api', to:'routes' },

  { id:6, type:'call', sec:'reg',
    label:'AuthService.get_user_by_email(db, email)',
    fn:'existing_user = await AuthService.get_user_by_email(db, user_in.email)',
    detail:'Duplicate email guard. Queries Postgres before any work is done. Email is normalized (lowercase + strip) before SELECT.',
    file:'routes.py:33', from:'routes', to:'service' },

  { id:7, type:'call', sec:'reg',
    label:'SELECT users WHERE email = :email',
    fn:'await db.execute(select(User).where(User.email == normalized_email))',
    detail:'SQLAlchemy async SELECT on the users table using the normalized email. Returns first matching row or None.',
    file:'service.py:14–17', from:'service', to:'pg' },

  { id:8, type:'ret', sec:'reg',
    label:'User row (or None)',
    fn:'result.scalars().first()',
    detail:'Returns existing User ORM object if email already registered, or None if email is new.',
    file:'service.py:17', from:'pg', to:'service' },

  { id:9, type:'ret', sec:'reg',
    label:'Optional[User] to route',
    fn:'return result.scalars().first()',
    detail:'AuthService returns the lookup result to the register() route handler.',
    file:'service.py:17', from:'service', to:'routes' },

  { id:10, type:'alt_start', label:'BRANCH — Email already exists (existing_user is not None)', sec:'err' },

  { id:11, type:'ret', sec:'err',
    label:'409 "A user with this email already exists"',
    fn:'raise HTTPException(status_code=409, detail="A user with this email already exists")',
    detail:'Route raises HTTP 409 Conflict. Frontend catches the RequestError and calls setError(err.message), rendering the red banner in RegisterPage.',
    file:'routes.py:34–38', from:'routes', to:'api' },

  { id:12, type:'alt_else', label:'BRANCH — Email is new, proceed to create account', sec:'reg' },

  { id:13, type:'call', sec:'reg',
    label:'AuthService.create_user(db, user_in)',
    fn:'user = await AuthService.create_user(db, user_in)',
    detail:'Route delegates creation to AuthService. Passes the validated UserRegister Pydantic model.',
    file:'routes.py:40', from:'routes', to:'service' },

  { id:14, type:'call', sec:'reg',
    label:'get_password_hash(user_in.password)',
    fn:'hashed_password = get_password_hash(user_in.password)',
    detail:'Calls core/security.py to securely hash the plaintext password before storing. Never stores raw passwords.',
    file:'service.py:29', from:'service', to:'sec' },

  { id:15, type:'call', sec:'reg',
    label:'bcrypt.gensalt(rounds=12) + bcrypt.hashpw()',
    fn:'salt = bcrypt.gensalt(rounds=12); hashed = bcrypt.hashpw(password.encode("utf-8"), salt)',
    detail:'Generates a fresh cryptographic salt with 12 rounds (2¹² = 4,096 iterations). bcrypt.hashpw() runs the password through 4,096 iterations of the Blowfish cipher. Salt is embedded in the output "$2b$12$…" string — no separate DB column needed.',
    file:'security.py:13–16', from:'sec', to:'sec' },

  { id:16, type:'ret', sec:'reg',
    label:'"$2b$12$…" bcrypt hash string',
    fn:'return hashed.decode("utf-8")',
    detail:'Returns the 60-char bcrypt hash string back to create_user(). Format: $2b$<rounds>$<22-char-salt><31-char-hash>.',
    file:'security.py:16', from:'sec', to:'service' },

  { id:17, type:'call', sec:'reg',
    label:'INSERT INTO users (email, hashed_password, full_name, is_active, is_superuser)',
    fn:'db.add(db_user); await db.commit(); await db.refresh(db_user)',
