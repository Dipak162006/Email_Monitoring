  AttachmentItem,
  AttachmentListResponse,
  AuthorizedEmailAccount,
  EmailAccountCreatePayload,
  EmailAccountItem,
  EmailAccountUpdatePayload,
  EmailDraftPayload,
  EmailItem,
  EmailListParams,
