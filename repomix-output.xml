.leg-line.solid{background:var(--dim);}
.leg-line.dashed{background:repeating-linear-gradient(90deg,var(--dim) 0,var(--dim) 4px,transparent 4px,transparent 8px);}
.leg-line.error{background:#ff7b72;}

/* highlight dimming */
.dim-lane .node:not(.layer-match){opacity:.18;filter:none;}
</style>
