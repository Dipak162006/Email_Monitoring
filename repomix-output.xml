<file path="frontend/src/pages/EmailAccountsPage.tsx">
import { useState } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  Mail,
  Plus,
  Server,
  RefreshCw,
  Edit3,
  Trash2,
  AlertCircle,
  CheckCircle2,
  X,
  ChevronRight,
  ShieldCheck,
  Building,
} from "lucide-react";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { EmailAccountDrawer } from "../components/accounts/EmailAccountDrawer";
import { DeleteAccountConfirmModal } from "../components/accounts/DeleteAccountConfirmModal";
import { useWorkspace } from "../hooks/useWorkspace";
import { usePermissions } from "../hooks/usePermissions";
import { emailAccountsApi } from "../services/api";
import type { EmailAccountItem } from "../types/emails";

export function EmailAccountsPage() {
  const queryClient = useQueryClient();

  // Drawer & Modal states
  const [isDrawerOpen, setIsDrawerOpen] = useState(false);
  const [selectedAccountForEdit, setSelectedAccountForEdit] = useState<EmailAccountItem | null>(
    null
  );
  const [accountToDelete, setAccountToDelete] = useState<EmailAccountItem | null>(null);
  const [syncingAccountId, setSyncingAccountId] = useState<number | null>(null);

  // User notification banner
  const [alertBanner, setAlertBanner] = useState<{
    type: "success" | "error" | "info";
    message: string;
  } | null>(null);

  // 1. Consume active workspace and centralized permissions
  const {
    currentCompany: activeCompany,
    isLoading: isWorkspaceLoading,
    isError: isWorkspaceError,
  } = useWorkspace();

  const { canManageEmailAccounts } = usePermissions();

  // 2. Fetch email accounts for current active company
  const {
    data: accounts = [],
    isLoading: isAccountsLoading,
    isError: isAccountsError,
    error: accountsErrorObj,
    refetch: refetchAccounts,
  } = useQuery({
    queryKey: ["company-email-accounts", activeCompany?.id],
    queryFn: () => emailAccountsApi.listCompanyAccounts(activeCompany!.id),
    enabled: !!activeCompany?.id,
    staleTime: 30000,
  });

  // 3. Delete mutation
  const deleteMutation = useMutation({
    mutationFn: async ({
      companyId,
      accountId,
    }: {
      companyId: number;
      accountId: number;
    }) => {
      if (!canManageEmailAccounts) {
        throw new Error("You do not have permission to delete email accounts in this workspace.");
      }
      return emailAccountsApi.deleteAccount(companyId, accountId);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["company-email-accounts"] });
      queryClient.invalidateQueries({ queryKey: ["authorized-accounts"] });
      setAccountToDelete(null);
      setAlertBanner({
        type: "success",
        message: "Email account successfully removed.",
      });
    },
    onError: (err: unknown) => {
      const errorObj = err as { detail?: string; message?: string };
      setAccountToDelete(null);
      setAlertBanner({
        type: "error",
        message:
          errorObj.detail || errorObj.message || "Failed to remove email account. Please try again.",
      });
    },
  });

  // Handle Sync action
  const handleSyncAccount = async (accountId: number, accountName: string) => {
    try {
      setSyncingAccountId(accountId);
      const res = await emailAccountsApi.triggerSync(accountId, false);

      if ("total_discovered" in res) {
        if (res.status === "SUCCESS") {
          const countMsg =
            res.new_messages > 0
              ? `${res.new_messages} new email${res.new_messages === 1 ? "" : "s"} fetched.`
              : "Mailbox is up to date (no new emails).";
          setAlertBanner({
            type: "success",
            message: `Synchronized ${accountName}: ${countMsg}`,
          });
        } else if (res.status === "PARTIAL") {
          setAlertBanner({
            type: "info",
            message: `Partial sync for ${accountName}: ${res.new_messages} new email(s) fetched. ${res.error_message || ""}`.trim(),
          });
        } else {
          setAlertBanner({
            type: "error",
            message: `Sync failed for ${accountName}: ${res.error_message || "Synchronization failed."}`,
          });
        }
      } else {
        setAlertBanner({
          type: "success",
          message: `Synchronization task queued for ${accountName}.`,
        });
      }

      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["company-email-accounts"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["dashboard-stats"] }),
        queryClient.invalidateQueries({ queryKey: ["dashboard-activity"] }),
      ]);
    } catch (err: unknown) {
      const errorObj = err as { message?: string; detail?: string };
      const rawMsg =
        errorObj.detail ||
        errorObj.message ||
        `Failed to synchronize ${accountName}. Please check configuration.`;
      setAlertBanner({
        type: "error",
        message: `${accountName}: ${rawMsg}`,
      });
    } finally {
      setSyncingAccountId(null);
    }
  };

  const handleOpenCreate = () => {
    if (!canManageEmailAccounts) return;
    setSelectedAccountForEdit(null);
    setIsDrawerOpen(true);
  };

  const handleOpenEdit = (account: EmailAccountItem) => {
    if (!canManageEmailAccounts) return;
    setSelectedAccountForEdit(account);
    setIsDrawerOpen(true);
  };

  const formatLastSynced = (dateStr?: string | null) => {
    if (!dateStr) return "Never";
    try {
      const date = new Date(dateStr);
      const diffMs = Date.now() - date.getTime();
      const diffMin = Math.floor(diffMs / 60000);
      if (diffMin < 1) return "Just now";
      if (diffMin < 60) return `${diffMin}m ago`;
      const diffHours = Math.floor(diffMin / 60);
      if (diffHours < 24) return `${diffHours}h ago`;
      return date.toLocaleDateString([], { month: "short", day: "numeric" });
    } catch {
      return "Unknown";
    }
  };

  const getProviderLabel = (provider: string) => {
    switch (provider) {
      case "GOOGLE":
        return "Google Workspace";
      case "YAHOO":
        return "Yahoo Mail";
      case "ZOHO":
        return "Zoho Mail";
      default:
        return "Custom IMAP / SMTP";
    }
  };

  const isLoading = isWorkspaceLoading || (!!activeCompany && isAccountsLoading);

  return (
    <div className="space-y-6">
      {/* Subheader / Action Bar matching Stitch design */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-1.5 text-xs text-slate-500 font-medium mb-1">
            <span>Settings</span>
            <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
            <span className="text-indigo-600 font-semibold">Connected Accounts</span>
            {activeCompany && (
              <>
                <ChevronRight className="w-3.5 h-3.5 text-slate-400" />
                <span className="inline-flex items-center gap-1 text-slate-600 font-medium">
                  <Building className="w-3 h-3 text-slate-400" />
                  {activeCompany.name}
                </span>
              </>
            )}
          </div>
          <h1 className="text-2xl font-bold text-slate-900 tracking-tight">
            Connected Email Accounts
          </h1>
          <p className="text-xs sm:text-sm text-slate-500 mt-0.5">
            Manage incoming and outgoing email servers, sync frequencies, and routing protocols.
          </p>
        </div>

        <div className="flex items-center gap-3 self-start md:self-auto">
          <Button
            size="sm"
            onClick={handleOpenCreate}
            disabled={!activeCompany || !canManageEmailAccounts}
            className="gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white shadow-sm shadow-indigo-200 cursor-pointer"
          >
            <Plus className="h-3.5 w-3.5" />
            Add New Account
          </Button>
        </div>
      </div>

      {/* Operation Alert Notification Banner */}
      {alertBanner && (
        <div
          className={`flex items-center justify-between px-4 py-3 rounded-xl border text-xs font-medium transition-all ${
            alertBanner.type === "success"
              ? "bg-emerald-50 border-emerald-200 text-emerald-800"
              : alertBanner.type === "error"
              ? "bg-rose-50 border-rose-200 text-rose-800"
              : "bg-blue-50 border-blue-200 text-blue-800"
          }`}
        >
          <div className="flex items-center gap-2">
            {alertBanner.type === "success" ? (
              <CheckCircle2 className="h-4 w-4 text-emerald-600 shrink-0" />
            ) : (
              <AlertCircle className="h-4 w-4 text-rose-600 shrink-0" />
            )}
            <span>{alertBanner.message}</span>
          </div>
          <button
            type="button"
            onClick={() => setAlertBanner(null)}
            className="p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 cursor-pointer"
            aria-label="Dismiss alert"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>
      )}

      {/* Cluster / Telemetry Info Banner matching Stitch */}
      <div className="bg-white border border-slate-200 rounded-xl p-5 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4">
        <div className="flex items-center gap-4">
          <div className="w-11 h-11 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
            <Server className="w-5 h-5" />
          </div>
          <div>
            <div className="flex items-center gap-2.5 flex-wrap">
              <span className="font-semibold text-slate-900 text-sm sm:text-base">
                Relay Gateway Cluster (v2.4)
              </span>
              <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 text-xs font-medium">
                <span className="w-1.5 h-1.5 rounded-full bg-emerald-500" />
                All Systems Operational
              </span>
            </div>
            <p className="text-xs text-slate-500 mt-1">
              Active company: <strong className="text-slate-700">{activeCompany?.name || "None"}</strong> ·{" "}
              {accounts.length} {accounts.length === 1 ? "account" : "accounts"} configured
            </p>
          </div>
        </div>

        <div className="flex items-center gap-2 text-xs text-slate-500 font-mono">
          <ShieldCheck className="w-4 h-4 text-indigo-600" />
          <span>AES-GCM Credential Encryption</span>
        </div>
      </div>

      {/* Content Rendering: Loading, Error, Empty, or Cards Grid */}
      {isLoading ? (
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {[1, 2, 3].map((idx) => (
            <div
              key={idx}
              className="bg-white rounded-xl border border-slate-200 p-5 shadow-xs animate-pulse space-y-4"
            >
              <div className="flex items-center gap-3">
                <div className="w-10 h-10 rounded-lg bg-slate-100" />
                <div className="space-y-2 flex-1">
                  <div className="h-4 bg-slate-100 rounded w-2/3" />
                  <div className="h-3 bg-slate-100 rounded w-1/2" />
                </div>
              </div>
              <div className="h-20 bg-slate-50 rounded-lg" />
              <div className="h-8 bg-slate-100 rounded" />
            </div>
          ))}
        </div>
      ) : isAccountsError || isWorkspaceError ? (
        <div className="bg-white rounded-xl border border-slate-200 p-8 text-center space-y-3">
          <AlertCircle className="w-8 h-8 text-rose-500 mx-auto" />
          <h3 className="text-sm font-semibold text-slate-900">Failed to load email accounts</h3>
          <p className="text-xs text-slate-500 max-w-sm mx-auto">
            {accountsErrorObj instanceof Error
              ? accountsErrorObj.message
              : "Unable to communicate with the email accounts service. Please check your network connection."}
          </p>
          <Button variant="outline" size="sm" onClick={() => refetchAccounts()}>
            Try Again
          </Button>
        </div>
      ) : !activeCompany ? (
        <EmptyState
          icon={<Building className="h-6 w-6 text-indigo-500" />}
          title="No company organization found"
          description="You are currently not associated with an active company organization. Please join or create a company to configure email accounts."
        />
      ) : accounts.length === 0 ? (
        <EmptyState
          icon={<Mail className="h-6 w-6 text-indigo-500" />}
          title="No email accounts configured"
          description="Add an email account with IMAP host, port, and credentials to enable automatic email synchronization and SMTP outgoing mail."
          actionLabel="Add Email Account"
          onAction={handleOpenCreate}
        />
      ) : (
        /* Connected Account Cards Grid matching Stitch */
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {accounts.map((account) => {
            const isSyncing = syncingAccountId === account.id;

            return (
              <div
                key={account.id}
                className="bg-white rounded-xl border border-slate-200 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between overflow-hidden"
              >
                <div className="p-5">
                  {/* Top card header */}
                  <div className="flex items-start justify-between gap-3">
                    <div className="flex items-center gap-3 min-w-0">
                      <div className="w-10 h-10 rounded-lg bg-indigo-50 text-indigo-600 flex items-center justify-center border border-indigo-100 shrink-0">
                        <Mail className="w-5 h-5" />
                      </div>
                      <div className="min-w-0">
                        <h3 className="font-semibold text-slate-900 text-sm truncate">
                          {account.name}
                        </h3>
                        <p className="font-mono text-xs text-slate-500 truncate">
                          {account.email_address}
                        </p>
                      </div>
                    </div>

                    <span
                      className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium shrink-0 ${
                        account.is_active
                          ? "bg-emerald-50 text-emerald-700 border border-emerald-200"
                          : "bg-slate-100 text-slate-600 border border-slate-200"
                      }`}
                    >
                      <span
                        className={`w-1.5 h-1.5 rounded-full ${
                          account.is_active ? "bg-emerald-500" : "bg-slate-400"
                        }`}
                      />
                      {account.is_active ? "Connected" : "Inactive"}
                    </span>
                  </div>

                  {/* Metadata table matching Stitch */}
                  <div className="mt-4 space-y-2 text-xs text-slate-600 bg-slate-50/80 border border-slate-100 rounded-lg p-3">
                    <div className="flex items-center justify-between">
                      <span className="text-slate-500">Provider</span>
                      <span className="font-medium text-slate-900">
                        {getProviderLabel(account.provider)}
                      </span>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-slate-500">Incoming (IMAP)</span>
                      <span className="font-mono text-slate-800 text-[11px]">
                        {account.imap_host
                          ? `${account.imap_host}:${account.imap_port ?? 993}`
                          : "Not configured"}
                      </span>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-slate-500">Outgoing (SMTP)</span>
                      <span className="font-mono text-slate-800 text-[11px]">
                        {account.smtp_host
                          ? `${account.smtp_host}:${account.smtp_port ?? 587}`
                          : "Not configured"}
                      </span>
                    </div>

                    <div className="flex items-center justify-between">
                      <span className="text-slate-500">Last Synced</span>
                      <span className="font-medium text-slate-900">
                        {formatLastSynced(account.last_synced_at)}
                      </span>
                    </div>
                  </div>
                </div>

                {/* Card footer actions matching Stitch */}
                <div className="px-5 py-3 bg-slate-50 border-t border-slate-100 flex items-center justify-between">
                  <button
                    type="button"
                    disabled={isSyncing}
                    onClick={() => handleSyncAccount(account.id, account.name)}
                    className="flex items-center gap-1.5 text-xs font-medium text-slate-600 hover:text-indigo-600 transition-colors disabled:opacity-50 cursor-pointer"
                  >
                    <RefreshCw className={`w-3.5 h-3.5 ${isSyncing ? "animate-spin text-indigo-600" : ""}`} />
                    <span>{isSyncing ? "Syncing..." : "Sync Now"}</span>
                  </button>

                  <div className="flex items-center gap-1">
                    <button
                      type="button"
                      disabled={!canManageEmailAccounts}
                      onClick={() => handleOpenEdit(account)}
                      className="p-1.5 rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-200/60 transition-colors disabled:opacity-30 cursor-pointer"
                      title="Edit Configuration"
                      aria-label={`Edit ${account.name}`}
                    >
                      <Edit3 className="w-4 h-4" />
                    </button>

                    <button
                      type="button"
                      disabled={!canManageEmailAccounts}
                      onClick={() => setAccountToDelete(account)}
                      className="p-1.5 rounded-md text-rose-400 hover:text-rose-600 hover:bg-rose-50 transition-colors disabled:opacity-30 cursor-pointer"
                      title="Remove Account"
                      aria-label={`Remove ${account.name}`}
                    >
                      <Trash2 className="w-4 h-4" />
                    </button>
                  </div>
                </div>
              </div>
            );
          })}
        </div>
      )}

      {/* Slide-over Drawer for Add/Edit Account */}
      {activeCompany && (
        <EmailAccountDrawer
          isOpen={isDrawerOpen}
          onClose={() => setIsDrawerOpen(false)}
          companyId={activeCompany.id}
          initialAccount={selectedAccountForEdit}
          onSuccess={() => {
            queryClient.invalidateQueries({ queryKey: ["company-email-accounts"] });
            queryClient.invalidateQueries({ queryKey: ["authorized-accounts"] });
            queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
            setAlertBanner({
              type: "success",
              message: selectedAccountForEdit
                ? `Account "${selectedAccountForEdit.name}" updated successfully.`
                : "New email account successfully configured and connected.",
            });
          }}
        />
      )}

      {/* Delete Confirmation Modal */}
      {accountToDelete && activeCompany && (
        <DeleteAccountConfirmModal
          isOpen={!!accountToDelete}
          accountName={accountToDelete.name}
          accountEmail={accountToDelete.email_address}
          isDeleting={deleteMutation.isPending}
          onClose={() => {
            if (!deleteMutation.isPending) setAccountToDelete(null);
          }}
          onConfirm={() => {
            deleteMutation.mutate({
              companyId: activeCompany.id,
              accountId: accountToDelete.id,
            });
          }}
        />
      )}
    </div>
  );
}
</file>

<file path="frontend/src/pages/SignaturesPage.tsx">
import { useState, useMemo, useEffect } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  PenTool,
  Plus,
  Search,
  CheckCircle2,
  ChevronDown,
  X,
} from "lucide-react";
import { signaturesApi, emailAccountsApi } from "../services/api";
import { useWorkspace } from "../hooks/useWorkspace";
import type {
  AuthorizedEmailAccount,
  EmailSignatureCreatePayload,
  EmailSignatureItem,
  EmailSignatureUpdatePayload,
} from "../types/emails";
import { SignatureCard } from "../components/signatures/SignatureCard";
import { SignatureDrawer } from "../components/signatures/SignatureDrawer";
import { SignaturePreviewModal } from "../components/signatures/SignaturePreviewModal";
import { DeleteSignatureModal } from "../components/signatures/DeleteSignatureModal";
import { ErrorState } from "../components/ui/ErrorState";

export function SignaturesPage() {
  const queryClient = useQueryClient();
  const { currentCompanyId } = useWorkspace();

  // Filters State
  const [searchQuery, setSearchQuery] = useState("");
  const [accountFilter, setAccountFilter] = useState<string>("all");
  const [statusFilter, setStatusFilter] = useState<string>("all");

  // Reset account filter when workspace changes
  useEffect(() => {
    setAccountFilter("all");
    setSearchQuery("");
  }, [currentCompanyId]);

  // Drawer & Modal State
  const [isDrawerOpen, setIsDrawerOpen] = useState(false);
  const [editingSignature, setEditingSignature] = useState<EmailSignatureItem | null>(null);
  const [previewSignature, setPreviewSignature] = useState<EmailSignatureItem | null>(null);
  const [deletingSignature, setDeletingSignature] = useState<EmailSignatureItem | null>(null);
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  const showToast = (message: string) => {
    setToastMessage(message);
    setTimeout(() => {
      setToastMessage((current) => (current === message ? null : current));
    }, 4000);
  };

  // 1. Fetch Authorized Email Accounts (scoped to active company)
  const { data: rawAccounts = [] } = useQuery({
    queryKey: ["authorizedEmailAccounts"],
    queryFn: () => emailAccountsApi.getAuthorizedAccounts(),
    staleTime: 60000,
  });

  const accounts = useMemo(() => {
    if (!currentCompanyId) return [];
    return rawAccounts.filter((acc) => acc.company_id === currentCompanyId);
  }, [rawAccounts, currentCompanyId]);

  const accountMap = useMemo(() => {
    const map = new Map<number, string>();
    accounts.forEach((acc) => {
      map.set(acc.id, acc.email_address);
    });
    return map;
  }, [accounts]);

  // 2. Fetch Signatures (strictly scoped to active workspace)
  const {
    data: signatures = [],
    isLoading,
    isError,
    error,
    refetch,
  } = useQuery({
    queryKey: ["signatures", currentCompanyId],
    queryFn: () => signaturesApi.listSignatures(undefined, currentCompanyId ?? undefined),
    enabled: !!currentCompanyId,
  });

  // Mutations
  const createMutation = useMutation({
    mutationFn: (data: EmailSignatureCreatePayload) => signaturesApi.createSignature(data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      showToast("Email signature created successfully.");
    },
  });

  const updateMutation = useMutation({
    mutationFn: ({ id, data }: { id: number; data: EmailSignatureUpdatePayload }) =>
      signaturesApi.updateSignature(id, data),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      showToast("Email signature updated successfully.");
    },
  });

  const deleteMutation = useMutation({
    mutationFn: (id: number) => signaturesApi.deleteSignature(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      setDeletingSignature(null);
      showToast("Email signature deleted.");
    },
  });

  const setDefaultMutation = useMutation({
    mutationFn: (id: number) => signaturesApi.setDefaultSignature(id),
    onSuccess: (updated) => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      showToast(`"${updated.name}" is now the default signature for this account.`);
    },
  });

  const duplicateMutation = useMutation({
    mutationFn: (sig: EmailSignatureItem) => {
      const copyPayload: EmailSignatureCreatePayload = {
        name: `${sig.name} (Copy)`,
        email_account_id: sig.email_account_id,
        body_text: sig.body_text,
        body_html: sig.body_html,
        is_default: false,
      };
      return signaturesApi.createSignature(copyPayload);
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      showToast("Signature duplicated successfully.");
    },
  });

  const copyToAllAccountsMutation = useMutation({
    mutationFn: async (sig: EmailSignatureItem) => {
      const otherAccounts = accounts.filter((a) => a.id !== sig.email_account_id);
      for (const acc of otherAccounts) {
        try {
          await signaturesApi.copySignature(sig.id, acc.id, undefined, false);
        } catch (e) {
          console.warn(`Could not copy signature to account ${acc.id}:`, e);
        }
      }
    },
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["signatures"] });
      showToast("Signature safely synced across accounts.");
    },
  });

  // Client-side Filter Logic
  const filteredSignatures = useMemo(() => {
    return signatures.filter((sig) => {
      // 1. Account Filter
      if (accountFilter !== "all" && String(sig.email_account_id) !== accountFilter) {
        return false;
      }

      // 2. Status Filter
      if (statusFilter === "default" && !sig.is_default) {
        return false;
      }
      if (statusFilter === "secondary" && sig.is_default) {
        return false;
      }

      // 3. Search Query Filter (name, account email, or text)
      if (searchQuery.trim()) {
        const query = searchQuery.toLowerCase().trim();
        const accEmail = (accountMap.get(sig.email_account_id) || "").toLowerCase();
        const matchesName = sig.name.toLowerCase().includes(query);
        const matchesEmail = accEmail.includes(query);
        const matchesBody = (sig.body_text || "").toLowerCase().includes(query);
        if (!matchesName && !matchesEmail && !matchesBody) {
          return false;
        }
      }

      return true;
    });
  }, [signatures, accountFilter, statusFilter, searchQuery, accountMap]);

  // Drawer handlers
  const handleOpenCreate = () => {
    setEditingSignature(null);
    setIsDrawerOpen(true);
  };

  const handleOpenEdit = (sig: EmailSignatureItem) => {
    setEditingSignature(sig);
    setIsDrawerOpen(true);
  };

  const handleSaveSignature = async (
    data: EmailSignatureCreatePayload | EmailSignatureUpdatePayload,
    isEdit: boolean
  ) => {
    if (isEdit && editingSignature) {
      await updateMutation.mutateAsync({ id: editingSignature.id, data });
    } else {
      await createMutation.mutateAsync(data as EmailSignatureCreatePayload);
    }
  };

  return (
    <div className="space-y-6 max-w-[1600px] w-full mx-auto">
      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed bottom-5 right-5 z-50 flex items-center gap-2 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-xl transition-all duration-300 text-sm font-medium animate-in fade-in slide-in-from-bottom-5">
          <CheckCircle2 className="h-4 w-4 text-emerald-400 shrink-0" />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* Top Header Bar */}
      <div className="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900 tracking-tight">Email Signatures</h1>
          <p className="text-sm text-slate-500 mt-1">
            Create and manage reusable email signatures for your connected mailboxes.
          </p>
        </div>

        <div className="flex items-center gap-3">
          <button
            type="button"
            onClick={handleOpenCreate}
            className="h-9 px-4 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs shadow-xs flex items-center gap-1.5 transition-all"
          >
            <Plus className="h-4 w-4" />
            <span>New Signature</span>
          </button>
        </div>
      </div>

      {/* Search & Filter Toolbar */}
      <div className="bg-white rounded-xl border border-slate-200 shadow-xs p-2.5 flex flex-col md:flex-row items-stretch md:items-center justify-between gap-3">
        {/* Search Field */}
        <div className="relative flex-1 flex items-center">
          <Search className="absolute left-3 h-4 w-4 text-slate-400 pointer-events-none" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search signatures by name or email..."
            className="w-full h-9 pl-9 pr-8 rounded-lg bg-slate-50 text-slate-900 placeholder:text-slate-400 text-xs focus:outline-none focus:bg-white focus:ring-1 focus:ring-indigo-500 transition-all border-0"
          />
          {searchQuery && (
            <button
              type="button"
              onClick={() => setSearchQuery("")}
              className="absolute right-2.5 p-0.5 rounded text-slate-400 hover:text-slate-600"
            >
              <X className="h-3.5 w-3.5" />
            </button>
          )}
        </div>

        {/* Dropdown Filters */}
        <div className="flex items-center gap-2 sm:gap-3 shrink-0">
          {/* Account Filter */}
          <div className="relative">
            <select
              value={accountFilter}
              onChange={(e) => setAccountFilter(e.target.value)}
              className="h-9 pl-3 pr-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium appearance-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all border-0"
            >
              <option value="all">All Accounts</option>
              {accounts.map((acc: AuthorizedEmailAccount) => (
                <option key={acc.id} value={String(acc.id)}>
                  {acc.email_address}
                </option>
              ))}
            </select>
            <ChevronDown className="absolute right-2.5 top-2.5 h-4 w-4 text-slate-400 pointer-events-none" />
          </div>

          {/* Status Filter */}
          <div className="relative">
            <select
              value={statusFilter}
              onChange={(e) => setStatusFilter(e.target.value)}
              className="h-9 pl-3 pr-8 rounded-lg bg-slate-50 hover:bg-slate-100 text-slate-700 text-xs font-medium appearance-none cursor-pointer focus:outline-none focus:ring-1 focus:ring-indigo-500 transition-all border-0"
            >
              <option value="all">All Statuses</option>
              <option value="default">Default only</option>
              <option value="secondary">Non-default</option>
            </select>
            <ChevronDown className="absolute right-2.5 top-2.5 h-4 w-4 text-slate-400 pointer-events-none" />
          </div>
        </div>
      </div>

      {/* Result Count Meta Bar */}
      <div className="flex items-center justify-between text-xs text-slate-500 px-1">
        <span className="font-medium">
          Displaying {filteredSignatures.length}{" "}
          {filteredSignatures.length === 1 ? "signature" : "signatures"}
        </span>
      </div>

      {/* Content States */}
      {isLoading ? (
        /* Loading Skeleton */
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
          {[...Array(3)].map((_, i) => (
            <div
              key={i}
              className="bg-white border border-slate-200/80 rounded-xl p-5 shadow-xs space-y-4 animate-pulse"
            >
              <div className="flex items-center justify-between">
                <div className="h-4 bg-slate-200 rounded w-1/2" />
                <div className="h-4 bg-slate-100 rounded-full w-14" />
              </div>
              <div className="h-3 bg-slate-100 rounded w-1/3" />
              <div className="h-24 bg-slate-50 rounded-lg" />
              <div className="h-4 bg-slate-100 rounded w-1/4 pt-2" />
            </div>
          ))}
        </div>
      ) : isError ? (
        /* Error State */
        <div className="py-8">
          <ErrorState
            title="Failed to Load Signatures"
            message={error instanceof Error ? error.message : "Could not fetch email signatures."}
            onRetry={() => refetch()}
          />
        </div>
      ) : signatures.length === 0 ? (
        /* Total Zero State */
        <div className="bg-white border border-slate-200 rounded-xl py-16 px-6 text-center shadow-xs">
          <div className="w-14 h-14 rounded-2xl bg-indigo-50 text-indigo-600 flex items-center justify-center mx-auto mb-4">
            <PenTool className="h-7 w-7" />
          </div>
          <h3 className="text-base font-semibold text-slate-900">No signatures yet</h3>
          <p className="text-xs text-slate-500 max-w-sm mx-auto mt-1.5 mb-5 leading-relaxed">
            Craft your first standardized email signature to boost sender credibility and brand
            recognition across outgoing campaigns.
          </p>
          <button
            type="button"
            onClick={handleOpenCreate}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-xs transition-all"
          >
            <Plus className="h-4 w-4" />
            <span>Create Signature</span>
          </button>
        </div>
      ) : filteredSignatures.length === 0 ? (
        /* Filter Zero State */
        <div className="bg-white border border-slate-200 rounded-xl py-12 px-6 text-center shadow-xs">
          <p className="text-sm font-medium text-slate-700">No matching signatures found</p>
          <p className="text-xs text-slate-400 mt-1 mb-4">
            Try adjusting your search terms, account filter, or status selection.
          </p>
          <button
            type="button"
            onClick={() => {
              setSearchQuery("");
              setAccountFilter("all");
              setStatusFilter("all");
            }}
            className="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
          >
            Clear Filters
          </button>
        </div>
      ) : (
        /* Populated Signatures Grid */
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-4">
          {filteredSignatures.map((sig) => (
            <SignatureCard
              key={sig.id}
              signature={sig}
              accountEmailOrName={accountMap.get(sig.email_account_id)}
              onEdit={handleOpenEdit}
              onSetDefault={(s) => setDefaultMutation.mutate(s.id)}
              onDuplicate={(s) => duplicateMutation.mutate(s)}
              onCopyToAllAccounts={
                accounts.length > 1 ? (s) => copyToAllAccountsMutation.mutate(s) : undefined
              }
              onPreview={(s) => setPreviewSignature(s)}
              onDelete={(s) => setDeletingSignature(s)}
              isUpdatingDefault={setDefaultMutation.isPending}
            />
          ))}
        </div>
      )}

      {/* Slide-over Drawer for Create / Edit */}
      <SignatureDrawer
        isOpen={isDrawerOpen}
        onClose={() => {
          setIsDrawerOpen(false);
          setEditingSignature(null);
        }}
        signature={editingSignature}
        accounts={accounts}
        onSave={handleSaveSignature}
        isSaving={createMutation.isPending || updateMutation.isPending}
      />

      {/* Preview Modal */}
      <SignaturePreviewModal
        isOpen={Boolean(previewSignature)}
        signature={previewSignature}
        accountEmailOrName={
          previewSignature ? accountMap.get(previewSignature.email_account_id) : undefined
        }
        onClose={() => setPreviewSignature(null)}
      />

      {/* Delete Confirmation Modal */}
      <DeleteSignatureModal
        isOpen={Boolean(deletingSignature)}
        signature={deletingSignature}
        onClose={() => setDeletingSignature(null)}
        onConfirm={() => {
          if (deletingSignature) {
            deleteMutation.mutate(deletingSignature.id);
          }
        }}
        isDeleting={deleteMutation.isPending}
      />
    </div>
  );
}
</file>

<file path="frontend/src/pages/TemplatesPage.tsx">
import { useState, useMemo, useEffect } from "react";
import { useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import { Plus, FileText, CheckCircle2 } from "lucide-react";
import { templatesApi, emailAccountsApi, RequestError } from "../services/api";
import { TemplateCard } from "../components/templates/TemplateCard";
import { TemplateFilters, type StatusFilter } from "../components/templates/TemplateFilters";
import { DeleteTemplateModal } from "../components/templates/DeleteTemplateModal";
import { LoadingState } from "../components/ui/LoadingState";
import { ErrorState } from "../components/ui/ErrorState";
import { useWorkspace } from "../hooks/useWorkspace";
import type { EmailTemplateItem } from "../types/emails";

function getTemplateErrorMessage(error: unknown): string {
  if (error instanceof RequestError) {
    switch (error.status) {
      case 401:
        return "Your session has expired. Please sign in again.";
      case 403:
        return "You do not have access to these templates.";
      case 404:
        return "Template service endpoint was not found.";
      case 422:
        return "Invalid parameters provided to the template service.";
      case 500:
      case 502:
      case 503:
        return "Template service is temporarily unavailable. Please try again later.";
      default:
        return error.message || "Unable to connect to the template server.";
    }
  }
  if (error instanceof Error) {
    return error.message;
  }
  return "Unable to connect to the server. Please check your connection and try again.";
}

export function TemplatesPage() {
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { currentCompanyId } = useWorkspace();

  // Filters
  const [searchQuery, setSearchQuery] = useState("");
  const [accountFilter, setAccountFilter] = useState("all");
  const [statusFilter, setStatusFilter] = useState<StatusFilter>("all");

  // Reset account filter when active company switches
  useEffect(() => {
    setAccountFilter("all");
  }, [currentCompanyId]);

  // Delete modal state
  const [templateToDelete, setTemplateToDelete] = useState<EmailTemplateItem | null>(null);
  const [isDeleteModalOpen, setIsDeleteModalOpen] = useState(false);

  // Toast feedback state
  const [toastMessage, setToastMessage] = useState<string | null>(null);

  const showToast = (msg: string) => {
    setToastMessage(msg);
    setTimeout(() => {
      setToastMessage(null);
    }, 3000);
  };

  // Fetch authorized accounts for filtering & badge display
  const { data: rawAccounts = [] } = useQuery({
    queryKey: ["authorizedEmailAccounts"],
    queryFn: () => emailAccountsApi.getAuthorizedAccounts(),
    staleTime: 60000,
  });

  const accounts = useMemo(() => {
    if (!currentCompanyId) return rawAccounts;
    return rawAccounts.filter((acc) => acc.company_id === currentCompanyId);
  }, [rawAccounts, currentCompanyId]);

  const accountMap = useMemo(() => {
    const map = new Map<number, string>();
    accounts.forEach((acc) => {
      map.set(acc.id, acc.name ? `${acc.name} (${acc.email_address})` : acc.email_address);
    });
    return map;
  }, [accounts]);

  // Fetch all accessible templates scoped to active company
  const {
    data: templates = [],
    isLoading,
    isError,
    error,
    refetch,
  } = useQuery({
    queryKey: ["templates", currentCompanyId],
    queryFn: () => templatesApi.listTemplates({ companyId: currentCompanyId ?? undefined }),
    staleTime: 30000,
  });

  // Toggle active status mutation
  const toggleActiveMutation = useMutation({
    mutationFn: (tpl: EmailTemplateItem) =>
      templatesApi.toggleTemplateActive(tpl.id, !tpl.is_active, currentCompanyId ?? undefined),
    onSuccess: (updated) => {
      queryClient.invalidateQueries({ queryKey: ["templates", currentCompanyId] });
      queryClient.invalidateQueries({ queryKey: ["templates"] });
      showToast(updated.is_active ? "Template activated" : "Template deactivated");
    },
    onError: (err: any) => {
      showToast(
        err?.response?.data?.detail || "Failed to update template status. Please try again."
      );
    },
  });

  // Delete template mutation
  const deleteMutation = useMutation({
    mutationFn: (id: number) => templatesApi.deleteTemplate(id, currentCompanyId ?? undefined),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["templates", currentCompanyId] });
      queryClient.invalidateQueries({ queryKey: ["templates"] });
      setIsDeleteModalOpen(false);
      const name = templateToDelete?.name || "Template";
      setTemplateToDelete(null);
      showToast(`Template "${name}" deleted successfully.`);
    },
    onError: (err: any) => {
      showToast(err?.response?.data?.detail || "Failed to delete template. Please try again.");
    },
  });

  // Compute status counts
  const { activeCount, inactiveCount } = useMemo(() => {
    let active = 0;
    let inactive = 0;
    templates.forEach((t) => {
      if (t.is_active) active++;
      else inactive++;
    });
    return { activeCount: active, inactiveCount: inactive };
  }, [templates]);

  // Filter templates based on search, account, and status
  const filteredTemplates = useMemo(() => {
    return templates.filter((t) => {
      // Status filter
      if (statusFilter === "active" && !t.is_active) return false;
      if (statusFilter === "inactive" && t.is_active) return false;

      // Account scope filter
      if (accountFilter === "global" && t.email_account_id !== null && t.email_account_id !== undefined) {
        return false;
      }
      if (
        accountFilter !== "all" &&
        accountFilter !== "global" &&
        String(t.email_account_id) !== accountFilter
      ) {
        return false;
      }

      // Search query filter
      if (searchQuery.trim()) {
        const query = searchQuery.toLowerCase().trim();
        const matchesName = t.name.toLowerCase().includes(query);
        const matchesSubject = (t.subject || "").toLowerCase().includes(query);
        const matchesBody = (t.body_text || "").toLowerCase().includes(query);
        if (!matchesName && !matchesSubject && !matchesBody) {
          return false;
        }
      }

      return true;
    });
  }, [templates, statusFilter, accountFilter, searchQuery]);

  const handleEdit = (tpl: EmailTemplateItem) => {
    navigate(`/templates/${tpl.id}/edit`);
  };

  const handleToggleActive = (tpl: EmailTemplateItem) => {
    toggleActiveMutation.mutate(tpl);
  };

  const handleDeleteRequest = (tpl: EmailTemplateItem) => {
    setTemplateToDelete(tpl);
    setIsDeleteModalOpen(true);
  };

  const handleConfirmDelete = () => {
    if (templateToDelete) {
      deleteMutation.mutate(templateToDelete.id);
    }
  };

  return (
    <div className="space-y-6 max-w-[1600px] w-full mx-auto">
      {/* Toast Notification */}
      {toastMessage && (
        <div className="fixed bottom-5 right-5 z-50 flex items-center gap-2 bg-slate-900 text-white px-4 py-2.5 rounded-xl shadow-xl transition-all duration-300 text-sm font-medium animate-in fade-in slide-in-from-bottom-5">
          <CheckCircle2 className="h-4 w-4 text-emerald-400 shrink-0" />
          <span>{toastMessage}</span>
        </div>
      )}

      {/* Top Directory Header Bar */}
      <div className="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <h1 className="text-2xl font-bold text-slate-900 tracking-tight">Templates</h1>
          <p className="text-sm text-slate-500 mt-0.5">
            Reusable email templates for faster, consistent communication.
          </p>
        </div>

        <div className="flex items-center gap-2.5 self-start md:self-auto">
          <button
            type="button"
            onClick={() => navigate("/templates/new")}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
          >
            <Plus className="h-4 w-4" />
            <span>New Template</span>
          </button>
        </div>
      </div>

      {/* Filter & Search Toolbar */}
      <TemplateFilters
        searchQuery={searchQuery}
        onSearchChange={setSearchQuery}
        accountFilter={accountFilter}
        onAccountFilterChange={setAccountFilter}
        statusFilter={statusFilter}
        onStatusFilterChange={setStatusFilter}
        accounts={accounts}
        activeCount={activeCount}
        inactiveCount={inactiveCount}
      />

      {/* Active Grid Count / Meta */}
      <div className="flex items-center justify-between text-xs text-slate-500 px-1">
        <div className="flex items-center gap-1.5 font-medium">
          <span>Displaying</span>
          <span className="font-bold text-slate-800">{filteredTemplates.length}</span>
          <span>{filteredTemplates.length === 1 ? "template" : "templates"}</span>
        </div>
      </div>

      {/* Content Area: Loading / Error / Empty / Grid */}
      {isLoading ? (
        <div className="py-12">
          <LoadingState message="Loading templates..." />
        </div>
      ) : isError ? (
        <div className="py-8">
          <ErrorState
            title="Failed to Load Templates"
            message={getTemplateErrorMessage(error)}
            onRetry={() => refetch()}
          />
        </div>
      ) : templates.length === 0 ? (
        /* Empty State: Zero total templates */
        <div className="bg-white border border-slate-200 rounded-xl py-16 px-6 text-center shadow-xs">
          <div className="w-12 h-12 bg-indigo-50 text-indigo-600 rounded-full flex items-center justify-center mx-auto mb-3">
            <FileText className="h-6 w-6" />
          </div>
          <h3 className="font-semibold text-slate-900 text-base">No templates yet</h3>
          <p className="text-xs text-slate-500 max-w-sm mx-auto mt-1 mb-5">
            Create reusable email templates to streamline outgoing customer responses and maintain
            brand voice across all accounts.
          </p>
          <button
            type="button"
            onClick={() => navigate("/templates/new")}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition-all"
          >
            <Plus className="h-4 w-4" />
            <span>Create Template</span>
          </button>
        </div>
      ) : filteredTemplates.length === 0 ? (
        /* Filter Empty State: Filters yielded zero matches */
        <div className="bg-white border border-slate-200 rounded-xl py-12 px-6 text-center shadow-xs">
          <p className="text-sm font-medium text-slate-700">No templates match your filters</p>
          <p className="text-xs text-slate-400 mt-1 mb-4">
            Try adjusting your search terms, account scope, or status filter.
          </p>
          <button
            type="button"
            onClick={() => {
              setSearchQuery("");
              setAccountFilter("all");
              setStatusFilter("all");
            }}
            className="px-3 py-1.5 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
          >
            Clear Filters
          </button>
        </div>
      ) : (
        /* Populated Templates Grid */
        <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {filteredTemplates.map((tpl) => (
            <TemplateCard
              key={tpl.id}
              template={tpl}
              accountEmailOrName={
                tpl.email_account_id ? accountMap.get(tpl.email_account_id) : undefined
              }
              onEdit={handleEdit}
              onToggleActive={handleToggleActive}
              onDelete={handleDeleteRequest}
              isTogglingActive={toggleActiveMutation.isPending}
            />
          ))}
        </div>
      )}

      {/* Delete Confirmation Modal */}
      <DeleteTemplateModal
        isOpen={isDeleteModalOpen}
        template={templateToDelete}
        onClose={() => {
          setIsDeleteModalOpen(false);
          setTemplateToDelete(null);
        }}
        onConfirm={handleConfirmDelete}
        isDeleting={deleteMutation.isPending}
      />
    </div>
  );
}
</file>

