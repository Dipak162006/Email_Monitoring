  const isAdminOrOwner =
    currentRole !== "MEMBER" &&
    (currentRole === "OWNER" ||
      currentRole === "ADMIN" ||
      Boolean(permissionsIsAdminOrOwner));

  // Filters & Search
  const [searchQuery, setSearchQuery] = useState("");
  const [reasonFilter, setReasonFilter] = useState<string>("ALL");
  const [copiedEmail, setCopiedEmail] = useState<string | null>(null);

  // Modals state
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [deleteModalState, setDeleteModalState] = useState<{
    isOpen: boolean;
    entry: SuppressionEntry | null;
  }>({
    isOpen: false,
    entry: null,
  });

  // Query: load company suppression list
  const {
    data: suppressions = [],
    isLoading,
    isError,
    error,
    refetch,
    isFetching,
  } = useQuery<SuppressionEntry[], Error>({
    queryKey: [
      "suppressions",
      currentCompanyId,
      reasonFilter !== "ALL" ? reasonFilter : undefined,
      searchQuery.trim() || undefined,
    ],
    queryFn: () => {
      if (!currentCompanyId) return Promise.resolve([]);
      return suppressionsApi.listSuppressions(currentCompanyId, {
        reason: reasonFilter !== "ALL" ? reasonFilter : undefined,
        search: searchQuery.trim() || undefined,
        limit: 100,
        offset: 0,
      });
    },
    enabled: Boolean(currentCompanyId),
  });

  // Filter in memory as additional safety / responsive filtering
  const filteredSuppressions = useMemo(() => {
    return suppressions.filter((entry) => {
      if (reasonFilter !== "ALL" && entry.reason !== reasonFilter) {
        return false;
      }
      if (searchQuery.trim().length > 0) {
        const q = searchQuery.toLowerCase();
        if (!entry.email.toLowerCase().includes(q)) {
          return false;
        }
      }
      return true;
    });
  }, [suppressions, reasonFilter, searchQuery]);

  const handleCopyEmail = (email: string) => {
    navigator.clipboard?.writeText(email);
    setCopiedEmail(email);
    setTimeout(() => {
      setCopiedEmail(null);
    }, 2000);
  };

  const handleAddSuccess = (msg: string) => {
    queryClient.invalidateQueries({ queryKey: ["suppressions", currentCompanyId] });
    onShowToast?.(msg, "success");
  };

  const handleDeleteSuccess = (email: string) => {
    queryClient.invalidateQueries({ queryKey: ["suppressions", currentCompanyId] });
    onShowToast?.(`Successfully unsuppressed ${email}.`, "success");
  };

  const formatDate = (isoString: string) => {
    try {
      return new Date(isoString).toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    } catch {
      return isoString;
    }
  };

  const hasActiveFilters = searchQuery.trim().length > 0 || reasonFilter !== "ALL";

  return (
    <div className="flex flex-col gap-5 w-full min-w-0">
      {/* Information Banner */}
      <div className="bg-indigo-50/60 border border-indigo-100 rounded-xl p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs text-indigo-900">
        <div className="flex items-start sm:items-center gap-3">
          <div className="w-8 h-8 rounded-lg bg-indigo-100/80 text-indigo-700 flex items-center justify-center shrink-0">
            <ShieldCheck className="h-4 w-4" />
          </div>
          <div>
            <span className="font-semibold block text-slate-900">
              Workspace Suppression Protection
            </span>
            <span className="text-slate-600">
              Addresses on this list are permanently blocked from campaign outreach across this
              workspace to safeguard your sender reputation.
            </span>
          </div>
        </div>
        <div className="text-slate-500 font-medium shrink-0 self-end sm:self-auto">
          {filteredSuppressions.length} suppressed address
          {filteredSuppressions.length === 1 ? "" : "es"}
        </div>
      </div>

      {/* Toolbar: Search, Reason Filter, Actions */}
      <div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-white p-3.5 rounded-xl border border-slate-200/80 shadow-2xs">
        <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 flex-1 min-w-0">
          {/* Search Box */}
          <div className="relative flex-1 min-w-[200px] max-w-md">
            <Search className="absolute left-3 top-1/2 -translate-y-1/2 h-4 w-4 text-slate-400 pointer-events-none" />
            <input
              type="text"
              aria-label="Search suppressed email"
              value={searchQuery}
              onChange={(e) => setSearchQuery(e.target.value)}
              placeholder="Search suppressed email..."
              className="w-full pl-9 pr-3 py-1.5 text-xs rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition bg-slate-50/50 focus:bg-white"
            />
            {searchQuery && (
              <button
                type="button"
                onClick={() => setSearchQuery("")}
                className="absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 text-xs"
                title="Clear search"
              >
                ✕
              </button>
            )}
          </div>

          {/* Reason Filter Dropdown */}
          <div className="flex items-center gap-2">
            <Filter className="h-3.5 w-3.5 text-slate-400 shrink-0 hidden sm:block" />
            <select
              aria-label="Filter by suppression reason"
              value={reasonFilter}
              onChange={(e) => setReasonFilter(e.target.value)}
              className="text-xs py-1.5 px-3 rounded-lg border border-slate-300 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent bg-white text-slate-700 font-medium shadow-2xs cursor-pointer"
            >
              <option value="ALL">All Reasons</option>
              <option value="BOUNCE">Bounced</option>
              <option value="UNSUBSCRIBE">Unsubscribed</option>
              <option value="MANUAL">Manual</option>
              <option value="COMPLAINT">Complaint</option>
            </select>
          </div>
        </div>

        {/* Action Buttons */}
        <div className="flex items-center gap-2 shrink-0">
          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={() => refetch()}
            disabled={isFetching}
            className="h-8 px-2.5 text-xs text-slate-600 hover:text-slate-900"
            title="Refresh suppression list"
          >
            <RefreshCw className={`h-3.5 w-3.5 ${isFetching ? "animate-spin" : ""}`} />
            <span className="hidden sm:inline">Refresh</span>
          </Button>

          {isAdminOrOwner && (
            <Button
              type="button"
              variant="primary"
              size="sm"
              onClick={() => setIsAddModalOpen(true)}
              className="h-8 px-3 text-xs flex items-center gap-1.5 shadow-sm"
            >
              <Plus className="h-3.5 w-3.5" />
              <span>Add Suppressed Email</span>
            </Button>
          )}
        </div>
      </div>

      {/* Main Content: Table / Skeletons / Empty States */}
      {isLoading ? (
        <div className="bg-white rounded-xl border border-slate-200/80 p-8 flex flex-col items-center justify-center gap-3">
          <RefreshCw className="h-6 w-6 text-indigo-500 animate-spin" />
          <p className="text-xs text-slate-500 font-medium">Loading suppression records...</p>
        </div>
      ) : isError ? (
        <div className="bg-white rounded-xl border border-rose-200 p-8 flex flex-col items-center justify-center text-center gap-3">
          <div className="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center">
            <AlertCircle className="h-5 w-5" />
          </div>
          <div>
            <h4 className="text-sm font-bold text-slate-900">Failed to load suppression list</h4>
            <p className="text-xs text-slate-500 mt-1 max-w-md">
              {error?.message || "An unexpected error occurred while communicating with the server."}
            </p>
          </div>
          <Button type="button" variant="outline" size="sm" onClick={() => refetch()}>
            Retry
          </Button>
        </div>
      ) : suppressions.length === 0 && !hasActiveFilters ? (
        // Empty State: No suppressions at all
        <div className="bg-white rounded-xl border border-slate-200/80 p-12 flex flex-col items-center justify-center text-center">
          <div className="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center mb-3">
            <Inbox className="h-6 w-6" />
          </div>
          <h4 className="text-sm font-bold text-slate-900">No suppressed email addresses</h4>
          <p className="text-xs text-slate-500 mt-1 max-w-md leading-relaxed">
            Hard bounces and unsubscribed recipients are automatically added here. You can also
            manually add addresses to safeguard your domain reputation.
          </p>
          {isAdminOrOwner && (
            <div className="mt-4">
              <Button
                type="button"
                variant="primary"
                size="sm"
                onClick={() => setIsAddModalOpen(true)}
                className="flex items-center gap-1.5"
              >
                <Plus className="h-3.5 w-3.5" />
                <span>Add Suppressed Email</span>
              </Button>
            </div>
          )}
        </div>
      ) : filteredSuppressions.length === 0 ? (
        // Search / Filter Empty State
        <div className="bg-white rounded-xl border border-slate-200/80 p-10 flex flex-col items-center justify-center text-center">
          <div className="w-10 h-10 rounded-xl bg-slate-100 text-slate-500 flex items-center justify-center mb-3">
            <Search className="h-5 w-5" />
          </div>
          <h4 className="text-sm font-bold text-slate-900">No matching suppression records</h4>
          <p className="text-xs text-slate-500 mt-1 max-w-sm">
            No suppressed addresses found matching your active filter criteria.
          </p>
          <div className="mt-4">
            <Button
              type="button"
              variant="outline"
              size="sm"
              onClick={() => {
                setSearchQuery("");
                setReasonFilter("ALL");
              }}
            >
              Clear Filters
            </Button>
          </div>
        </div>
      ) : (
        <div className="w-full min-w-0 flex flex-col rounded-xl border border-slate-200/80 bg-white shadow-2xs overflow-hidden">
          {/* Desktop Table View */}
          <div className="hidden sm:block overflow-x-auto">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="border-b border-slate-200/80 bg-slate-50/75 text-[11px] font-semibold text-slate-500 uppercase tracking-wider">
                  <th className="py-3 px-4">Email Address</th>
                  <th className="py-3 px-4">Reason</th>
                  <th className="py-3 px-4">Date Suppressed</th>
                  {isAdminOrOwner && (
                    <th className="py-3 px-4 text-right">Actions</th>
                  )}
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 text-xs">
                {filteredSuppressions.map((entry) => (
                  <tr
                    key={entry.id}
                    data-testid={`suppression-row-${entry.id}`}
                    className="hover:bg-slate-50/50 transition-colors group"
                  >
                    {/* Email Column */}
                    <td className="py-3 px-4">
                      <div className="flex items-center gap-2">
                        <span className="font-mono font-medium text-slate-900 select-all">
                          {entry.email}
                        </span>
                        <button
                          type="button"
                          onClick={() => handleCopyEmail(entry.email)}
                          className="opacity-0 group-hover:opacity-100 text-slate-400 hover:text-slate-600 transition-opacity p-0.5 rounded"
                          title="Copy email address"
                        >
                          {copiedEmail === entry.email ? (
                            <Check className="h-3.5 w-3.5 text-emerald-600" />
                          ) : (
                            <Copy className="h-3.5 w-3.5" />
                          )}
                        </button>
                      </div>
                    </td>

                    {/* Reason Column */}
                    <td className="py-3 px-4">
                      <SuppressionReasonBadge reason={entry.reason} />
                    </td>

                    {/* Date Column */}
                    <td className="py-3 px-4 text-slate-500 whitespace-nowrap">
                      {formatDate(entry.created_at)}
                    </td>

                    {/* Actions Column */}
                    {isAdminOrOwner && (
                      <td className="py-3 px-4 text-right">
                        <Button
                          type="button"
                          variant="ghost"
                          size="sm"
                          onClick={() =>
                            setDeleteModalState({
                              isOpen: true,
                              entry,
                            })
                          }
                          aria-label={`Unsuppress ${entry.email}`}
                          className="h-7 px-2 text-rose-600 hover:text-rose-700 hover:bg-rose-50 text-xs gap-1 font-medium"
                          title="Remove from suppression list"
                        >
                          <Trash2 className="h-3.5 w-3.5" />
                          <span>Unsuppress</span>
                        </Button>
                      </td>
                    )}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>

          {/* Mobile Cards View */}
          <div className="sm:hidden divide-y divide-slate-100">
            {filteredSuppressions.map((entry) => (
              <div
                key={entry.id}
                data-testid={`suppression-card-${entry.id}`}
                className="p-4 flex flex-col gap-2.5"
              >
                <div className="flex items-start justify-between gap-2">
                  <span className="font-mono font-semibold text-xs text-slate-900 break-all">
                    {entry.email}
                  </span>
                  <SuppressionReasonBadge reason={entry.reason} />
                </div>
                <div className="flex items-center justify-between text-[11px] text-slate-500 pt-1">
                  <span>Suppressed {formatDate(entry.created_at)}</span>
                  {isAdminOrOwner && (
                    <Button
                      type="button"
                      variant="ghost"
                      size="sm"
                      onClick={() =>
                        setDeleteModalState({
                          isOpen: true,
                          entry,
                        })
                      }
                      className="h-7 px-2 text-rose-600 hover:text-rose-700 hover:bg-rose-50 text-xs"
                    >
                      <Trash2 className="h-3.5 w-3.5" />
                      <span>Unsuppress</span>
                    </Button>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Add Modal */}
      {currentCompanyId && (
        <AddSuppressionModal
          isOpen={isAddModalOpen}
          companyId={currentCompanyId}
          onClose={() => setIsAddModalOpen(false)}
          onSuccess={handleAddSuccess}
        />
      )}

      {/* Delete / Unsuppress Modal */}
      {currentCompanyId && (
        <DeleteSuppressionModal
          isOpen={deleteModalState.isOpen}
          entry={deleteModalState.entry}
          companyId={currentCompanyId}
          onClose={() => setDeleteModalState({ isOpen: false, entry: null })}
          onSuccess={handleDeleteSuccess}
        />
      )}
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/suppressions/SuppressionReasonBadge.tsx">
import React from "react";
import { AlertCircle, Ban, ShieldAlert, UserX } from "lucide-react";
import type { SuppressionReason } from "../../../types/campaign";

interface SuppressionReasonBadgeProps {
  reason: SuppressionReason | string;
  className?: string;
}

export const SuppressionReasonBadge: React.FC<SuppressionReasonBadgeProps> = ({
  reason,
  className = "",
}) => {
  const normalized = (reason || "").toUpperCase();

  switch (normalized) {
    case "BOUNCE":
      return (
        <span
          data-testid="suppression-reason-bounce"
          className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-50 text-rose-700 border border-rose-200 shadow-2xs ${className}`}
        >
          <AlertCircle className="w-3 h-3 text-rose-500" />
          <span>Bounced</span>
        </span>
      );
    case "UNSUBSCRIBE":
      return (
        <span
          data-testid="suppression-reason-unsubscribe"
          className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-amber-50 text-amber-700 border border-amber-200 shadow-2xs ${className}`}
        >
          <UserX className="w-3 h-3 text-amber-500" />
          <span>Unsubscribed</span>
        </span>
      );
    case "COMPLAINT":
      return (
        <span
          data-testid="suppression-reason-complaint"
          className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-200 shadow-2xs ${className}`}
        >
          <ShieldAlert className="w-3 h-3 text-purple-500" />
          <span>Complaint</span>
        </span>
      );
    case "MANUAL":
    default:
      return (
        <span
          data-testid="suppression-reason-manual"
          className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 shadow-2xs ${className}`}
        >
          <Ban className="w-3 h-3 text-slate-500" />
          <span>Manual</span>
        </span>
      );
  }
};
</file>

<file path="frontend/src/components/campaigns/CampaignActionsMenu.tsx">
import React, { useEffect, useLayoutEffect, useRef, useState, useCallback } from "react";
import { createPortal } from "react-dom";
import {
  MoreHorizontal,
  Eye,
  Edit,
  Pause,
  Play,
  XCircle,
  Trash2,
  Send,
  Loader2,
  Users,
} from "lucide-react";
import type { Campaign } from "../../types/campaign";

interface CampaignActionsMenuProps {
  campaign: Campaign;
  isOpen: boolean;
  onToggle: (e: React.MouseEvent) => void;
  onClose: () => void;
  onView: (campaign: Campaign) => void;
  onEdit?: (campaign: Campaign) => void;
  onManageRecipients?: (campaign: Campaign) => void;
  onSendNow?: (campaign: Campaign) => void;
  onPause?: (campaign: Campaign) => void;
  onResume?: (campaign: Campaign) => void;
  onCancel?: (campaign: Campaign) => void;
  onDelete?: (campaign: Campaign) => void;
  isMutating?: boolean;
}

export const CampaignActionsMenu: React.FC<CampaignActionsMenuProps> = ({
  campaign,
  isOpen,
  onToggle,
  onClose,
  onView,
  onEdit,
  onManageRecipients,
  onSendNow,
  onPause,
  onResume,
  onCancel,
  onDelete,
  isMutating = false,
}) => {
  const menuRef = useRef<HTMLDivElement>(null);
  const buttonRef = useRef<HTMLButtonElement>(null);

  const [coords, setCoords] = useState<{
    top?: number;
    bottom?: number;
    left: number;
    width: number;
  } | null>(null);

  const updatePosition = useCallback(() => {
    if (!buttonRef.current || !buttonRef.current.isConnected) {
      return;
    }
    const rect = buttonRef.current.getBoundingClientRect();
    const menuWidth = 192;
    const estimatedHeight = 220;

    const viewportWidth = window.innerWidth || 1024;
    const viewportHeight = window.innerHeight || 768;

    // Viewport boundary clamping for horizontal alignment
    let left = rect.right - menuWidth;
    if (left < 8) {
      left = Math.max(8, rect.left);
    }
    if (left + menuWidth > viewportWidth - 8) {
      left = Math.max(8, viewportWidth - menuWidth - 8);
    }

    // Check vertical space: flip upward if near viewport bottom
    const spaceBelow = viewportHeight - rect.bottom;
    const shouldFlipUp = spaceBelow < estimatedHeight && rect.top > estimatedHeight;

    if (shouldFlipUp) {
      setCoords({
        bottom: viewportHeight - rect.top + 4,
        left,
        width: menuWidth,
      });
    } else {
      setCoords({
        top: rect.bottom + 4,
        left,
        width: menuWidth,
      });
    }
  }, []);

  // Compute position immediately when opening, or reset when closed
  useLayoutEffect(() => {
    if (!isOpen) {
      setCoords(null);
      return;
    }

    if (!buttonRef.current || !buttonRef.current.isConnected) {
      onClose();
      return;
    }

    updatePosition();
  }, [isOpen, onClose, updatePosition]);

  // Close on Escape, click outside, or update position on scroll/resize
  useEffect(() => {
    if (!isOpen) return;

    // Close menu if trigger button was removed from the DOM
    if (!buttonRef.current || !buttonRef.current.isConnected) {
      onClose();
      return;
    }

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        onClose();
        buttonRef.current?.focus();
      }
    };

    const handleClickOutside = (e: MouseEvent) => {
      const target = e.target as Node;
      if (
        menuRef.current &&
        !menuRef.current.contains(target) &&
        buttonRef.current &&
        !buttonRef.current.contains(target)
      ) {
        onClose();
      }
    };

    const handleScrollOrResize = () => {
      updatePosition();
    };

    document.addEventListener("keydown", handleKeyDown);
    document.addEventListener("mousedown", handleClickOutside);
    window.addEventListener("resize", handleScrollOrResize);
    window.addEventListener("scroll", handleScrollOrResize, true);

    return () => {
      document.removeEventListener("keydown", handleKeyDown);
      document.removeEventListener("mousedown", handleClickOutside);
      window.removeEventListener("resize", handleScrollOrResize);
      window.removeEventListener("scroll", handleScrollOrResize, true);
    };
  }, [isOpen, onClose, updatePosition]);

  const status = (campaign.status || "").toUpperCase();

  return (
    <div className="inline-block text-left" onClick={(e) => e.stopPropagation()}>
      <button
        ref={buttonRef}
        type="button"
        onClick={onToggle}
        disabled={isMutating}
        aria-haspopup="menu"
        aria-expanded={isOpen}
        aria-label={`Actions for campaign ${campaign.name}`}
        className="p-1.5 rounded-lg text-slate-400 hover:text-slate-700 hover:bg-slate-100/80 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 transition-colors disabled:opacity-50"
      >
        {isMutating ? (
          <Loader2 className="h-4 w-4 animate-spin text-slate-500" />
        ) : (
          <MoreHorizontal className="h-4 w-4" />
        )}
      </button>

      {isOpen &&
        coords &&
        typeof document !== "undefined" &&
        createPortal(
          <div
            ref={menuRef}
            role="menu"
            aria-orientation="vertical"
            style={{
              position: "fixed",
              top: coords.top !== undefined ? `${coords.top}px` : undefined,
              bottom: coords.bottom !== undefined ? `${coords.bottom}px` : undefined,
              left: `${coords.left}px`,
              width: `${coords.width}px`,
              zIndex: 9999,
            }}
            className="rounded-xl bg-white shadow-xl border border-slate-200/90 p-1.5 text-left animate-in fade-in zoom-in-95 duration-100 focus:outline-none"
            onClick={(e) => e.stopPropagation()}
          >
            {/* Header indicator */}
            <div className="px-2 py-1 text-slate-400 text-[10px] uppercase font-bold tracking-wider">
              {status} Actions
            </div>

            {/* View Details - available for all states */}
            <button
              type="button"
              role="menuitem"
              onClick={(e) => {
                e.stopPropagation();
                onView(campaign);
                onClose();
              }}
              className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-xs text-slate-700 transition-colors"
            >
              <Eye className="h-3.5 w-3.5 text-slate-500" />
              <span>View Details</span>
            </button>

            {/* Manage Recipients */}
            {onManageRecipients && (
              <button
                type="button"
                role="menuitem"
                onClick={(e) => {
                  e.stopPropagation();
                  onManageRecipients(campaign);
                  onClose();
                }}
                className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-xs text-slate-700 transition-colors"
              >
                <Users className="h-3.5 w-3.5 text-slate-500" />
                <span>Manage Recipients</span>
              </button>
            )}

            {/* DRAFT specific */}
            {status === "DRAFT" && onEdit && (
              <button
                type="button"
                role="menuitem"
                onClick={(e) => {
                  e.stopPropagation();
                  onEdit(campaign);
                  onClose();
                }}
                className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-xs text-slate-700 transition-colors"
              >
                <Edit className="h-3.5 w-3.5 text-slate-500" />
                <span>Edit Draft</span>
              </button>
            )}

            {/* SCHEDULED specific */}
            {status === "SCHEDULED" && onSendNow && (
              <button
                type="button"
                role="menuitem"
                onClick={(e) => {
                  e.stopPropagation();
                  onSendNow(campaign);
                  onClose();
                }}
                className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-slate-100 text-xs text-indigo-600 font-medium transition-colors"
              >
                <Send className="h-3.5 w-3.5 text-indigo-500" />
                <span>Send Now</span>
              </button>
            )}

            {/* RUNNING specific */}
            {status === "RUNNING" && onPause && (
              <button
                type="button"
                role="menuitem"
                onClick={(e) => {
                  e.stopPropagation();
                  onPause(campaign);
                  onClose();
                }}
                className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-amber-50 text-xs text-amber-700 font-medium transition-colors"
              >
                <Pause className="h-3.5 w-3.5 text-amber-600" />
                <span>Pause Campaign</span>
              </button>
            )}

            {/* PAUSED specific */}
            {status === "PAUSED" && onResume && (
              <button
                type="button"
                role="menuitem"
                onClick={(e) => {
                  e.stopPropagation();
                  onResume(campaign);
                  onClose();
                }}
                className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-emerald-50 text-xs text-emerald-700 font-medium transition-colors"
              >
                <Play className="h-3.5 w-3.5 text-emerald-600" />
                <span>Resume Campaign</span>
              </button>
            )}

            {/* Cancel Campaign - available for SCHEDULED, QUEUED, RUNNING, PAUSED */}
            {(status === "SCHEDULED" ||
              status === "QUEUED" ||
              status === "RUNNING" ||
              status === "PAUSED") &&
              onCancel && (
                <>
                  <div className="h-px bg-slate-100 my-1" />
                  <button
                    type="button"
                    role="menuitem"
                    onClick={(e) => {
                      e.stopPropagation();
                      onCancel(campaign);
                      onClose();
                    }}
                    className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-rose-50 text-xs text-rose-600 transition-colors"
                  >
                    <XCircle className="h-3.5 w-3.5 text-rose-500" />
                    <span>Cancel Campaign</span>
                  </button>
                </>
              )}

            {/* Delete Draft / Finished Campaign - available for DRAFT, COMPLETED, CANCELLED, FAILED */}
            {(status === "DRAFT" ||
              status === "COMPLETED" ||
              status === "CANCELLED" ||
              status === "FAILED") &&
              onDelete && (
                <>
                  <div className="h-px bg-slate-100 my-1" />
                  <button
                    type="button"
                    role="menuitem"
                    onClick={(e) => {
                      e.stopPropagation();
                      onDelete(campaign);
                      onClose();
                    }}
                    className="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-lg hover:bg-rose-50 text-xs text-rose-600 transition-colors"
                  >
                    <Trash2 className="h-3.5 w-3.5 text-rose-500" />
                    <span>{status === "DRAFT" ? "Delete Draft" : "Delete Campaign"}</span>
                  </button>
                </>
              )}
          </div>,
          document.body
        )}
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/CampaignDetailsStep.tsx">
import React, { useState, useEffect } from "react";
import { Info, AlertCircle, Plus, Clock, Gauge } from "lucide-react";

interface CampaignDetailsStepProps {
  name: string;
  onNameChange: (val: string) => void;
  subject: string;
  onSubjectChange: (val: string) => void;
  sendIntervalSeconds?: number;
  onSendIntervalSecondsChange?: (val: number) => void;
  nameError?: string | null;
  subjectError?: string | null;
  nameInputRef?: React.RefObject<HTMLInputElement>;
  subjectInputRef?: React.RefObject<HTMLInputElement>;
}

export const CampaignDetailsStep: React.FC<CampaignDetailsStepProps> = ({
  name,
  onNameChange,
  subject,
  onSubjectChange,
  sendIntervalSeconds = 0,
  onSendIntervalSecondsChange,
  nameError,
  subjectError,
  nameInputRef,
  subjectInputRef,
}) => {
  // Pacing mode: 'none' (immediate/0s) or 'custom' (> 0s)
  const isCustomPacing = sendIntervalSeconds > 0;
  
  // Default helper calculation for unit and value
  const initialUnit =
    sendIntervalSeconds > 0
      ? sendIntervalSeconds % 60 === 0
        ? "minutes"
        : "seconds"
      : "minutes";
  const initialValue =
    sendIntervalSeconds > 0
      ? initialUnit === "minutes"
        ? Math.floor(sendIntervalSeconds / 60)
        : sendIntervalSeconds
      : 5;

  const [intervalUnit, setIntervalUnit] = useState<"seconds" | "minutes">(initialUnit);
  const [intervalNum, setIntervalNum] = useState<number>(initialValue);

  // Sync internal state when parent props change (e.g. draft edit pre-population)
  useEffect(() => {
    if (sendIntervalSeconds > 0) {
      if (sendIntervalSeconds % 60 === 0) {
        setIntervalUnit("minutes");
        setIntervalNum(Math.floor(sendIntervalSeconds / 60));
      } else {
        setIntervalUnit("seconds");
        setIntervalNum(sendIntervalSeconds);
      }
    }
  }, [sendIntervalSeconds]);

  const handleInsertFirstName = () => {
    const trimmed = subject.trimEnd();
    const newSubject = trimmed ? `${trimmed} {{first_name}}` : "{{first_name}}";
    onSubjectChange(newSubject);
    subjectInputRef?.current?.focus();
  };

  const handleNameInputChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const val = e.target.value;
    if (val.length <= 80) {
      onNameChange(val);
    }
  };

  const handlePacingModeChange = (mode: "none" | "custom") => {
    if (!onSendIntervalSecondsChange) return;
    if (mode === "none") {
      onSendIntervalSecondsChange(0);
    } else {
      const safeNum = Math.max(1, intervalNum || 1);
      const computedSec = intervalUnit === "minutes" ? safeNum * 60 : safeNum;
      onSendIntervalSecondsChange(Math.min(86400, computedSec));
    }
  };

  const handleIntervalNumChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const rawVal = e.target.value;
    const num = parseInt(rawVal, 10);
    if (isNaN(num)) {
      setIntervalNum(0);
      return;
    }
    const maxVal = intervalUnit === "minutes" ? 1440 : 86400;
    const clamped = Math.max(1, Math.min(maxVal, num));
    setIntervalNum(clamped);

    if (onSendIntervalSecondsChange) {
      const totalSec = intervalUnit === "minutes" ? clamped * 60 : clamped;
      onSendIntervalSecondsChange(Math.min(86400, totalSec));
    }
  };

  const handleUnitChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    const newUnit = e.target.value as "seconds" | "minutes";
    setIntervalUnit(newUnit);

    let newNum = intervalNum;
    if (newUnit === "minutes" && intervalUnit === "seconds") {
      newNum = Math.max(1, Math.round(intervalNum / 60));
    } else if (newUnit === "seconds" && intervalUnit === "minutes") {
      newNum = Math.min(86400, intervalNum * 60);
    }
    setIntervalNum(newNum);

    if (onSendIntervalSecondsChange) {
      const totalSec = newUnit === "minutes" ? newNum * 60 : newNum;
      onSendIntervalSecondsChange(Math.min(86400, totalSec));
    }
  };

  return (
    <section className="space-y-6">
      <div className="bg-white rounded-xl border border-slate-200 shadow-2xs p-6 sm:p-8 space-y-6">
        {/* Step Header */}
        <div className="space-y-1">
          <h2 className="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
            Campaign Details
          </h2>
          <p className="text-xs sm:text-sm text-slate-500">
            Configure identity, labeling, and default messaging headline.
          </p>
        </div>

        {/* Informational Callout: Draft State */}
        <div className="p-4 rounded-lg bg-indigo-50/60 border border-indigo-100 flex items-start gap-3">
          <Info className="h-5 w-5 text-indigo-600 shrink-0 mt-0.5" />
          <div className="min-w-0">
            <p className="text-xs sm:text-sm font-semibold text-slate-900 leading-snug">
              Campaign draft state
            </p>
            <p className="text-xs text-slate-600 mt-0.5 leading-relaxed">
              Your campaign will remain a draft until you complete the setup and launch it.
            </p>
          </div>
        </div>

        {/* Form Fields */}
        <div className="space-y-6">
          {/* Campaign Name Field */}
          <div className="space-y-1.5">
            <div className="flex items-center justify-between">
              <label
                htmlFor="campaign-name"
                className="text-xs sm:text-sm font-semibold text-slate-900"
              >
                Campaign Name <span className="text-red-500">*</span>
              </label>
              <span className="text-[11px] text-slate-400 font-normal">
                {name.length}/80 chars
              </span>
            </div>
            <div className="relative">
              <input
                id="campaign-name"
                ref={nameInputRef}
                type="text"
                value={name}
                maxLength={80}
                onChange={handleNameInputChange}
                placeholder="e.g. Product Launch — October"
                aria-required="true"
                aria-invalid={Boolean(nameError)}
                aria-describedby={
                  nameError ? "campaign-name-err" : "campaign-name-help"
                }
                className={`w-full px-3.5 py-2.5 rounded-lg text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 border transition-all focus:outline-none focus:ring-2 ${
                  nameError
                    ? "border-red-300 bg-red-50/20 text-red-900 focus:ring-red-500/20 focus:border-red-600"
                    : "border-slate-200 bg-white focus:ring-indigo-500/20 focus:border-indigo-600 shadow-2xs"
                }`}
              />
              {nameError && (
                <div className="absolute right-3 top-2.5 text-red-500 pointer-events-none">
                  <AlertCircle className="h-5 w-5" />
                </div>
              )}
            </div>
            {nameError ? (
              <p
                id="campaign-name-err"
                role="alert"
                className="text-xs text-red-600 flex items-center gap-1 font-medium mt-1"
              >
                <AlertCircle className="h-3.5 w-3.5" />
                <span>{nameError}</span>
              </p>
            ) : (
              <p
                id="campaign-name-help"
                className="text-xs text-slate-500 mt-1"
              >
                Internal name used to identify this campaign.
              </p>
            )}
          </div>

          {/* Subject Field */}
          <div className="space-y-1.5">
            <div className="flex items-center justify-between">
              <label
                htmlFor="campaign-subject"
                className="text-xs sm:text-sm font-semibold text-slate-900"
              >
                Subject <span className="text-red-500">*</span>
              </label>
              <button
                type="button"
                onClick={handleInsertFirstName}
                className="text-xs font-semibold text-indigo-600 hover:text-indigo-700 flex items-center gap-1 transition-colors focus:outline-none focus:underline"
              >
                <Plus className="h-3.5 w-3.5" />
                <span>Insert {"{{first_name}}"}</span>
              </button>
            </div>
            <div className="relative">
              <input
                id="campaign-subject"
                ref={subjectInputRef}
                type="text"
                value={subject}
                onChange={(e) => onSubjectChange(e.target.value)}
                placeholder="e.g. Introducing our new product line"
                aria-required="true"
                aria-invalid={Boolean(subjectError)}
                aria-describedby={
                  subjectError ? "campaign-subject-err" : "campaign-subject-help"
                }
                className={`w-full px-3.5 py-2.5 rounded-lg text-xs sm:text-sm text-slate-900 placeholder:text-slate-400 border transition-all focus:outline-none focus:ring-2 ${
                  subjectError
                    ? "border-red-300 bg-red-50/20 text-red-900 focus:ring-red-500/20 focus:border-red-600"
                    : "border-slate-200 bg-white focus:ring-indigo-500/20 focus:border-indigo-600 shadow-2xs"
                }`}
              />
              {subjectError && (
                <div className="absolute right-3 top-2.5 text-red-500 pointer-events-none">
                  <AlertCircle className="h-5 w-5" />
                </div>
              )}
            </div>
            {subjectError ? (
              <p
                id="campaign-subject-err"
                role="alert"
                className="text-xs text-red-600 flex items-center gap-1 font-medium mt-1"
              >
                <AlertCircle className="h-3.5 w-3.5" />
                <span>{subjectError}</span>
              </p>
            ) : (
              <p
                id="campaign-subject-help"
                className="text-xs text-slate-500 mt-1"
              >
                This is the subject recipients will see.
              </p>
            )}
          </div>

          {/* C14 Configurable Sending Interval / Pacing Section */}
          <div className="pt-2 border-t border-slate-100 space-y-3">
            <div className="flex items-center gap-2">
              <Gauge className="h-4 w-4 text-indigo-600 shrink-0" />
              <label className="text-xs sm:text-sm font-semibold text-slate-900">
                Sending Interval
              </label>
            </div>
            <p className="text-xs text-slate-500 -mt-1 leading-relaxed">
              Controls the pacing delay between consecutive recipient send attempts. Useful for IP warm-up and adhering to email provider rate limits.
            </p>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              {/* Option 1: Immediate / No delay */}
              <label
                className={`relative flex items-start gap-3 p-3.5 rounded-lg border cursor-pointer transition-all ${
                  !isCustomPacing
                    ? "border-indigo-600 bg-indigo-50/30 ring-1 ring-indigo-500/20"
                    : "border-slate-200 bg-white hover:bg-slate-50/60"
                }`}
              >
                <input
                  type="radio"
                  name="pacing-mode"
                  value="none"
                  checked={!isCustomPacing}
                  onChange={() => handlePacingModeChange("none")}
                  className="mt-0.5 text-indigo-600 focus:ring-indigo-500"
                />
                <div className="min-w-0">
                  <p className="text-xs sm:text-sm font-semibold text-slate-900">
                    No intentional delay
                  </p>
                  <p className="text-[11px] text-slate-500 mt-0.5 leading-snug">
                    Send eligible recipients immediately one after another as fast as possible.
                  </p>
                </div>
              </label>

              {/* Option 2: Custom Pacing Interval */}
              <label
                className={`relative flex items-start gap-3 p-3.5 rounded-lg border cursor-pointer transition-all ${
                  isCustomPacing
                    ? "border-indigo-600 bg-indigo-50/30 ring-1 ring-indigo-500/20"
                    : "border-slate-200 bg-white hover:bg-slate-50/60"
                }`}
              >
                <input
                  type="radio"
                  name="pacing-mode"
                  value="custom"
                  checked={isCustomPacing}
                  onChange={() => handlePacingModeChange("custom")}
                  className="mt-0.5 text-indigo-600 focus:ring-indigo-500"
                />
                <div className="min-w-0">
                  <p className="text-xs sm:text-sm font-semibold text-slate-900">
                    Paced sending delay
                  </p>
                  <p className="text-[11px] text-slate-500 mt-0.5 leading-snug">
                    Wait a minimum delay between each recipient dispatch attempt.
                  </p>
                </div>
              </label>
            </div>

            {/* Custom Interval Inputs (rendered when custom pacing is active) */}
            {isCustomPacing && (
              <div className="mt-3 p-4 rounded-lg bg-slate-50 border border-slate-200/80 space-y-3">
                <div className="flex flex-wrap items-center gap-3">
                  <div className="w-32">
                    <label htmlFor="send-interval-num" className="sr-only">
                      Interval numeric value
                    </label>
                    <input
                      id="send-interval-num"
                      type="number"
                      min={1}
                      max={intervalUnit === "minutes" ? 1440 : 86400}
                      value={intervalNum || ""}
                      onChange={handleIntervalNumChange}
                      aria-label="Pacing interval value"
                      className="w-full px-3 py-2 text-xs sm:text-sm bg-white rounded-lg border border-slate-200 text-slate-900 font-semibold focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-2xs"
                    />
                  </div>

                  <div className="w-36">
                    <label htmlFor="send-interval-unit" className="sr-only">
                      Interval unit
                    </label>
                    <select
                      id="send-interval-unit"
                      value={intervalUnit}
                      onChange={handleUnitChange}
                      aria-label="Pacing interval unit"
                      className="w-full px-3 py-2 text-xs sm:text-sm bg-white rounded-lg border border-slate-200 text-slate-800 font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-2xs"
                    >
                      <option value="minutes">Minutes</option>
                      <option value="seconds">Seconds</option>
                    </select>
                  </div>

                  <div className="text-xs text-slate-600 flex items-center gap-1.5">
                    <Clock className="h-3.5 w-3.5 text-indigo-600" />
                    <span>
                      {intervalUnit === "minutes"
                        ? `Equivalent to ${intervalNum * 60} seconds`
                        : `Equivalent to ${(intervalNum / 60).toFixed(1)} minutes`}
                    </span>
                  </div>
                </div>

                <p className="text-xs text-indigo-700 bg-indigo-50/80 px-3 py-1.5 rounded-md border border-indigo-100 flex items-center gap-1.5">
                  <Info className="h-3.5 w-3.5 shrink-0" />
                  <span>
                    The first recipient is sent immediately, followed by at least {intervalNum}{" "}
                    {intervalUnit} between each subsequent recipient.
                  </span>
                </p>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  );
};
</file>

