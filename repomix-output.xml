<file path="frontend/src/components/compose/AttachmentUploadList.tsx">
import React from "react";
import { FileText, FileCode, Image, File, X } from "lucide-react";

export interface ComposeAttachment {
  id: number | string;
  file_name: string;
  file_size: number;
  content_type: string;
  isPending?: boolean;
}

interface AttachmentUploadListProps {
  attachments: ComposeAttachment[];
  onRemove: (attachmentId: number | string) => void;
  isUploading?: boolean;
}

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function getAttachmentIcon(fileName: string, contentType: string) {
  const lower = fileName.toLowerCase();
  if (lower.endsWith(".pdf") || contentType.includes("pdf")) {
    return <FileText className="h-4 w-4 text-rose-500 shrink-0" />;
  }
  if (
    lower.endsWith(".json") ||
    lower.endsWith(".xml") ||
    lower.endsWith(".html") ||
    contentType.includes("json") ||
    contentType.includes("xml")
  ) {
    return <FileCode className="h-4 w-4 text-indigo-500 shrink-0" />;
  }
  if (
    lower.endsWith(".png") ||
    lower.endsWith(".jpg") ||
    lower.endsWith(".jpeg") ||
    contentType.includes("image")
  ) {
    return <Image className="h-4 w-4 text-emerald-500 shrink-0" />;
  }
  return <File className="h-4 w-4 text-slate-500 shrink-0" />;
}

export const AttachmentUploadList: React.FC<AttachmentUploadListProps> = ({
  attachments,
  onRemove,
  isUploading = false,
}) => {
  if (attachments.length === 0 && !isUploading) {
    return null;
  }

  return (
    <div className="pt-4 border-t border-slate-100 space-y-2">
      <span className="text-xs font-semibold text-slate-500 uppercase tracking-wider block">
        Attachments ({attachments.length} {attachments.length === 1 ? "file" : "files"})
      </span>

      <div className="flex flex-wrap gap-2.5">
        {attachments.map((att) => (
          <div
            key={att.id}
            className="flex items-center gap-2 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-xs font-medium text-slate-800 transition-colors shadow-2xs"
          >
            {getAttachmentIcon(att.file_name, att.content_type)}
            <span className="truncate max-w-[200px]">{att.file_name}</span>
            <span className="text-slate-400 font-normal">({formatFileSize(att.file_size)})</span>
            {att.isPending && (
              <span className="text-[10px] bg-amber-50 text-amber-700 border border-amber-200 px-1 py-0.5 rounded font-medium">
                Staged
              </span>
            )}
            <button
              type="button"
              onClick={() => onRemove(att.id)}
              className="text-slate-400 hover:text-rose-600 p-0.5 rounded transition-colors ml-1"
              title="Remove attachment"
              aria-label={`Remove ${att.file_name}`}
            >
              <X className="h-3.5 w-3.5" />
            </button>
          </div>
        ))}

        {isUploading && (
          <div className="flex items-center gap-2 px-3 py-1.5 bg-indigo-50/50 border border-indigo-200 rounded-lg text-xs font-medium text-indigo-700 animate-pulse">
            <span className="w-2 h-2 rounded-full bg-indigo-600 animate-ping" />
            <span>Uploading attachment...</span>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/compose/RecipientInput.tsx">
import React, { useState, type KeyboardEvent } from "react";
import { X } from "lucide-react";

interface RecipientInputProps {
  label: string;
  recipients: string[];
  onChange: (recipients: string[]) => void;
  placeholder?: string;
  autoFocus?: boolean;
  rightAction?: React.ReactNode;
}

const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

export const RecipientInput: React.FC<RecipientInputProps> = ({
  label,
  recipients,
  onChange,
  placeholder = "Add recipients...",
  autoFocus = false,
  rightAction,
}) => {
  const [inputValue, setInputValue] = useState("");
  const [error, setError] = useState<string | null>(null);

  const addRecipient = (raw: string) => {
    const trimmed = raw.trim().replace(/[,;]+$/, "").trim();
    if (!trimmed) return;

    if (!EMAIL_REGEX.test(trimmed)) {
      setError(`"${trimmed}" is not a valid email`);
      return;
    }

    if (recipients.includes(trimmed)) {
      setInputValue("");
      setError(null);
      return;
    }

    onChange([...recipients, trimmed]);
    setInputValue("");
    setError(null);
  };

  const removeRecipient = (index: number) => {
    onChange(recipients.filter((_, i) => i !== index));
  };

  const handleKeyDown = (e: KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter" || e.key === "," || e.key === ";") {
      e.preventDefault();
      addRecipient(inputValue);
    } else if (e.key === "Backspace" && !inputValue && recipients.length > 0) {
      e.preventDefault();
      removeRecipient(recipients.length - 1);
    } else if (error) {
      setError(null);
    }
  };

  const handleBlur = () => {
    if (inputValue) {
      addRecipient(inputValue);
    }
  };

  return (
    <div className="py-2.5 flex items-start text-sm border-b border-slate-100 last:border-b-0">
      <span className="w-16 pt-1 text-slate-500 font-medium select-none text-xs sm:text-sm">
        {label}
      </span>

      <div className="flex-1 flex flex-col min-w-0">
        <div className="flex flex-wrap items-center gap-1.5 min-h-[32px]">
          {recipients.map((email, idx) => (
            <div
              key={idx}
              className="bg-slate-100 hover:bg-slate-200/80 text-slate-800 border border-slate-200/80 rounded-lg px-2.5 py-1 flex items-center gap-1.5 text-xs font-medium transition-colors"
            >
              <span className="truncate max-w-[220px]">{email}</span>
              <button
                type="button"
                onClick={() => removeRecipient(idx)}
                className="text-slate-400 hover:text-slate-700 p-0.5 rounded transition-colors"
                title={`Remove ${email}`}
                aria-label={`Remove ${email}`}
              >
                <X className="h-3 w-3" />
              </button>
            </div>
          ))}

          <input
            type="email"
            value={inputValue}
            autoFocus={autoFocus}
            onChange={(e) => {
              setInputValue(e.target.value);
              if (error) setError(null);
            }}
            onKeyDown={handleKeyDown}
            onBlur={handleBlur}
            placeholder={recipients.length === 0 ? placeholder : ""}
            className="flex-1 min-w-[140px] bg-transparent outline-none text-xs sm:text-sm text-slate-900 placeholder-slate-400 py-1"
          />
        </div>

        {error && <span className="text-[11px] text-rose-600 mt-1">{error}</span>}
      </div>

      {rightAction && <div className="ml-2 shrink-0 pt-0.5">{rightAction}</div>}
    </div>
  );
};
</file>

<file path="frontend/src/components/domains/AddDomainDialog.tsx">
import React, { useState } from "react";
import { createPortal } from "react-dom";
import { X, Loader2, AlertCircle, Plus } from "lucide-react";
import { Button } from "../ui/Button";
import { domainsApi } from "../../services/api";
import type { Domain } from "../../types/domains";

interface AddDomainDialogProps {
  isOpen: boolean;
  onClose: () => void;
  companyId: number;
  onSuccess: (newDomain: Domain) => void;
}

export const AddDomainDialog: React.FC<AddDomainDialogProps> = ({
  isOpen,
  onClose,
  companyId,
  onSuccess,
}) => {
  const [domainName, setDomainName] = useState("");
  const [dkimSelector, setDkimSelector] = useState("");
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  if (!isOpen) return null;

  const handleClose = () => {
    if (isSubmitting) return;
    setDomainName("");
    setDkimSelector("");
    setErrorMessage(null);
    onClose();
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setErrorMessage(null);

    const trimmedDomain = domainName.trim();
    if (!trimmedDomain) {
      setErrorMessage("Domain name is required.");
      return;
    }

    if (trimmedDomain.includes("@")) {
      setErrorMessage("Domain name must not contain '@' (enter a domain name, not an email address).");
      return;
    }

    if (trimmedDomain.toLowerCase().startsWith("http://") || trimmedDomain.toLowerCase().startsWith("https://")) {
      setErrorMessage("Do not include http:// or https:// in domain name.");
      return;
    }

    setIsSubmitting(true);
    try {
      const payload = {
        domain_name: trimmedDomain,
        dkim_selector: dkimSelector.trim() || undefined,
      };

      const result = await domainsApi.createDomain(companyId, payload);
      setDomainName("");
      setDkimSelector("");
      setErrorMessage(null);
      onSuccess(result);
    } catch (err: unknown) {
      const errorObj = err as { detail?: string; message?: string };
      setErrorMessage(
        errorObj.detail || errorObj.message || "Failed to add domain. Please check your input and try again."
      );
    } finally {
      setIsSubmitting(false);
    }
  };

  return createPortal(
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150"
      role="dialog"
      aria-modal="true"
      aria-labelledby="add-domain-title"
    >
      <div className="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-lg w-full overflow-hidden animate-in zoom-in-95 duration-150">
        {/* Header */}
        <div className="px-6 py-5 border-b border-slate-100 flex items-start justify-between bg-slate-50/50">
          <div>
            <h3 id="add-domain-title" className="text-base font-bold text-slate-900">
              Add Domain
            </h3>
            <p className="text-xs text-slate-500 mt-0.5">
              Manage and verify DNS authentication for your company's email domains.
            </p>
          </div>
          <button
            type="button"
            disabled={isSubmitting}
            onClick={handleClose}
            aria-label="Close dialog"
            className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors disabled:opacity-50 cursor-pointer"
          >
            <X className="w-5 h-5" />
          </button>
        </div>

        {/* Form Body */}
        <form onSubmit={handleSubmit} className="p-6 space-y-4">
          {errorMessage && (
            <div
              className="p-3.5 rounded-xl border border-rose-200 bg-rose-50/70 text-rose-800 text-xs flex items-start gap-2.5"
              role="alert"
            >
              <AlertCircle className="w-4 h-4 text-rose-600 shrink-0 mt-0.5" />
              <span className="leading-relaxed">{errorMessage}</span>
            </div>
          )}

          {/* Domain Name */}
          <div className="space-y-1.5">
            <label
              htmlFor="add-domain-name"
              className="block text-xs font-semibold text-slate-800"
            >
              Domain Name <span className="text-rose-500">*</span>
            </label>
            <input
              id="add-domain-name"
              type="text"
              required
              disabled={isSubmitting}
              value={domainName}
              onChange={(e) => setDomainName(e.target.value)}
              placeholder="e.g. example.com or mail.example.com"
              className="w-full px-3.5 py-2 text-xs font-mono bg-white border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all disabled:opacity-50"
            />
            <p className="text-[11px] text-slate-500">
              Enter a domain such as example.com. Do not include http://, https://, or trailing slashes.
            </p>
          </div>

          {/* DKIM Selector */}
          <div className="space-y-1.5">
            <label
              htmlFor="add-dkim-selector"
              className="block text-xs font-semibold text-slate-800"
            >
              DKIM Selector{" "}
              <span className="text-slate-400 font-normal">(Optional)</span>
            </label>
            <input
              id="add-dkim-selector"
              type="text"
              disabled={isSubmitting}
              value={dkimSelector}
              onChange={(e) => setDkimSelector(e.target.value)}
              placeholder="e.g. pm2024 or default"
              className="w-full px-3.5 py-2 text-xs font-mono bg-white border border-slate-300 rounded-xl text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition-all disabled:opacity-50"
            />
            <p className="text-[11px] text-slate-500">
              Optional. You can configure or update the selector later.
            </p>
          </div>

          {/* Actions */}
          <div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5">
            <Button
              type="button"
              variant="outline"
              size="sm"
              disabled={isSubmitting}
              onClick={handleClose}
              className="cursor-pointer"
            >
              Cancel
            </Button>
            <Button
              type="submit"
              size="sm"
              disabled={isSubmitting}
              className="gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer"
            >
              {isSubmitting ? (
                <>
                  <Loader2 className="w-3.5 h-3.5 animate-spin" />
                  <span>Adding Domain...</span>
                </>
              ) : (
                <>
                  <Plus className="w-3.5 h-3.5" />
                  <span>Add Domain</span>
                </>
              )}
            </Button>
          </div>
        </form>
      </div>
    </div>,
    document.body
  );
};
</file>

<file path="frontend/src/components/domains/DeleteDomainDialog.tsx">
import React, { useState } from "react";
import { createPortal } from "react-dom";
import { AlertTriangle, X, Loader2, Trash2 } from "lucide-react";
import { Button } from "../ui/Button";
import { domainsApi } from "../../services/api";
import type { Domain } from "../../types/domains";

interface DeleteDomainDialogProps {
  isOpen: boolean;
  onClose: () => void;
  domain: Domain | null;
  companyId: number;
  onSuccess: (deletedDomain: Domain) => void;
}

export const DeleteDomainDialog: React.FC<DeleteDomainDialogProps> = ({
  isOpen,
  onClose,
  domain,
  companyId,
  onSuccess,
}) => {
  const [isDeleting, setIsDeleting] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);

  if (!isOpen || !domain) return null;

  const handleClose = () => {
    if (isDeleting) return;
    setErrorMessage(null);
    onClose();
  };

  const handleConfirm = async () => {
    setErrorMessage(null);
    setIsDeleting(true);

    try {
      await domainsApi.deleteDomain(companyId, domain.id);
      setIsDeleting(false);
      onSuccess(domain);
    } catch (err: unknown) {
      const errorObj = err as { detail?: string; message?: string };
      setErrorMessage(
        errorObj.detail || errorObj.message || "Failed to delete domain. Please try again."
      );
      setIsDeleting(false);
    }
  };

  return createPortal(
    <div
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/40 backdrop-blur-xs animate-in fade-in duration-150"
      role="dialog"
      aria-modal="true"
      aria-labelledby="delete-domain-title"
    >
      <div className="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-md w-full overflow-hidden animate-in zoom-in-95 duration-150">
        {/* Header */}
        <div className="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-rose-50/50">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600 shrink-0">
              <AlertTriangle className="h-4 w-4" />
            </div>
            <h3 id="delete-domain-title" className="text-sm font-bold text-slate-900">
              Delete Domain
            </h3>
          </div>
          <button
            type="button"
            disabled={isDeleting}
            onClick={handleClose}
            aria-label="Close dialog"
            className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors disabled:opacity-50 cursor-pointer"
          >
            <X className="h-4 w-4" />
          </button>
        </div>

        {/* Body */}
        <div className="p-6 space-y-3">
          {errorMessage && (
            <div
              className="p-3 rounded-xl border border-rose-200 bg-rose-50 text-rose-800 text-xs"
              role="alert"
            >
              {errorMessage}
            </div>
          )}

          <p className="text-xs text-slate-700 leading-relaxed font-medium">
            Delete <strong className="font-mono text-slate-900 font-semibold">{domain.domain_name}</strong>?
          </p>
          <div className="p-3 bg-amber-50/80 border border-amber-200/80 rounded-xl text-[11px] text-amber-900 leading-relaxed">
            This action cannot be undone. Email sending and receiving for this domain will fail verification checks immediately.
          </div>
        </div>

        {/* Actions */}
        <div className="px-6 py-4 bg-slate-50 border-t border-slate-100 flex items-center justify-end gap-2.5">
          <Button
            type="button"
            variant="outline"
            size="sm"
            disabled={isDeleting}
            onClick={handleClose}
            className="cursor-pointer"
          >
            Cancel
          </Button>
          <Button
            type="button"
            variant="destructive"
            size="sm"
            disabled={isDeleting}
            onClick={handleConfirm}
            className="gap-1.5 bg-rose-600 hover:bg-rose-700 text-white cursor-pointer"
          >
            {isDeleting ? (
              <>
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
                <span>Deleting...</span>
              </>
            ) : (
              <>
                <Trash2 className="h-3.5 w-3.5" />
                <span>Delete Domain</span>
              </>
            )}
          </Button>
        </div>
      </div>
    </div>,
    document.body
  );
};
</file>

<file path="frontend/src/components/domains/DomainActionMenu.tsx">
import React, { useState, useRef, useEffect } from "react";
import {
  MoreHorizontal,
  Eye,
  RefreshCw,
  Key,
  Trash2,
} from "lucide-react";
import type { Domain } from "../../types/domains";
import { cn } from "../../lib/utils";

interface DomainActionMenuProps {
  domain: Domain;
  canManage: boolean;
  isVerifying?: boolean;
  onViewDetails: (domain: Domain) => void;
  onVerify: (domain: Domain) => void;
  onEditDkim: (domain: Domain) => void;
  onDelete: (domain: Domain) => void;
  direction?: "down" | "up";
  className?: string;
}

export const DomainActionMenu: React.FC<DomainActionMenuProps> = ({
  domain,
  canManage,
  isVerifying = false,
  onViewDetails,
  onVerify,
  onEditDkim,
  onDelete,
  direction = "down",
  className,
}) => {
  const [isOpen, setIsOpen] = useState(false);
  const menuRef = useRef<HTMLDivElement>(null);

  // Close menu on click outside or Escape key
  useEffect(() => {
    if (!isOpen) return;

    const handleClickOutside = (e: MouseEvent) => {
      if (menuRef.current && !menuRef.current.contains(e.target as Node)) {
        setIsOpen(false);
      }
    };

    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        setIsOpen(false);
      }
    };

    document.addEventListener("mousedown", handleClickOutside);
    document.addEventListener("keydown", handleKeyDown);

    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
      document.removeEventListener("keydown", handleKeyDown);
    };
  }, [isOpen]);

  const handleToggle = (e: React.MouseEvent) => {
    e.stopPropagation();
    setIsOpen((prev) => !prev);
  };

  const handleAction = (action: () => void) => (e: React.MouseEvent) => {
    e.stopPropagation();
    setIsOpen(false);
    action();
  };

  return (
    <div
      ref={menuRef}
      className={cn("relative inline-block text-left", isOpen ? "z-50" : "z-10", className)}
    >
      <button
        type="button"
        onClick={handleToggle}
        aria-label="Domain actions"
        aria-haspopup="menu"
        aria-expanded={isOpen}
        className={cn(
          "p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition-colors cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500/20",
          isOpen && "bg-slate-100 text-slate-700 ring-1 ring-slate-200"
        )}
      >
        <MoreHorizontal className="w-4 h-4" />
      </button>

      {isOpen && (
        <div
          role="menu"
          aria-orientation="vertical"
          aria-label="Domain actions menu"
          className={cn(
            "absolute right-0 w-44 rounded-xl bg-white border border-slate-200 shadow-xl py-1 text-xs animate-in fade-in zoom-in-95 duration-100",
            direction === "up" ? "bottom-full mb-1.5" : "top-full mt-1.5"
          )}
        >
          {/* View Details - Accessible to ALL roles */}
          <button
            type="button"
            role="menuitem"
            onClick={handleAction(() => onViewDetails(domain))}
            className="w-full text-left px-3.5 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5 cursor-pointer transition-colors"
          >
            <Eye className="w-3.5 h-3.5 text-slate-400 shrink-0" />
            <span>View Details</span>
          </button>

          {/* Mutations - Only for OWNER / ADMIN */}
          {canManage && (
            <>
              {/* Verify DNS */}
              <button
                type="button"
                role="menuitem"
                disabled={isVerifying}
                onClick={handleAction(() => onVerify(domain))}
                className="w-full text-left px-3.5 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5 cursor-pointer transition-colors disabled:opacity-50"
              >
                <RefreshCw
                  className={cn("w-3.5 h-3.5 text-slate-400 shrink-0", isVerifying && "animate-spin text-indigo-600")}
                />
                <span>{isVerifying ? "Verifying..." : "Verify DNS"}</span>
              </button>

              {/* Edit DKIM */}
              <button
                type="button"
                role="menuitem"
                onClick={handleAction(() => onEditDkim(domain))}
                className="w-full text-left px-3.5 py-2 text-slate-700 hover:bg-slate-50 flex items-center gap-2.5 cursor-pointer transition-colors"
              >
                <Key className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                <span>Edit DKIM</span>
              </button>

              <div className="my-1 border-t border-slate-100" />

              {/* Delete Domain */}
              <button
                type="button"
                role="menuitem"
                onClick={handleAction(() => onDelete(domain))}
                className="w-full text-left px-3.5 py-2 text-rose-600 hover:bg-rose-50 flex items-center gap-2.5 cursor-pointer font-medium transition-colors"
              >
                <Trash2 className="w-3.5 h-3.5 text-rose-500 shrink-0" />
                <span>Delete Domain</span>
              </button>
            </>
          )}
        </div>
      )}
    </div>
  );
};
</file>

<file path="frontend/src/components/domains/DomainDetailsDrawer.tsx">
import React, { useEffect } from "react";
import { createPortal } from "react-dom";
import {
  X,
  RefreshCw,
  AlertCircle,
  Key,
  Trash2,
  Calendar,
} from "lucide-react";
import { DomainStatusBadge } from "./DomainStatusBadge";
import type { Domain, DomainVerificationStatus } from "../../types/domains";
import { Button } from "../ui/Button";
import { cn } from "../../lib/utils";

interface DomainDetailsDrawerProps {
  isOpen: boolean;
  onClose: () => void;
  domain: Domain | null;
  onVerify?: () => void;
  isVerifying?: boolean;
  canManage?: boolean;
  onEditDkim?: () => void;
  onDelete?: () => void;
}

export const DomainDetailsDrawer: React.FC<DomainDetailsDrawerProps> = ({
  isOpen,
  onClose,
  domain,
  onVerify,
  isVerifying = false,
  canManage = false,
  onEditDkim,
  onDelete,
}) => {
  // Handle Escape key to close
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && isOpen) {
        onClose();
      }
    };
    window.addEventListener("keydown", handleKeyDown);
    return () => window.removeEventListener("keydown", handleKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen || !domain) return null;

  const formatDate = (dateStr: string | null) => {
    if (!dateStr) return "Never";
    try {
      const date = new Date(dateStr);
      return date.toLocaleString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
      });
    } catch {
      return dateStr;
    }
  };

  const getDnsExplanation = (
    type: "MX" | "SPF" | "DKIM" | "DMARC",
    status: DomainVerificationStatus,
    selector?: string | null
  ): string => {
    if (type === "DKIM" && (!selector || !selector.trim())) {
      return "Configure a DKIM selector to verify DKIM.";
    }

    switch (status) {
      case "VERIFIED":
        switch (type) {
          case "MX":
            return "Valid Mail Exchange (MX) record detected and verified.";
          case "SPF":
            return "Sender Policy Framework (SPF) record verified.";
          case "DKIM":
            return `DKIM public key detected and verified for selector "${selector}".`;
          case "DMARC":
            return "DMARC policy detected and verified.";
        }
        break;
      case "WARNING":
        switch (type) {
          case "MX":
            return "MX record detected but may require configuration review.";
          case "SPF":
            return "SPF record detected with potential configuration warnings.";
          case "DKIM":
            return `DKIM configuration requires review for selector "${selector}".`;
          case "DMARC":
            return "The domain's DMARC policy requires attention (e.g. p=none).";
        }
        break;
      case "FAILED":
        switch (type) {
          case "MX":
            return "No valid MX records detected pointing to your mail setup.";
          case "SPF":
            return "No SPF record was detected or SPF authentication failed.";
          case "DKIM":
            return `DKIM verification failed for selector "${selector}".`;
          case "DMARC":
            return "No valid DMARC record was detected or alignment failed.";
        }
        break;
      case "PENDING":
      default:
        switch (type) {
          case "MX":
            return "MX verification pending. Run verification to validate.";
          case "SPF":
            return "SPF verification pending. Run verification to validate.";
          case "DKIM":
            return selector
              ? `DKIM verification pending for selector "${selector}".`
              : "Configure a DKIM selector to verify DKIM.";
          case "DMARC":
            return "DMARC verification pending. Run verification to validate.";
        }
    }
  };

  const hasDkimSelector = Boolean(domain.dkim_selector && domain.dkim_selector.trim());

  return createPortal(
    <div
      className="fixed inset-0 z-50 overflow-hidden"
      role="dialog"
      aria-modal="true"
      aria-labelledby="drawer-title"
    >
      {/* Backdrop */}
      <div
        className="fixed inset-0 bg-slate-900/40 backdrop-blur-xs transition-opacity duration-300 animate-in fade-in"
        onClick={onClose}
        aria-hidden="true"
      />

      <div className="fixed inset-y-0 right-0 max-w-full flex pl-10 pointer-events-none">
        <div className="w-screen max-w-lg pointer-events-auto bg-white shadow-2xl flex flex-col justify-between border-l border-slate-200 animate-in slide-in-from-right duration-300">
          {/* Header */}
          <div className="px-6 py-5 border-b border-slate-200 flex items-start justify-between bg-slate-50/60">
            <div className="flex flex-col min-w-0 pr-4">
              <div className="flex items-center gap-2.5 mb-1.5 flex-wrap">
                <h2
                  id="drawer-title"
                  className="font-mono text-base font-bold text-slate-900 truncate"
                >
                  {domain.domain_name}
                </h2>
                <DomainStatusBadge status={domain.verification_status} size="sm" />
              </div>
              <p className="text-xs text-slate-500 flex items-center gap-1.5">
                <Calendar className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                <span>Added {formatDate(domain.created_at)}</span>
              </p>
            </div>
            <div className="flex items-center gap-1 shrink-0">
              {canManage && onVerify && (
                <button
                  type="button"
                  onClick={onVerify}
                  disabled={isVerifying}
                  title="Verify DNS Now"
                  aria-label="Verify DNS Now"
                  className="p-2 rounded-lg text-indigo-600 hover:bg-indigo-50 hover:text-indigo-700 transition-colors disabled:opacity-50 cursor-pointer"
                >
                  <RefreshCw
                    className={cn("w-4 h-4", isVerifying && "animate-spin text-indigo-600")}
                  />
                </button>
              )}
              <button
                type="button"
                onClick={onClose}
                title="Close sheet"
                aria-label="Close sheet"
                className="p-2 rounded-lg text-slate-400 hover:bg-slate-100 hover:text-slate-600 transition-colors cursor-pointer"
              >
                <X className="w-5 h-5" />
              </button>
            </div>
          </div>

          {/* Drawer Scrollable Body */}
          <div className="flex-1 overflow-y-auto px-6 py-5 space-y-5">
            {/* Global Verification Error Alert */}
            {domain.verification_error && (
              <div
                className="rounded-xl border border-rose-200 bg-rose-50/70 p-4 text-rose-900 space-y-1.5"
                role="alert"
              >
                <div className="flex items-center gap-2 text-xs font-bold text-rose-800">
                  <AlertCircle className="w-4 h-4 text-rose-600 shrink-0" />
                  <span>DNS Verification Notice</span>
                </div>
                <p className="text-xs font-mono text-rose-700 leading-relaxed whitespace-pre-wrap break-words">
                  {domain.verification_error}
                </p>
              </div>
            )}

            {/* Diagnostic Breakdown Header */}
            <div className="flex items-center justify-between border-b border-slate-100 pb-2">
              <span className="text-xs font-bold uppercase tracking-wider text-slate-500">
                DNS Diagnostic Breakdown
              </span>
              <span className="text-[11px] font-medium text-indigo-600">Persisted Records</span>
            </div>

            {/* Diagnostic Breakdown Cards */}
            <div className="space-y-3">
              {/* MX Card */}
              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="font-mono text-xs font-bold text-slate-800">
                    Mail Exchange (MX)
                  </span>
                  <DomainStatusBadge status={domain.mx_status} size="sm" />
                </div>
                <p className="text-xs text-slate-600 leading-relaxed">
                  {getDnsExplanation("MX", domain.mx_status)}
                </p>
              </div>

              {/* SPF Card */}
              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="font-mono text-xs font-bold text-slate-800">
                    Sender Policy Framework (SPF)
                  </span>
                  <DomainStatusBadge status={domain.spf_status} size="sm" />
                </div>
                <p className="text-xs text-slate-600 leading-relaxed">
                  {getDnsExplanation("SPF", domain.spf_status)}
                </p>
              </div>

              {/* DKIM Card */}
              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="font-mono text-xs font-bold text-slate-800">
                    DomainKeys Identified Mail (DKIM)
                  </span>
                  <div className="flex items-center gap-1.5">
                    {hasDkimSelector && (
                      <span className="px-2 py-0.5 rounded font-mono text-[11px] bg-slate-200 text-slate-700 font-medium">
                        Selector: {domain.dkim_selector}
                      </span>
                    )}
                    <DomainStatusBadge status={domain.dkim_status} size="sm" />
                  </div>
                </div>
                <p className="text-xs text-slate-600 leading-relaxed">
                  {getDnsExplanation("DKIM", domain.dkim_status, domain.dkim_selector)}
                </p>
                {hasDkimSelector && (
                  <div className="pt-1.5 mt-1 border-t border-slate-200/60 text-[11px] text-slate-500 font-mono">
                    Host:{" "}
                    <span className="text-slate-800 font-medium">
                      {domain.dkim_selector}._domainkey.{domain.domain_name}
                    </span>
                  </div>
                )}
              </div>

              {/* DMARC Card */}
              <div className="p-4 rounded-xl bg-slate-50 border border-slate-200/80 space-y-2">
                <div className="flex items-center justify-between">
                  <span className="font-mono text-xs font-bold text-slate-800">
                    DMARC Policy Enforcement
                  </span>
                  <DomainStatusBadge status={domain.dmarc_status} size="sm" />
                </div>
                <p className="text-xs text-slate-600 leading-relaxed">
                  {getDnsExplanation("DMARC", domain.dmarc_status)}
                </p>
              </div>
            </div>

            {/* Quick Actions (if canManage) */}
            {canManage && (
              <div className="pt-2 border-t border-slate-100 flex items-center gap-2">
                {onEditDkim && (
                  <Button
                    type="button"
                    variant="outline"
                    size="sm"
                    onClick={onEditDkim}
                    className="flex-1 gap-1.5 text-xs border-slate-200 text-slate-700 hover:bg-slate-50 cursor-pointer"
                  >
                    <Key className="w-3.5 h-3.5 text-slate-500" />
                    <span>Edit DKIM</span>
                  </Button>
                )}
                {onDelete && (
                  <Button
                    type="button"
                    variant="outline"
                    size="sm"
                    onClick={onDelete}
                    className="gap-1.5 text-xs border-rose-200 text-rose-700 hover:bg-rose-50 cursor-pointer"
                  >
                    <Trash2 className="w-3.5 h-3.5 text-rose-600" />
                    <span>Delete</span>
                  </Button>
                )}
              </div>
            )}
          </div>

          {/* Drawer Fixed Footer */}
          <div className="px-6 py-4 border-t border-slate-200 bg-white flex items-center justify-between">
            <div className="flex flex-col">
              <span className="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">
                Last Checked
              </span>
              <span className="font-mono text-xs font-semibold text-slate-700">
                {formatDate(domain.last_checked_at)}
              </span>
            </div>
            <div className="flex items-center gap-2">
              {canManage && onVerify && (
                <Button
                  type="button"
                  size="sm"
                  onClick={onVerify}
                  disabled={isVerifying}
                  className="gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white cursor-pointer"
                >
                  <RefreshCw className={cn("w-3.5 h-3.5", isVerifying && "animate-spin")} />
                  <span>{isVerifying ? "Verifying..." : "Verify DNS"}</span>
                </Button>
              )}
              <Button
                type="button"
                variant="outline"
                size="sm"
                onClick={onClose}
                className="cursor-pointer"
              >
                Close Sheet
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>,
    document.body
  );
};
