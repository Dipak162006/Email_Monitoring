          </span>

          {/* Compact Telemetry Quick Indicator Pills */}
          <div className="flex items-center gap-1.5 ml-0 sm:ml-2 flex-wrap">
            <button
              type="button"
              onClick={() => onFilterChange({ unread: !activeUnreadFilter })}
