    <!-- Info Cards -->
    <div class="cards">
      <div class="card">
        <div class="card-header">
          <div class="card-dot rose"></div>
          <h3>Decision gates</h3>
        </div>
        <ul>
          <li>Auth: missing/expired token 401, inactive user 403</li>
          <li>Access: non-member 403, member without account grant 403</li>
          <li>Send: not DRAFT 400, already SENDING 409, no recipient or body 422</li>
          <li>Sync: auth/config errors fail fast, network errors retry 3 times</li>
        </ul>
