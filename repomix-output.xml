<file path="frontend/src/components/compose/AttachmentUploadList.tsx">
import React from "react";
import { FileText, FileCode, Image, File, X } from "lucide-react";

export interface ComposeAttachment {
  id: number | string;
  file_name: string;
  file_size: number;
  content_type: string;
  isPending?: boolean;
}

interface AttachmentUploadListProps {
  attachments: ComposeAttachment[];
  onRemove: (attachmentId: number | string) => void;
  isUploading?: boolean;
}

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function getAttachmentIcon(fileName: string, contentType: string) {
  const lower = fileName.toLowerCase();
  if (lower.endsWith(".pdf") || contentType.includes("pdf")) {
    return <FileText className="h-4 w-4 text-rose-500 shrink-0" />;
  }
  if (
    lower.endsWith(".json") ||
    lower.endsWith(".xml") ||
    lower.endsWith(".html") ||
    contentType.includes("json") ||
    contentType.includes("xml")
  ) {
    return <FileCode className="h-4 w-4 text-indigo-500 shrink-0" />;
  }
  if (
    lower.endsWith(".png") ||
    lower.endsWith(".jpg") ||
    lower.endsWith(".jpeg") ||
    contentType.includes("image")
  ) {
    return <Image className="h-4 w-4 text-emerald-500 shrink-0" />;
  }
  return <File className="h-4 w-4 text-slate-500 shrink-0" />;
}

export const AttachmentUploadList: React.FC<AttachmentUploadListProps> = ({
  attachments,
  onRemove,
  isUploading = false,
}) => {
  if (attachments.length === 0 && !isUploading) {
    return null;
  }

  return (
    <div className="pt-4 border-t border-slate-100 space-y-2">
      <span className="text-xs font-semibold text-slate-500 uppercase tracking-wider block">
        Attachments ({attachments.length} {attachments.length === 1 ? "file" : "files"})
      </span>

      <div className="flex flex-wrap gap-2.5">
        {attachments.map((att) => (
          <div
            key={att.id}
            className="flex items-center gap-2 px-3 py-1.5 bg-slate-50 hover:bg-slate-100 border border-slate-200 rounded-lg text-xs font-medium text-slate-800 transition-colors shadow-2xs"
          >
            {getAttachmentIcon(att.file_name, att.content_type)}
            <span className="truncate max-w-[200px]">{att.file_name}</span>
            <span className="text-slate-400 font-normal">({formatFileSize(att.file_size)})</span>
            {att.isPending && (
              <span className="text-[10px] bg-amber-50 text-amber-700 border border-amber-200 px-1 py-0.5 rounded font-medium">
                Staged
              </span>
            )}
            <button
              type="button"
              onClick={() => onRemove(att.id)}
              className="text-slate-400 hover:text-rose-600 p-0.5 rounded transition-colors ml-1"
              title="Remove attachment"
              aria-label={`Remove ${att.file_name}`}
            >
              <X className="h-3.5 w-3.5" />
            </button>
          </div>
        ))}

        {isUploading && (
          <div className="flex items-center gap-2 px-3 py-1.5 bg-indigo-50/50 border border-indigo-200 rounded-lg text-xs font-medium text-indigo-700 animate-pulse">
            <span className="w-2 h-2 rounded-full bg-indigo-600 animate-ping" />
            <span>Uploading attachment...</span>
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/compose/RecipientInput.tsx">
import React, { useState, type KeyboardEvent } from "react";
import { X } from "lucide-react";

interface RecipientInputProps {
  label: string;
  recipients: string[];
  onChange: (recipients: string[]) => void;
  placeholder?: string;
  autoFocus?: boolean;
  rightAction?: React.ReactNode;
}

const EMAIL_REGEX = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;

export const RecipientInput: React.FC<RecipientInputProps> = ({
  label,
  recipients,
  onChange,
  placeholder = "Add recipients...",
  autoFocus = false,
  rightAction,
}) => {
  const [inputValue, setInputValue] = useState("");
  const [error, setError] = useState<string | null>(null);

  const addRecipient = (raw: string) => {
    const trimmed = raw.trim().replace(/[,;]+$/, "").trim();
    if (!trimmed) return;

    if (!EMAIL_REGEX.test(trimmed)) {
      setError(`"${trimmed}" is not a valid email`);
      return;
    }

    if (recipients.includes(trimmed)) {
      setInputValue("");
      setError(null);
      return;
    }

    onChange([...recipients, trimmed]);
    setInputValue("");
    setError(null);
  };

  const removeRecipient = (index: number) => {
    onChange(recipients.filter((_, i) => i !== index));
  };

  const handleKeyDown = (e: KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter" || e.key === "," || e.key === ";") {
      e.preventDefault();
      addRecipient(inputValue);
    } else if (e.key === "Backspace" && !inputValue && recipients.length > 0) {
      e.preventDefault();
      removeRecipient(recipients.length - 1);
    } else if (error) {
      setError(null);
    }
  };

  const handleBlur = () => {
    if (inputValue) {
      addRecipient(inputValue);
    }
  };

  return (
    <div className="py-2.5 flex items-start text-sm border-b border-slate-100 last:border-b-0">
      <span className="w-16 pt-1 text-slate-500 font-medium select-none text-xs sm:text-sm">
        {label}
      </span>

      <div className="flex-1 flex flex-col min-w-0">
        <div className="flex flex-wrap items-center gap-1.5 min-h-[32px]">
          {recipients.map((email, idx) => (
            <div
              key={idx}
              className="bg-slate-100 hover:bg-slate-200/80 text-slate-800 border border-slate-200/80 rounded-lg px-2.5 py-1 flex items-center gap-1.5 text-xs font-medium transition-colors"
            >
              <span className="truncate max-w-[220px]">{email}</span>
              <button
                type="button"
                onClick={() => removeRecipient(idx)}
                className="text-slate-400 hover:text-slate-700 p-0.5 rounded transition-colors"
                title={`Remove ${email}`}
                aria-label={`Remove ${email}`}
              >
                <X className="h-3 w-3" />
              </button>
            </div>
          ))}

          <input
            type="email"
            value={inputValue}
            autoFocus={autoFocus}
            onChange={(e) => {
              setInputValue(e.target.value);
              if (error) setError(null);
            }}
            onKeyDown={handleKeyDown}
            onBlur={handleBlur}
            placeholder={recipients.length === 0 ? placeholder : ""}
            className="flex-1 min-w-[140px] bg-transparent outline-none text-xs sm:text-sm text-slate-900 placeholder-slate-400 py-1"
          />
        </div>

        {error && <span className="text-[11px] text-rose-600 mt-1">{error}</span>}
      </div>

      {rightAction && <div className="ml-2 shrink-0 pt-0.5">{rightAction}</div>}
    </div>
  );
};
</file>

