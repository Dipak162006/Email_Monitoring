import { CampaignContentStep } from "../CampaignContentStep";
import { CreateCampaignPage } from "../../../pages/CreateCampaignPage";

const mockAccounts: AuthorizedEmailAccount[] = [
  {
    id: 1,
    company_id: 10,
    name: "Sales Team",
