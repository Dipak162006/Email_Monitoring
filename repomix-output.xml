def process_inline_media_images(
    html_content: str,
    company_id: int,
) -> Tuple[str, List[Dict[str, Any]]]:
    """Scan HTML for local company media images and convert them for inline CID email embedding.

    Scans for src=".../api/v1/media/{company_id}/{filename}".
    Returns:
        Tuple of (mime_html_copy, list_of_inline_media_dicts)
    """
    if not html_content or "/api/v1/media/" not in html_content:
        return html_content, []

    from app.core.storage import AttachmentStorageService

    # Match src attributes containing /api/v1/media/{company_id}/{filename}
    pattern = re.compile(
        r'''(?i)(src=["'])(?:https?://[^/"'>]+)?(?:/api/v1/media/'''
        + str(company_id)
        + r'''/([a-f0-9]{32}\.(?:png|jpg|jpeg|gif|webp)))(["'])'''
    )

    found_files: Dict[str, Any] = {}
    for match in pattern.finditer(html_content):
        filename = match.group(2)
        if filename not in found_files:
            try:
                path = AttachmentStorageService.resolve_media_path(company_id, filename)
                if path.is_file():
                    found_files[filename] = path
            except Exception:
                pass

    if not found_files:
        return html_content, []

    inline_items: List[Dict[str, Any]] = []
    mime_html = html_content

    for filename, path in found_files.items():
        cid_val = f"media_{filename}@pulsemail"
        ext = path.suffix.lower()
        subtype = "jpeg" if ext in {".jpg", ".jpeg"} else ext.lstrip(".")
        img_bytes = path.read_bytes()

        # Replace src with cid: in outgoing MIME HTML copy
        replace_pattern = re.compile(
            r'''(?i)(src=["'])(?:https?://[^/"'>]+)?(?:/api/v1/media/'''
            + str(company_id)
            + r'''/'''
            + re.escape(filename)
            + r''')(["'])'''
        )
        mime_html = replace_pattern.sub(rf'\1cid:{cid_val}\2', mime_html)

        inline_items.append({
            "cid": cid_val,
            "cid_header": f"<{cid_val}>",
            "bytes": img_bytes,
            "maintype": "image",
            "subtype": subtype,
            "filename": filename,
        })

    return mime_html, inline_items


class EmailService:
    """Service orchestrating email message construction, authorization verification,
    transport transmission, and database audit persistence.
    """

    def __init__(
        self,
        transport: Optional[EmailTransport] = None,
        smtp_adapter: Optional[BaseSMTPAdapter] = None,
    ):
        if transport is not None:
            self.transport = transport
            if isinstance(transport, SMTPTransport):
                self.smtp_adapter = transport.smtp_adapter
            else:
                self.smtp_adapter = None
        elif smtp_adapter is not None:
            self.smtp_adapter = smtp_adapter
            self.transport = SMTPTransport(smtp_adapter=smtp_adapter)
        else:
            adapter = StandardSMTPAdapter()
            self.smtp_adapter = adapter
            self.transport = SMTPTransport(smtp_adapter=adapter)

    @staticmethod
    def build_mime_message(
        account: EmailAccount,
        send_req: EmailSendRequest,
        parent_email: Optional[Email] = None,
    ) -> Tuple[EmailMessage, str, List[str], Optional[str], Optional[str]]:
        """Construct a standardized MIME EmailMessage instance from account settings and send request.
        
        Returns:
            Tuple containing (EmailMessage, generated_message_id, envelope_recipients_list, in_reply_to, references)
        """
        msg = EmailMessage()

        # 1. Authoritative From Address (derived exclusively from server-side EmailAccount)
        sender_display = formataddr((account.name, account.email_address)) if account.name else account.email_address
        msg["From"] = sender_display

        # 2. Destination Headers
        to_addrs = [str(addr) for addr in send_req.to]
        msg["To"] = ", ".join(to_addrs)

        cc_addrs: Optional[List[str]] = None
        if send_req.cc:
            cc_addrs = [str(addr) for addr in send_req.cc]
            msg["Cc"] = ", ".join(cc_addrs)

        bcc_addrs: Optional[List[str]] = None
        if send_req.bcc:
            bcc_addrs = [str(addr) for addr in send_req.bcc]
            # Note: BCC is deliberately NOT placed in public MIME headers to preserve privacy

        if send_req.reply_to:
            msg["Reply-To"] = str(send_req.reply_to)

        # RFC 8058 One-Click Unsubscribe headers
        if getattr(send_req, "unsubscribe_url", None):
            msg["List-Unsubscribe"] = f"<{send_req.unsubscribe_url}>"
            msg["List-Unsubscribe-Post"] = "List-Unsubscribe=One-Click"

        # Custom headers
        if getattr(send_req, "custom_headers", None) and isinstance(send_req.custom_headers, dict):
            for h_name, h_val in send_req.custom_headers.items():
                if h_name not in msg:
                    msg[h_name] = str(h_val)

        # 3. Subject & Identification Headers
        msg["Subject"] = send_req.subject or ""
        domain = account.email_address.split("@")[-1] if "@" in account.email_address else "localhost"
        message_id = make_msgid(domain=domain)
        msg["Message-ID"] = message_id
        msg["Date"] = email.utils.formatdate(localtime=True)

        # Threading Headers (In-Reply-To and References)
        in_reply_to_val = send_req.in_reply_to or (parent_email.message_id if parent_email else None)
        references_val: Optional[str] = None
        if in_reply_to_val:
            msg["In-Reply-To"] = in_reply_to_val
            # Construct References from parent's references + parent's message_id without duplicates
            parent_refs: List[str] = []
            if parent_email and parent_email.references_header:
                parent_refs = EmailThreadService.extract_message_ids(parent_email.references_header)
            elif parent_email and parent_email.in_reply_to:
                parent_refs = EmailThreadService.extract_message_ids(parent_email.in_reply_to)

            combined_refs = list(parent_refs)
            if in_reply_to_val not in combined_refs:
                combined_refs.append(in_reply_to_val)
            references_val = " ".join(combined_refs)
            msg["References"] = references_val

        # 4. Message Bodies (Text and/or HTML)
        has_text = bool(send_req.body_text and send_req.body_text.strip())
        has_html = bool(send_req.body_html and send_req.body_html.strip())
        if has_html:
            sanitized = sanitize_html(send_req.body_html) or send_req.body_html
            mime_html, inline_media = process_inline_media_images(sanitized, account.company_id)
            if has_text:
                msg.set_content(send_req.body_text)
                msg.add_alternative(mime_html, subtype="html")
            else:
                msg.set_content(mime_html, subtype="html")

            # Attach local media images as inline related parts
            for item in inline_media:
                msg.add_related(
                    item["bytes"],
                    maintype=item["maintype"],
                    subtype=item["subtype"],
                    cid=item["cid_header"],
                    filename=item["filename"],
                    disposition="inline",
                )
        else:
            msg.set_content(send_req.body_text or "")

        # 5. Build full envelope recipient list (deduplicated while preserving order)
        all_recipients: List[str] = []
        for r in to_addrs + (cc_addrs or []) + (bcc_addrs or []):
            if r not in all_recipients:
                all_recipients.append(r)

        return msg, message_id, all_recipients, in_reply_to_val, references_val

    async def send_email(
        self,
        db: AsyncSession,
        current_user: Optional[User],
        account: EmailAccount,
        send_req: EmailSendRequest,
    ) -> Email:
        """Construct, transmit, and record an outgoing email message.
        
        Persists an Email record in the database with status SENT upon successful transmission,
        or status FAILED upon any transport or connection failure before raising an HTTPException.
        """
        # 1. Validate Account State & Configuration
        if not account.is_active:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Email account is inactive and cannot be used for sending.",
            )
        if not account.smtp_host:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Email account does not have an SMTP host configured.",
            )

        # 1b. Resolve Signature (explicit or default for account)
        from app.modules.emails.models import EmailSignature
        from app.modules.emails.signature_service import SignatureService
        target_sig = None
        if send_req.signature_id is not None:
            if current_user is not None:
                target_sig = await SignatureService.get_signature(
                    db=db,
                    current_user=current_user,
                    signature_id=send_req.signature_id,
                    company_id=account.company_id,
                )
            else:
                target_sig = await db.get(EmailSignature, send_req.signature_id)
            if not target_sig or target_sig.company_id != account.company_id or target_sig.email_account_id != account.id:
                raise HTTPException(
                    status_code=status.HTTP_400_BAD_REQUEST,
                    detail="Signature does not belong to the selected email account.",
                )
        else:
            if current_user is not None:
                target_sig = await SignatureService.get_default_signature(
                    db=db,
                    current_user=current_user,
                    account_id=account.id,
                    company_id=account.company_id,
                )
            else:
                stmt = select(EmailSignature).where(
                    EmailSignature.email_account_id == account.id,
                    EmailSignature.is_default == True,
                )
                res = await db.execute(stmt)
                target_sig = res.scalars().first()

        if target_sig:
            send_req.body_text, send_req.body_html = SignatureService.apply_signature_to_content(
                send_req.body_text, send_req.body_html, target_sig
            )
        elif send_req.body_html:
            send_req.body_html = sanitize_html(send_req.body_html)

        if not send_req.body_text and send_req.body_html:
            clean_txt = re.sub(r"<style[^>]*>[\s\S]*?<\/style>", " ", send_req.body_html, flags=re.IGNORECASE)
            clean_txt = re.sub(r"<script[^>]*>[\s\S]*?<\/script>", " ", clean_txt, flags=re.IGNORECASE)
            clean_txt = re.sub(r"<[^>]+>", " ", clean_txt)
            send_req.body_text = re.sub(r"\s+", " ", clean_txt).strip() or None

        # 1c. Resolve and Validate Attachments for Direct Send
        from app.modules.emails.attachment_service import AttachmentService
        validated_attachments = []
        if send_req.attachment_ids:
            validated_attachments = await AttachmentService.validate_and_load_attachments_for_send(
                db=db,
                attachment_ids=send_req.attachment_ids,
                company_id=account.company_id,
                account_id=account.id,
                current_user=current_user,
            )

        campaign_attachments = []
        if getattr(send_req, "campaign_attachment_ids", None):
            from app.modules.campaigns.models import CampaignAttachment
            unique_c_ids = list(dict.fromkeys(send_req.campaign_attachment_ids))
            c_stmt = select(CampaignAttachment).where(
                CampaignAttachment.id.in_(unique_c_ids),
                CampaignAttachment.company_id == account.company_id,
                CampaignAttachment.email_account_id == account.id,
            )
            c_res = await db.execute(c_stmt)
            found_c = {att.id: att for att in c_res.scalars().all()}
            campaign_attachments = [found_c[cid] for cid in unique_c_ids if cid in found_c]

        # 2. Resolve or Create Conversation Thread
        thread, parent_email = await EmailThreadService.resolve_or_create_outgoing_thread(
            db=db,
            account=account,
            requested_thread_id=send_req.thread_id,
            in_reply_to=send_req.in_reply_to,
            subject=send_req.subject,
            body_text=send_req.body_text,
            body_html=send_req.body_html,
        )

        # 3. Build MIME Message
        mime_msg, message_id, envelope_recipients, in_reply_to_val, references_val = self.build_mime_message(
            account=account,
            send_req=send_req,
            parent_email=parent_email,
        )

        # 3b. Attach files if present
        all_to_attach = list(validated_attachments) + list(campaign_attachments)
        if all_to_attach:
            await AttachmentService.attach_to_mime_message(mime_msg, all_to_attach)

        to_list = [str(r) for r in send_req.to]
        cc_list = [str(r) for r in send_req.cc] if send_req.cc else None
        bcc_list = [str(r) for r in send_req.bcc] if send_req.bcc else None
        sender_str = str(mime_msg["From"])

        # 4. Attempt Transport Transmission
        try:
            transport_req = EmailTransportRequest(
                account=account,
                message=mime_msg,
                envelope_recipients=envelope_recipients,
            )
            await self.transport.send(transport_req)

            # Record successful transmission
            email_record = Email(
                company_id=account.company_id,
                email_account_id=account.id,
                thread_id=thread.id,
                user_id=current_user.id if current_user else None,
                message_id=message_id,
                in_reply_to=in_reply_to_val,
                references_header=references_val,
                direction=EmailDirection.OUTGOING.value,
                status=EmailStatus.SENT.value,
                sender=sender_str,
                recipients=to_list,
                cc=cc_list,
                bcc=bcc_list,
                reply_to=str(send_req.reply_to) if send_req.reply_to else None,
                subject=send_req.subject,
                body_text=send_req.body_text,
                body_html=send_req.body_html,
                is_read=True,
                sent_at=datetime.now(timezone.utc),
                error_message=None,
            )
            EmailThreadService.attach_email_to_thread(thread, email_record)
            db.add(email_record)
            await db.flush()

            # Associate validated attachments with the resulting sent Email
            for att in validated_attachments:
                if att.email_id and att.email_id != email_record.id:
                    new_att = EmailAttachment(
                        company_id=att.company_id,
                        email_account_id=att.email_account_id,
                        email_id=email_record.id,
                        file_name=att.file_name,
                        content_type=att.content_type,
                        file_size=att.file_size,
                        storage_path=att.storage_path,
                    )
                    db.add(new_att)
                else:
                    att.email_id = email_record.id

            for c_att in campaign_attachments:
                recip_att = EmailAttachment(
                    company_id=c_att.company_id,
                    email_account_id=c_att.email_account_id,
                    email_id=email_record.id,
                    file_name=c_att.file_name,
                    content_type=c_att.content_type,
                    file_size=c_att.file_size,
                    storage_path=c_att.storage_path,
                )
                db.add(recip_att)

            await db.commit()
            await db.refresh(email_record)
            logger.info("Successfully sent and logged email id=%d (Message-ID: %s, Thread-ID: %d)", email_record.id, message_id, thread.id)
            return email_record

        except Exception as exc:
            # Determine safe error message for persistence and client response
            safe_error_msg = getattr(exc, "safe_message", "Failed to transmit message via SMTP.")
            logger.warning("SMTP sending failure for account id=%d: %s", account.id, safe_error_msg)

            # Persist the attempted email in FAILED state for auditability and error tracking
            failed_email_record = Email(
                company_id=account.company_id,
                email_account_id=account.id,
                thread_id=thread.id,
                user_id=current_user.id if current_user else None,
                message_id=message_id,
                in_reply_to=in_reply_to_val,
                references_header=references_val,
                direction=EmailDirection.OUTGOING.value,
                status=EmailStatus.FAILED.value,
                sender=sender_str,
                recipients=to_list,
                cc=cc_list,
                bcc=bcc_list,
                reply_to=str(send_req.reply_to) if send_req.reply_to else None,
                subject=send_req.subject,
                body_text=send_req.body_text,
                body_html=send_req.body_html,
                is_read=True,
                sent_at=None,
                error_message=safe_error_msg,
            )
            EmailThreadService.attach_email_to_thread(thread, failed_email_record)
            db.add(failed_email_record)
            await db.flush()

            # Associate validated attachments with the failed audit Email
            for att in validated_attachments:
                att.email_id = failed_email_record.id

            await db.commit()
            await db.refresh(failed_email_record)

            # Map domain and transport exceptions to safe HTTP responses
            if isinstance(exc, (TransportConfigurationError, SMTPConfigurationError)):
                http_exc = HTTPException(status_code=status.HTTP_400_BAD_REQUEST, detail=safe_error_msg)
            elif isinstance(exc, (
                TransportAuthenticationError,
                TransportConnectionError,
                TransportRecipientRejectedError,
                TransportSendError,
                EmailTransportException,
                SMTPAuthenticationError,
                SMTPConnectionError,
                SMTPRecipientRejectedError,
                SMTPSendError,
                SMTPServiceException,
            )):
                http_exc = HTTPException(status_code=status.HTTP_502_BAD_GATEWAY, detail=safe_error_msg)
            else:
                http_exc = HTTPException(
                    status_code=status.HTTP_502_BAD_GATEWAY,
                    detail="SMTP server error during email transmission.",
                )
            http_exc.email_record = failed_email_record
            http_exc.original_exception = exc
            raise http_exc

    @staticmethod
    async def get_email(db: AsyncSession, email_id: int) -> Optional[Email]:
        """Fetch a specific email by database primary key ID."""
        result = await db.execute(select(Email).where(Email.id == email_id))
        return result.scalars().first()
</file>

<file path="frontend/src/pages/MailboxPage.tsx">
import { useState, useMemo, useEffect } from "react";
import { useSearchParams, useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient, keepPreviousData } from "@tanstack/react-query";
import { Inbox, AlertCircle, CheckCircle2, Info, X } from "lucide-react";
import { emailsApi, emailAccountsApi } from "../services/api";
import type { EmailItem, EmailListParams } from "../types/emails";
import { MailboxHeader } from "../components/mailbox/MailboxHeader";
import { MailboxToolbar } from "../components/mailbox/MailboxToolbar";
import { EmailRow } from "../components/mailbox/EmailRow";
import { EmailDetailDrawer } from "../components/mailbox/EmailDetailDrawer";
import { RestoreConfirmModal } from "../components/mailbox/RestoreConfirmModal";
import { PermanentDeleteConfirmModal } from "../components/mailbox/PermanentDeleteConfirmModal";
import { EmptyState } from "../components/ui/EmptyState";
import { Button } from "../components/ui/Button";
import { useWorkspace } from "../hooks/useWorkspace";

export function MailboxPage() {
  const [searchParams, setSearchParams] = useSearchParams();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { currentCompanyId } = useWorkspace();

  // Active folder from URL search params (default to "inbox")
  const rawFolder = searchParams.get("folder")?.toLowerCase();
  const activeFolder = useMemo(() => {
    if (rawFolder && ["inbox", "sent", "drafts", "responses", "bounced", "trash"].includes(rawFolder)) {
      return rawFolder;
    }
    return "inbox";
  }, [rawFolder]);

  // Local state
  const [searchQuery, setSearchQuery] = useState("");
  const [debouncedSearchQuery, setDebouncedSearchQuery] = useState("");
  const [selectedAccountId, setSelectedAccountId] = useState<number | undefined>(undefined);
  const [sortBy, setSortBy] = useState<"newest" | "oldest">("newest");
  const [unreadOnly, setUnreadOnly] = useState<boolean | undefined>(undefined);
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState<number>(50);
  const [selectedIds, setSelectedIds] = useState<Set<number>>(new Set());
  const [selectedEmail, setSelectedEmail] = useState<EmailItem | null>(null);
  const [isSyncing, setIsSyncing] = useState(false);

  // Debounce search query updates by ~300ms to avoid firing API requests on every keystroke
  useEffect(() => {
    const timer = setTimeout(() => {
      setDebouncedSearchQuery(searchQuery);
    }, 300);
    return () => clearTimeout(timer);
  }, [searchQuery]);

  // Restore & Permanent Delete modal state
  const [isRestoreModalOpen, setIsRestoreModalOpen] = useState(false);
  const [isRestoring, setIsRestoring] = useState(false);
  const [isPermanentDeleteModalOpen, setIsPermanentDeleteModalOpen] = useState(false);
  const [isPermanentDeleting, setIsPermanentDeleting] = useState(false);
  const [permanentDeleteTargetIds, setPermanentDeleteTargetIds] = useState<number[]>([]);
  const [alertBanner, setAlertBanner] = useState<{ type: "success" | "error" | "info"; message: string } | null>(null);

  // Auto-dismiss alert banner after 5 seconds
  useEffect(() => {
    if (alertBanner) {
      const timer = setTimeout(() => {
        setAlertBanner(null);
      }, 5000);
      return () => clearTimeout(timer);
    }
  }, [alertBanner]);

  // Folder Title formatting
  const folderTitle = useMemo(() => {
    return activeFolder.charAt(0).toUpperCase() + activeFolder.slice(1);
  }, [activeFolder]);

  // Reset folder-scoped state whenever the active folder changes
  useEffect(() => {
    setSelectedIds(new Set());
    setCurrentPage(1);
    setSelectedEmail(null);
    setUnreadOnly(undefined);
    setSearchQuery("");
    setDebouncedSearchQuery("");
  }, [activeFolder]);

  // Reset company-scoped filter and selection state when active company changes
  useEffect(() => {
    setSelectedAccountId(undefined);
    setSelectedIds(new Set());
    setCurrentPage(1);
    setSelectedEmail(null);
    setSearchQuery("");
    setDebouncedSearchQuery("");
  }, [currentCompanyId]);

  // Fetch Mailbox dynamic counts scoped to the selected email account
  const { data: mailboxCounts, refetch: refetchCounts } = useQuery({
    queryKey: ["mailbox-counts", currentCompanyId, selectedAccountId],
    queryFn: () => emailsApi.getMailboxCounts(currentCompanyId ?? undefined, selectedAccountId),
    staleTime: 30000,
  });

  // Fetch Authorized Accounts for filter dropdown
  const { data: authorizedAccounts = [] } = useQuery({
    queryKey: ["authorized-accounts"],
    queryFn: () => emailAccountsApi.getAuthorizedAccounts(),
    staleTime: 60000,
  });

  // Filter authorized accounts strictly to the active company workspace
  const companyAuthorizedAccounts = useMemo(() => {
    if (!currentCompanyId) return authorizedAccounts;
    return authorizedAccounts.filter((acc) => acc.company_id === currentCompanyId);
  }, [authorizedAccounts, currentCompanyId]);

  // Query params for emails list
  const listParams: EmailListParams = useMemo(() => {
    return {
      folder: activeFolder,
      search: debouncedSearchQuery.trim() || undefined,
      emailAccountId: selectedAccountId,
      isRead: unreadOnly ? false : undefined,
      limit: pageSize,
      offset: (currentPage - 1) * pageSize,
      sort: sortBy,
      companyId: currentCompanyId ?? undefined,
    };
  }, [activeFolder, debouncedSearchQuery, selectedAccountId, unreadOnly, currentPage, pageSize, sortBy, currentCompanyId]);

  // Fetch email list with keepPreviousData to prevent unmounting/reset during pagination
  const {
    data: emailListData,
    isLoading,
    isError,
    error,
    refetch: refetchEmails,
  } = useQuery({
    queryKey: ["emails", listParams],
    queryFn: () => emailsApi.listEmails(listParams),
    placeholderData: keepPreviousData,
    staleTime: 15000,
  });

  const emails = emailListData?.emails || [];
  const totalEmails = emailListData?.total || 0;

  // Pagination safety: only clamp if data has successfully loaded, total > 0, and currentPage exceeds totalPages
  useEffect(() => {
    if (emailListData && emailListData.total > 0) {
      const calculatedTotalPages = Math.ceil(emailListData.total / pageSize);
      if (currentPage > calculatedTotalPages) {
        setCurrentPage(Math.max(1, calculatedTotalPages));
      }
    }
  }, [emailListData, currentPage, pageSize]);

  // Selection Scoping: Only allow selection of emails currently visible on the page
  const visibleEmailIds = useMemo(() => new Set(emails.map((e) => e.id)), [emails]);
  const currentSelectedIds = useMemo(() => {
    const valid = new Set<number>();
    for (const id of selectedIds) {
      if (visibleEmailIds.has(id)) {
        valid.add(id);
      }
    }
    return valid;
  }, [selectedIds, visibleEmailIds]);

  const selectedCount = currentSelectedIds.size;
  const isAllSelected = emails.length > 0 && currentSelectedIds.size === emails.length;
  const isSomeSelected = currentSelectedIds.size > 0 && !isAllSelected;

  // Determine whether all currently selected visible emails are starred
  const isAllSelectedStarred = useMemo(() => {
    if (currentSelectedIds.size === 0) return false;
    const selected = emails.filter((e) => currentSelectedIds.has(e.id));
    return selected.length > 0 && selected.every((e) => e.is_starred);
  }, [emails, currentSelectedIds]);

  // Selection Logic
  const handleToggleSelectAll = () => {
    if (isAllSelected) {
      setSelectedIds(new Set());
    } else {
      setSelectedIds(new Set(emails.map((e: EmailItem) => e.id)));
    }
  };

  const handleToggleSelectRow = (id: number) => {
    setSelectedIds((prev) => {
      const next = new Set(prev);
      if (next.has(id)) {
        next.delete(id);
      } else {
        next.add(id);
      }
      return next;
    });
  };

  // Filter & Page Handlers with safe selection reset
  const handleSearchChange = (q: string) => {
    setSearchQuery(q);
    setCurrentPage(1);
    setSelectedIds(new Set());
  };

  const handleAccountChange = (id?: number) => {
    setSelectedAccountId(id);
    setCurrentPage(1);
    setSelectedIds(new Set());
  };

  const handlePageChange = (newPage: number) => {
    setCurrentPage(newPage);
    setSelectedIds(new Set());
  };

  const handlePageSizeChange = (newSize: number) => {
    setPageSize(newSize);
    setCurrentPage(1);
    setSelectedIds(new Set());
  };

  // Sync handler
  const handleSync = async () => {
    try {
      setIsSyncing(true);
      await Promise.all([refetchCounts(), refetchEmails()]);
    } finally {
      setTimeout(() => setIsSyncing(false), 600);
    }
  };

  // Quick Filter Pill Click
  const handleQuickFilter = (filter: { unread?: boolean; folder?: string }) => {
    if (filter.folder) {
      setSearchParams({ folder: filter.folder });
      setCurrentPage(1);
      setSelectedIds(new Set());
    } else if (filter.unread !== undefined) {
      setUnreadOnly(filter.unread ? true : undefined);
      setCurrentPage(1);
      setSelectedIds(new Set());
    }
  };

  // Mutations for email actions
  const markReadMutation = useMutation({
    mutationFn: ({ id, isRead }: { id: number; isRead: boolean }) =>
      emailsApi.markRead(id, isRead),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["emails"] });
      queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
    },
  });

  const markStarMutation = useMutation({
    mutationFn: ({ id, isStarred }: { id: number; isStarred: boolean }) =>
      emailsApi.markStarred(id, isStarred),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["emails"] });
    },
  });

  // Single Row Handlers
  const handleToggleStar = (id: number, currentStarred: boolean) => {
    markStarMutation.mutate({ id, isStarred: !currentStarred });
  };

  const handleToggleRead = (id: number, currentRead: boolean) => {
    markReadMutation.mutate({ id, isRead: !currentRead });
  };

  // Move to Trash (Soft Delete) Handlers
  const handleMoveToTrashSingle = async (id: number) => {
    try {
      await emailsApi.softDelete(id);
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
      ]);
      setSelectedIds((prev) => {
        const next = new Set(prev);
        next.delete(id);
        return next;
      });
      if (selectedEmail?.id === id) {
        setSelectedEmail(null);
      }
      setAlertBanner({
        type: "success",
        message: "Email moved to Trash.",
      });
    } catch {
      setAlertBanner({
        type: "error",
        message: "Failed to move email to Trash. Please try again.",
      });
    }
  };

  const handleBulkMoveToTrash = async () => {
    const ids = Array.from(currentSelectedIds);
    if (ids.length === 0) return;
    try {
      const results = await Promise.allSettled(ids.map((id) => emailsApi.softDelete(id)));
      const succeeded = results.filter((r) => r.status === "fulfilled").length;
      setSelectedIds(new Set());
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
      ]);
      if (succeeded === ids.length) {
        setAlertBanner({
          type: "success",
          message: succeeded === 1 ? "Email moved to Trash." : `${succeeded} emails moved to Trash.`,
        });
      } else if (succeeded > 0) {
        setAlertBanner({
          type: "error",
          message: `Moved ${succeeded} email(s) to Trash, but ${ids.length - succeeded} failed.`,
        });
      } else {
        setAlertBanner({
          type: "error",
          message: "Failed to move selected email(s) to Trash.",
        });
      }
    } catch {
      setAlertBanner({
        type: "error",
        message: "An unexpected error occurred while moving emails to Trash.",
      });
    }
  };

  // Bulk Star & Read Handlers
  const handleBulkStar = async () => {
    const ids = Array.from(currentSelectedIds);
    if (ids.length === 0) return;
    const targetStarredState = !isAllSelectedStarred;
    await Promise.all(ids.map((id) => emailsApi.markStarred(id, targetStarredState)));
    queryClient.invalidateQueries({ queryKey: ["emails"] });
    setAlertBanner({
      type: "success",
      message: targetStarredState
        ? (ids.length === 1 ? "Email starred." : `${ids.length} emails starred.`)
        : (ids.length === 1 ? "Email unstarred." : `${ids.length} emails unstarred.`),
    });
  };

  const handleBulkMarkRead = async (isRead: boolean) => {
    const ids = Array.from(currentSelectedIds);
    if (ids.length === 0) return;
    await Promise.all(ids.map((id) => emailsApi.markRead(id, isRead)));
    queryClient.invalidateQueries({ queryKey: ["emails"] });
    queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
  };

  // Permanent Delete Handlers (Trash Folder only)
  const handlePermanentDeletePrompt = (targetId?: number) => {
    if (activeFolder !== "trash") return;
    if (targetId) {
      setPermanentDeleteTargetIds([targetId]);
      setIsPermanentDeleteModalOpen(true);
    } else if (currentSelectedIds.size > 0) {
      setPermanentDeleteTargetIds(Array.from(currentSelectedIds));
      setIsPermanentDeleteModalOpen(true);
    }
  };

  const handleConfirmPermanentDelete = async () => {
    if (permanentDeleteTargetIds.length === 0 || activeFolder !== "trash") {
      setIsPermanentDeleteModalOpen(false);
      return;
    }
    setIsPermanentDeleting(true);
    const succeededIds: number[] = [];
    const failedIds: number[] = [];

    try {
      const results = await Promise.allSettled(
        permanentDeleteTargetIds.map((id) => emailsApi.permanentDelete(id))
      );

      results.forEach((res, index) => {
        if (res.status === "fulfilled") {
          succeededIds.push(permanentDeleteTargetIds[index]);
        } else {
          failedIds.push(permanentDeleteTargetIds[index]);
        }
      });

      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
      ]);

      if (failedIds.length === 0) {
        setSelectedIds((prev) => {
          const next = new Set(prev);
          succeededIds.forEach((id) => next.delete(id));
          return next;
        });
        setAlertBanner({
          type: "success",
          message:
            succeededIds.length === 1
              ? "Email permanently deleted."
              : `${succeededIds.length} emails permanently deleted.`,
        });
      } else if (succeededIds.length > 0) {
        setSelectedIds(new Set(failedIds));
        setAlertBanner({
          type: "error",
          message: `Permanently deleted ${succeededIds.length} email(s), but failed to delete ${failedIds.length}.`,
        });
      } else {
        setAlertBanner({
          type: "error",
          message: "Failed to permanently delete selected email(s).",
        });
      }

      if (selectedEmail && succeededIds.includes(selectedEmail.id)) {
        setSelectedEmail(null);
      }
    } catch {
      setAlertBanner({
        type: "error",
        message: "An unexpected error occurred while permanently deleting email(s).",
      });
    } finally {
      setIsPermanentDeleting(false);
      setIsPermanentDeleteModalOpen(false);
      setPermanentDeleteTargetIds([]);
    }
  };

  // Restore Handlers (Trash Folder)
  const handleRestorePrompt = () => {
    if (currentSelectedIds.size === 0 || activeFolder !== "trash") return;
    setIsRestoreModalOpen(true);
  };

  const handleConfirmRestore = async () => {
    const idsToRestore = Array.from(currentSelectedIds);
    if (idsToRestore.length === 0 || activeFolder !== "trash") {
      setIsRestoreModalOpen(false);
      return;
    }
    setIsRestoring(true);
    const succeededIds: number[] = [];
    const failedIds: number[] = [];

    try {
      const results = await Promise.allSettled(
        idsToRestore.map((id) => emailsApi.restore(id))
      );

      results.forEach((res, index) => {
        if (res.status === "fulfilled") {
          succeededIds.push(idsToRestore[index]);
        } else {
          failedIds.push(idsToRestore[index]);
        }
      });

      // Always invalidate mailbox lists and counts
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
      ]);

      if (failedIds.length === 0) {
        setSelectedIds(new Set());
        setAlertBanner({
          type: "success",
          message:
            succeededIds.length === 1
              ? "Successfully restored 1 email to Inbox."
              : `Successfully restored ${succeededIds.length} emails to Inbox.`,
        });
      } else if (succeededIds.length > 0) {
        setSelectedIds(new Set(failedIds));
        setAlertBanner({
          type: "error",
          message: `Restored ${succeededIds.length} email(s), but failed to restore ${failedIds.length} email(s).`,
        });
      } else {
        setAlertBanner({
          type: "error",
          message: "Failed to restore selected email(s). Please try again.",
        });
      }

      if (selectedEmail && succeededIds.includes(selectedEmail.id)) {
        setSelectedEmail(null);
      }
    } catch {
      setAlertBanner({
        type: "error",
        message: "An unexpected error occurred while restoring emails.",
      });
    } finally {
      setIsRestoring(false);
      setIsRestoreModalOpen(false);
    }
  };

  const handleRestoreSingle = async (id: number) => {
    try {
      setIsRestoring(true);
      await emailsApi.restore(id);
      await Promise.all([
        queryClient.invalidateQueries({ queryKey: ["emails"] }),
        queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] }),
      ]);
      setSelectedIds((prev) => {
        const next = new Set(prev);
        next.delete(id);
        return next;
      });
      if (selectedEmail?.id === id) {
        setSelectedEmail(null);
      }
      setAlertBanner({
        type: "success",
        message: "Email successfully restored to Inbox.",
      });
    } catch {
      setAlertBanner({
        type: "error",
        message: "Failed to restore email. Please try again.",
      });
    } finally {
      setIsRestoring(false);
    }
  };

  // Row click opens drawer
  const handleEmailClick = (email: EmailItem) => {
    setSelectedEmail(email);
    // Mark as read automatically when opened if currently unread
    if (!email.is_read) {
      markReadMutation.mutate({ id: email.id, isRead: true });
    }
  };

  return (
    <div className="space-y-6">
      {/* 1. Header with Breadcrumb, Total Count, Live Ingestion, Quick Indicators */}
      <MailboxHeader
        folderTitle={folderTitle}
        totalCount={totalEmails}
        mailboxCounts={mailboxCounts}
        isSyncing={isSyncing}
        onSync={handleSync}
        onFilterChange={handleQuickFilter}
        activeUnreadFilter={unreadOnly}
      />

      {/* Operation Feedback Alert Banner */}
      {alertBanner && (
        <div
          className={`flex items-center justify-between px-4 py-3 rounded-xl border text-xs font-medium transition-all ${
            alertBanner.type === "success"
              ? "bg-emerald-50 border-emerald-200 text-emerald-800"
              : alertBanner.type === "info"
              ? "bg-sky-50 border-sky-200 text-sky-800"
              : "bg-rose-50 border-rose-200 text-rose-800"
          }`}
        >
          <div className="flex items-center gap-2">
            {alertBanner.type === "success" ? (
              <CheckCircle2 className="h-4 w-4 text-emerald-600 shrink-0" />
            ) : alertBanner.type === "info" ? (
              <Info className="h-4 w-4 text-sky-600 shrink-0" />
            ) : (
              <AlertCircle className="h-4 w-4 text-rose-600 shrink-0" />
            )}
            <span>{alertBanner.message}</span>
          </div>
          <button
            type="button"
            onClick={() => setAlertBanner(null)}
            className="p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 cursor-pointer"
            aria-label="Dismiss message"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>
      )}

      {/* 2. Primary Card: Integrated Toolbar & Table */}
      <div className="flex flex-col bg-white border border-slate-200/80 rounded-xl shadow-2xs overflow-hidden">
        {/* Integrated Horizontal Toolbar */}
        <MailboxToolbar
          isAllSelected={isAllSelected}
          isSomeSelected={isSomeSelected}
          selectedCount={selectedCount}
          totalVisibleCount={emails.length}
          onToggleSelectAll={handleToggleSelectAll}
          onBulkStar={handleBulkStar}
          isAllSelectedStarred={isAllSelectedStarred}
          onBulkMarkRead={handleBulkMarkRead}
          onBulkMoveToTrash={handleBulkMoveToTrash}
          isTrash={activeFolder === "trash"}
          onRestore={handleRestorePrompt}
          isRestoring={isRestoring}
          onBulkPermanentDelete={() => handlePermanentDeletePrompt()}
          isPermanentDeleting={isPermanentDeleting}
          accounts={companyAuthorizedAccounts}
          selectedAccountId={selectedAccountId}
          onAccountChange={handleAccountChange}
          sortBy={sortBy}
          onSortChange={setSortBy}
          searchQuery={searchQuery}
          onSearchChange={handleSearchChange}
          folderTitle={folderTitle}
          currentPage={currentPage}
          pageSize={pageSize}
          totalCount={totalEmails}
          onPageChange={handlePageChange}
          onPageSizeChange={handlePageSizeChange}
        />

        {/* Desktop Table Column Headers */}
        <div className="hidden lg:grid grid-cols-12 gap-4 px-5 py-2.5 bg-slate-50/80 border-b border-slate-200/80 text-[11px] uppercase tracking-wider text-slate-500 font-semibold select-none">
          <div className="col-span-1 flex items-center gap-2">
            <span>State</span>
          </div>
          <div className="col-span-3 flex items-center">
            <span>Sender &amp; Gateway</span>
          </div>
          <div className="col-span-5 flex items-center">
            <span>Subject &amp; Snippet</span>
          </div>
          <div className="col-span-2 flex items-center justify-center">
            <span>Telemetry Status</span>
          </div>
          <div className="col-span-1 flex items-center justify-end">
            <span>Timestamp</span>
          </div>
        </div>

        {/* Email Rows List Content */}
        <div className="flex flex-col divide-y divide-slate-100">
          {isLoading && (
            <div className="p-8 space-y-4">
              {[...Array(6)].map((_, i) => (
                <div key={i} className="flex items-center gap-4 animate-pulse">
                  <div className="h-4 w-4 bg-slate-100 rounded" />
                  <div className="h-7 w-7 rounded-full bg-slate-100" />
                  <div className="h-4 w-36 bg-slate-100 rounded" />
                  <div className="h-4 flex-1 bg-slate-100 rounded" />
                  <div className="h-4 w-16 bg-slate-100 rounded" />
                </div>
              ))}
            </div>
          )}

          {isError && (
            <div className="p-12 text-center space-y-3">
              <div className="inline-flex p-3 rounded-full bg-rose-50 text-rose-600">
                <AlertCircle className="h-6 w-6" />
              </div>
              <h3 className="text-sm font-semibold text-slate-900">Failed to load emails</h3>
              <p className="text-xs text-slate-500 max-w-sm mx-auto">
                {(error as Error)?.message || "An unexpected error occurred while fetching emails."}
              </p>
              <Button size="sm" variant="outline" onClick={() => refetchEmails()} className="mt-2">
                Try Again
              </Button>
            </div>
          )}

          {!isLoading && !isError && emails.length === 0 && (
            <div className="p-12">
              <EmptyState
                icon={<Inbox className="h-8 w-8 text-indigo-500" />}
                title={`No messages in ${folderTitle}`}
                description={
                  debouncedSearchQuery
                    ? `No messages matched your search term "${debouncedSearchQuery}".`
                    : activeFolder === "trash"
                    ? "Your trash folder is currently empty."
                    : activeFolder === "drafts"
                    ? "You have no saved drafts. Compose a message to create one."
                    : `Your ${folderTitle.toLowerCase()} folder is currently empty. Connect an account or trigger sync to ingest emails.`
                }
                actionLabel={
                  searchQuery
                    ? "Clear Search"
                    : activeFolder === "drafts"
                    ? "Compose Email"
                    : activeFolder === "trash"
                    ? undefined
                    : "Sync Mailbox"
                }
                onAction={() => {
                  if (searchQuery) {
                    handleSearchChange("");
                  } else if (activeFolder === "drafts") {
                    navigate("/compose");
                  } else if (activeFolder !== "trash") {
                    handleSync();
                  }
                }}
              />
            </div>
          )}

          {!isLoading &&
            !isError &&
            emails.map((email: EmailItem) => (
              <EmailRow
                key={email.id}
                email={email}
                isSelected={currentSelectedIds.has(email.id)}
                onToggleSelect={handleToggleSelectRow}
                onToggleStar={handleToggleStar}
                onToggleRead={handleToggleRead}
                onMoveToTrash={handleMoveToTrashSingle}
                onPermanentDelete={(id) => handlePermanentDeletePrompt(id)}
                onRestore={handleRestoreSingle}
                onClick={handleEmailClick}
              />
            ))}
        </div>
      </div>

      {/* 3. Slide-Over Conversation & Message Detail Drawer */}
      <EmailDetailDrawer
        email={selectedEmail}
        onClose={() => setSelectedEmail(null)}
        onRestore={handleRestoreSingle}
        onMoveToTrash={handleMoveToTrashSingle}
        onPermanentDelete={(id) => handlePermanentDeletePrompt(id)}
      />

      {/* 4. Restore Confirmation Modal */}
      <RestoreConfirmModal
        isOpen={isRestoreModalOpen}
        count={selectedCount}
        isRestoring={isRestoring}
        onClose={() => {
          if (!isRestoring) setIsRestoreModalOpen(false);
        }}
        onConfirm={handleConfirmRestore}
      />

      {/* 5. Permanent Delete Confirmation Modal */}
      <PermanentDeleteConfirmModal
        isOpen={isPermanentDeleteModalOpen}
        count={permanentDeleteTargetIds.length}
        isDeleting={isPermanentDeleting}
        onClose={() => {
          if (!isPermanentDeleting) {
            setIsPermanentDeleteModalOpen(false);
            setPermanentDeleteTargetIds([]);
          }
        }}
        onConfirm={handleConfirmPermanentDelete}
      />
    </div>
  );
}
</file>

<file path="backend/app/main.py">
from contextlib import asynccontextmanager
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware
from app.core.config import settings
from app.core.redis import get_redis_client
from app.modules.auth.routes import router as auth_router
from app.modules.companies.routes import (
    invitations_router,
    router as companies_router,
)
from app.modules.campaigns.routes import router as campaigns_router
from app.modules.campaigns.suppression_routes import router as suppression_router
from app.modules.domains.routes import router as domains_router
from app.modules.email_accounts.routes import router as email_accounts_router
from app.modules.emails.routes import router as emails_router
from app.modules.health.routes import router as health_router
from app.modules.campaigns.public_routes import public_router


@asynccontextmanager
async def lifespan(app: FastAPI):
    """Application startup and shutdown events."""
    # Startup
    yield
    # Shutdown: cleanly close Redis connection pool if initialized
    redis = get_redis_client()
    await redis.aclose()


def create_application() -> FastAPI:
    """Application factory."""
    app = FastAPI(
        title=settings.PROJECT_NAME,
        version="0.1.0",
        description="Standalone Email Monitoring and Management Platform",
        docs_url="/docs",
        redoc_url="/redoc",
        openapi_url=f"{settings.API_V1_STR}/openapi.json",
        lifespan=lifespan,
    )

    # Configure CORS
    if settings.BACKEND_CORS_ORIGINS:
        app.add_middleware(
            CORSMiddleware,
            allow_origins=[str(origin) for origin in settings.BACKEND_CORS_ORIGINS],
            allow_credentials=True,
            allow_methods=["*"],
            allow_headers=["*"],
        )

    # Include application routes
    app.include_router(auth_router, prefix=settings.API_V1_STR)
    app.include_router(companies_router, prefix=settings.API_V1_STR)
    app.include_router(invitations_router, prefix=settings.API_V1_STR)
    app.include_router(campaigns_router, prefix=settings.API_V1_STR)
    app.include_router(suppression_router, prefix=settings.API_V1_STR)
    app.include_router(public_router, prefix=settings.API_V1_STR)
    app.include_router(domains_router, prefix=settings.API_V1_STR)
    app.include_router(email_accounts_router, prefix=settings.API_V1_STR)
    app.include_router(emails_router, prefix=settings.API_V1_STR)
    app.include_router(health_router, prefix=settings.API_V1_STR)
    app.include_router(health_router)

    @app.get("/", tags=["Root"])
    async def root():
        return {
            "name": settings.PROJECT_NAME,
            "version": "0.1.0",
            "environment": settings.APP_ENV,
            "docs": "/docs",
            "health": f"{settings.API_V1_STR}/health",
        }

    return app


app = create_application()
</file>

<file path="frontend/src/layouts/AppLayout.tsx">
import React, { useState, useRef, useEffect } from "react";
import { Link, Outlet, useNavigate, useLocation } from "react-router-dom";
import { useQuery } from "@tanstack/react-query";
import {
  LayoutDashboard,
  Inbox,
  Send,
  FileEdit,
  CornerDownLeft,
  ShieldAlert,
  Trash2,
  Mail,
  HardDrive,
  LayoutGrid,
  PenTool,
  Users,
  Activity,
  Building2,
  Globe,
  User as UserIcon,
  LogOut,
  Menu,
  X,
  Search,
  Bell,
  Plus,
  ChevronRight,
  ChevronLeft,
  ChevronsUpDown,
  ChevronUp,
  Megaphone,
} from "lucide-react";
import { useAuth } from "../hooks/useAuth";
import { cn } from "../lib/utils";
import { Button } from "../components/ui/Button";
import { emailsApi } from "../services/api";
import { useWorkspace } from "../hooks/useWorkspace";
import { usePermissions } from "../hooks/usePermissions";
import { WorkspaceSwitcher } from "../components/workspace/WorkspaceSwitcher";

interface NavLinkItem {
  label: string;
  href: string;
  icon: React.ComponentType<{ className?: string }>;
  count?: number;
  badgeType?: "count" | "cyan" | "rose" | "dot-green" | "dot-rose";
}

export function AppLayout() {
  const { user, logout } = useAuth();
  const { currentCompany, currentCompanyId, currentRole } = useWorkspace();
  const { canAccessEmailAccounts, canAccessTeam, canAccessDiagnostics, canAccessSettings } = usePermissions();
  const navigate = useNavigate();
  const location = useLocation();

  // Dynamic mailbox folder counts query scoped to active company
  const { data: mailboxCounts } = useQuery({
    queryKey: ["mailbox-counts", currentCompanyId],
    queryFn: () => emailsApi.getMailboxCounts(currentCompanyId ?? undefined),
    staleTime: 30000,
    refetchInterval: 60000,
  });

  // Mobile drawer state
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);


  // Desktop hover & pin collapse state
  const [isHovered, setIsHovered] = useState(false);
  const [isPinned, setIsPinned] = useState(false);
  const leaveTimeoutRef = useRef<NodeJS.Timeout | null>(null);

  // Effective expansion state (always expanded in mobile drawer mode)
  const isExpanded = isHovered || isPinned || mobileMenuOpen;

  const handleMouseEnter = () => {
    if (leaveTimeoutRef.current) {
      clearTimeout(leaveTimeoutRef.current);
      leaveTimeoutRef.current = null;
    }
    setIsHovered(true);
  };

  const handleMouseLeave = () => {
    // 200ms debounce buffer prevents rapid toggling/flicker
    leaveTimeoutRef.current = setTimeout(() => {
      setIsHovered(false);
    }, 200);
  };

  const handleFocus = () => {
    if (leaveTimeoutRef.current) {
      clearTimeout(leaveTimeoutRef.current);
      leaveTimeoutRef.current = null;
    }
    setIsHovered(true);
  };

  const handleBlur = (e: React.FocusEvent) => {
    if (!e.currentTarget.contains(e.relatedTarget as Node)) {
      setIsHovered(false);
    }
  };

  const togglePin = (e: React.MouseEvent) => {
    e.stopPropagation();
    setIsPinned((prev) => !prev);
    if (isPinned) {
      setIsHovered(false);
    }
  };

  useEffect(() => {
    return () => {
      if (leaveTimeoutRef.current) {
        clearTimeout(leaveTimeoutRef.current);
      }
    };
  }, []);

  const handleLogout = () => {
    logout();
    navigate("/login");
  };

  // Route-aware breadcrumb calculation
  const getBreadcrumbTitle = (): string => {
    const path = location.pathname;
    if (path === "/dashboard" || path === "/") return "Dashboard Overview";
    if (path.startsWith("/mailbox")) {
      const folder = new URLSearchParams(location.search).get("folder");
      if (folder) {
        return `Mailbox / ${folder.charAt(0).toUpperCase() + folder.slice(1)}`;
      }
      return "Mailbox";
    }
    if (path.startsWith("/emails/")) return "Email Detail";
    if (path.startsWith("/compose")) return "Compose Email";
    if (path.startsWith("/campaigns")) return "Campaigns";
    if (path.startsWith("/domains")) return "Settings / Domains";
    if (path.startsWith("/email-accounts")) return "Connected Accounts";
    if (path.startsWith("/templates")) return "Templates";
    if (path.startsWith("/signatures")) return "Signatures";
    if (path.startsWith("/team")) return "Team & Permissions";
    if (path.startsWith("/diagnostics")) return "System Diagnostics";
    if (path.startsWith("/settings")) return "Company Settings";
    if (path.startsWith("/profile")) return "Profile & Account";
    return "Overview";
  };

  // Active state matching helper
  const isItemActive = (href: string) => {
    const [targetPath, targetQuery] = href.split("?");
    if (targetQuery) {
      const targetParams = new URLSearchParams(targetQuery);
      const targetFolder = targetParams.get("folder");
      const currentFolder =
        new URLSearchParams(location.search).get("folder") ||
        (location.pathname === "/mailbox" ? "inbox" : null);
      return location.pathname === targetPath && currentFolder === targetFolder;
    }
    if (href === "/dashboard") {
      return location.pathname === "/dashboard" || location.pathname === "/";
    }
    return (
      (location.pathname === href || (href !== "/" && location.pathname.startsWith(href))) &&
      !location.search.includes("folder")
    );
  };

  const overviewItems: NavLinkItem[] = [
    { label: "Dashboard", href: "/dashboard", icon: LayoutDashboard },
  ];

  const mailboxItems: NavLinkItem[] = [
    {
      label: "Inbox",
      href: "/mailbox?folder=inbox",
      icon: Inbox,
      count: mailboxCounts?.inbox ?? 0,
      badgeType: "dot-green",
    },
    {
      label: "Sent",
      href: "/mailbox?folder=sent",
      icon: Send,
      count: mailboxCounts?.sent ?? 0,
    },
    {
      label: "Drafts",
      href: "/mailbox?folder=drafts",
      icon: FileEdit,
      count: mailboxCounts?.drafts ?? 0,
    },
    {
      label: "Responses",
      href: "/mailbox?folder=responses",
      icon: CornerDownLeft,
      count: mailboxCounts?.responses ?? 0,
      badgeType: "cyan",
    },
    {
      label: "Bounced",
      href: "/mailbox?folder=bounced",
      icon: ShieldAlert,
      count: mailboxCounts?.bounced ?? 0,
      badgeType: "rose",
    },
    {
      label: "Trash",
      href: "/mailbox?folder=trash",
      icon: Trash2,
      count: mailboxCounts?.trash ?? 0,
    },
  ];

  const outreachItems: NavLinkItem[] = [
    {
      label: "Campaigns",
      href: "/campaigns",
      icon: Megaphone,
    },
  ];

  const configItems: NavLinkItem[] = React.useMemo(() => {
    const items: NavLinkItem[] = [];
    if (canAccessEmailAccounts) {
      items.push({ label: "Connected Accounts", href: "/email-accounts", icon: HardDrive });
    }
    items.push({ label: "Domains", href: "/domains", icon: Globe });
    items.push({ label: "Templates", href: "/templates", icon: LayoutGrid });
    items.push({ label: "Signatures", href: "/signatures", icon: PenTool });
    if (canAccessDiagnostics) {
      items.push({ label: "System Diagnostics", href: "/diagnostics", icon: Activity });
    }
    return items;
  }, [canAccessEmailAccounts, canAccessDiagnostics]);

  const settingsItems: NavLinkItem[] = React.useMemo(() => {
    const items: NavLinkItem[] = [];
    items.push({ label: "Profile & Account", href: "/profile", icon: UserIcon });
    if (canAccessSettings) {
      items.push({ label: "Company Settings", href: "/settings", icon: Building2 });
    }
    if (canAccessTeam) {
      items.push({ label: "Team & Permissions", href: "/team", icon: Users });
    }
    return items;
  }, [canAccessSettings, canAccessTeam]);

  const renderNavGroup = (title: string, items: NavLinkItem[], showHeaderChevron = false) => (
    <div className="space-y-0.5">
      {/* Group Header (only visible when expanded) */}
      {isExpanded ? (
        <div className="px-3 pb-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider flex items-center justify-between">
          <span>{title}</span>
          {showHeaderChevron && <ChevronUp className="h-3 w-3 text-slate-400" />}
        </div>
      ) : (
        <div className="h-2" />
      )}

      {items.map((item) => {
        const Icon = item.icon;
        const active = isItemActive(item.href);
        const count = item.count ?? 0;
        const hasCount = count > 0;
        const formattedBadge = hasCount ? count.toLocaleString() : undefined;

        return (
          <div key={item.href} className="relative group">
            <Link
              to={item.href}
              onClick={() => setMobileMenuOpen(false)}
              title={!isExpanded ? item.label : undefined}
              className={cn(
                "relative flex items-center rounded-xl text-xs font-medium transition-all duration-150 focus:outline-none focus:ring-2 focus:ring-indigo-500",
                isExpanded
                  ? "px-3 py-2 justify-between w-full"
                  : "h-10 w-10 mx-auto justify-center",
                active
                  ? "bg-indigo-50 text-indigo-700 font-semibold shadow-2xs"
                  : "text-slate-600 hover:bg-slate-50 hover:text-slate-900"
              )}
            >
              {/* Icon Container */}
              <div className={cn("flex items-center", isExpanded ? "space-x-3 min-w-0" : "justify-center")}>
                <div className="relative shrink-0 flex items-center justify-center">
                  <Icon className={cn("h-4 w-4", active ? "text-indigo-600" : "text-slate-500")} />

                  {/* Collapsed State Badge Indicators: ONLY shown when count > 0 */}
                  {!isExpanded && (
                    <>
                      {hasCount && item.badgeType === "dot-green" && (
                        <span className="absolute -top-1 -right-1 h-2 w-2 rounded-full bg-emerald-500 ring-2 ring-white" />
                      )}
                      {hasCount && (item.badgeType === "dot-rose" || item.badgeType === "rose") && (
                        <span className="absolute -top-1 -right-1 h-2 w-2 rounded-full bg-rose-500 ring-2 ring-white" />
                      )}
                      {hasCount && item.badgeType === "cyan" && (
                        <span className="absolute -top-1.5 -right-2 px-1 py-0.2 text-[8px] font-bold text-cyan-700 bg-cyan-100 rounded-full ring-1 ring-white">
                          {count > 99 ? "99+" : count}
                        </span>
                      )}
                      {active && (
                        <span className="absolute -top-0.5 -right-0.5 h-1.5 w-1.5 rounded-full bg-indigo-600 ring-1 ring-white" />
                      )}
                    </>
                  )}
                </div>

                {/* Expanded Label */}
                {isExpanded && (
                  <span className="truncate text-xs text-slate-700 font-medium">
                    {item.label}
                  </span>
                )}
              </div>

              {/* Expanded State Badges / Active Indicator: ONLY shown when count > 0 */}
              {isExpanded && (
                <div className="flex items-center space-x-1.5 shrink-0 ml-2">
                  {hasCount && formattedBadge && (
                    <span
                      className={cn(
                        "text-[10px] font-semibold px-2 py-0.5 rounded-full",
                        item.badgeType === "cyan"
                          ? "bg-cyan-50 text-cyan-600"
                          : item.badgeType === "rose"
                          ? "bg-rose-50 text-rose-600"
                          : "bg-slate-100 text-slate-600 font-medium"
                      )}
                    >
                      {formattedBadge}
                    </span>
                  )}
                  {active && (!hasCount || !formattedBadge) && (
                    <span className="h-1.5 w-1.5 rounded-full bg-indigo-600 shrink-0" />
                  )}
                </div>
              )}
            </Link>

            {/* Hover Tooltip for Collapsed State: Includes real count when > 0 */}
            {!isExpanded && (
              <div className="absolute left-full ml-3 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-slate-900 text-white text-[11px] font-medium rounded-md shadow-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-150 z-50 whitespace-nowrap">
                {item.label}
                {hasCount && formattedBadge && (
                  <span className="ml-1.5 text-slate-300 font-normal">({formattedBadge})</span>
                )}
              </div>
            )}
          </div>
        );
      })}
    </div>

  );

  return (
    <div className="h-full w-full overflow-hidden flex bg-slate-50 relative">
      {/* Mobile menu backdrop */}
      {mobileMenuOpen && (
        <div
          className="fixed inset-0 z-40 bg-slate-900/40 backdrop-blur-xs lg:hidden"
          onClick={() => setMobileMenuOpen(false)}
        />
      )}

      {/* ===================================================================== */}
      {/* COLLAPSIBLE SIDEBAR WITH HOVER & PIN EXPANSION */}
      {/* ===================================================================== */}
      <aside
        onMouseEnter={handleMouseEnter}
        onMouseLeave={handleMouseLeave}
        onFocus={handleFocus}
        onBlur={handleBlur}
        className={cn(
          "fixed inset-y-0 left-0 z-50 bg-white border-r border-slate-200 flex flex-col h-full shrink-0 transition-[width,transform] duration-300 ease-in-out select-none",
          // Mobile drawer behavior
          mobileMenuOpen ? "translate-x-0 w-64" : "-translate-x-full lg:translate-x-0",
          // Desktop dynamic width
          "lg:static lg:z-30",
          isExpanded ? "lg:w-64" : "lg:w-[72px]"
        )}
      >
        {/* Circular Toggle Button on the Right Border (Desktop) */}
        <button
          type="button"
          onClick={togglePin}
          title={isExpanded ? "Collapse sidebar" : "Expand sidebar"}
          aria-label={isExpanded ? "Collapse sidebar" : "Expand sidebar"}
          className="hidden lg:flex absolute -right-3.5 top-44 z-40 h-7 w-7 rounded-full bg-white border border-slate-200 shadow-xs items-center justify-center text-slate-500 hover:text-indigo-600 hover:border-indigo-300 hover:shadow-sm transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500"
        >
          {isExpanded ? (
            <ChevronLeft className="h-3.5 w-3.5" />
          ) : (
            <ChevronRight className="h-3.5 w-3.5" />
          )}
        </button>

        {/* Brand Header */}
        <div className="h-16 px-4 border-b border-slate-200 flex items-center justify-between shrink-0 overflow-hidden">
          {isExpanded ? (
            <div className="flex items-center justify-between w-full">
              <Link to="/dashboard" className="flex items-center space-x-2.5 min-w-0">
                <div className="h-9 w-9 rounded-xl bg-indigo-600 flex items-center justify-center shadow-xs text-white font-bold shrink-0">
                  <Mail className="h-5 w-5" />
                </div>
                <div className="min-w-0">
                  <span className="font-bold text-sm tracking-tight text-slate-900 block leading-tight truncate">
                    PulseMail B2B
                  </span>
                  <span className="text-[10px] font-semibold text-slate-400 tracking-wider block truncate">
                    {currentCompany?.name || "Email Monitoring"}
                  </span>
                </div>
              </Link>
              <div className="flex items-center space-x-1">
                <ChevronsUpDown className="h-4 w-4 text-slate-400 shrink-0" />
                <button
                  type="button"
                  className="lg:hidden p-1.5 rounded-lg text-slate-500 hover:bg-slate-100"
                  onClick={() => setMobileMenuOpen(false)}
                >
                  <X className="h-5 w-5" />
                </button>
              </div>
            </div>
          ) : (
            <div className="w-full flex items-center justify-center">
              <Link to="/dashboard" title="PulseMail B2B" className="flex items-center justify-center">
                <div className="h-10 w-10 rounded-xl bg-indigo-600 flex items-center justify-center shadow-xs text-white font-bold">
                  <Mail className="h-5 w-5" />
                </div>
              </Link>
            </div>
          )}
        </div>

        {/* Compose Button Area */}
        <div className="p-3 shrink-0">
          {isExpanded ? (
            <Link to="/compose" onClick={() => setMobileMenuOpen(false)}>
              <Button className="w-full justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold text-xs py-2.5 h-10 rounded-xl shadow-xs transition-all">
                <Plus className="h-4 w-4" />
                <span>Compose Email</span>
              </Button>
            </Link>
          ) : (
            <div className="relative group flex justify-center">
              <Link
                to="/compose"
                onClick={() => setMobileMenuOpen(false)}
                title="Compose Email"
                className="h-10 w-10 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-600 flex items-center justify-center transition-colors shadow-2xs focus:outline-none focus:ring-2 focus:ring-indigo-500"
              >
                <Plus className="h-5 w-5 text-indigo-600" />
              </Link>
              <div className="absolute left-full ml-3 top-1/2 -translate-y-1/2 px-2.5 py-1 bg-slate-900 text-white text-[11px] font-medium rounded-md shadow-lg opacity-0 pointer-events-none group-hover:opacity-100 transition-opacity duration-150 z-50 whitespace-nowrap">
                Compose Email
              </div>
            </div>
          )}
        </div>

        {/* Navigation Links Area */}
        <nav className="flex-1 px-3 py-2 space-y-3 overflow-y-auto overflow-x-hidden">
          {renderNavGroup("Overview", overviewItems)}
          {renderNavGroup("Mailboxes", mailboxItems, true)}
          {renderNavGroup("Outreach", outreachItems)}
          {renderNavGroup("Configuration", configItems)}
          {settingsItems.length > 0 && renderNavGroup("Settings", settingsItems)}
        </nav>

        {/* Sidebar Footer: Authenticated User Profile (Monthly Quota Completely Removed) */}
        <div className="p-3 border-t border-slate-200 mt-auto shrink-0">
          {isExpanded ? (
            <div className="flex items-center space-x-3 p-1.5 rounded-lg hover:bg-slate-50 transition-colors">
              <Link
                to="/profile"
                className="flex items-center space-x-3 min-w-0 flex-1 cursor-pointer"
                title="Profile & Account Settings"
              >
                <div className="h-8 w-8 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-xs shrink-0 ring-1 ring-slate-200 shadow-2xs">
                  {user?.full_name ? user.full_name[0].toUpperCase() : user?.email ? user.email[0].toUpperCase() : "U"}
                </div>
                <div className="min-w-0 flex-1">
