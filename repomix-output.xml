    .container {
      width: 100%;
      max-width: var(--archify-reader-width, 1440px);
      margin: 0 auto;
    }
    html[data-reader-narrow="true"]:not([data-present="true"]) .diagram-container > svg {
      min-width: 0;
      max-width: var(--archify-diagram-max-width);
