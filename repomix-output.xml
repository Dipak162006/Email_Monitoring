<file path="frontend/src/components/mailbox/AttachmentList.tsx">
import React, { useState } from "react";
import { FileText, FileCode, Image, File, Download, Loader2, AlertCircle, X } from "lucide-react";
import type { AttachmentItem } from "../../types/emails";
import { emailsApi } from "../../services/api";

interface AttachmentListProps {
  emailId: number;
  attachments: AttachmentItem[];
}

function formatFileSize(bytes: number): string {
  if (bytes < 1024) return `${bytes} B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(1)} MB`;
}

function getFileIcon(fileName: string, contentType: string) {
  const lower = fileName.toLowerCase();
  if (lower.endsWith(".pdf") || contentType.includes("pdf")) {
    return <FileText className="h-5 w-5 text-rose-600" />;
  }
  if (
    lower.endsWith(".json") ||
    lower.endsWith(".xml") ||
    lower.endsWith(".html") ||
    contentType.includes("json") ||
    contentType.includes("xml")
  ) {
    return <FileCode className="h-5 w-5 text-indigo-600" />;
  }
  if (
    lower.endsWith(".png") ||
    lower.endsWith(".jpg") ||
    lower.endsWith(".jpeg") ||
    lower.endsWith(".gif") ||
    contentType.includes("image")
  ) {
    return <Image className="h-5 w-5 text-emerald-600" />;
  }
  return <File className="h-5 w-5 text-slate-500" />;
}

export const AttachmentList: React.FC<AttachmentListProps> = ({ emailId, attachments }) => {
  const [downloadingId, setDownloadingId] = useState<number | null>(null);
  const [downloadError, setDownloadError] = useState<string | null>(null);

  if (!attachments || attachments.length === 0) {
    return null;
  }

  const handleDownload = async (attachment: AttachmentItem) => {
    try {
      setDownloadError(null);
      setDownloadingId(attachment.id);
      const blob = await emailsApi.downloadAttachment(emailId, attachment.id);
      const url = window.URL.createObjectURL(blob);
      const link = document.createElement("a");
      link.href = url;
      link.download = attachment.file_name;
      document.body.appendChild(link);
      link.click();
      document.body.removeChild(link);
      window.URL.revokeObjectURL(url);
    } catch (err) {
      console.error("Failed to download attachment:", err);
      setDownloadError(`Failed to download ${attachment.file_name}. Please try again.`);
    } finally {
      setDownloadingId(null);
    }
  };

  return (
    <div className="pt-4 border-t border-slate-100 space-y-2">
      <span className="text-xs uppercase tracking-wider text-slate-500 font-semibold">
        Attachments ({attachments.length} {attachments.length === 1 ? "File" : "Files"})
      </span>

      {downloadError && (
        <div className="flex items-center justify-between px-3 py-2 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-xs">
          <div className="flex items-center gap-1.5 min-w-0">
            <AlertCircle className="h-3.5 w-3.5 text-rose-600 shrink-0" />
            <span className="truncate">{downloadError}</span>
          </div>
          <button
            type="button"
            onClick={() => setDownloadError(null)}
            className="p-1 rounded text-rose-400 hover:text-rose-600 cursor-pointer shrink-0"
            aria-label="Dismiss download error"
          >
            <X className="h-3 w-3" />
          </button>
        </div>
      )}
      <div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
        {attachments.map((att) => {
          const isDownloading = downloadingId === att.id;
          return (
            <div
              key={att.id}
              onClick={() => !isDownloading && handleDownload(att)}
              className="flex items-center justify-between p-2.5 rounded-lg bg-slate-50 border border-slate-200 hover:bg-slate-100 hover:border-slate-300 transition-colors cursor-pointer group"
              title={`Click to download ${att.file_name}`}
            >
              <div className="flex items-center gap-2.5 min-w-0">
                <div className="shrink-0">{getFileIcon(att.file_name, att.content_type)}</div>
                <div className="flex flex-col min-w-0">
                  <span className="text-xs font-semibold text-slate-900 truncate group-hover:text-indigo-600 transition-colors">
                    {att.file_name}
                  </span>
                  <span className="text-[11px] text-slate-500">{formatFileSize(att.file_size)}</span>
                </div>
              </div>
              <button
                type="button"
                className="p-1 rounded text-slate-400 group-hover:text-indigo-600 transition-colors shrink-0"
                aria-label={`Download ${att.file_name}`}
              >
                {isDownloading ? (
                  <Loader2 className="h-4 w-4 animate-spin text-indigo-600" />
                ) : (
                  <Download className="h-4 w-4" />
                )}
              </button>
            </div>
          );
        })}
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/mailbox/MailboxHeader.tsx">
import React from "react";
import { Link } from "react-router-dom";
import { RefreshCw, Plus } from "lucide-react";
import type { MailboxCounts } from "../../services/api";

interface MailboxHeaderProps {
  folderTitle: string;
  totalCount: number;
  mailboxCounts?: MailboxCounts;
  isSyncing: boolean;
  onSync: () => void;
  onFilterChange: (filter: { unread?: boolean; folder?: string }) => void;
  activeUnreadFilter?: boolean;
}

export const MailboxHeader: React.FC<MailboxHeaderProps> = ({
  folderTitle,
  totalCount,
  mailboxCounts,
  isSyncing,
  onSync,
  onFilterChange,
  activeUnreadFilter,
}) => {
  return (
    <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      {/* Title, Badges & Quick Indicator Pills */}
      <div className="flex flex-col space-y-1">
        <div className="flex items-center gap-3 flex-wrap">
          <h1 className="text-xl sm:text-2xl font-semibold text-slate-900 tracking-tight">
            {folderTitle}
          </h1>

          {/* Dynamic Total Count Badge */}
          {totalCount > 0 && (
            <span className="px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 text-xs font-semibold border border-indigo-200/60">
              {totalCount.toLocaleString()}
            </span>
          )}

          {/* Live Ingestion Indicator */}
          <span className="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-medium border border-emerald-200/60">
            <span className="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse" />
            Live Ingestion
          </span>

          {/* Compact Telemetry Quick Indicator Pills */}
          <div className="flex items-center gap-1.5 ml-0 sm:ml-2 flex-wrap">
            <button
              type="button"
              onClick={() => onFilterChange({ unread: !activeUnreadFilter })}
              className={`inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium border shadow-2xs transition-colors cursor-pointer ${
                activeUnreadFilter
                  ? "bg-indigo-50 text-indigo-700 border-indigo-300"
                  : "bg-white hover:bg-slate-50 text-slate-700 border-slate-200"
              }`}
              title="Toggle unread filter"
            >
              <span className="w-2 h-2 rounded-full bg-indigo-600" />
              <span>Unread</span>
              {mailboxCounts && (
                <span className="font-semibold text-indigo-600 ml-0.5">
                  {mailboxCounts.unread ?? 0}
                </span>
              )}
            </button>

            <button
              type="button"
              onClick={() => onFilterChange({ folder: "responses" })}
              className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-2xs transition-colors cursor-pointer"
              title="View responses"
            >
              <span className="w-2 h-2 rounded-full bg-sky-500" />
              <span>Responses</span>
              {mailboxCounts && mailboxCounts.responses > 0 && (
                <span className="font-semibold text-sky-700 ml-0.5">
                  {mailboxCounts.responses}
                </span>
              )}
            </button>

            <button
              type="button"
              onClick={() => onFilterChange({ folder: "bounced" })}
              className="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md text-xs font-medium bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 shadow-2xs transition-colors cursor-pointer"
              title="View bounced messages"
            >
              <span className="w-2 h-2 rounded-full bg-rose-500" />
              <span>Bounced</span>
              {mailboxCounts && mailboxCounts.bounced > 0 && (
                <span className="font-semibold text-rose-600 ml-0.5">
                  {mailboxCounts.bounced}
                </span>
              )}
            </button>
          </div>
        </div>

        <p className="text-xs text-slate-500">
          Incoming dispatches and telemetry events across connected exchangers.
        </p>
      </div>

      {/* Right Header Actions: Refresh & Compose */}
      <div className="flex items-center gap-2.5 self-start sm:self-center">
        <button
          type="button"
          onClick={onSync}
          disabled={isSyncing}
          className="p-2 rounded-lg bg-white border border-slate-200 text-slate-600 hover:text-indigo-600 hover:bg-slate-50 text-xs font-medium shadow-2xs transition-colors flex items-center justify-center group disabled:opacity-50"
          title="Synchronize all IMAP / POP3 sockets"
          aria-label="Synchronize mailbox"
        >
          <RefreshCw
            className={`h-4 w-4 ${isSyncing ? "animate-spin text-indigo-600" : "group-hover:rotate-180 transition-transform duration-500"}`}
          />
        </button>

        <Link to="/compose">
          <button
            type="button"
            className="flex items-center gap-2 px-3.5 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white font-medium text-xs shadow-xs transition-all group"
          >
            <Plus className="h-4 w-4 transition-transform group-hover:rotate-90" />
            <span>Compose Email</span>
          </button>
        </Link>
      </div>
    </div>
  );
};
