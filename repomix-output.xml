<file path="frontend/src/components/templates/DeleteTemplateModal.tsx">
import React from "react";
import { AlertTriangle, Loader2 } from "lucide-react";
import type { EmailTemplateItem } from "../../types/emails";

export interface DeleteTemplateModalProps {
  isOpen: boolean;
  template: EmailTemplateItem | null;
  onClose: () => void;
  onConfirm: () => void;
  isDeleting?: boolean;
}

export const DeleteTemplateModal: React.FC<DeleteTemplateModalProps> = ({
  isOpen,
  template,
  onClose,
  onConfirm,
  isDeleting = false,
}) => {
  if (!isOpen || !template) return null;

  return (
    <div className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4">
      <div className="bg-white border border-slate-200 rounded-2xl shadow-xl max-w-md w-full p-6 text-center animate-in fade-in zoom-in-95 duration-150">
        <div className="w-12 h-12 bg-rose-50 text-rose-600 rounded-full mx-auto flex items-center justify-center mb-4">
          <AlertTriangle className="h-6 w-6" />
        </div>

        <h3 className="text-base font-bold text-slate-900">Delete Email Template?</h3>
        <p className="text-xs text-slate-500 mt-2 mb-6 leading-relaxed">
          Are you sure you want to delete <strong className="text-slate-800">"{template.name}"</strong>? Any pending
          drafts referencing this template will not be affected, but this template cannot be recovered.
        </p>

        <div className="flex items-center justify-center gap-2.5">
          <button
            type="button"
            disabled={isDeleting}
            onClick={onClose}
            className="px-4 py-2 rounded-lg border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors"
          >
            Cancel
          </button>
          <button
            type="button"
            disabled={isDeleting}
            onClick={onConfirm}
            className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-semibold transition-all shadow-xs disabled:opacity-50"
          >
            {isDeleting ? (
              <>
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
                <span>Deleting...</span>
              </>
            ) : (
              <span>Delete Template</span>
            )}
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

