<file path="frontend/src/components/campaigns/CampaignWizardStepper.tsx">
import React from "react";
import { Check } from "lucide-react";

export interface WizardStepDef {
  number: number;
  id: string;
  label: string;
  shortLabel: string;
}

export const WIZARD_STEPS: WizardStepDef[] = [
  { number: 1, id: "details", label: "Details", shortLabel: "Details" },
  { number: 2, id: "sender", label: "Sender", shortLabel: "Sender" },
  { number: 3, id: "content", label: "Content", shortLabel: "Content" },
  { number: 4, id: "review", label: "Review", shortLabel: "Review" },
];

interface CampaignWizardStepperProps {
  currentStep: number;
  onStepClick: (step: number) => void;
  canNavigateToStep?: (step: number) => boolean;
}

export const CampaignWizardStepper: React.FC<CampaignWizardStepperProps> = ({
  currentStep,
  onStepClick,
  canNavigateToStep = (step) => step <= currentStep,
}) => {
  // Progress line width calculation
  const progressPercent = ((currentStep - 1) / (WIZARD_STEPS.length - 1)) * 100;

  return (
    <nav
      aria-label="Campaign Creation Progress"
      className="bg-white rounded-xl border border-slate-200 px-4 py-3 sm:py-3.5 shadow-2xs"
    >
      <div className="grid grid-cols-4 gap-2 relative">
        {/* Connecting line background */}
        <div
          aria-hidden="true"
          className="hidden sm:block absolute top-4 left-8 right-8 h-0.5 bg-slate-100 -z-0"
        />
        {/* Dynamic progress bar fill */}
        <div
          aria-hidden="true"
          className="hidden sm:block absolute top-4 left-8 h-0.5 bg-indigo-600 -z-0 transition-all duration-300"
          style={{ width: `calc(${progressPercent}% * 0.82)` }}
        />

        {WIZARD_STEPS.map((step) => {
          const isCompleted = step.number < currentStep;
          const isActive = step.number === currentStep;
          const isAccessible = canNavigateToStep(step.number);

          return (
            <button
              key={step.id}
              type="button"
              onClick={() => isAccessible && onStepClick(step.number)}
              disabled={!isAccessible}
              className={`flex flex-col items-center sm:items-start text-center sm:text-left gap-1 z-10 group focus:outline-none ${
                isAccessible ? "cursor-pointer" : "cursor-not-allowed opacity-75"
              }`}
              aria-current={isActive ? "step" : undefined}
            >
              <div className="flex items-center gap-2">
                <span
                  className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-semibold transition-all ${
                    isCompleted
                      ? "bg-indigo-600 text-white shadow-2xs"
                      : isActive
                      ? "bg-indigo-600 text-white ring-4 ring-indigo-50 shadow-2xs"
                      : "bg-slate-100 text-slate-500 border border-slate-200"
                  }`}
                >
                  {isCompleted ? (
                    <Check className="h-4 w-4 stroke-[2.5]" />
                  ) : (
                    step.number
                  )}
                </span>

                <div className="hidden md:block">
                  <span
                    className={`text-[10px] uppercase tracking-wider font-semibold block ${
                      isActive
                        ? "text-indigo-600"
                        : isCompleted
                        ? "text-slate-500"
                        : "text-slate-400"
                    }`}
                  >
                    Step {step.number}
                  </span>
                  <span
                    className={`text-xs font-semibold ${
                      isActive
                        ? "text-slate-900"
                        : isCompleted
                        ? "text-slate-700"
                        : "text-slate-400"
                    }`}
                  >
                    {step.label}
                  </span>
                </div>
              </div>

              <span
                className={`md:hidden text-[11px] font-semibold ${
                  isActive
                    ? "text-indigo-600"
                    : isCompleted
                    ? "text-slate-700"
                    : "text-slate-400"
                }`}
              >
                {step.shortLabel}
              </span>
            </button>
          );
        })}
      </div>
    </nav>
  );
};
</file>

<file path="frontend/src/components/campaigns/CancelCampaignModal.tsx">
import React, { useEffect } from "react";
import { AlertTriangle, Loader2 } from "lucide-react";
import type { Campaign } from "../../types/campaign";

export type CampaignModalMode = "cancel" | "delete";

interface CancelCampaignModalProps {
  isOpen: boolean;
  campaign: Campaign | null;
  mode: CampaignModalMode;
  onClose: () => void;
  onConfirm: () => void;
  isLoading?: boolean;
}

export const CancelCampaignModal: React.FC<CancelCampaignModalProps> = ({
  isOpen,
  campaign,
  mode,
  onClose,
  onConfirm,
  isLoading = false,
}) => {
  useEffect(() => {
    if (!isOpen) return;
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape" && !isLoading) {
        onClose();
      }
    };
    document.addEventListener("keydown", handleKeyDown);
    return () => document.removeEventListener("keydown", handleKeyDown);
  }, [isOpen, isLoading, onClose]);

  if (!isOpen || !campaign) return null;

  const isCancel = mode === "cancel";
  const title = isCancel
    ? `Cancel ${campaign.status === "SCHEDULED" ? "Scheduled " : ""}Campaign?`
    : `Delete ${campaign.status === "DRAFT" ? "Draft " : ""}Campaign?`;

  const description = isCancel
    ? `The campaign "${campaign.name}" will halt all pending deliveries and transition permanently to CANCELLED. This action cannot be undone.`
    : `Are you sure you want to delete "${campaign.name}"? This campaign and its associated records will be permanently removed. This action cannot be undone.`;

  const confirmButtonText = isCancel ? "Cancel Campaign" : "Delete Campaign";

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="campaign-modal-title"
      className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in duration-150"
    >
      <div className="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 text-left animate-in zoom-in-95 duration-150">
        {/* Header with warning icon */}
        <div className="flex items-center gap-3 mb-3">
          <div className="w-10 h-10 rounded-xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center shrink-0">
            <AlertTriangle className="h-5 w-5" />
          </div>
          <div className="flex flex-col min-w-0">
            <h3 id="campaign-modal-title" className="text-sm font-bold text-slate-900 truncate">
              {title}
            </h3>
            <span className="text-xs text-slate-500 truncate">
              Ref: {campaign.name}
            </span>
          </div>
        </div>

        {/* Explanatory Consequence Text */}
        <p className="text-xs text-slate-600 mb-6 leading-relaxed">
          {description}
        </p>

        {/* Buttons */}
        <div className="flex items-center justify-end gap-2.5">
          <button
            type="button"
            disabled={isLoading}
            onClick={onClose}
            className="px-3.5 py-2 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-medium transition-colors disabled:opacity-50"
          >
            {isCancel ? "Keep Campaign" : "Cancel"}
          </button>
          <button
            type="button"
            disabled={isLoading}
            onClick={onConfirm}
            className="px-4 py-2 rounded-lg bg-rose-600 hover:bg-rose-700 text-white text-xs font-medium shadow-sm transition-colors flex items-center gap-1.5 disabled:opacity-50"
          >
            {isLoading ? (
              <>
                <Loader2 className="h-3.5 w-3.5 animate-spin" />
                <span>Processing...</span>
              </>
            ) : (
              <span>{confirmButtonText}</span>
            )}
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/DraftImportModal.tsx">
import React, { useState, useEffect } from "react";
import { useQuery } from "@tanstack/react-query";
import { X, FileText, Paperclip, AlertTriangle, Check, RefreshCw } from "lucide-react";
import { emailsApi } from "../../services/api";
import type { EmailItem } from "../../types/emails";

interface DraftImportModalProps {
  isOpen: boolean;
  onClose: () => void;
  onSelectDraft: (draft: EmailItem) => void;
  selectedAccountId?: number | null;
  companyId?: number | null;
  hasExistingContent: boolean;
}

export const DraftImportModal: React.FC<DraftImportModalProps> = ({
  isOpen,
  onClose,
  onSelectDraft,
  selectedAccountId,
  companyId,
  hasExistingContent,
}) => {
  const [selectedDraft, setSelectedDraft] = useState<EmailItem | null>(null);
  const [showWarning, setShowWarning] = useState<boolean>(false);

  const {
    data: draftsResponse,
    isLoading,
    isError,
    refetch,
  } = useQuery({
    queryKey: ["drafts", companyId, selectedAccountId],
    queryFn: () =>
      emailsApi.listEmails({
        folder: "drafts",
        companyId: companyId || undefined,
        emailAccountId: selectedAccountId || undefined,
        limit: 50,
      }),
    enabled: isOpen && !!companyId,
    staleTime: 0,
    refetchOnMount: "always",
  });

  useEffect(() => {
    if (isOpen) {
      refetch();
      setSelectedDraft(null);
      setShowWarning(false);
    }
  }, [isOpen, refetch]);

  const drafts = draftsResponse?.emails || [];

  const handleDraftClick = (draft: EmailItem) => {
    if (hasExistingContent) {
      setSelectedDraft(draft);
      setShowWarning(true);
    } else {
      onSelectDraft(draft);
      onClose();
    }
  };

  const handleConfirmImport = () => {
    if (selectedDraft) {
      onSelectDraft(selectedDraft);
      setShowWarning(false);
      onClose();
    }
  };

  if (!isOpen) return null;

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="draft-import-modal-title"
      className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/50 backdrop-blur-xs animate-in fade-in duration-150"
    >
      <div className="bg-white rounded-2xl border border-slate-200 shadow-2xl max-w-xl w-full max-h-[85vh] flex flex-col overflow-hidden">
        {/* Header */}
        <div className="px-6 py-4 border-b border-slate-100 flex items-center justify-between bg-slate-50/80">
          <div className="flex items-center gap-2.5">
            <div className="p-2 bg-indigo-50 text-indigo-600 rounded-lg">
              <FileText className="h-5 w-5" />
            </div>
            <div>
              <h3 id="draft-import-modal-title" className="text-base font-semibold text-slate-900">
                Use Existing Draft
              </h3>
              <p className="text-xs text-slate-500">
                Select an existing email draft to import into your campaign
              </p>
            </div>
          </div>
          <button
            type="button"
            onClick={onClose}
            aria-label="Close modal"
            className="p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-200/60 transition-colors cursor-pointer"
          >
            <X className="h-5 w-5" />
          </button>
        </div>

        {/* Content */}
        <div className="p-6 overflow-y-auto flex-1 space-y-4">
          {showWarning && selectedDraft ? (
            <div className="rounded-xl border border-amber-200 bg-amber-50/80 p-5 space-y-4">
              <div className="flex items-start gap-3">
                <AlertTriangle className="h-5 w-5 text-amber-600 shrink-0 mt-0.5" />
                <div className="space-y-1">
                  <h4 className="text-sm font-semibold text-amber-900">
                    Replace Existing Campaign Content?
                  </h4>
                  <p className="text-xs text-amber-800 leading-relaxed">
                    Importing draft &ldquo;<strong>{selectedDraft.subject || "Untitled Draft"}</strong>&rdquo;
                    will overwrite your current campaign subject, body content, and attachments.
                  </p>
                  {selectedDraft.attachment_count && selectedDraft.attachment_count > 0 ? (
                    <p className="text-xs text-amber-700 font-medium">
                      Note: {selectedDraft.attachment_count} attachment{selectedDraft.attachment_count > 1 ? "s" : ""} from this draft will also be imported.
                    </p>
                  ) : null}
                </div>
              </div>

              <div className="flex items-center justify-end gap-3 pt-2">
                <button
                  type="button"
                  onClick={() => setShowWarning(false)}
                  className="px-4 py-2 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-2xs transition-colors cursor-pointer"
                >
                  Cancel
                </button>
                <button
                  type="button"
                  onClick={handleConfirmImport}
                  className="px-4 py-2 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-700 rounded-lg shadow-2xs transition-colors cursor-pointer flex items-center gap-1.5"
                >
                  <Check className="h-4 w-4" />
                  <span>Confirm & Import</span>
                </button>
              </div>
            </div>
          ) : null}

          {isLoading && (
            <div className="space-y-3 py-4">
              {[...Array(3)].map((_, i) => (
                <div key={i} className="h-20 bg-slate-50 rounded-xl animate-pulse border border-slate-100" />
              ))}
            </div>
          )}

          {isError && (
            <div className="p-8 text-center space-y-3">
              <p className="text-sm text-rose-600 font-medium">Failed to load email drafts.</p>
              <button
                type="button"
                onClick={() => refetch()}
                className="inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-lg shadow-2xs cursor-pointer"
              >
                <RefreshCw className="h-3.5 w-3.5" />
                <span>Retry</span>
              </button>
            </div>
          )}

          {!isLoading && !isError && drafts.length === 0 && (
            <div className="p-10 text-center space-y-2">
              <div className="w-12 h-12 rounded-xl bg-slate-100 text-slate-400 mx-auto flex items-center justify-center">
                <FileText className="h-6 w-6" />
              </div>
              <p className="text-sm font-medium text-slate-800">No drafts available</p>
              <p className="text-xs text-slate-500 max-w-sm mx-auto">
                No saved drafts were found for the selected email account. You can create drafts in the mailbox composer.
              </p>
            </div>
          )}

          {!isLoading && !isError && drafts.length > 0 && !showWarning && (
            <div className="space-y-2.5">
              <p className="text-xs text-slate-500 font-medium">
                Found {drafts.length} draft{drafts.length > 1 ? "s" : ""}:
              </p>
              {drafts.map((draft) => {
                const dateStr = draft.updated_at
                  ? new Date(draft.updated_at).toLocaleDateString([], {
                      month: "short",
                      day: "numeric",
                      year: "numeric",
                    })
                  : "";
                const cleanSnippet = (draft.body_text || "")
                  .replace(/\s+/g, " ")
                  .trim()
                  .slice(0, 120);

                return (
                  <div
                    key={draft.id}
                    onClick={() => handleDraftClick(draft)}
                    className="p-4 rounded-xl border border-slate-200 hover:border-indigo-300 hover:bg-indigo-50/20 transition-all cursor-pointer group text-left space-y-1.5"
                  >
                    <div className="flex items-center justify-between gap-3">
                      <h4 className="text-xs sm:text-sm font-semibold text-slate-900 group-hover:text-indigo-600 transition-colors truncate">
                        {draft.subject || "(Untitled Draft)"}
                      </h4>
                      <span className="text-[11px] text-slate-400 shrink-0 font-medium">
                        {dateStr}
                      </span>
                    </div>

                    {cleanSnippet ? (
                      <p className="text-xs text-slate-500 line-clamp-2">
                        {cleanSnippet}
                      </p>
                    ) : (
                      <p className="text-xs text-slate-400 italic">No body text preview</p>
                    )}

                    <div className="flex items-center gap-3 pt-1 text-[11px] text-slate-400">
                      {draft.recipients && draft.recipients.length > 0 && (
                        <span>To: {draft.recipients.join(", ")}</span>
                      )}
                      {draft.attachment_count && draft.attachment_count > 0 ? (
                        <span className="inline-flex items-center gap-1 font-medium text-indigo-600 bg-indigo-50 px-2 py-0.5 rounded">
                          <Paperclip className="h-3 w-3" />
                          <span>{draft.attachment_count} attachment{draft.attachment_count > 1 ? "s" : ""}</span>
                        </span>
                      ) : null}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>

        {/* Footer */}
        <div className="px-6 py-3 border-t border-slate-100 bg-slate-50 flex items-center justify-end">
          <button
            type="button"
            onClick={onClose}
            className="px-4 py-2 text-xs font-medium text-slate-700 bg-white hover:bg-slate-100 border border-slate-200 rounded-lg shadow-2xs transition-colors cursor-pointer"
          >
            Close
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/SenderAccountCard.tsx">
import React from "react";
import { Check, AlertCircle } from "lucide-react";
import type { AuthorizedEmailAccount } from "../../types/emails";

interface SenderAccountCardProps {
  account: AuthorizedEmailAccount;
  isSelected: boolean;
  onSelect: (account: AuthorizedEmailAccount) => void;
}

export const SenderAccountCard: React.FC<SenderAccountCardProps> = ({
  account,
  isSelected,
  onSelect,
}) => {
  const isInactive = !account.is_active;

  // Extract initials from name or email
  const initials = (account.name || account.email_address)
    .split(" ")
    .map((w) => w[0])
    .filter(Boolean)
    .slice(0, 2)
    .join("")
    .toUpperCase();

  // Provider display name helper
  const formatProvider = (p: string) => {
    switch (p?.toUpperCase()) {
      case "GMAIL":
      case "GOOGLE":
        return "Google Workspace";
      case "OUTLOOK":
      case "OFFICE365":
      case "MICROSOFT":
        return "Microsoft 365";
      case "SMTP_IMAP":
      case "SMTP":
        return "Custom SMTP";
      case "ZOHO":
        return "Zoho Mail";
      default:
        return p || "Email Account";
    }
  };

  const handleClick = () => {
    if (!isInactive) {
      onSelect(account);
    }
  };

  const handleKeyDown = (e: React.KeyboardEvent) => {
    if ((e.key === "Enter" || e.key === " ") && !isInactive) {
      e.preventDefault();
      onSelect(account);
    }
  };

  return (
    <div
      role="radio"
      aria-checked={isSelected}
      aria-disabled={isInactive}
      tabIndex={isInactive ? -1 : 0}
      onClick={handleClick}
      onKeyDown={handleKeyDown}
      className={`p-4 rounded-xl border transition-all relative flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 ${
        isInactive
          ? "bg-slate-50/70 border-slate-200 opacity-60 cursor-not-allowed"
          : isSelected
          ? "bg-indigo-50/30 border-2 border-indigo-600 shadow-xs cursor-pointer"
          : "bg-white border-slate-200 hover:border-slate-300 hover:bg-slate-50/50 shadow-2xs cursor-pointer focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
      }`}
    >
      <div className="flex items-center gap-3.5 min-w-0">
        {/* Account Avatar Initials */}
        <div
          className={`w-10 h-10 rounded-full flex items-center justify-center text-xs font-bold shrink-0 transition-colors ${
            isInactive
              ? "bg-slate-200 text-slate-500"
              : isSelected
              ? "bg-indigo-600 text-white"
              : "bg-indigo-100 text-indigo-700"
          }`}
        >
          {initials || "MB"}
        </div>

        {/* Identity Details */}
        <div className="min-w-0 space-y-0.5">
          <div className="flex items-center gap-2 flex-wrap">
            <span className="text-xs sm:text-sm font-semibold text-slate-900 truncate">
              {account.name}
            </span>
            <span className="px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 text-[10px] font-medium border border-slate-200">
              {formatProvider(account.provider)}
            </span>
            {account.is_active ? (
              <span className="px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-[10px] font-semibold border border-emerald-200">
                Active
              </span>
            ) : (
              <span className="px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 text-[10px] font-semibold border border-rose-200">
                Inactive
              </span>
            )}
          </div>
          <p className="text-xs text-slate-500 truncate">{account.email_address}</p>
          {isInactive && (
            <p className="text-[11px] text-rose-600 flex items-center gap-1 font-medium pt-0.5">
              <AlertCircle className="h-3 w-3 shrink-0" />
              <span>Mailbox is inactive. Re-activate in Connected Accounts to send.</span>
            </p>
          )}
        </div>
      </div>

      {/* Radio Check Indicator */}
      <div className="shrink-0 self-end sm:self-center">
        {isInactive ? (
          <span className="text-[11px] px-2 py-1 rounded bg-slate-100 text-slate-400 font-medium">
            Unavailable
          </span>
        ) : (
          <div
            className={`w-6 h-6 rounded-full flex items-center justify-center transition-all ${
              isSelected
                ? "bg-indigo-600 text-white shadow-2xs"
                : "border border-slate-300 bg-white text-transparent hover:border-slate-400"
            }`}
          >
            <Check className="h-3.5 w-3.5 stroke-[3]" />
          </div>
        )}
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/campaigns/SenderSelectionStep.tsx">
import React from "react";
import { Link } from "react-router-dom";
import { PlusCircle, Mail, AlertCircle, Loader2 } from "lucide-react";
import type { AuthorizedEmailAccount } from "../../types/emails";
import { SenderAccountCard } from "./SenderAccountCard";

interface SenderSelectionStepProps {
  accounts: AuthorizedEmailAccount[];
  selectedAccountId: number | null;
  onSelectAccount: (accountId: number) => void;
  isLoading?: boolean;
  isError?: boolean;
  onRetry?: () => void;
  error?: string | null;
}

export const SenderSelectionStep: React.FC<SenderSelectionStepProps> = ({
  accounts,
  selectedAccountId,
  onSelectAccount,
  isLoading = false,
  isError = false,
  onRetry,
  error,
}) => {
  const selectedAccount = accounts.find((a) => a.id === selectedAccountId);

  // Extract domain from selected email
  const selectedDomain = selectedAccount?.email_address
    ? selectedAccount.email_address.split("@")[1]
    : null;

  return (
    <section className="space-y-6">
      <div className="bg-white rounded-xl border border-slate-200 shadow-2xs p-6 sm:p-8 space-y-6">
        {/* Step Header */}
        <div className="flex items-start justify-between gap-4">
          <div className="space-y-1">
            <h2 className="text-lg sm:text-xl font-bold text-slate-900 tracking-tight">
              Sender Account
            </h2>
            <p className="text-xs sm:text-sm text-slate-500">
              Select which authenticated mailbox will dispatch this sequence.
            </p>
          </div>
          <Link
            to="/email-accounts"
            className="inline-flex items-center gap-1.5 text-xs font-semibold text-indigo-600 hover:text-indigo-700 transition-colors shrink-0"
          >
            <PlusCircle className="h-4 w-4" />
            <span>Add Mailbox</span>
          </Link>
        </div>

        {/* Loading state */}
        {isLoading && (
          <div className="py-12 flex flex-col items-center justify-center text-center space-y-3">
            <Loader2 className="h-8 w-8 animate-spin text-indigo-600" />
            <p className="text-xs sm:text-sm text-slate-500 font-medium">
              Loading authorized sending accounts...
            </p>
          </div>
        )}

        {/* Error state */}
        {!isLoading && isError && (
          <div className="p-6 rounded-xl bg-red-50/50 border border-red-200 text-center space-y-3">
            <div className="w-10 h-10 mx-auto rounded-full bg-red-100 text-red-600 flex items-center justify-center">
              <AlertCircle className="h-5 w-5" />
            </div>
            <div>
              <h3 className="text-sm font-semibold text-slate-900">
                Failed to load email accounts
              </h3>
              <p className="text-xs text-slate-500 mt-1">
                {error || "An unexpected error occurred while fetching sending mailboxes."}
              </p>
            </div>
            {onRetry && (
              <button
                type="button"
                onClick={onRetry}
                className="px-4 py-2 rounded-lg bg-white border border-slate-200 text-slate-700 text-xs font-semibold hover:bg-slate-50 transition-colors shadow-2xs"
              >
                Retry
              </button>
            )}
          </div>
        )}

        {/* Empty state: No accounts returned */}
        {!isLoading && !isError && accounts.length === 0 && (
          <div className="p-8 sm:p-12 rounded-xl bg-slate-50 border border-dashed border-slate-200 text-center space-y-4">
            <div className="w-14 h-14 mx-auto rounded-full bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shadow-2xs">
              <Mail className="h-6 w-6" />
            </div>
            <div className="max-w-md mx-auto space-y-1">
              <h3 className="text-sm sm:text-base font-bold text-slate-900">
                No sending accounts available
              </h3>
              <p className="text-xs sm:text-sm text-slate-500 leading-relaxed">
                Connect and configure an email account before creating a campaign.
              </p>
            </div>
            <Link
              to="/email-accounts"
              className="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-sm transition-colors"
            >
              <PlusCircle className="h-4 w-4" />
              <span>Connect Email Account</span>
            </Link>
          </div>
        )}

        {/* Sender Cards List */}
        {!isLoading && !isError && accounts.length > 0 && (
          <div
            role="radiogroup"
            aria-label="Select sender account"
            className="space-y-2.5"
          >
            {accounts.map((account) => (
              <SenderAccountCard
                key={account.id}
                account={account}
                isSelected={account.id === selectedAccountId}
                onSelect={(acc) => onSelectAccount(acc.id)}
              />
            ))}
          </div>
        )}

        {/* Sender Information Summary Panel */}
        {selectedAccount && (
          <div className="p-4 rounded-xl bg-slate-50 border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
            <div className="space-y-0.5">
              <span className="text-[11px] uppercase tracking-wider text-slate-500 font-semibold block">
                Selected Identity
              </span>
              <p className="text-xs sm:text-sm font-semibold text-slate-900">
                Sending from {selectedAccount.name} ({selectedAccount.email_address})
              </p>
              {selectedDomain && (
                <div className="flex items-center gap-1.5 pt-0.5">
                  <span className="text-xs text-slate-500">
                    Domain: <strong className="text-slate-700">{selectedDomain}</strong>
                  </span>
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </section>
  );
};
</file>

<file path="frontend/src/components/campaigns/UnsavedChangesDialog.tsx">
import React, { useEffect } from "react";
import { AlertTriangle } from "lucide-react";

interface UnsavedChangesDialogProps {
  isOpen: boolean;
  onClose: () => void;
  onConfirm: () => void;
}

export const UnsavedChangesDialog: React.FC<UnsavedChangesDialogProps> = ({
  isOpen,
  onClose,
  onConfirm,
}) => {
  useEffect(() => {
    if (!isOpen) return;
    const handleKeyDown = (e: KeyboardEvent) => {
      if (e.key === "Escape") {
        onClose();
      }
    };
    document.addEventListener("keydown", handleKeyDown);
    return () => document.removeEventListener("keydown", handleKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="unsaved-modal-title"
      aria-describedby="unsaved-modal-description"
      className="fixed inset-0 z-50 bg-slate-900/40 backdrop-blur-xs flex items-center justify-center p-4 animate-in fade-in duration-150"
    >
      <div className="w-full max-w-md bg-white rounded-2xl shadow-2xl border border-slate-200 p-6 text-left animate-in zoom-in-95 duration-150">
        <div className="flex items-start gap-3.5 mb-4">
          <div className="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 text-amber-600 flex items-center justify-center shrink-0">
            <AlertTriangle className="h-5 w-5" />
          </div>
          <div>
            <h3
              id="unsaved-modal-title"
              className="text-base font-semibold text-slate-900"
            >
              Discard unsaved changes?
            </h3>
            <p
              id="unsaved-modal-description"
              className="text-xs sm:text-sm text-slate-500 mt-1 leading-relaxed"
            >
              Your campaign changes have not been saved. If you leave this wizard, any unsaved work will be lost.
            </p>
          </div>
        </div>

        <div className="flex items-center justify-end gap-2.5 pt-2 border-t border-slate-100">
          <button
            type="button"
            onClick={onClose}
            className="px-4 py-2 rounded-lg text-xs font-semibold text-slate-700 bg-white border border-slate-200 hover:bg-slate-50 transition-colors shadow-2xs focus:outline-none focus:ring-2 focus:ring-slate-300"
          >
            Keep Editing
          </button>
          <button
            type="button"
            onClick={onConfirm}
            className="px-4 py-2 rounded-lg text-xs font-semibold text-white bg-red-600 hover:bg-red-700 transition-colors shadow-2xs focus:outline-none focus:ring-2 focus:ring-red-500"
          >
            Discard Changes
          </button>
        </div>
      </div>
    </div>
  );
};
</file>

<file path="frontend/src/components/compose/__tests__/ComposeForwardAttachments.test.tsx">
import { describe, it, expect, vi } from "vitest";
import { render, screen, fireEvent } from "@testing-library/react";
import { AttachmentUploadList, type ComposeAttachment } from "../AttachmentUploadList";

describe("Compose Forward Attachments UI & Operations", () => {
  it("renders forwarded attachments with name, formatted size, and remove button", () => {
    const attachments: ComposeAttachment[] = [
      {
        id: 101,
        file_name: "financial_report.pdf",
        file_size: 1024 * 500, // 500 KB
        content_type: "application/pdf",
        isPending: false,
      },
      {
        id: 102,
        file_name: "data_export.csv",
        file_size: 2048, // 2.0 KB
        content_type: "text/csv",
        isPending: false,
      },
    ];

    const onRemove = vi.fn();

    render(
      <AttachmentUploadList
        attachments={attachments}
        onRemove={onRemove}
        isUploading={false}
      />
    );

    // Displays count header
    expect(screen.getByText("Attachments (2 files)")).toBeTruthy();

    // Displays file names
    expect(screen.getByText("financial_report.pdf")).toBeTruthy();
    expect(screen.getByText("data_export.csv")).toBeTruthy();

    // Displays formatted sizes
    expect(screen.getByText("(500.0 KB)")).toBeTruthy();
    expect(screen.getByText("(2.0 KB)")).toBeTruthy();

    // Clicking remove triggers callback with specific attachment id
    const removePdfBtn = screen.getByLabelText("Remove financial_report.pdf");
    fireEvent.click(removePdfBtn);
    expect(onRemove).toHaveBeenCalledWith(101);
  });

  it("handles duplicate attachment copy prevention logic correctly", () => {
    // Test the idempotent guard mechanism used in ComposePage
    let forwardAttsRefValue: string | null = null;
    const mockCopyFn = vi.fn();

    const loadForwardAttachments = (forwardId: string) => {
      if (forwardAttsRefValue === forwardId) {
        // Skip duplicate load/copy
        return;
      }
      forwardAttsRefValue = forwardId;
      mockCopyFn(forwardId);
    };

    // First trigger for forward email "42"
    loadForwardAttachments("42");
    expect(mockCopyFn).toHaveBeenCalledTimes(1);
    expect(mockCopyFn).toHaveBeenCalledWith("42");

    // Component rerender / autosave trigger with same forwardId "42"
    loadForwardAttachments("42");
    expect(mockCopyFn).toHaveBeenCalledTimes(1); // Still 1, no duplicate copy call

    // Switching to a different forwarded email "88"
    loadForwardAttachments("88");
    expect(mockCopyFn).toHaveBeenCalledTimes(2);
    expect(mockCopyFn).toHaveBeenCalledWith("88");
  });

  it("recovers from a transient failure and allows retry without duplicating", async () => {
    let forwardAttsRefValue: string | null = null;
    let shouldFail = true;
    let errorWarning: string | null = null;
    const mockCopyFn = vi.fn();

    const executeCopy = async (forwardId: string) => {
      if (forwardAttsRefValue === forwardId) {
        return;
      }
      forwardAttsRefValue = forwardId;
      try {
        if (shouldFail) {
          throw new Error("Network timeout during attachment clone");
        }
        mockCopyFn(forwardId);
        errorWarning = null;
      } catch (err: unknown) {
        // Safe reset: resets ref so user/component can retry
        forwardAttsRefValue = null;
        errorWarning = `Forwarding attachments warning: ${err instanceof Error ? err.message : String(err)}`;
      }
    };

    // First attempt fails due to transient network failure
    await executeCopy("42");
    expect(mockCopyFn).not.toHaveBeenCalled();
    expect(forwardAttsRefValue).toBeNull();
    expect(errorWarning).toContain("Forwarding attachments warning: Network timeout");

    // Retry succeeds
    shouldFail = false;
    await executeCopy("42");
    expect(mockCopyFn).toHaveBeenCalledTimes(1);
    expect(mockCopyFn).toHaveBeenCalledWith("42");
    expect(forwardAttsRefValue).toBe("42");
    expect(errorWarning).toBeNull();

    // Subsequent rerender/autosave with same forwardId does not trigger duplicate copy
    await executeCopy("42");
    expect(mockCopyFn).toHaveBeenCalledTimes(1);
  });
});
</file>

