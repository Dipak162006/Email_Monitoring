<file path="frontend/src/pages/CampaignRecipientsPage.tsx">
import React, { useState } from "react";
import { useParams, Link } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  ArrowLeft,
  ArrowRight,
  RefreshCw,
  UserPlus,
  UploadCloud,
  ShieldCheck,
  CheckCircle2,
  AlertCircle,
  ChevronLeft,
  ChevronRight,
} from "lucide-react";

import { useWorkspace } from "../hooks/useWorkspace";
import { campaignsApi, RequestError } from "../services/api";
import type {
  CampaignRecipient,
  CampaignRecipientCreatePayload,
  CampaignRecipientUpdatePayload,
  CampaignRecipientImportResponse,
} from "../types/campaign";

import { CampaignStatusBadge } from "../components/campaigns/CampaignStatusBadge";
import { RecipientSummaryCards } from "../components/campaigns/recipients/RecipientSummaryCards";
import { RecipientManualForm } from "../components/campaigns/recipients/RecipientManualForm";
import { RecipientCsvImport } from "../components/campaigns/recipients/RecipientCsvImport";
import { RecipientToolbar } from "../components/campaigns/recipients/RecipientToolbar";
import { RecipientTable } from "../components/campaigns/recipients/RecipientTable";
import { RecipientMobileCard } from "../components/campaigns/recipients/RecipientMobileCard";
import { RecipientDeleteModal } from "../components/campaigns/recipients/RecipientDeleteModal";
import { RecipientEditModal } from "../components/campaigns/recipients/RecipientEditModal";
import {
  RecipientSkeleton,
  RecipientEmptyAudience,
  RecipientSearchEmpty,
  RecipientErrorState,
} from "../components/campaigns/recipients/RecipientStates";

export const CampaignRecipientsPage: React.FC = () => {
  const { campaignId } = useParams<{ campaignId: string }>();
  const campaignIdNum = Number(campaignId);
  const queryClient = useQueryClient();
  const { currentCompanyId, currentRole } = useWorkspace();

  // Toast feedback state
  const [toastMessage, setToastMessage] = useState<{
    text: string;
    type: "success" | "error" | "info";
  } | null>(null);

  const showToast = (
    text: string,
    type: "success" | "error" | "info" = "success"
  ) => {
    setToastMessage({ text, type });
    setTimeout(() => {
      setToastMessage(null);
    }, 3500);
  };

  const isAdminOrOwner = currentRole === "OWNER" || currentRole === "ADMIN";

  // Navigation & Tabs state
  const [activeTab, setActiveTab] = useState<"manual" | "csv">("manual");

  // Filtering & Pagination state
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState("ALL");
  const [currentPage, setCurrentPage] = useState(1);
  const [pageSize, setPageSize] = useState(50);

  // Modals state
  const [deleteModal, setDeleteModal] = useState<{
    isOpen: boolean;
    recipient: CampaignRecipient | null;
  }>({ isOpen: false, recipient: null });

  const [editModal, setEditModal] = useState<{
    isOpen: boolean;
    recipient: CampaignRecipient | null;
  }>({ isOpen: false, recipient: null });

  // 1. Fetch Campaign Details
  const {
    data: campaign,
    isLoading: isCampaignLoading,
    refetch: refetchCampaign,
  } = useQuery({
    queryKey: ["campaigns", currentCompanyId, "detail", campaignIdNum],
    queryFn: () => {
      if (!currentCompanyId || !campaignIdNum) throw new Error("Missing parameters");
      return campaignsApi.getCampaign(currentCompanyId, campaignIdNum);
    },
    enabled: Boolean(currentCompanyId && campaignIdNum),
    staleTime: 30000,
  });

  // 2. Fetch Recipients List
  const {
    data: loadedRecipients = [],
    isLoading: isRecipientsLoading,
    isError: isRecipientsError,
    error: recipientsError,
    refetch: refetchRecipients,
    isFetching: isRecipientsFetching,
  } = useQuery({
    queryKey: [
      "campaigns",
      currentCompanyId,
      campaignIdNum,
      "recipients",
      { statusFilter, searchQuery, currentPage, pageSize },
    ],
    queryFn: () => {
      if (!currentCompanyId || !campaignIdNum) throw new Error("Missing parameters");
      return campaignsApi.listRecipients(currentCompanyId, campaignIdNum, {
        status: statusFilter !== "ALL" ? statusFilter : undefined,
        search: searchQuery.trim() || undefined,
        limit: pageSize,
        offset: (currentPage - 1) * pageSize,
      });
    },
    enabled: Boolean(currentCompanyId && campaignIdNum),
  });

  const isDraft = campaign?.status === "DRAFT";
  const isEditable = Boolean(isDraft && isAdminOrOwner);

  // Invalidation helper
  const invalidateRecipientQueries = () => {
    queryClient.invalidateQueries({
      queryKey: ["campaigns", currentCompanyId, campaignIdNum, "recipients"],
    });
    queryClient.invalidateQueries({
      queryKey: ["campaigns", currentCompanyId, "detail", campaignIdNum],
    });
    queryClient.invalidateQueries({
      queryKey: ["campaigns", currentCompanyId],
    });
  };

  // 3. Add Single Recipient Mutation
  const createMutation = useMutation({
    mutationFn: (payload: CampaignRecipientCreatePayload) => {
      if (!currentCompanyId || !campaignIdNum) throw new Error("Missing parameters");
      return campaignsApi.createRecipient(currentCompanyId, campaignIdNum, payload);
    },
    onSuccess: (newRecipient) => {
      invalidateRecipientQueries();
      showToast(`Added ${newRecipient.email} to campaign audience.`);
    },
    onError: (err: unknown) => {
      const msg =
        err instanceof RequestError
          ? String(err.detail || err.message)
          : "Failed to add recipient.";
      showToast(msg, "error");
    },
  });

  // 4. Update Recipient Mutation
  const updateMutation = useMutation({
    mutationFn: ({
      recipientId,
      payload,
    }: {
      recipientId: number;
      payload: CampaignRecipientUpdatePayload;
    }) => {
      if (!currentCompanyId || !campaignIdNum) throw new Error("Missing parameters");
      return campaignsApi.updateRecipient(
        currentCompanyId,
        campaignIdNum,
        recipientId,
        payload
      );
    },
    onSuccess: (updated) => {
      invalidateRecipientQueries();
      setEditModal({ isOpen: false, recipient: null });
      showToast(`Updated recipient "${updated.email}".`);
    },
    onError: (err: unknown) => {
      const msg =
        err instanceof RequestError
          ? String(err.detail || err.message)
          : "Failed to update recipient.";
      showToast(msg, "error");
    },
  });

  // 5. Delete Recipient Mutation
  const deleteMutation = useMutation({
    mutationFn: (recipientId: number) => {
      if (!currentCompanyId || !campaignIdNum) throw new Error("Missing parameters");
      return campaignsApi.deleteRecipient(currentCompanyId, campaignIdNum, recipientId);
    },
    onSuccess: () => {
      invalidateRecipientQueries();
      const removedEmail = deleteModal.recipient?.email;
      setDeleteModal({ isOpen: false, recipient: null });
      showToast(
        removedEmail
          ? `Removed ${removedEmail} from audience.`
          : "Recipient removed from audience."
      );
    },
    onError: (err: unknown) => {
      setDeleteModal({ isOpen: false, recipient: null });
      const msg =
        err instanceof RequestError
          ? String(err.detail || err.message)
          : "Failed to remove recipient.";
      showToast(msg, "error");
    },
  });

  // 6. CSV Import Handler
  const handleCsvImport = async (file: File): Promise<CampaignRecipientImportResponse | null> => {
    if (!currentCompanyId || !campaignIdNum) return null;
    try {
      const res = await campaignsApi.importRecipientsCsv(
        currentCompanyId,
        campaignIdNum,
        file
      );
      invalidateRecipientQueries();
      showToast(
        `Import complete: ${res.inserted_count} added, ${res.skipped_duplicates_count} skipped.`
      );
      return res;
    } catch (err: unknown) {
      const msg =
        err instanceof RequestError
          ? String(err.detail || err.message)
          : "Failed to import CSV.";
      showToast(msg, "error");
      return null;
    }
  };

  const handleRefresh = () => {
    refetchCampaign();
    refetchRecipients();
    showToast("Audience records refreshed.", "info");
  };

  const handleCopyEmail = (emailText: string) => {
    navigator.clipboard?.writeText(emailText).then(() => {
      showToast(`Copied ${emailText} to clipboard.`, "info");
    });
  };

  const handleClearFilters = () => {
    setSearchQuery("");
    setStatusFilter("ALL");
    setCurrentPage(1);
  };

  const totalLoaded = loadedRecipients.length;
  const hasActiveFilters = Boolean(searchQuery || statusFilter !== "ALL");

  return (
    <div className="w-full max-w-[1440px] mx-auto min-w-0 px-3 sm:px-4 md:px-6 lg:px-8 py-6 space-y-6 box-border">
      {/* 1. Header & Navigation */}
      <div className="flex flex-col gap-4">
        {/* Breadcrumb row */}
        <div className="flex flex-wrap items-center justify-between gap-3">
          <nav className="flex items-center gap-1.5 text-xs sm:text-sm text-slate-500 truncate">
            <Link
              to="/campaigns"
              className="hover:text-indigo-600 transition-colors flex items-center gap-1 text-slate-600"
            >
              <ArrowLeft className="h-3.5 w-3.5" />
              <span>Back to Campaigns</span>
            </Link>
            <span className="text-slate-300">/</span>
            <Link
              to={`/campaigns/${campaignIdNum}`}
              className="text-slate-600 hover:text-indigo-600 transition-colors font-medium truncate max-w-[200px] sm:max-w-xs"
            >
              {campaign?.name || `Campaign #${campaignIdNum}`}
            </Link>
            <span className="text-slate-300">/</span>
            <span className="text-slate-900 font-semibold">Audience Records</span>
          </nav>

          <div className="flex items-center gap-2 shrink-0">
            {campaign && <CampaignStatusBadge status={campaign.status} />}
            <button
              type="button"
              onClick={handleRefresh}
              disabled={isRecipientsFetching}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white border border-slate-200 hover:bg-slate-50 text-slate-700 text-xs font-medium transition-colors shadow-2xs disabled:opacity-50"
            >
              <RefreshCw
                className={`h-3.5 w-3.5 text-indigo-600 ${
                  isRecipientsFetching ? "animate-spin" : ""
                }`}
              />
              <span className="hidden sm:inline">Refresh List</span>
            </button>
            <Link
              to={campaignIdNum ? `/campaigns/${campaignIdNum}` : "/campaigns"}
              className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-semibold shadow-2xs transition-all shrink-0"
            >
              <span>Return to Details</span>
              <ArrowRight className="h-3.5 w-3.5" />
            </Link>
          </div>
        </div>

        {/* Main Headline */}
        <div className="flex flex-col md:flex-row md:items-end justify-between gap-3">
          <div className="min-w-0">
            <div className="flex flex-wrap items-center gap-3">
              <h1 className="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight">
                Campaign Recipients
              </h1>
              <span className="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-50 text-indigo-700 border border-indigo-200/60">
                {(campaign?.recipient_count ?? totalLoaded).toLocaleString()} target records
              </span>
            </div>
            <p className="text-xs sm:text-sm text-slate-500 mt-1 max-w-3xl leading-relaxed">
              Manage the audience and recipient list for this campaign. Audience records define the intended dispatch scope and are pre-screened for delivery safety.
            </p>
          </div>
        </div>
      </div>

      {/* 2. Recipient Metric Cards */}
      <RecipientSummaryCards
        campaign={campaign || null}
        recipients={loadedRecipients}
        isLoading={isCampaignLoading || isRecipientsLoading}
      />

      {/* 3. Ingestion Methods Box (Draft & Admin Only) */}
      <div className="bg-white rounded-xl border border-slate-200/80 shadow-2xs overflow-hidden min-w-0">
        {!isDraft ? (
          <div className="p-4 bg-slate-50/70 border-b border-slate-200 text-xs text-slate-600 flex items-center gap-2">
            <AlertCircle className="h-4 w-4 text-amber-600 shrink-0" />
            <span>
              Recipients cannot be modified when campaign is in{" "}
              <strong className="text-slate-800">{campaign?.status}</strong> status. Audience records can only be configured while in DRAFT.
            </span>
          </div>
        ) : !isAdminOrOwner ? (
          <div className="p-4 bg-slate-50/70 border-b border-slate-200 text-xs text-slate-600 flex items-center gap-2">
            <AlertCircle className="h-4 w-4 text-slate-500 shrink-0" />
            <span>
              Read-only view: Only workspace Admins and Owners can add, import, or remove recipients.
            </span>
          </div>
        ) : (
          <>
            {/* Tabs Header */}
            <div className="flex items-center px-4 sm:px-6 pt-3 gap-4 bg-slate-50/60 border-b border-slate-200">
              <button
                type="button"
                onClick={() => setActiveTab("manual")}
                className={`pb-3 px-1 text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 border-b-2 ${
                  activeTab === "manual"
                    ? "text-indigo-600 border-indigo-600"
                    : "text-slate-500 border-transparent hover:text-slate-800"
                }`}
              >
                <UserPlus className="h-4 w-4" />
                <span>Add Manually</span>
              </button>
              <button
                type="button"
                onClick={() => setActiveTab("csv")}
                className={`pb-3 px-1 text-xs sm:text-sm font-semibold transition-all flex items-center gap-2 border-b-2 ${
                  activeTab === "csv"
                    ? "text-indigo-600 border-indigo-600"
                    : "text-slate-500 border-transparent hover:text-slate-800"
                }`}
              >
                <UploadCloud className="h-4 w-4" />
                <span>Import CSV</span>
                <span className="px-1.5 py-0.2 rounded-full text-[10px] bg-slate-200 text-slate-700">
                  Batch
                </span>
              </button>
            </div>

            {/* Tab Contents */}
            <div className="p-4 sm:p-6">
              {activeTab === "manual" ? (
                <RecipientManualForm
                  onSubmit={async (payload) => {
                    await createMutation.mutateAsync(payload);
                  }}
                  isLoading={createMutation.isPending}
                  disabled={!isEditable}
                />
              ) : (
                <RecipientCsvImport
                  onImport={handleCsvImport}
                  disabled={!isEditable}
                />
              )}
            </div>
          </>
        )}
      </div>

      {/* 4. Search & Filter Toolbar */}
      <RecipientToolbar
        searchQuery={searchQuery}
        onSearchChange={(q) => {
          setSearchQuery(q);
          setCurrentPage(1);
        }}
        statusFilter={statusFilter}
        onStatusFilterChange={(s) => {
          setStatusFilter(s);
          setCurrentPage(1);
        }}
        totalFilteredCount={totalLoaded}
        totalLoadedCount={campaign?.recipient_count ?? totalLoaded}
        onClearFilters={handleClearFilters}
        hasActiveFilters={hasActiveFilters}
      />

      {/* 5. Audience Records Main Table / Cards View */}
      <div className="w-full min-w-0 bg-white rounded-xl border border-slate-200/80 shadow-2xs overflow-hidden">
        {isRecipientsLoading ? (
          <RecipientSkeleton />
        ) : isRecipientsError ? (
          <RecipientErrorState
            message={recipientsError instanceof Error ? recipientsError.message : undefined}
            onRetry={() => refetchRecipients()}
          />
        ) : totalLoaded === 0 && !hasActiveFilters ? (
          <RecipientEmptyAudience
            isEditable={isEditable}
            onSelectTab={(t) => setActiveTab(t)}
          />
        ) : totalLoaded === 0 && hasActiveFilters ? (
          <RecipientSearchEmpty onClearFilters={handleClearFilters} />
        ) : (
          <>
            {/* Desktop Table View */}
            <div className="hidden md:block w-full min-w-0">
              <RecipientTable
                recipients={loadedRecipients}
                isEditable={isEditable}
                onEdit={(r) => setEditModal({ isOpen: true, recipient: r })}
                onDelete={(r) => setDeleteModal({ isOpen: true, recipient: r })}
                onCopyEmail={handleCopyEmail}
              />
            </div>

            {/* Mobile Cards View */}
            <div className="block md:hidden w-full divide-y divide-slate-100 p-3 space-y-3">
              {loadedRecipients.map((recipient) => (
                <RecipientMobileCard
                  key={recipient.id}
                  recipient={recipient}
                  isEditable={isEditable}
                  onEdit={(r) => setEditModal({ isOpen: true, recipient: r })}
                  onDelete={(r) => setDeleteModal({ isOpen: true, recipient: r })}
                  onCopyEmail={handleCopyEmail}
                />
              ))}
            </div>

            {/* Bounded Pagination Footer */}
            <div className="px-4 sm:px-6 py-3 bg-slate-50/70 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-slate-600 text-xs">
              <div className="flex items-center gap-2">
                <span>Rows per page:</span>
                <select
                  value={pageSize}
                  onChange={(e) => {
                    setPageSize(Number(e.target.value));
                    setCurrentPage(1);
                  }}
                  className="bg-white border border-slate-200 rounded px-2 py-1 text-slate-800 text-xs focus:outline-none cursor-pointer"
                >
                  <option value={10}>10</option>
                  <option value={25}>25</option>
                  <option value={50}>50</option>
                  <option value={100}>100</option>
                </select>
              </div>

              <div className="flex items-center gap-3">
                <span>
                  Page {currentPage}
                </span>
                <div className="flex items-center gap-1">
                  <button
                    type="button"
                    onClick={() => setCurrentPage((p) => Math.max(1, p - 1))}
                    disabled={currentPage <= 1}
                    className="p-1 rounded bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                    title="Previous page"
                  >
                    <ChevronLeft className="h-4 w-4" />
                  </button>
                  <button
                    type="button"
                    onClick={() => setCurrentPage((p) => p + 1)}
                    disabled={totalLoaded < pageSize}
                    className="p-1 rounded bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed transition-colors"
                    title="Next page"
                  >
                    <ChevronRight className="h-4 w-4" />
                  </button>
                </div>
              </div>
            </div>
          </>
        )}
      </div>

      {/* 6. Informational Deliverability Safety Banner */}
      <div className="rounded-xl bg-slate-50/80 border border-slate-200 p-4 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
        <div className="flex items-center gap-3 min-w-0">
          <ShieldCheck className="h-5 w-5 text-indigo-600 shrink-0" />
          <div className="min-w-0">
            <p className="text-xs font-semibold text-slate-900 truncate">
              Strict RFC 5322 validation active
            </p>
            <p className="text-xs text-slate-500 truncate">
              Syntax validation and deduplication are enforced during recipient ingestion.
            </p>
          </div>
        </div>
      </div>

      {/* 7. Next Step / Return to Detail Callout */}
      <div className="rounded-xl bg-white border border-indigo-100 p-4.5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 shadow-2xs">
        <div className="flex items-center gap-3 min-w-0">
          <div className="w-9 h-9 rounded-lg bg-indigo-50 border border-indigo-100 text-indigo-600 flex items-center justify-center shrink-0">
            <CheckCircle2 className="h-5 w-5" />
          </div>
          <div className="min-w-0">
            <p className="text-xs sm:text-sm font-semibold text-slate-900 truncate">
              {isDraft ? "Audience configured in DRAFT status" : `Campaign status: ${campaign?.status}`}
            </p>
            <p className="text-xs text-slate-500 truncate">
              {isDraft
                ? "Recipients are staged. Return to the campaign detail page to run preflight validation and schedule or dispatch."
                : "Audience records are frozen for this lifecycle status."}
            </p>
          </div>
        </div>
        <Link
          to={campaignIdNum ? `/campaigns/${campaignIdNum}` : "/campaigns"}
          className="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-700 text-white text-xs sm:text-sm font-semibold transition-all shadow-2xs shrink-0"
        >
          <span>Continue to Campaign Details</span>
          <ArrowRight className="h-4 w-4" />
        </Link>
      </div>

      {/* 8. Delete Confirmation Dialog */}
      <RecipientDeleteModal
        isOpen={deleteModal.isOpen}
        recipient={deleteModal.recipient}
        onClose={() => setDeleteModal({ isOpen: false, recipient: null })}
        onConfirm={() => {
          if (deleteModal.recipient) {
            deleteMutation.mutate(deleteModal.recipient.id);
          }
        }}
        isLoading={deleteMutation.isPending}
      />

      {/* 8. Edit Recipient Dialog */}
      <RecipientEditModal
        isOpen={editModal.isOpen}
        recipient={editModal.recipient}
        onClose={() => setEditModal({ isOpen: false, recipient: null })}
        onSave={(recipientId, payload) => {
          updateMutation.mutate({ recipientId, payload });
        }}
        isLoading={updateMutation.isPending}
      />

      {/* Toast Notification */}
      {toastMessage && (
        <div
          role="status"
          aria-live="polite"
          className={`fixed bottom-6 right-6 z-50 px-4 py-2.5 rounded-lg text-xs font-semibold shadow-xl border flex items-center gap-2 animate-in slide-in-from-bottom-2 ${
            toastMessage.type === "error"
              ? "bg-rose-900 border-rose-800 text-rose-100"
              : toastMessage.type === "info"
              ? "bg-slate-900 border-slate-800 text-slate-100"
              : "bg-slate-900 border-slate-800 text-slate-100"
          }`}
        >
          <span>{toastMessage.text}</span>
        </div>
      )}
    </div>
  );
};
</file>

<file path="frontend/src/pages/DomainsPage.tsx">
import { useState, useMemo } from "react";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  Globe,
  Plus,
  RefreshCw,
  Search,
  Lock,
} from "lucide-react";
import { useWorkspace } from "../hooks/useWorkspace";
import { useNotification } from "../hooks/useNotification";
import { domainsApi } from "../services/api";
import type { Domain, DomainVerificationStatus } from "../types/domains";
import { DomainStatusBadge } from "../components/domains/DomainStatusBadge";
import { DomainDnsStatus } from "../components/domains/DomainDnsStatus";
import { DomainActionMenu } from "../components/domains/DomainActionMenu";
import { DomainDetailsDrawer } from "../components/domains/DomainDetailsDrawer";
import { AddDomainDialog } from "../components/domains/AddDomainDialog";
import { EditDkimDialog } from "../components/domains/EditDkimDialog";
import { DeleteDomainDialog } from "../components/domains/DeleteDomainDialog";
import { Button } from "../components/ui/Button";
import { EmptyState } from "../components/ui/EmptyState";
import { ErrorState } from "../components/ui/ErrorState";
import { cn } from "../lib/utils";

type StatusFilter = "ALL" | DomainVerificationStatus;

export function DomainsPage() {
  const queryClient = useQueryClient();

  // Active workspace & permissions context
  const {
    currentCompany,
    currentCompanyId,
    currentRole,
    isLoading: isWorkspaceLoading,
    isError: isWorkspaceError,
  } = useWorkspace();

  const canManage = currentRole === "OWNER" || currentRole === "ADMIN";
  const isMember = currentRole === "MEMBER";

  // Global notification feedback
  const { showNotification } = useNotification();

  // Modal / Drawer states
  const [isAddModalOpen, setIsAddModalOpen] = useState(false);
  const [selectedDomainForDrawer, setSelectedDomainForDrawer] = useState<Domain | null>(null);
  const [selectedDomainForEdit, setSelectedDomainForEdit] = useState<Domain | null>(null);
  const [selectedDomainForDelete, setSelectedDomainForDelete] = useState<Domain | null>(null);

  // Search and status filter
  const [searchQuery, setSearchQuery] = useState("");
  const [statusFilter, setStatusFilter] = useState<StatusFilter>("ALL");

  // Per-domain verification state
  const [verifyingDomainId, setVerifyingDomainId] = useState<number | null>(null);

  // Fetch domains for active company
  const {
    data: domains = [],
    isLoading: isDomainsLoading,
    isError: isDomainsError,
    error: domainsErrorObj,
    refetch: refetchDomains,
    isFetching: isRefetching,
  } = useQuery({
    queryKey: ["company-domains", currentCompanyId],
    queryFn: () => domainsApi.listDomains(currentCompanyId!),
    enabled: !!currentCompanyId,
    staleTime: 30000,
  });

  // Verify Domain Mutation
  const verifyMutation = useMutation({
    mutationFn: async ({
      companyId,
      domainId,
    }: {
      companyId: number;
      domainId: number;
    }) => {
      if (!canManage) {
        throw new Error("You do not have permission to verify domains in this workspace.");
      }
      setVerifyingDomainId(domainId);
      return domainsApi.verifyDomain(companyId, domainId);
    },
    onSuccess: (updatedDomain) => {
      setVerifyingDomainId(null);
      queryClient.invalidateQueries({ queryKey: ["company-domains", currentCompanyId] });
      // If the drawer is open for this domain, keep it in sync
      if (selectedDomainForDrawer && selectedDomainForDrawer.id === updatedDomain.id) {
        setSelectedDomainForDrawer(updatedDomain);
      }
      showNotification(`DNS verification complete for ${updatedDomain.domain_name}.`);
    },
    onError: (err: unknown) => {
      setVerifyingDomainId(null);
      const errorObj = err as { detail?: string; message?: string };
      showNotification(
        errorObj.detail || errorObj.message || "DNS verification failed. Please try again.",
        "error"
      );
    },
  });

  // Client-side filtering by search query and verification_status
  const filteredDomains = useMemo(() => {
    return domains.filter((dom) => {
      // Status filter
      if (statusFilter !== "ALL" && dom.verification_status !== statusFilter) {
        return false;
      }
      // Search query
      if (searchQuery.trim()) {
        const q = searchQuery.toLowerCase().trim();
        const matchesName = dom.domain_name.toLowerCase().includes(q);
        const matchesSelector = dom.dkim_selector
          ? dom.dkim_selector.toLowerCase().includes(q)
          : false;
        if (!matchesName && !matchesSelector) {
          return false;
        }
      }
      return true;
    });
  }, [domains, statusFilter, searchQuery]);

  const handleVerify = (domain: Domain) => {
    if (!currentCompanyId) return;
    verifyMutation.mutate({
      companyId: currentCompanyId,
      domainId: domain.id,
    });
  };

  const handleDrawerVerify = () => {
    if (selectedDomainForDrawer) {
      handleVerify(selectedDomainForDrawer);
    }
  };

  const formatDate = (dateStr: string | null) => {
    if (!dateStr) return "Never";
    try {
      const date = new Date(dateStr);
      const now = new Date();
      const diffMs = now.getTime() - date.getTime();
      const diffMins = Math.floor(diffMs / (1000 * 60));
      const diffHours = Math.floor(diffMins / 60);
      const diffDays = Math.floor(diffHours / 24);

      if (diffMins < 1) return "Just now";
      if (diffMins < 60) return `${diffMins} min${diffMins === 1 ? "" : "s"} ago`;
      if (diffHours < 24) return `${diffHours} hour${diffHours === 1 ? "" : "s"} ago`;
      if (diffDays < 7) return `${diffDays} day${diffDays === 1 ? "" : "s"} ago`;

      return date.toLocaleDateString(undefined, {
        month: "short",
        day: "numeric",
        year: "numeric",
      });
    } catch {
      return dateStr;
    }
  };

  // Workspace error state
  if (isWorkspaceError || (!isWorkspaceLoading && !currentCompany)) {
    return (
      <div className="py-8">
        <ErrorState
          title="Workspace Unavailable"
          message="Could not load your active workspace. Please check your company connection."
        />
      </div>
    );
  }

  return (
    <div className="space-y-6">
      {/* Header Section */}
      <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <div className="flex items-center gap-3 flex-wrap">
            <h1 className="text-xl font-bold tracking-tight text-slate-900">
              Domains
            </h1>
            {!isDomainsLoading && (
              <span className="px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700 text-xs font-semibold">
                {domains.length} {domains.length === 1 ? "Domain" : "Domains"} Configured
              </span>
            )}
          </div>
          <p className="text-xs text-slate-500 mt-1">
            Manage and verify DNS authentication for your company's email domains.
          </p>
        </div>

        {/* Action Button Group */}
        <div className="flex items-center gap-2.5 shrink-0">
          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={() => refetchDomains()}
            disabled={isRefetching || isDomainsLoading}
            className="gap-1.5 text-xs text-slate-700 bg-white border-slate-200 hover:bg-slate-50 cursor-pointer shadow-2xs"
            title="Refresh domain DNS data"
          >
            <RefreshCw
              className={cn("w-3.5 h-3.5 text-slate-500", (isRefetching || isDomainsLoading) && "animate-spin")}
            />
            <span>Refresh</span>
          </Button>

          {canManage && (
            <Button
              type="button"
              size="sm"
              onClick={() => setIsAddModalOpen(true)}
              className="gap-1.5 text-xs bg-indigo-600 hover:bg-indigo-700 text-white font-semibold cursor-pointer shadow-2xs"
            >
              <Plus className="w-3.5 h-3.5" />
              <span>Add Domain</span>
            </Button>
          )}
        </div>
      </div>

      {/* Read-Only Member Banner */}
      {isMember && (
        <div
          className="rounded-xl bg-slate-100/80 border border-slate-200 px-4 py-2.5 flex items-center gap-2.5 text-slate-700 text-xs"
          role="note"
        >
          <Lock className="w-4 h-4 text-slate-500 shrink-0" />
          <span>
            <strong>Read-Only Access:</strong> You are currently signed in as a workspace Member. Domain additions, modifications, and deletions are disabled.
          </span>
        </div>
      )}

      {/* Filter & Search Toolbar */}
      <div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        {/* Search */}
        <div className="relative flex-1 max-w-md">
          <Search className="w-3.5 h-3.5 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none" />
          <input
            type="text"
            value={searchQuery}
            onChange={(e) => setSearchQuery(e.target.value)}
            placeholder="Search domain name or selector..."
            className="w-full pl-9 pr-4 py-1.5 text-xs bg-white border border-slate-200 rounded-lg text-slate-900 placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 shadow-2xs transition-all"
          />
        </div>

        {/* Status Filter Tabs */}
        <div className="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0">
          <span className="text-xs font-medium text-slate-500 shrink-0 mr-1">
            Status:
          </span>
          <div className="flex items-center gap-1 bg-slate-100 p-1 rounded-lg">
            {(["ALL", "VERIFIED", "WARNING", "FAILED", "PENDING"] as StatusFilter[]).map((tab) => {
              const isActive = statusFilter === tab;
              const label =
                tab === "ALL"
                  ? "All"
                  : tab.charAt(0) + tab.slice(1).toLowerCase();

              return (
                <button
                  key={tab}
                  type="button"
                  onClick={() => setStatusFilter(tab)}
                  className={cn(
                    "px-2.5 py-1 rounded-md text-xs font-medium transition-all cursor-pointer",
                    isActive
                      ? "bg-white text-slate-900 font-semibold shadow-2xs"
                      : "text-slate-600 hover:text-slate-900"
                  )}
                >
                  {label}
                </button>
              );
            })}
          </div>
        </div>
      </div>

      {/* Main Content Area */}
      {isDomainsLoading ? (
        /* Polished Skeleton Loading State */
        <div className="bg-white rounded-xl border border-slate-200 p-4 shadow-2xs space-y-3">
          <div className="flex items-center justify-between pb-3 border-b border-slate-100">
            <div className="h-4 w-32 bg-slate-100 animate-pulse rounded" />
            <div className="h-4 w-24 bg-slate-100 animate-pulse rounded" />
          </div>
          <div className="space-y-3">
            {[1, 2, 3, 4].map((i) => (
              <div
                key={i}
                className="h-14 w-full bg-slate-50 animate-pulse rounded-lg border border-slate-100"
              />
            ))}
          </div>
        </div>
      ) : isDomainsError ? (
        /* Error State */
        <ErrorState
          title="Failed to Load Domains"
          message={
            (domainsErrorObj as { detail?: string; message?: string })?.detail ||
            "Unable to retrieve registered domains for this company. Please try again."
          }
          onRetry={() => refetchDomains()}
        />
      ) : domains.length === 0 ? (
        /* Empty State */
        <EmptyState
          icon={<Globe className="w-6 h-6 text-slate-400" />}
          title="No domains configured"
          description="Add your first domain to verify its DNS authentication settings for email."
          actionLabel={canManage ? "+ Add Domain" : undefined}
          onAction={canManage ? () => setIsAddModalOpen(true) : undefined}
        />
      ) : filteredDomains.length === 0 ? (
        /* No Search / Filter Matches */
        <div className="bg-white rounded-xl border border-dashed border-slate-200 p-8 text-center">
          <Search className="w-8 h-8 text-slate-300 mx-auto mb-2" />
          <h4 className="text-xs font-semibold text-slate-800">No matching domains</h4>
          <p className="text-[11px] text-slate-500 mt-0.5">
            No domains matched your search query or filter.
          </p>
          <Button
            type="button"
            variant="outline"
            size="sm"
            onClick={() => {
              setSearchQuery("");
              setStatusFilter("ALL");
            }}
            className="mt-3 text-xs"
          >
            Clear Filters
          </Button>
        </div>
      ) : (
        /* Loaded Table & Mobile Cards */
        <div className="space-y-4">
          {/* Desktop Table (>= 1024px) */}
          <div className="hidden lg:block bg-white rounded-xl border border-slate-200 shadow-2xs overflow-visible">
            <table className="w-full text-left border-collapse">
              <thead>
                <tr className="bg-slate-50/80 border-b border-slate-200 text-slate-500 text-[11px] font-bold uppercase tracking-wider select-none">
                  <th scope="col" className="py-3 px-4">
                    Domain Name
                  </th>
                  <th scope="col" className="py-3 px-4">
                    Overall Status
                  </th>
                  <th scope="col" className="py-3 px-4">
                    DNS Diagnostics
                  </th>
                  <th scope="col" className="py-3 px-4">
                    Last Checked
                  </th>
                  <th scope="col" className="py-3 px-4 text-right">
                    Actions
                  </th>
                </tr>
              </thead>
              <tbody className="divide-y divide-slate-100 text-xs">
                {filteredDomains.map((domain, index) => {
                  const isVerifying = verifyingDomainId === domain.id;

                  return (
                    <tr
                      key={domain.id}
                      className="hover:bg-slate-50/60 transition-colors group"
                    >
                      {/* Domain Name */}
                      <td className="py-3.5 px-4">
                        <div
                          onClick={() => setSelectedDomainForDrawer(domain)}
                          className="flex items-center gap-2.5 cursor-pointer"
                        >
                          <div className="w-7 h-7 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 group-hover:bg-indigo-600 group-hover:text-white transition-colors shrink-0">
                            <Globe className="w-3.5 h-3.5" />
                          </div>
                          <div className="flex flex-col min-w-0">
                            <span className="font-mono text-xs font-bold text-slate-900 group-hover:text-indigo-600 transition-colors truncate">
                              {domain.domain_name}
                            </span>
                            <span className="text-[11px] text-slate-400">
                              Added {formatDate(domain.created_at)}
                            </span>
                          </div>
                        </div>
                      </td>

                      {/* Overall Status */}
                      <td className="py-3.5 px-4">
                        <DomainStatusBadge status={domain.verification_status} size="sm" />
                      </td>

                      {/* DNS Diagnostics Matrix */}
                      <td className="py-3.5 px-4">
                        <DomainDnsStatus
                          mxStatus={domain.mx_status}
                          spfStatus={domain.spf_status}
                          dkimStatus={domain.dkim_status}
                          dmarcStatus={domain.dmarc_status}
                          dkimSelector={domain.dkim_selector}
                        />
                      </td>

                      {/* Last Checked */}
                      <td className="py-3.5 px-4">
                        <span className="font-mono text-[11px] text-slate-500">
                          {formatDate(domain.last_checked_at)}
                        </span>
                      </td>

                      {/* Actions */}
                      <td className="py-3.5 px-4 text-right">
                        <div className="flex items-center justify-end gap-1.5">
                          {canManage && (
                            <button
                              type="button"
                              onClick={() => handleVerify(domain)}
                              disabled={isVerifying}
                              className="px-2.5 py-1 rounded-lg bg-slate-100 hover:bg-slate-200/70 text-slate-700 text-xs font-medium transition-colors flex items-center gap-1 disabled:opacity-50 cursor-pointer"
                              title="Verify DNS authentication now"
                            >
                              <RefreshCw
                                className={cn("w-3 h-3 text-slate-500", isVerifying && "animate-spin")}
                              />
                              <span>{isVerifying ? "Verifying..." : "Verify"}</span>
                            </button>
                          )}

                          {/* 3-Dot Action Menu */}
                          <DomainActionMenu
                            domain={domain}
                            canManage={canManage}
                            isVerifying={isVerifying}
                            onViewDetails={(dom) => setSelectedDomainForDrawer(dom)}
                            onVerify={(dom) => handleVerify(dom)}
                            onEditDkim={(dom) => setSelectedDomainForEdit(dom)}
                            onDelete={(dom) => setSelectedDomainForDelete(dom)}
                            direction={index >= filteredDomains.length - 2 && filteredDomains.length > 2 ? "up" : "down"}
                          />
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>

          {/* Mobile Responsive Card Stack (< 1024px) */}
          <div className="lg:hidden space-y-3">
            {filteredDomains.map((domain) => {
              const isVerifying = verifyingDomainId === domain.id;

              return (
                <div
                  key={domain.id}
                  className="bg-white rounded-xl border border-slate-200 p-4 shadow-2xs space-y-3"
                >
                  <div className="flex items-start justify-between gap-2">
                    <div
                      onClick={() => setSelectedDomainForDrawer(domain)}
                      className="flex items-center gap-2.5 cursor-pointer min-w-0"
                    >
                      <div className="w-8 h-8 rounded-lg bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-600 shrink-0">
                        <Globe className="w-4 h-4" />
                      </div>
                      <div className="min-w-0">
                        <span className="font-mono text-xs font-bold text-slate-900 block truncate">
                          {domain.domain_name}
                        </span>
                        <p className="text-[11px] text-slate-400">
                          Added {formatDate(domain.created_at)}
                        </p>
                      </div>
                    </div>
                    <DomainStatusBadge status={domain.verification_status} size="sm" />
                  </div>

                  {/* DNS Matrix */}
                  <div className="pt-1">
                    <DomainDnsStatus
                      mxStatus={domain.mx_status}
                      spfStatus={domain.spf_status}
                      dkimStatus={domain.dkim_status}
                      dmarcStatus={domain.dmarc_status}
                      dkimSelector={domain.dkim_selector}
                    />
                  </div>

                  {/* Card Footer */}
                  <div className="flex items-center justify-between pt-2.5 border-t border-slate-100 text-xs">
                    <span className="font-mono text-[11px] text-slate-400">
                      Checked {formatDate(domain.last_checked_at)}
                    </span>
                    <div className="flex items-center gap-2">
                      {canManage && (
                        <Button
                          type="button"
                          variant="outline"
                          size="sm"
                          disabled={isVerifying}
                          onClick={() => handleVerify(domain)}
                          className="h-7 px-2.5 text-xs text-slate-700 border-slate-200"
                        >
                          <RefreshCw
                            className={cn("w-3 h-3 mr-1", isVerifying && "animate-spin")}
                          />
                          <span>{isVerifying ? "Checking..." : "Verify"}</span>
                        </Button>
                      )}
                      <Button
                        type="button"
                        size="sm"
                        onClick={() => setSelectedDomainForDrawer(domain)}
                        className="h-7 px-2.5 text-xs bg-indigo-600 hover:bg-indigo-700 text-white"
                      >
                        Details
                      </Button>

                      {/* Mobile 3-dot overflow */}
                      <DomainActionMenu
                        domain={domain}
                        canManage={canManage}
                        isVerifying={isVerifying}
                        onViewDetails={(dom) => setSelectedDomainForDrawer(dom)}
                        onVerify={(dom) => handleVerify(dom)}
                        onEditDkim={(dom) => setSelectedDomainForEdit(dom)}
                        onDelete={(dom) => setSelectedDomainForDelete(dom)}
                        direction="up"
                      />
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Details Slide-Over Sheet */}
      <DomainDetailsDrawer
        isOpen={Boolean(selectedDomainForDrawer)}
        onClose={() => setSelectedDomainForDrawer(null)}
        domain={selectedDomainForDrawer}
        canManage={canManage}
        isVerifying={verifyingDomainId === selectedDomainForDrawer?.id}
        onVerify={handleDrawerVerify}
        onEditDkim={() => {
          setSelectedDomainForEdit(selectedDomainForDrawer);
          setSelectedDomainForDrawer(null);
        }}
        onDelete={() => {
          setSelectedDomainForDelete(selectedDomainForDrawer);
          setSelectedDomainForDrawer(null);
        }}
      />

      {/* Add Domain Dialog */}
      {currentCompanyId && (
        <AddDomainDialog
          isOpen={isAddModalOpen}
          onClose={() => setIsAddModalOpen(false)}
          companyId={currentCompanyId}
          onSuccess={(newDomain) => {
            setIsAddModalOpen(false);
            queryClient.invalidateQueries({ queryKey: ["company-domains", currentCompanyId] });
            showNotification(`Domain ${newDomain.domain_name} added successfully.`);
          }}
        />
      )}

      {/* Edit DKIM Dialog */}
      {currentCompanyId && selectedDomainForEdit && (
        <EditDkimDialog
          isOpen={Boolean(selectedDomainForEdit)}
          onClose={() => setSelectedDomainForEdit(null)}
          domain={selectedDomainForEdit}
          companyId={currentCompanyId}
          onSuccess={(updatedDomain) => {
            setSelectedDomainForEdit(null);
            queryClient.invalidateQueries({ queryKey: ["company-domains", currentCompanyId] });
            showNotification(`DKIM configuration updated for ${updatedDomain.domain_name}.`);
          }}
        />
      )}

      {/* Delete Domain Confirmation Dialog */}
      {currentCompanyId && selectedDomainForDelete && (
        <DeleteDomainDialog
          isOpen={Boolean(selectedDomainForDelete)}
          onClose={() => setSelectedDomainForDelete(null)}
          domain={selectedDomainForDelete}
          companyId={currentCompanyId}
          onSuccess={(deletedDomain) => {
            setSelectedDomainForDelete(null);
            if (selectedDomainForDrawer?.id === deletedDomain.id) {
              setSelectedDomainForDrawer(null);
            }
            queryClient.invalidateQueries({ queryKey: ["company-domains", currentCompanyId] });
            queryClient.invalidateQueries({ queryKey: ["company-email-accounts"] });
            showNotification(`Domain ${deletedDomain.domain_name} deleted.`);
          }}
        />
      )}
    </div>
  );
}
</file>

<file path="frontend/src/pages/ProfilePage.tsx">
import { useState, useEffect, type FormEvent } from "react";
import {
  User as UserIcon,
  Lock,
  Shield,
  ShieldCheck,
  Eye,
  EyeOff,
  Check,
  X,
  AlertCircle,
  CheckCircle2,
  Loader2,
  Calendar,
  Info,
  CheckSquare,
} from "lucide-react";
import { useAuth } from "../hooks/useAuth";
import { authApi } from "../services/api";
import { cn } from "../lib/utils";

function formatMemberSince(dateStr?: string): string {
  if (!dateStr) return "Unknown";
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString("en-US", {
      month: "long",
      year: "numeric",
    });
  } catch {
    return "Unknown";
  }
}

export function ProfilePage() {
  const { user, refreshUser } = useAuth();

  // Personal Information State
  const [nameInput, setNameInput] = useState(user?.full_name ?? "");
  const [isSavingProfile, setIsSavingProfile] = useState(false);
  const [profileValidationError, setProfileValidationError] = useState<string | null>(null);
  const [profileSuccessMessage, setProfileSuccessMessage] = useState<string | null>(null);
  const [profileErrorMessage, setProfileErrorMessage] = useState<string | null>(null);

  // Change Password State
  const [currentPassword, setCurrentPassword] = useState("");
  const [newPassword, setNewPassword] = useState("");
  const [confirmPassword, setConfirmPassword] = useState("");
  const [showCurrentPassword, setShowCurrentPassword] = useState(false);
  const [showNewPassword, setShowNewPassword] = useState(false);
  const [showConfirmPassword, setShowConfirmPassword] = useState(false);
  const [isChangingPassword, setIsChangingPassword] = useState(false);
  const [passwordSuccessMessage, setPasswordSuccessMessage] = useState<string | null>(null);
  const [passwordErrorMessage, setPasswordErrorMessage] = useState<string | null>(null);

  // Sync profile name whenever user data updates
  useEffect(() => {
    if (user?.full_name !== undefined) {
      setNameInput(user.full_name ?? "");
      setProfileValidationError(null);
    }
  }, [user?.full_name]);

  // Profile calculations
  const isProfileDirty = nameInput.trim() !== (user?.full_name ?? "");
  const canSaveProfile = isProfileDirty && nameInput.trim().length > 0 && nameInput.length <= 255;

  const handleProfileReset = () => {
    setNameInput(user?.full_name ?? "");
    setProfileValidationError(null);
    setProfileSuccessMessage(null);
    setProfileErrorMessage(null);
  };

  const handleProfileSubmit = async (e: FormEvent) => {
    e.preventDefault();
    const trimmed = nameInput.trim();

    if (!trimmed) {
      setProfileValidationError("Full name is required and cannot be empty.");
      return;
    }

    if (trimmed.length > 255) {
      setProfileValidationError("Full name cannot exceed 255 characters.");
      return;
    }

    setIsSavingProfile(true);
    setProfileValidationError(null);
    setProfileSuccessMessage(null);
    setProfileErrorMessage(null);

    try {
      await authApi.updateProfile({ full_name: trimmed });
      // Instantly refresh user in AuthContext so topbar and sidebar reflect new name
      await refreshUser();
      setProfileSuccessMessage("Profile information saved successfully.");
    } catch (err: any) {
      const detail =
        err?.response?.data?.detail ||
        err?.message ||
        "Failed to update profile. Please try again.";
      setProfileErrorMessage(typeof detail === "string" ? detail : JSON.stringify(detail));
    } finally {
      setIsSavingProfile(false);
    }
  };

  // Password calculations
  const isMismatch = confirmPassword.length > 0 && newPassword !== confirmPassword;
  const isLengthValid = newPassword.length >= 8 && newPassword.length <= 128;
  const canSubmitPassword =
    currentPassword.length > 0 &&
    newPassword.length >= 8 &&
    newPassword.length <= 128 &&
    newPassword === confirmPassword;

  const handlePasswordSubmit = async (e: FormEvent) => {
    e.preventDefault();

    if (!currentPassword) {
      setPasswordErrorMessage("Current password is required.");
      return;
    }

    if (!isLengthValid) {
      setPasswordErrorMessage("New password must be between 8 and 128 characters.");
      return;
    }

    if (newPassword !== confirmPassword) {
      setPasswordErrorMessage("New password and confirmation do not match.");
      return;
    }

    setIsChangingPassword(true);
    setPasswordSuccessMessage(null);
    setPasswordErrorMessage(null);

    try {
      await authApi.changePassword({
        current_password: currentPassword,
        new_password: newPassword,
      });

      // Clear password fields on successful response
      setCurrentPassword("");
      setNewPassword("");
      setConfirmPassword("");
      setShowCurrentPassword(false);
      setShowNewPassword(false);
      setShowConfirmPassword(false);
      setPasswordSuccessMessage("Password changed successfully.");
    } catch (err: any) {
      const detail =
        err?.response?.data?.detail ||
        err?.message ||
        "Failed to change password. Please check your credentials.";
      setPasswordErrorMessage(typeof detail === "string" ? detail : JSON.stringify(detail));
    } finally {
      setIsChangingPassword(false);
    }
  };

  return (
    <div className="w-full bg-slate-50/50 min-h-screen py-8 px-4 sm:px-6 lg:px-8">
      <div className="max-w-6xl mx-auto flex flex-col gap-6">
        {/* Page Header */}
        <div className="flex flex-col sm:flex-row sm:items-end justify-between gap-4 pb-4 border-b border-slate-200">
          <div className="flex flex-col gap-1">
            <h1 className="text-2xl sm:text-3xl font-bold tracking-tight text-slate-900">
              Profile &amp; Account Settings
            </h1>
            <p className="text-sm text-slate-500">
              Manage your personal information and account security.
            </p>
          </div>
          <div className="flex items-center gap-2 self-start sm:self-auto">
            <span className="px-3 py-1 rounded-full bg-slate-100 border border-slate-200 text-slate-600 text-xs font-medium flex items-center gap-1.5 shadow-2xs">
              <ShieldCheck className="w-4 h-4 text-indigo-600" />
              <span>Workspace Protected</span>
            </span>
          </div>
        </div>

        {/* Two-Column Responsive Layout */}
        <div className="grid grid-cols-1 xl:grid-cols-2 gap-6 items-start">
          {/* Card 1: Personal Information */}
          <div className="bg-white rounded-xl p-6 sm:p-7 shadow-xs border border-slate-200 flex flex-col gap-6">
            {/* Card Header */}
            <div className="flex items-center gap-3.5 pb-4 border-b border-slate-100">
              <div className="w-10 h-10 rounded-lg bg-indigo-50 border border-indigo-100/80 flex items-center justify-center text-indigo-600 shrink-0">
                <UserIcon className="w-5 h-5 text-indigo-600" />
              </div>
              <div className="flex flex-col">
                <h2 className="text-base font-semibold text-slate-900">Personal Information</h2>
                <p className="text-xs text-slate-500 mt-0.5">
                  Update your display name and view account details.
                </p>
              </div>
            </div>

            {/* Profile Feedback Notifications */}
            {profileSuccessMessage && (
              <div className="p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-between text-emerald-800">
                <div className="flex items-center gap-2 text-xs sm:text-sm font-medium">
                  <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>{profileSuccessMessage}</span>
                </div>
                <button
                  type="button"
                  onClick={() => setProfileSuccessMessage(null)}
                  className="text-emerald-500 hover:text-emerald-700 p-0.5 rounded-sm cursor-pointer"
                  aria-label="Dismiss notification"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            )}

            {profileErrorMessage && (
              <div className="p-3.5 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-between text-rose-800">
                <div className="flex items-center gap-2 text-xs sm:text-sm font-medium">
                  <AlertCircle className="w-4 h-4 text-rose-600 shrink-0" />
                  <span>{profileErrorMessage}</span>
                </div>
                <button
                  type="button"
                  onClick={() => setProfileErrorMessage(null)}
                  className="text-rose-500 hover:text-rose-700 p-0.5 rounded-sm cursor-pointer"
                  aria-label="Dismiss notification"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            )}

            {/* Personal Information Form */}
            <form onSubmit={handleProfileSubmit} className="flex flex-col gap-5">
              {/* Full Name */}
              <div className="flex flex-col gap-1.5">
                <div className="flex items-center justify-between">
                  <label
                    htmlFor="profile-full-name"
                    className="text-xs font-semibold text-slate-700 flex items-center gap-1"
                  >
                    <span>Full Name</span>
                    <span className="text-rose-500">*</span>
                  </label>
                  <span
                    className={cn(
                      "text-xs transition-colors",
                      nameInput.length > 255 ? "text-rose-600 font-semibold" : "text-slate-400"
                    )}
                  >
                    {nameInput.length} / 255
                  </span>
                </div>

                <div className="relative flex items-center rounded-lg">
                  <input
                    id="profile-full-name"
                    type="text"
                    maxLength={255}
                    value={nameInput}
                    onChange={(e) => {
                      setNameInput(e.target.value);
                      if (profileValidationError) setProfileValidationError(null);
                      if (profileSuccessMessage) setProfileSuccessMessage(null);
                      if (profileErrorMessage) setProfileErrorMessage(null);
                    }}
                    disabled={isSavingProfile}
                    placeholder="Enter your full name"
                    className={cn(
                      "w-full px-3.5 py-2.5 rounded-lg bg-slate-50 border text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:bg-white transition-all",
                      profileValidationError
                        ? "border-rose-300 focus:ring-rose-500"
                        : "border-slate-200 focus:ring-indigo-500 focus:border-indigo-500"
                    )}
                  />
                  {nameInput.length > 0 && !isSavingProfile && (
                    <button
                      type="button"
                      onClick={() => {
                        setNameInput("");
                        document.getElementById("profile-full-name")?.focus();
                      }}
                      className="absolute right-3 p-1 text-slate-400 hover:text-slate-600 rounded-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                      aria-label="Clear full name"
                      title="Clear full name"
                    >
                      <X className="w-4 h-4" />
                    </button>
                  )}
                </div>

                {profileValidationError && (
                  <span className="text-xs text-rose-600 font-medium flex items-center gap-1 pt-0.5">
                    <AlertCircle className="w-3.5 h-3.5 shrink-0" />
                    <span>{profileValidationError}</span>
                  </span>
                )}
              </div>

              {/* Read-Only Email Address */}
              <div className="flex flex-col gap-1.5">
                <div className="flex items-center justify-between">
                  <label
                    htmlFor="profile-email"
                    className="text-xs font-semibold text-slate-700"
                  >
                    Email Address
                  </label>
                  <span className="text-xs text-slate-400 flex items-center gap-1">
                    <Lock className="w-3 h-3 text-slate-400" />
                    <span>Read-only</span>
                  </span>
                </div>

                <div className="relative flex items-center">
                  <input
                    id="profile-email"
                    type="email"
                    value={user?.email ?? ""}
                    readOnly
                    tabIndex={-1}
                    aria-describedby="email-explanation"
                    className="w-full pl-3.5 pr-10 py-2.5 rounded-lg bg-slate-100/70 border border-slate-200 text-slate-600 text-sm cursor-not-allowed select-none focus:outline-none"
                  />
                  <div className="absolute right-3 pointer-events-none text-slate-400">
                    <Lock className="w-4 h-4" />
                  </div>
                </div>

                <p id="email-explanation" className="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                  <Info className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                  <span>Email address cannot currently be changed.</span>
                </p>
              </div>

              {/* Account Metadata Box */}
              <div className="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div className="flex items-center gap-2 text-xs text-slate-600">
                  <Calendar className="w-4 h-4 text-slate-400 shrink-0" />
                  <span>
                    Member Since:{" "}
                    <strong className="font-semibold text-slate-800">
                      {formatMemberSince(user?.created_at)}
                    </strong>
                  </span>
                </div>
                <div className="flex items-center gap-2">
                  <span className="text-xs text-slate-500">Status:</span>
                  <span className="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200/80 text-xs font-semibold text-emerald-700">
                    <span
                      className={cn(
                        "w-1.5 h-1.5 rounded-full",
                        user?.is_active ? "bg-emerald-500 animate-pulse" : "bg-slate-400"
                      )}
                    />
                    {user?.is_active ? "Active" : "Inactive"}
                  </span>
                </div>
              </div>

              {/* Action Buttons */}
              <div className="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button
                  type="button"
                  onClick={handleProfileReset}
                  disabled={!isProfileDirty || isSavingProfile}
                  className="px-4 py-2 rounded-lg bg-white hover:bg-slate-50 border border-slate-200 text-slate-700 text-xs font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                >
                  Reset
                </button>
                <button
                  type="submit"
                  disabled={!canSaveProfile || isSavingProfile}
                  className="px-5 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 text-xs font-semibold flex items-center gap-2 shadow-xs transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                >
                  {isSavingProfile ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <Check className="w-4 h-4" />
                  )}
                  <span>{isSavingProfile ? "Saving..." : "Save Changes"}</span>
                </button>
              </div>
            </form>
          </div>

          {/* Card 2: Change Password */}
          <div className="bg-white rounded-xl p-6 sm:p-7 shadow-xs border border-slate-200 flex flex-col gap-6">
            {/* Card Header */}
            <div className="flex items-center gap-3.5 pb-4 border-b border-slate-100">
              <div className="w-10 h-10 rounded-lg bg-indigo-50 border border-indigo-100/80 flex items-center justify-center text-indigo-600 shrink-0">
                <Lock className="w-5 h-5 text-indigo-600" />
              </div>
              <div className="flex flex-col">
                <h2 className="text-base font-semibold text-slate-900">Change Password</h2>
                <p className="text-xs text-slate-500 mt-0.5">
                  Update your password to keep your account secure.
                </p>
              </div>
            </div>

            {/* Password Hint Callout */}
            <div className="p-3.5 rounded-lg bg-slate-50 border border-slate-200/80 flex items-start gap-2.5 text-slate-600">
              <Shield className="w-4 h-4 text-indigo-600 mt-0.5 shrink-0" />
              <span className="text-xs leading-relaxed">
                Your current password is required to authorize a change. Enter a strong, unique key below.
              </span>
            </div>

            {/* Password Feedback Notifications */}
            {passwordSuccessMessage && (
              <div className="p-3.5 rounded-lg bg-emerald-50 border border-emerald-200 flex items-center justify-between text-emerald-800">
                <div className="flex items-center gap-2 text-xs sm:text-sm font-medium">
                  <CheckCircle2 className="w-4 h-4 text-emerald-600 shrink-0" />
                  <span>{passwordSuccessMessage}</span>
                </div>
                <button
                  type="button"
                  onClick={() => setPasswordSuccessMessage(null)}
                  className="text-emerald-500 hover:text-emerald-700 p-0.5 rounded-sm cursor-pointer"
                  aria-label="Dismiss notification"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            )}

            {passwordErrorMessage && (
              <div className="p-3.5 rounded-lg bg-rose-50 border border-rose-200 flex items-center justify-between text-rose-800">
                <div className="flex items-center gap-2 text-xs sm:text-sm font-medium">
                  <AlertCircle className="w-4 h-4 text-rose-600 shrink-0" />
                  <span>{passwordErrorMessage}</span>
                </div>
                <button
                  type="button"
                  onClick={() => setPasswordErrorMessage(null)}
                  className="text-rose-500 hover:text-rose-700 p-0.5 rounded-sm cursor-pointer"
                  aria-label="Dismiss notification"
                >
                  <X className="w-4 h-4" />
                </button>
              </div>
            )}

            {/* Password Form */}
            <form onSubmit={handlePasswordSubmit} className="flex flex-col gap-5">
              {/* Current Password */}
              <div className="flex flex-col gap-1.5">
                <label
                  htmlFor="current-password"
                  className="text-xs font-semibold text-slate-700"
                >
                  Current Password
                </label>
                <div className="relative flex items-center">
                  <input
                    id="current-password"
                    type={showCurrentPassword ? "text" : "password"}
                    value={currentPassword}
                    onChange={(e) => {
                      setCurrentPassword(e.target.value);
                      if (passwordSuccessMessage) setPasswordSuccessMessage(null);
                      if (passwordErrorMessage) setPasswordErrorMessage(null);
                    }}
                    disabled={isChangingPassword}
                    placeholder="••••••••••••"
                    required
                    className="w-full pl-3.5 pr-10 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
                  />
                  <button
                    type="button"
                    onClick={() => setShowCurrentPassword((prev) => !prev)}
                    className="absolute right-3 p-1 text-slate-400 hover:text-slate-600 rounded-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                    aria-label={showCurrentPassword ? "Hide current password" : "Show current password"}
                    title={showCurrentPassword ? "Hide password" : "Show password"}
                  >
                    {showCurrentPassword ? (
                      <EyeOff className="w-4 h-4" />
                    ) : (
                      <Eye className="w-4 h-4" />
                    )}
                  </button>
                </div>
              </div>

              {/* New Password */}
              <div className="flex flex-col gap-1.5">
                <label
                  htmlFor="new-password"
                  className="text-xs font-semibold text-slate-700"
                >
                  New Password
                </label>
                <div className="relative flex items-center">
                  <input
                    id="new-password"
                    type={showNewPassword ? "text" : "password"}
                    value={newPassword}
                    onChange={(e) => {
                      setNewPassword(e.target.value);
                      if (passwordSuccessMessage) setPasswordSuccessMessage(null);
                      if (passwordErrorMessage) setPasswordErrorMessage(null);
                    }}
                    disabled={isChangingPassword}
                    placeholder="Enter new password"
                    minLength={8}
                    maxLength={128}
                    required
                    className="w-full pl-3.5 pr-10 py-2.5 rounded-lg bg-slate-50 border border-slate-200 text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:bg-white transition-all"
                  />
                  <button
                    type="button"
                    onClick={() => setShowNewPassword((prev) => !prev)}
                    className="absolute right-3 p-1 text-slate-400 hover:text-slate-600 rounded-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                    aria-label={showNewPassword ? "Hide new password" : "Show new password"}
                    title={showNewPassword ? "Hide password" : "Show password"}
                  >
                    {showNewPassword ? (
                      <EyeOff className="w-4 h-4" />
                    ) : (
                      <Eye className="w-4 h-4" />
                    )}
                  </button>
                </div>
                <p className="text-xs text-slate-500 flex items-center gap-1 mt-0.5">
                  <CheckSquare className="w-3.5 h-3.5 text-slate-400 shrink-0" />
                  <span>Minimum 8 characters, maximum 128 characters.</span>
                </p>
              </div>

              {/* Confirm New Password */}
              <div className="flex flex-col gap-1.5">
                <label
                  htmlFor="confirm-password"
                  className="text-xs font-semibold text-slate-700"
                >
                  Confirm New Password
                </label>
                <div className="relative flex items-center">
                  <input
                    id="confirm-password"
                    type={showConfirmPassword ? "text" : "password"}
                    value={confirmPassword}
                    onChange={(e) => {
                      setConfirmPassword(e.target.value);
                      if (passwordSuccessMessage) setPasswordSuccessMessage(null);
                      if (passwordErrorMessage) setPasswordErrorMessage(null);
                    }}
                    disabled={isChangingPassword}
                    placeholder="Re-enter new password"
                    required
                    className={cn(
                      "w-full pl-3.5 pr-10 py-2.5 rounded-lg bg-slate-50 border text-slate-900 text-sm placeholder:text-slate-400 focus:outline-none focus:ring-2 transition-all",
                      isMismatch
                        ? "border-rose-300 focus:ring-rose-500 ring-1 ring-rose-200"
                        : "border-slate-200 focus:ring-indigo-500 focus:bg-white"
                    )}
                  />
                  <button
                    type="button"
                    onClick={() => setShowConfirmPassword((prev) => !prev)}
                    className="absolute right-3 p-1 text-slate-400 hover:text-slate-600 rounded-sm focus:outline-none focus:ring-2 focus:ring-indigo-500 cursor-pointer"
                    aria-label={showConfirmPassword ? "Hide confirmation password" : "Show confirmation password"}
                    title={showConfirmPassword ? "Hide password" : "Show password"}
                  >
                    {showConfirmPassword ? (
                      <EyeOff className="w-4 h-4" />
                    ) : (
                      <Eye className="w-4 h-4" />
                    )}
                  </button>
                </div>
                {isMismatch && (
                  <p className="text-xs text-rose-600 font-medium flex items-center gap-1 mt-0.5">
                    <AlertCircle className="w-3.5 h-3.5 shrink-0" />
                    <span>Passwords do not match</span>
                  </p>
                )}
              </div>

              {/* Action Buttons */}
              <div className="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <button
                  type="submit"
                  disabled={!canSubmitPassword || isChangingPassword}
                  className="px-5 py-2 rounded-lg bg-indigo-600 text-white hover:bg-indigo-700 text-xs font-semibold flex items-center gap-2 shadow-xs transition-all disabled:opacity-50 disabled:cursor-not-allowed cursor-pointer"
                >
                  {isChangingPassword ? (
                    <Loader2 className="w-4 h-4 animate-spin" />
                  ) : (
                    <Lock className="w-4 h-4" />
                  )}
                  <span>{isChangingPassword ? "Updating..." : "Change Password"}</span>
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  );
}
