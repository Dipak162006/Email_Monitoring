    code: false,
    align: "left",
    style: "p",
    font: "sans-serif",
  });

  // Save current selection range inside the editor
  const saveSelection = useCallback(() => {
    const sel = window.getSelection();
    if (sel && sel.rangeCount > 0 && editorRef.current?.contains(sel.anchorNode)) {
      savedRangeRef.current = sel.getRangeAt(0).cloneRange();
    }
  }, []);

  // Restore saved selection range
  const restoreSelection = useCallback(() => {
    if (savedRangeRef.current) {
      const sel = window.getSelection();
      if (sel) {
        sel.removeAllRanges();
        sel.addRange(savedRangeRef.current);
      }
    }
  }, []);

  // Sync initial content or external programmatic updates (templates, reply quote, drafts)
  useEffect(() => {
    if (!editorRef.current) return;

    if (!isInitialized.current) {
      if (initialHtml) {
        editorRef.current.innerHTML = initialHtml;
        lastReportedHtmlRef.current = initialHtml;
        isInitialized.current = true;
      }
      return;
    }

    // Only update innerHTML when the prop change was NOT caused by the user typing
    if (initialHtml !== lastReportedHtmlRef.current) {
      editorRef.current.innerHTML = initialHtml;
      lastReportedHtmlRef.current = initialHtml;
    }
  }, [initialHtml]);

  const handleInput = useCallback(() => {
    if (editorRef.current) {
      const html = editorRef.current.innerHTML;
      const text = editorRef.current.innerText;
      lastReportedHtmlRef.current = html;
      isInitialized.current = true;
      onChange(html, text);
    }
  }, [onChange]);

  // Query and update active states of toolbar buttons
  const updateActiveStates = useCallback(() => {
    if (!editorRef.current) return;
    const sel = window.getSelection();
    if (!sel || !sel.anchorNode || !editorRef.current.contains(sel.anchorNode)) {
      return;
    }

    // Always update saved selection range when active inside editor
    if (sel.rangeCount > 0) {
      savedRangeRef.current = sel.getRangeAt(0).cloneRange();
    }

    try {
      const bold = document.queryCommandState("bold");
      const italic = document.queryCommandState("italic");
      const underline = document.queryCommandState("underline");
      const strikeThrough = document.queryCommandState("strikeThrough");
      const unorderedList = document.queryCommandState("insertUnorderedList");
      const orderedList = document.queryCommandState("insertOrderedList");
      const justifyCenter = document.queryCommandState("justifyCenter");
      const justifyRight = document.queryCommandState("justifyRight");

      // Inspect ancestor elements for blockquote, pre, code, and headings
      let node: Node | null = sel.anchorNode;
      if (node.nodeType === Node.TEXT_NODE) {
        node = node.parentNode;
      }
      const el = node as HTMLElement | null;

      const blockquote = !!el?.closest("blockquote");
      const code = !!el?.closest("pre, code");

      let currentStyle = "p";
      let styleLabel = "Normal";
      if (el?.closest("h1")) {
        currentStyle = "h1";
        styleLabel = "Heading 1";
      } else if (el?.closest("h2")) {
        currentStyle = "h2";
        styleLabel = "Heading 2";
      } else if (el?.closest("h3")) {
        currentStyle = "h3";
        styleLabel = "Heading 3";
      }
      setSelectedStyleLabel(styleLabel);

      // Detect current font family via queryCommandValue or enclosing element style
      let rawFont = document.queryCommandValue("fontName") || "";
      if (!rawFont && el) {
        const fontEl = el.closest("[style*='font-family']") as HTMLElement | null;
        if (fontEl) {
          rawFont = fontEl.style.fontFamily;
        }
      }
      const cleanFont = rawFont.replace(/['"]/g, "").trim().toLowerCase();
      const matchedFont = FONT_OPTIONS.find((f) =>
        cleanFont === f.value.toLowerCase() ||
        cleanFont === f.label.toLowerCase() ||
        cleanFont.startsWith(f.value.toLowerCase()) ||
        cleanFont.includes(f.value.toLowerCase())
      );
      if (matchedFont) {
        setSelectedFontLabel(matchedFont.label);
      } else if (!cleanFont || cleanFont.includes("jakarta")) {
        setSelectedFontLabel("Sans Serif");
      }

      setActiveStates({
        bold,
        italic,
        underline,
        strikeThrough,
        unorderedList,
        orderedList,
        blockquote,
        code,
        align: justifyRight ? "right" : justifyCenter ? "center" : "left",
        style: currentStyle,
        font: rawFont,
      });
    } catch {
      // Ignored for detached ranges
    }
  }, []);

  // Listen to selection changes across the document
  useEffect(() => {
    const handleSelectionChange = () => {
      updateActiveStates();
    };
    document.addEventListener("selectionchange", handleSelectionChange);
    return () => {
      document.removeEventListener("selectionchange", handleSelectionChange);
    };
  }, [updateActiveStates]);

  // Close dropdowns on outside click
  useEffect(() => {
    const handleClickOutside = (e: MouseEvent) => {
      if (containerRef.current && !containerRef.current.contains(e.target as Node)) {
        setIsFontDropdownOpen(false);
        setIsStyleDropdownOpen(false);
      }
    };
    document.addEventListener("mousedown", handleClickOutside);
    return () => {
      document.removeEventListener("mousedown", handleClickOutside);
    };
  }, []);

  // Core execution helper
  const exec = (command: string, value: string | undefined = undefined) => {
    restoreSelection();
    editorRef.current?.focus();
    restoreSelection();
    document.execCommand("styleWithCSS", false, "true");
    document.execCommand(command, false, value);
    handleInput();
    updateActiveStates();
  };

  // Font family handler
  const handleSelectFont = (fontValue: string, fontLabel: string) => {
    restoreSelection();
    editorRef.current?.focus();
    restoreSelection();

    document.execCommand("styleWithCSS", false, "true");

    const sel = window.getSelection();
    if (sel && !sel.isCollapsed && sel.rangeCount > 0 && editorRef.current?.contains(sel.anchorNode)) {
      // Formats selected text in place with the chosen font face
      document.execCommand("fontName", false, fontValue);
    } else if (sel && sel.isCollapsed && sel.rangeCount > 0 && editorRef.current?.contains(sel.anchorNode)) {
      // Collapsed caret: insert zero-width space styled with chosen font so subsequent typing immediately uses this font
      const range = sel.getRangeAt(0);
      const span = document.createElement("span");
      span.style.fontFamily = fontValue;
      const zws = document.createTextNode("\u200B");
      span.appendChild(zws);
      range.insertNode(span);
      range.setStart(zws, 1);
      range.setEnd(zws, 1);
      sel.removeAllRanges();
      sel.addRange(range);
      savedRangeRef.current = range.cloneRange();
    } else {
      document.execCommand("fontName", false, fontValue);
    }

    setSelectedFontLabel(fontLabel);
    setIsFontDropdownOpen(false);
    handleInput();
    updateActiveStates();
  };

  // Text style handler (p, h1, h2, h3)
  const handleSelectStyle = (styleValue: string, styleLabel: string) => {
    editorRef.current?.focus();
    restoreSelection();
    if (styleValue === "p") {
      document.execCommand("formatBlock", false, "<p>");
    } else {
      document.execCommand("formatBlock", false, `<${styleValue}>`);
    }
    setSelectedStyleLabel(styleLabel);
    setIsStyleDropdownOpen(false);
    handleInput();
    updateActiveStates();
  };

  // Toggle blockquote
  const toggleBlockquote = () => {
    editorRef.current?.focus();
    restoreSelection();
    if (activeStates.blockquote) {
      document.execCommand("formatBlock", false, "<p>");
    } else {
      document.execCommand("formatBlock", false, "<blockquote>");
    }
    handleInput();
    updateActiveStates();
  };

  // Toggle code block
  const toggleCode = () => {
    editorRef.current?.focus();
    restoreSelection();
    if (activeStates.code) {
      document.execCommand("formatBlock", false, "<p>");
    } else {
      document.execCommand("formatBlock", false, "<pre>");
    }
    handleInput();
    updateActiveStates();
  };

  // Insert or edit hyperlink
  const handleInsertLink = () => {
    editorRef.current?.focus();
    restoreSelection();
    const sel = window.getSelection();
    let existingUrl = "";
    let anchorEl: HTMLAnchorElement | null = null;

    if (sel && sel.anchorNode) {
      const parent = sel.anchorNode.nodeType === Node.TEXT_NODE ? sel.anchorNode.parentNode : sel.anchorNode;
      anchorEl = (parent as HTMLElement)?.closest("a");
      if (anchorEl) {
        existingUrl = anchorEl.getAttribute("href") || "";
      }
    }

    const url = prompt("Enter hyperlink URL:", existingUrl || "https://");
    if (url === null) return;
    if (!url.trim()) {
      if (anchorEl) {
        document.execCommand("unlink", false);
      }
      handleInput();
      updateActiveStates();
      return;
    }

    const cleanUrl = url.trim().match(/^https?:\/\//i) ? url.trim() : `https://${url.trim()}`;
    if (sel && sel.isCollapsed) {
      const range = sel.getRangeAt(0);
      const linkNode = document.createElement("a");
      linkNode.href = cleanUrl;
      linkNode.textContent = cleanUrl;
      linkNode.target = "_blank";
      linkNode.rel = "noopener noreferrer";
      linkNode.style.color = "#4f46e5";
      linkNode.style.textDecoration = "underline";
      range.insertNode(linkNode);
      range.setStartAfter(linkNode);
      range.collapse(true);
      sel.removeAllRanges();
      sel.addRange(range);
    } else {
      document.execCommand("createLink", false, cleanUrl);
    }
    handleInput();
    updateActiveStates();
  };

  const getButtonClass = (isActive: boolean) =>
    `p-1.5 rounded transition-all select-none ${
      isActive
        ? "bg-indigo-100 text-indigo-700 font-semibold ring-1 ring-indigo-300 shadow-2xs"
        : "text-slate-600 hover:text-slate-900 hover:bg-slate-200/70"
    }`;

  return (
    <div ref={containerRef} className="flex flex-col border border-slate-200 rounded-xl overflow-hidden bg-white shadow-2xs">
      <style>{`
        .compose-editor blockquote {
          border-left: 3px solid #6366f1;
          padding: 6px 14px;
          margin: 10px 0;
          color: #475569;
          font-style: italic;
          background: #f8fafc;
          border-radius: 0 6px 6px 0;
        }
        .compose-editor pre {
          background-color: #f1f5f9;
          color: #0f172a;
          padding: 10px 14px;
          border-radius: 8px;
          font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
          font-size: 13px;
          margin: 10px 0;
          overflow-x: auto;
          border: 1px solid #e2e8f0;
          white-space: pre-wrap;
        }
        .compose-editor code {
          background-color: #f1f5f9;
          color: #e11d48;
          padding: 2px 5px;
          border-radius: 4px;
          font-family: monospace;
          font-size: 12px;
        }
        .compose-editor ul {
          list-style-type: disc !important;
          margin: 8px 0 8px 24px !important;
          padding-left: 0 !important;
        }
        .compose-editor ol {
          list-style-type: decimal !important;
          margin: 8px 0 8px 24px !important;
          padding-left: 0 !important;
        }
        .compose-editor li {
          margin-bottom: 4px;
        }
        .compose-editor h1 {
          font-size: 1.5rem;
          font-weight: 700;
          margin: 14px 0 6px;
          color: #0f172a;
        }
        .compose-editor h2 {
          font-size: 1.25rem;
          font-weight: 600;
          margin: 12px 0 6px;
          color: #0f172a;
        }
        .compose-editor h3 {
          font-size: 1.125rem;
          font-weight: 600;
          margin: 10px 0 4px;
          color: #0f172a;
        }
        .compose-editor a {
          color: #4f46e5;
          text-decoration: underline;
        }
        .compose-editor a:hover {
          color: #3730a3;
        }
        .compose-editor p {
          margin: 4px 0;
        }
      `}</style>

      {/* Formatting Toolbar */}
      <div className="px-4 py-2 bg-slate-50/80 border-b border-slate-200 flex flex-wrap items-center gap-1 text-slate-600 text-xs select-none">
        {/* Font Family Dropdown */}
        <div className="flex items-center gap-1 pr-2 border-r border-slate-200">
          <div className="relative">
            <button
              type="button"
              onMouseDown={(e) => {
                e.preventDefault();
                saveSelection();
              }}
              onClick={() => {
                setIsFontDropdownOpen((prev) => !prev);
                setIsStyleDropdownOpen(false);
              }}
              className="flex items-center gap-1 px-2 py-1 rounded hover:bg-slate-200/60 text-xs font-medium text-slate-700 transition-colors"
              title="Font Family"
              aria-label="Font family"
            >
              <span>{selectedFontLabel}</span>
              <ChevronDown className="h-3 w-3 text-slate-400" />
            </button>

            {isFontDropdownOpen && (
              <div className="absolute left-0 top-full mt-1 w-36 bg-white border border-slate-200 rounded-lg shadow-lg py-1 z-30">
                {FONT_OPTIONS.map((opt) => (
                  <button
                    key={opt.label}
                    type="button"
                    onMouseDown={(e) => e.preventDefault()}
                    onClick={() => handleSelectFont(opt.value, opt.label)}
                    className={`w-full text-left px-3 py-1.5 text-xs transition-colors flex items-center justify-between ${
                      selectedFontLabel === opt.label
                        ? "bg-indigo-50 text-indigo-700 font-semibold"
                        : "text-slate-700 hover:bg-slate-100"
                    }`}
                  >
                    <span style={{ fontFamily: opt.style }}>{opt.label}</span>
                    {selectedFontLabel === opt.label && <span className="text-indigo-600 font-bold">✓</span>}
                  </button>
                ))}
              </div>
            )}
          </div>

          {/* Text Style Dropdown (Normal, H1, H2, H3) */}
          <div className="relative">
            <button
              type="button"
              onMouseDown={(e) => {
                e.preventDefault();
                saveSelection();
              }}
              onClick={() => {
                setIsStyleDropdownOpen((prev) => !prev);
                setIsFontDropdownOpen(false);
              }}
              className="flex items-center gap-1 px-2 py-1 rounded hover:bg-slate-200/60 text-xs font-medium text-slate-700 transition-colors"
              title="Text Style"
              aria-label="Text style"
            >
              <span>{selectedStyleLabel}</span>
              <ChevronDown className="h-3 w-3 text-slate-400" />
            </button>

            {isStyleDropdownOpen && (
              <div className="absolute left-0 top-full mt-1 w-32 bg-white border border-slate-200 rounded-lg shadow-lg py-1 z-30">
                {STYLE_OPTIONS.map((opt) => (
                  <button
                    key={opt.label}
                    type="button"
                    onMouseDown={(e) => e.preventDefault()}
                    onClick={() => handleSelectStyle(opt.value, opt.label)}
                    className={`w-full text-left px-3 py-1.5 text-xs transition-colors flex items-center justify-between ${
                      selectedStyleLabel === opt.label
                        ? "bg-indigo-50 text-indigo-700 font-semibold"
                        : "text-slate-700 hover:bg-slate-100"
                    }`}
                  >
                    <span>{opt.label}</span>
                    {selectedStyleLabel === opt.label && <span className="text-indigo-600 font-bold">✓</span>}
                  </button>
                ))}
              </div>
            )}
          </div>
        </div>

        {/* Basic Styles: Bold, Italic, Underline, Strikethrough */}
        <div className="flex items-center gap-0.5 px-2 border-r border-slate-200">
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("bold")}
            className={getButtonClass(activeStates.bold)}
            title="Bold (Ctrl+B)"
            aria-label="Bold"
          >
            <Bold className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("italic")}
            className={getButtonClass(activeStates.italic)}
            title="Italic (Ctrl+I)"
            aria-label="Italic"
          >
            <Italic className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("underline")}
            className={getButtonClass(activeStates.underline)}
            title="Underline (Ctrl+U)"
            aria-label="Underline"
          >
            <Underline className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("strikeThrough")}
            className={getButtonClass(activeStates.strikeThrough)}
            title="Strikethrough"
            aria-label="Strikethrough"
          >
            <Strikethrough className="h-3.5 w-3.5" />
          </button>
        </div>

        {/* Lists & Blocks: Unordered, Ordered, Blockquote, Code Block */}
        <div className="flex items-center gap-0.5 px-2 border-r border-slate-200">
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("insertUnorderedList")}
            className={getButtonClass(activeStates.unorderedList)}
            title="Bulleted List"
            aria-label="Bullet list"
          >
            <List className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("insertOrderedList")}
            className={getButtonClass(activeStates.orderedList)}
            title="Numbered List"
            aria-label="Numbered list"
          >
            <ListOrdered className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={toggleBlockquote}
            className={getButtonClass(activeStates.blockquote)}
            title="Blockquote"
            aria-label="Blockquote"
          >
            <Quote className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={toggleCode}
            className={getButtonClass(activeStates.code)}
            title="Code Block"
            aria-label="Code block"
          >
            <Code className="h-3.5 w-3.5" />
          </button>
        </div>

        {/* Alignment: Left, Center, Right */}
        <div className="flex items-center gap-0.5 px-2 border-r border-slate-200">
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("justifyLeft")}
            className={getButtonClass(activeStates.align === "left")}
            title="Align Left"
            aria-label="Align left"
          >
            <AlignLeft className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("justifyCenter")}
            className={getButtonClass(activeStates.align === "center")}
            title="Align Center"
            aria-label="Align center"
          >
            <AlignCenter className="h-3.5 w-3.5" />
          </button>
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={() => exec("justifyRight")}
            className={getButtonClass(activeStates.align === "right")}
            title="Align Right"
            aria-label="Align right"
          >
            <AlignRight className="h-3.5 w-3.5" />
          </button>
        </div>

        {/* Hyperlink */}
        <div className="flex items-center gap-0.5 pl-2">
          <button
            type="button"
            onMouseDown={(e) => e.preventDefault()}
            onClick={handleInsertLink}
            className="p-1.5 hover:bg-slate-200/70 rounded text-slate-700 hover:text-slate-900 transition-colors"
            title="Insert Link"
            aria-label="Insert link"
          >
            <LinkIcon className="h-3.5 w-3.5" />
          </button>
        </div>
      </div>

      {/* Writing Canvas / ContentEditable */}
      <div
        ref={editorRef}
        contentEditable
        onInput={handleInput}
        onKeyUp={updateActiveStates}
        onMouseUp={updateActiveStates}
        data-placeholder={placeholder}
        className="compose-editor p-6 sm:p-8 min-h-[360px] max-h-[600px] overflow-y-auto text-slate-800 text-sm sm:text-base leading-relaxed outline-none focus:ring-0"
      />
    </div>
  );
};
</file>

<file path="frontend/src/components/dashboard/ActivityTrendChart.tsx">
import React, { useState, useMemo } from "react";
import type { DashboardActivityPoint } from "../../types/dashboard";

interface ActivityTrendChartProps {
  points: DashboardActivityPoint[];
  isLoading?: boolean;
}

interface ChartPoint {
  key: string;
  date: string;
  label: string;
  fullLabel: string;
  sent: number;
  responses: number;
  bounced: number;
}

const MONTH_NAMES_SHORT = [
  "Jan", "Feb", "Mar", "Apr", "May", "Jun",
  "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"
];

const MONTH_NAMES_FULL = [
  "January", "February", "March", "April", "May", "June",
  "July", "August", "September", "October", "November", "December"
];

function parseDate(dStr: string): { year: number; month: number; day: number } {
  const parts = dStr.split("-").map(Number);
  return {
    year: parts[0] || 2026,
    month: parts[1] || 1,
    day: parts[2] || 1,
  };
}

/**
 * Adaptively aggregates raw daily activity points into an optimal number of chart points.
 * - <= 31 days (Today, 7d, 30d): Keep daily resolution.
 * - 32 to 210 days (90d, 6m): Aggregate into 7-day weekly buckets (~13 to 26 points).
 * - > 210 days (1y, All Time): Aggregate into calendar month buckets (~12 to 25 points).
 *
 * All sums (sent, responses, bounced) are strictly preserved across buckets with zero data loss.
 */
function aggregateActivityPoints(rawPoints: DashboardActivityPoint[]): ChartPoint[] {
  if (!rawPoints || rawPoints.length === 0) return [];
  const n = rawPoints.length;

  // Case 1: Short ranges (<= 31 days) -> Keep daily points
  if (n <= 31) {
    return rawPoints.map((p) => {
      const { year, month, day } = parseDate(p.date);
      const shortLabel = n <= 7 && p.label ? p.label : `${MONTH_NAMES_SHORT[month - 1]} ${day}`;
      const fullLabel = `${MONTH_NAMES_FULL[month - 1]} ${day}, ${year}`;
      return {
        key: p.date,
        date: p.date,
        label: shortLabel,
        fullLabel,
        sent: p.sent,
        responses: p.responses,
        bounced: p.bounced,
      };
    });
  }

  // Case 2: Medium ranges (32 to 210 days) -> 7-day weekly buckets
  if (n <= 210) {
    const chunkSize = 7;
    const aggregated: ChartPoint[] = [];

    for (let i = 0; i < n; i += chunkSize) {
      const slice = rawPoints.slice(i, i + chunkSize);
      const startPt = slice[0];
      const endPt = slice[slice.length - 1];

      const startParsed = parseDate(startPt.date);
      const endParsed = parseDate(endPt.date);

      const sentSum = slice.reduce((acc, cur) => acc + cur.sent, 0);
      const respSum = slice.reduce((acc, cur) => acc + cur.responses, 0);
      const bounceSum = slice.reduce((acc, cur) => acc + cur.bounced, 0);

      const label = `${MONTH_NAMES_SHORT[startParsed.month - 1]} ${startParsed.day}`;
      const fullLabel = `${MONTH_NAMES_SHORT[startParsed.month - 1]} ${startParsed.day} – ${MONTH_NAMES_SHORT[endParsed.month - 1]} ${endParsed.day}, ${endParsed.year}`;

      aggregated.push({
        key: `week-${startPt.date}`,
        date: startPt.date,
        label,
        fullLabel,
        sent: sentSum,
        responses: respSum,
        bounced: bounceSum,
      });
    }

    return aggregated;
  }

  // Case 3: Long ranges (> 210 days) -> Calendar month buckets
  const monthMap = new Map<
    string,
    {
      year: number;
      month: number;
      sent: number;
      responses: number;
      bounced: number;
      firstDate: string;
    }
  >();

  for (const pt of rawPoints) {
    const { year, month } = parseDate(pt.date);
    const monthKey = `${year}-${String(month).padStart(2, "0")}`;
    const existing = monthMap.get(monthKey);
    if (!existing) {
      monthMap.set(monthKey, {
        year,
        month,
        sent: pt.sent,
        responses: pt.responses,
        bounced: pt.bounced,
        firstDate: pt.date,
      });
    } else {
      existing.sent += pt.sent;
      existing.responses += pt.responses;
      existing.bounced += pt.bounced;
    }
  }

  const years = new Set(Array.from(monthMap.values()).map((m) => m.year));
  const isMultiYear = years.size > 1;

  const aggregated: ChartPoint[] = [];
  for (const [key, data] of monthMap.entries()) {
    const label = isMultiYear
      ? `${MONTH_NAMES_SHORT[data.month - 1]} '${String(data.year).slice(-2)}`
      : MONTH_NAMES_SHORT[data.month - 1];
    const fullLabel = `${MONTH_NAMES_FULL[data.month - 1]} ${data.year}`;

    aggregated.push({
      key,
      date: data.firstDate,
      label,
      fullLabel,
      sent: data.sent,
      responses: data.responses,
      bounced: data.bounced,
    });
  }

  return aggregated;
}

export function ActivityTrendChart({ points, isLoading }: ActivityTrendChartProps) {
  const [hoverIndex, setHoverIndex] = useState<number | null>(null);

  const chartPoints = useMemo(() => {
    return aggregateActivityPoints(points || []);
  }, [points]);

  if (isLoading) {
    return (
      <div className="h-64 w-full flex items-center justify-center bg-slate-50/50 rounded-xl border border-slate-100 animate-pulse">
        <div className="flex flex-col items-center space-y-2">
          <div className="h-4 w-32 bg-slate-200 rounded"></div>
          <div className="h-3 w-48 bg-slate-200/70 rounded"></div>
        </div>
      </div>
    );
  }

  const n = chartPoints.length;
  const maxVal = Math.max(
    ...chartPoints.map((p) => Math.max(p.sent, p.responses, p.bounced)),
    5 // Minimum scale ceiling so 0 isn't collapsed
  );

  const width = 800;
  const height = 240;
  const paddingX = 45;
  const paddingBottom = 40;
  const paddingTop = 30;
  const chartWidth = width - paddingX * 2;
  const chartHeight = height - paddingTop - paddingBottom;

  const getX = (idx: number) => {
    if (n <= 1) return width / 2;
    return paddingX + (idx / (n - 1)) * chartWidth;
  };

  const getY = (val: number) => {
    const ratio = Math.min(1, Math.max(0, val / maxVal));
    return height - paddingBottom - ratio * chartHeight;
  };

  // Build smooth cubic bezier path
  const buildSmoothPath = (values: number[]) => {
    if (values.length === 0) return "";
    const pts = values.map((v, i) => ({ x: getX(i), y: getY(v) }));
    if (pts.length === 1) {
      return `M ${paddingX} ${pts[0].y} L ${width - paddingX} ${pts[0].y}`;
    }

    let path = `M ${pts[0].x} ${pts[0].y}`;
    for (let i = 0; i < pts.length - 1; i++) {
      const p0 = pts[i === 0 ? 0 : i - 1];
      const p1 = pts[i];
      const p2 = pts[i + 1];
      const p3 = pts[i + 2 < pts.length ? i + 2 : i + 1];

      const cp1x = p1.x + (p2.x - p0.x) / 6;
      const cp1y = p1.y + (p2.y - p0.y) / 6;
      const cp2x = p2.x - (p3.x - p1.x) / 6;
      const cp2y = p2.y - (p3.y - p1.y) / 6;

      path += ` C ${cp1x.toFixed(1)},${cp1y.toFixed(1)} ${cp2x.toFixed(1)},${cp2y.toFixed(1)} ${p2.x.toFixed(1)},${p2.y.toFixed(1)}`;
    }
    return path;
  };

  const sentPath = buildSmoothPath(chartPoints.map((p) => p.sent));
  const respPath = buildSmoothPath(chartPoints.map((p) => p.responses));
  const bouncePath = buildSmoothPath(chartPoints.map((p) => p.bounced));

  // Area under curve paths
  const baselineY = height - paddingBottom;
  const buildAreaPath = (linePath: string) => {
    if (!linePath || chartPoints.length === 0) return "";
    const firstX = chartPoints.length === 1 ? paddingX : getX(0);
    const lastX = chartPoints.length === 1 ? width - paddingX : getX(chartPoints.length - 1);
    return `${linePath} L ${lastX} ${baselineY} L ${firstX} ${baselineY} Z`;
  };

  const sentArea = buildAreaPath(sentPath);
  const respArea = buildAreaPath(respPath);

  const activePoint =
    hoverIndex !== null && chartPoints[hoverIndex] ? chartPoints[hoverIndex] : null;

  const handleMouseMove = (e: React.MouseEvent<SVGSVGElement>) => {
    const rect = e.currentTarget.getBoundingClientRect();
    const clientX = e.clientX - rect.left;
    const svgX = (clientX / rect.width) * width;

    let closestIdx = 0;
    let minDiff = Infinity;
    chartPoints.forEach((_, idx) => {
      const diff = Math.abs(getX(idx) - svgX);
      if (diff < minDiff) {
        minDiff = diff;
        closestIdx = idx;
      }
    });
    setHoverIndex(closestIdx);
  };

  const allZero = chartPoints.every(
    (p) => p.sent === 0 && p.responses === 0 && p.bounced === 0
  );

  return (
    <div className="w-full relative">
      <svg
        viewBox={`0 0 ${width} ${height}`}
        className="w-full h-auto overflow-visible select-none"
        onMouseMove={handleMouseMove}
        onMouseLeave={() => setHoverIndex(null)}
      >
        <defs>
          <linearGradient id="sentGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#6366f1" stopOpacity="0.18" />
            <stop offset="100%" stopColor="#6366f1" stopOpacity="0.0" />
          </linearGradient>
          <linearGradient id="respGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#0ea5e9" stopOpacity="0.16" />
            <stop offset="100%" stopColor="#0ea5e9" stopOpacity="0.0" />
          </linearGradient>
          <linearGradient id="bounceGradient" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0%" stopColor="#f43f5e" stopOpacity="0.12" />
            <stop offset="100%" stopColor="#f43f5e" stopOpacity="0.0" />
          </linearGradient>
        </defs>

        {/* Horizontal grid lines */}
        {[0, 0.25, 0.5, 0.75, 1].map((tick) => {
          const y = height - paddingBottom - tick * chartHeight;
          return (
            <line
              key={tick}
              x1={paddingX}
              y1={y}
              x2={width - paddingX}
              y2={y}
              stroke="#f1f5f9"
              strokeWidth="1"
              strokeDasharray={tick === 0 ? "none" : "3 3"}
            />
          );
        })}

        {/* Area Fills */}
        {sentArea && <path d={sentArea} fill="url(#sentGradient)" />}
        {respArea && <path d={respArea} fill="url(#respGradient)" />}

        {/* Smooth Series Lines */}
        {bouncePath && (
          <path
            d={bouncePath}
            fill="none"
            stroke="#f43f5e"
            strokeWidth="2.5"
            strokeLinecap="round"
            strokeLinejoin="round"
            className="transition-all duration-300"
          />
        )}
        {respPath && (
          <path
            d={respPath}
            fill="none"
            stroke="#0ea5e9"
            strokeWidth="2.5"
            strokeLinecap="round"
            strokeLinejoin="round"
            className="transition-all duration-300"
          />
        )}
        {sentPath && (
          <path
            d={sentPath}
            fill="none"
            stroke="#6366f1"
            strokeWidth="3"
            strokeLinecap="round"
            strokeLinejoin="round"
            className="transition-all duration-300"
          />
        )}

        {/* Date Labels on X Axis */}
        {chartPoints.map((p, idx) => {
          const maxLabels = 8;
          const step = Math.max(1, Math.floor(chartPoints.length / maxLabels));
          const isFirst = idx === 0;
          const isLast = idx === chartPoints.length - 1;
          const isStepped = idx % step === 0;
          const showLabel = isFirst || isLast || isStepped;

          // Prevent rendering penultimate label if it is too close to the last one
          if (!isFirst && !isLast && isStepped && idx >= chartPoints.length - Math.ceil(step / 1.5)) {
            return null;
          }

          if (!showLabel && hoverIndex !== idx) return null;
          const x = getX(idx);
          const isSelected = hoverIndex === idx;
          return (
            <text
              key={p.key}
              x={x}
              y={height - 12}
              textAnchor="middle"
              className={`text-[11px] transition-colors duration-150 select-none ${
                isSelected ? "fill-indigo-700 font-semibold" : "fill-slate-400 font-medium"
              }`}
            >
              {p.label}
            </text>
          );
        })}

        {/* Active Hover Indicator Line & Markers */}
        {hoverIndex !== null && activePoint && (
          <g>
            <line
              x1={getX(hoverIndex)}
              y1={paddingTop - 10}
              x2={getX(hoverIndex)}
              y2={baselineY}
              stroke="#94a3b8"
              strokeWidth="1"
              strokeDasharray="3 3"
            />
            {/* Sent marker dot */}
            <circle
              cx={getX(hoverIndex)}
              cy={getY(activePoint.sent)}
              r="4.5"
              fill="#6366f1"
              stroke="#ffffff"
              strokeWidth="2"
              className="drop-shadow-sm"
            />
            {/* Response marker dot */}
            <circle
              cx={getX(hoverIndex)}
              cy={getY(activePoint.responses)}
              r="4.5"
              fill="#0ea5e9"
              stroke="#ffffff"
              strokeWidth="2"
              className="drop-shadow-sm"
            />
            {/* Bounced marker dot */}
            <circle
              cx={getX(hoverIndex)}
              cy={getY(activePoint.bounced)}
              r="4.5"
              fill="#f43f5e"
              stroke="#ffffff"
              strokeWidth="2"
              className="drop-shadow-sm"
            />
          </g>
        )}
      </svg>

      {/* Floating Tooltip with boundary-safe positioning */}
      {hoverIndex !== null && activePoint && (
        <div
          className="absolute z-20 pointer-events-none transition-all duration-75"
          style={{
            left: `${Math.max(5, Math.min(95, (getX(hoverIndex) / width) * 100))}%`,
            top: "8px",
            transform:
              getX(hoverIndex) / width > 0.75
                ? "translateX(-95%)"
                : getX(hoverIndex) / width < 0.25
                ? "translateX(-5%)"
                : "translateX(-50%)",
          }}
        >
          <div className="bg-slate-900/95 text-white text-[11px] rounded-xl px-3.5 py-2 shadow-xl backdrop-blur-xs border border-slate-700 flex items-center space-x-3 whitespace-nowrap">
            <span className="font-semibold text-slate-200">{activePoint.fullLabel}</span>
            <span className="h-3 w-px bg-slate-700" />
            <span className="text-indigo-300 font-medium">
              Sent: <strong className="text-white">{activePoint.sent.toLocaleString()}</strong>
            </span>
            <span className="text-sky-300 font-medium">
              Resp: <strong className="text-white">{activePoint.responses.toLocaleString()}</strong>
            </span>
            <span className="text-rose-300 font-medium">
              Bounced: <strong className="text-white">{activePoint.bounced.toLocaleString()}</strong>
            </span>
          </div>
        </div>
      )}

      {/* Empty State Overlay if 0 data across period */}
      {allZero && (
        <div className="absolute inset-0 flex items-center justify-center bg-white/40 backdrop-blur-[0.5px]">
          <span className="text-xs text-slate-400 bg-white/80 px-3 py-1.5 rounded-full border border-slate-200/80 shadow-xs">
            No activity recorded during this period
          </span>
        </div>
      )}
    </div>
  );
}
