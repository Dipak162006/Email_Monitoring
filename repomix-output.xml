  const renderCampaignsPageWithRole = (role: "OWNER" | "ADMIN" | "MEMBER" = "ADMIN") => {
    const wsValue: WorkspaceContextType = {
      ...mockWorkspaceValue,
      currentRole: role,
      currentCompany: { ...mockCompany, role },
