<file path="frontend/src/pages/EmailDetailPage.tsx">
import { useState, useEffect, useRef } from "react";
import { useParams, Link, useNavigate } from "react-router-dom";
import { useQuery, useMutation, useQueryClient } from "@tanstack/react-query";
import {
  ArrowLeft,
  Reply,
  ReplyAll,
  CornerUpRight,
  Trash2,
  Star,
  Mail,
  MailOpen,
  ShieldCheck,
  Clock,
  AlertCircle,
  RotateCcw,
  CheckCircle2,
  X,
  PenTool,
  ChevronDown,
} from "lucide-react";
import { emailsApi } from "../services/api";
import { Card, CardContent } from "../components/ui/Card";
import { Button } from "../components/ui/Button";
import { AttachmentList } from "../components/mailbox/AttachmentList";
import { EmailConversation } from "../components/mailbox/EmailConversation";
import { EmailBodyViewer } from "../components/mailbox/EmailBodyViewer";
import { RestoreConfirmModal } from "../components/mailbox/RestoreConfirmModal";
import { PermanentDeleteConfirmModal } from "../components/mailbox/PermanentDeleteConfirmModal";
import { useWorkspace } from "../hooks/useWorkspace";

function parseSenderDisplay(sender: string): { name: string; address: string; initial: string } {
  if (!sender) return { name: "Unknown", address: "", initial: "U" };
  const match = sender.match(/^(.*?)\s*<(.+?)>$/);
  if (match) {
    const name = match[1].trim().replace(/^["']|["']$/g, "");
    const address = match[2].trim();
    const initial = (name || address).charAt(0).toUpperCase();
    return { name: name || address, address, initial };
  }
  const clean = sender.trim().replace(/^["']|["']$/g, "");
  return { name: clean, address: clean, initial: clean.charAt(0).toUpperCase() };
}

export function EmailDetailPage() {
  const { emailId } = useParams<{ emailId: string }>();
  const navigate = useNavigate();
  const queryClient = useQueryClient();
  const { currentCompanyId } = useWorkspace();
  const [showDetails, setShowDetails] = useState<boolean>(false);

  // Modals and feedback state
  const [isRestoreModalOpen, setIsRestoreModalOpen] = useState(false);
  const [isPermanentDeleteModalOpen, setIsPermanentDeleteModalOpen] = useState(false);
  const [alertBanner, setAlertBanner] = useState<{ type: "success" | "error"; message: string } | null>(null);

  const id = Number(emailId);
  const hasMarkedReadRef = useRef<number | null>(null);

  // Fetch email details scoped to active company
  const {
    data: email,
    isLoading,
    isError,
    error,
  } = useQuery({
    queryKey: ["email-detail", currentCompanyId, id],
    queryFn: () => emailsApi.getEmailById(id, currentCompanyId ?? undefined),
    enabled: !isNaN(id),
    staleTime: 30000,
  });

  // Automatically mark unread email as read once opened
  useEffect(() => {
    if (email && !email.is_read && hasMarkedReadRef.current !== email.id) {
      hasMarkedReadRef.current = email.id;
      markReadMutation.mutate(true);
    }
  }, [email?.id, email?.is_read]);

  // Fetch attachments
  const { data: attachmentsData } = useQuery({
    queryKey: ["email-attachments", currentCompanyId, id],
    queryFn: () => emailsApi.getAttachments(id, currentCompanyId ?? undefined),
    enabled: !isNaN(id),
    staleTime: 60000,
  });

  // Mutations
  const markReadMutation = useMutation({
    mutationFn: (isRead: boolean) => emailsApi.markRead(id, isRead),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["email-detail", id] });
      queryClient.invalidateQueries({ queryKey: ["emails"] });
      queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
    },
  });

  const markStarMutation = useMutation({
    mutationFn: (isStarred: boolean) => emailsApi.markStarred(id, isStarred),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["email-detail", id] });
      queryClient.invalidateQueries({ queryKey: ["emails"] });
    },
  });

  const deleteMutation = useMutation({
    mutationFn: () => emailsApi.softDelete(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["emails"] });
      queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
      navigate("/mailbox");
    },
    onError: () => {
      setAlertBanner({ type: "error", message: "Failed to move email to Trash. Please try again." });
    },
  });

  const restoreMutation = useMutation({
    mutationFn: () => emailsApi.restore(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["email-detail", id] });
      queryClient.invalidateQueries({ queryKey: ["emails"] });
      queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
      setIsRestoreModalOpen(false);
      setAlertBanner({ type: "success", message: "Email successfully restored to Inbox." });
    },
    onError: () => {
      setIsRestoreModalOpen(false);
      setAlertBanner({ type: "error", message: "Failed to restore email. Please try again." });
    },
  });

  const permanentDeleteMutation = useMutation({
    mutationFn: () => emailsApi.permanentDelete(id),
    onSuccess: () => {
      queryClient.invalidateQueries({ queryKey: ["emails"] });
      queryClient.invalidateQueries({ queryKey: ["mailbox-counts"] });
      setIsPermanentDeleteModalOpen(false);
      navigate("/mailbox?folder=trash");
    },
    onError: () => {
      setIsPermanentDeleteModalOpen(false);
      setAlertBanner({ type: "error", message: "Failed to permanently delete email." });
    },
  });

  if (isLoading) {
    return (
      <div className="space-y-4 max-w-5xl mx-auto">
        <div className="h-8 w-32 bg-slate-200 rounded animate-pulse" />
        <Card className="p-8 space-y-6">
          <div className="h-6 w-3/4 bg-slate-100 rounded animate-pulse" />
          <div className="h-4 w-1/2 bg-slate-100 rounded animate-pulse" />
          <div className="h-32 bg-slate-50 rounded-xl animate-pulse" />
          <div className="h-48 bg-slate-50 rounded-lg animate-pulse" />
        </Card>
      </div>
    );
  }

  if (isError || !email) {
    return (
      <div className="max-w-md mx-auto p-12 text-center space-y-4">
        <div className="inline-flex p-3 rounded-full bg-rose-50 text-rose-600">
          <AlertCircle className="h-6 w-6" />
        </div>
        <h2 className="text-base font-semibold text-slate-900">Email Not Found</h2>
        <p className="text-xs text-slate-500">
          {(error as Error)?.message || "The requested email could not be retrieved."}
        </p>
        <Link to="/mailbox">
          <Button size="sm" variant="outline" className="mt-2">
            Back to Mailbox
          </Button>
        </Link>
      </div>
    );
  }

  const formattedDate = new Date(email.sent_at || email.received_at || email.created_at).toLocaleString([], {
    dateStyle: "medium",
    timeStyle: "short",
  });
  const senderInfo = parseSenderDisplay(email.sender);

  return (
    <div className="space-y-4 max-w-5xl mx-auto pb-10">
      {/* Top Action & Navigation Bar */}
      <div className="flex items-center justify-between flex-wrap gap-3">
        <Link to="/mailbox">
          <Button variant="ghost" size="sm" className="gap-1.5 text-slate-600 hover:text-slate-900">
            <ArrowLeft className="h-4 w-4" />
            Back to Mailbox
          </Button>
        </Link>

        <div className="flex items-center space-x-2">
          <button
            type="button"
            onClick={() => markStarMutation.mutate(!email.is_starred)}
            className={`p-2 rounded-lg border text-xs font-medium transition-colors ${
              email.is_starred
                ? "bg-amber-50 border-amber-200 text-amber-600"
                : "bg-white border-slate-200 text-slate-600 hover:bg-slate-50"
            }`}
            title={email.is_starred ? "Unstar" : "Star"}
          >
            <Star className="h-4 w-4" fill={email.is_starred ? "currentColor" : "none"} />
          </button>

          <button
            type="button"
            onClick={() => markReadMutation.mutate(!email.is_read)}
            className="p-2 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 text-xs font-medium transition-colors"
            title={email.is_read ? "Mark Unread" : "Mark Read"}
          >
            {email.is_read ? <Mail className="h-4 w-4" /> : <MailOpen className="h-4 w-4" />}
          </button>

          {email.is_deleted ? (
            <>
              <Button
                variant="outline"
                size="sm"
                onClick={() => setIsRestoreModalOpen(true)}
                disabled={restoreMutation.isPending}
                className="gap-1.5 text-indigo-600 hover:bg-indigo-50 border-indigo-200"
              >
                <RotateCcw className="h-3.5 w-3.5" />
                Restore to Inbox
              </Button>

              <Button
                variant="outline"
                size="sm"
                onClick={() => setIsPermanentDeleteModalOpen(true)}
                disabled={permanentDeleteMutation.isPending}
                className="gap-1.5 text-rose-600 hover:bg-rose-50 border-rose-200"
              >
                <Trash2 className="h-3.5 w-3.5" />
                Delete Permanently
              </Button>
            </>
          ) : email.status === "DRAFT" ? (
            <>
              <Link to={`/compose?draft_id=${email.id}`}>
                <Button size="sm" className="gap-1.5 bg-indigo-600 hover:bg-indigo-700 text-white">
                  <PenTool className="h-3.5 w-3.5" />
                  Continue Editing Draft
                </Button>
              </Link>
              <Button
                variant="outline"
                size="sm"
                onClick={() => deleteMutation.mutate()}
                disabled={deleteMutation.isPending}
                className="gap-1.5 text-rose-600 hover:bg-rose-50 border-slate-200"
              >
                <Trash2 className="h-3.5 w-3.5" />
                Discard Draft
              </Button>
            </>
          ) : (
            <>
              <Link to={`/compose?reply_to=${email.id}`}>
                <Button variant="outline" size="sm" className="gap-1.5">
                  <Reply className="h-3.5 w-3.5" />
                  Reply
                </Button>
              </Link>

              <Link to={`/compose?reply_to=${email.id}&reply_all=true`}>
                <Button variant="outline" size="sm" className="gap-1.5" title="Reply to all recipients">
                  <ReplyAll className="h-3.5 w-3.5" />
                  Reply All
                </Button>
              </Link>

              <Link to={`/compose?forward=${email.id}`}>
                <Button variant="outline" size="sm" className="gap-1.5">
                  <CornerUpRight className="h-3.5 w-3.5" />
                  Forward
                </Button>
              </Link>

              <Button
                variant="outline"
                size="sm"
                onClick={() => deleteMutation.mutate()}
                disabled={deleteMutation.isPending}
                className="gap-1.5 text-rose-600 hover:bg-rose-50 border-slate-200"
              >
                <Trash2 className="h-3.5 w-3.5" />
                Move to Trash
              </Button>
            </>
          )}
        </div>
      </div>

      {/* Operation Feedback Alert Banner */}
      {alertBanner && (
        <div
          className={`flex items-center justify-between px-4 py-3 rounded-xl border text-xs font-medium transition-all ${
            alertBanner.type === "success"
              ? "bg-emerald-50 border-emerald-200 text-emerald-800"
              : "bg-rose-50 border-rose-200 text-rose-800"
          }`}
        >
          <div className="flex items-center gap-2">
            {alertBanner.type === "success" ? (
              <CheckCircle2 className="h-4 w-4 text-emerald-600 shrink-0" />
            ) : (
              <AlertCircle className="h-4 w-4 text-rose-600 shrink-0" />
            )}
            <span>{alertBanner.message}</span>
          </div>
          <button
            type="button"
            onClick={() => setAlertBanner(null)}
            className="p-1 rounded-md text-slate-400 hover:text-slate-600 hover:bg-slate-200/50 cursor-pointer"
            aria-label="Dismiss message"
          >
            <X className="h-3.5 w-3.5" />
          </button>
        </div>
      )}

      {/* Main Email Display Card */}
      <Card className="border-slate-200 shadow-2xs overflow-hidden">
        <CardContent className="p-6 sm:p-8 space-y-6">
          {/* Header Info */}
          <div className="border-b border-slate-100 pb-5 space-y-4">
            <h1 className="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              {email.subject || "(No Subject)"}
            </h1>

            {/* Sender, Recipient, Date Row (Gmail standard) */}
            <div className="flex items-start justify-between gap-4 flex-wrap">
              <div className="flex items-start gap-3 min-w-0">
                {/* Sender Avatar */}
                <div className="h-10 w-10 rounded-full bg-gradient-to-br from-indigo-500 to-purple-600 flex items-center justify-center text-white font-bold text-sm shadow-xs shrink-0 select-none">
                  {senderInfo.initial}
                </div>

                <div className="min-w-0 space-y-0.5">
                  <div className="flex items-center gap-2 flex-wrap">
                    <span className="font-bold text-sm text-slate-900 tracking-tight">
                      {senderInfo.name}
                    </span>
                    {senderInfo.address && senderInfo.address !== senderInfo.name && (
                      <span className="text-xs text-slate-500 font-normal">
                        &lt;{senderInfo.address}&gt;
                      </span>
                    )}
                  </div>

                  <div className="flex items-center gap-1.5 text-xs text-slate-500">
                    <span>
                      to {email.recipients && email.recipients.length > 0 ? (email.recipients.length === 1 ? email.recipients[0] : `${email.recipients[0]} +${email.recipients.length - 1}`) : "me"}
                    </span>
                    <button
                      type="button"
                      onClick={() => setShowDetails((prev) => !prev)}
                      className="p-0.5 hover:bg-slate-100 rounded text-slate-400 hover:text-slate-600 cursor-pointer transition-colors"
                      title="Show security and delivery details"
                    >
                      <ChevronDown className={`h-3 w-3 transition-transform ${showDetails ? "rotate-180" : ""}`} />
                    </button>
                  </div>
                </div>
              </div>

              {/* Timestamp */}
              <div className="flex items-center gap-2 text-xs text-slate-500 shrink-0">
                <Clock className="h-3.5 w-3.5 text-slate-400 shrink-0" />
                <span>{formattedDate}</span>
              </div>
            </div>

            {/* Collapsible Security & Telemetry Details Card */}
            {showDetails && (
              <div className="bg-slate-50 border border-slate-200 p-4 rounded-xl space-y-2 text-xs">
                <div className="grid grid-cols-1 sm:grid-cols-2 gap-2 text-slate-700 font-mono">
                  <div><span className="font-sans font-semibold text-slate-500">From: </span>{email.sender}</div>
                  {email.reply_to && <div><span className="font-sans font-semibold text-slate-500">Reply-To: </span>{email.reply_to}</div>}
                  <div><span className="font-sans font-semibold text-slate-500">To: </span>{email.recipients?.join(", ") || "me"}</div>
                  {email.cc && email.cc.length > 0 && <div><span className="font-sans font-semibold text-slate-500">Cc: </span>{email.cc.join(", ")}</div>}
                  <div><span className="font-sans font-semibold text-slate-500">Date: </span>{formattedDate}</div>
                  <div><span className="font-sans font-semibold text-slate-500">Message-ID: </span><span className="break-all">{email.message_id || `MSG-${email.id}`}</span></div>
                </div>

                <div className="pt-2 border-t border-slate-200 flex items-center justify-between text-[11px] text-slate-500 flex-wrap gap-2">
                  <span className="text-emerald-700 font-medium flex items-center gap-1 font-mono">
                    <ShieldCheck className="h-3.5 w-3.5" />
                    Standard TLS Encryption • SPF: PASS • DKIM: PASS
                  </span>
                  <span className="font-medium text-slate-500">Direction: {email.direction} • Status: {email.status}</span>
                </div>
              </div>
            )}
          </div>

          {/* Email Body Canvas */}
          <EmailBodyViewer
            html={email.body_html}
            text={email.body_text}
            defaultMode={email.body_html ? "html" : "text"}
          />

          {/* Attachments */}
          {attachmentsData?.attachments && attachmentsData.attachments.length > 0 && (
            <AttachmentList emailId={email.id} attachments={attachmentsData.attachments} />
          )}

          {/* Conversation Thread */}
          {email.thread_id && (
            <EmailConversation threadId={email.thread_id} currentEmailId={email.id} />
          )}
        </CardContent>
      </Card>

      {/* Restore Confirmation Modal */}
      <RestoreConfirmModal
        isOpen={isRestoreModalOpen}
        count={1}
        isRestoring={restoreMutation.isPending}
        onClose={() => {
          if (!restoreMutation.isPending) setIsRestoreModalOpen(false);
        }}
        onConfirm={() => restoreMutation.mutate()}
      />

      {/* Permanent Delete Confirmation Modal */}
      <PermanentDeleteConfirmModal
        isOpen={isPermanentDeleteModalOpen}
        count={1}
        isDeleting={permanentDeleteMutation.isPending}
        onClose={() => {
          if (!permanentDeleteMutation.isPending) setIsPermanentDeleteModalOpen(false);
        }}
        onConfirm={() => permanentDeleteMutation.mutate()}
      />
    </div>
  );
}
</file>

