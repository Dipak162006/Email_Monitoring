}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
body{font-family:'Inter',system-ui,sans-serif;background:var(--bg);color:var(--text);height:100vh;display:flex;flex-direction:column;overflow:hidden;}

/* ── TOP BAR ── */
.topbar{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1.5rem;background:var(--surface);border-bottom:1px solid var(--border);flex-shrink:0;z-index:10;}
.topbar-left h1{font-size:1rem;font-weight:700;color:var(--text);}
.topbar-left p{font-size:.75rem;color:var(--dim);margin-top:.1rem;}
.topbar-controls{display:flex;gap:.5rem;}
.ctrl-btn{cursor:pointer;background:var(--surface2);border:1px solid var(--border);border-radius:6px;color:var(--dim);padding:.35rem .65rem;font-size:.82rem;font-weight:600;transition:all .15s;}
.ctrl-btn:hover{background:var(--border);color:var(--text);}

/* ── LAYOUT ── */
.workspace{display:flex;flex:1;overflow:hidden;}

/* ── CANVAS AREA ── */
.canvas-wrap{flex:1;overflow:auto;position:relative;background:var(--bg);}
.canvas-wrap::-webkit-scrollbar{width:8px;height:8px;}
.canvas-wrap::-webkit-scrollbar-track{background:var(--bg);}
.canvas-wrap::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px;}

.canvas{position:relative;min-width:1100px;padding:2rem 1.5rem 4rem;}

/* ── SWIMLANE HEADERS ── */
.lanes{display:grid;grid-template-columns:80px repeat(6,1fr);gap:0;margin-bottom:0;}
.lane-hdr{text-align:center;padding:.6rem .4rem;font-size:.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;border-radius:8px 8px 0 0;border:1px solid;border-bottom:none;cursor:pointer;transition:all .2s;position:relative;z-index:2;}
.lane-hdr.num{background:transparent;border-color:transparent;color:var(--muted);}
.lane-hdr.fe   {background:var(--fe-bg);  border-color:var(--fe-bdr);  color:var(--fe);}
.lane-hdr.api  {background:var(--api-bg); border-color:var(--api-bdr); color:var(--api);}
.lane-hdr.auth {background:var(--auth-bg);border-color:var(--auth-bdr);color:var(--auth);}
.lane-hdr.svc  {background:var(--svc-bg); border-color:var(--svc-bdr); color:var(--svc);}
.lane-hdr.smtp {background:var(--smtp-bg);border-color:var(--smtp-bdr);color:var(--smtp);}
.lane-hdr.db   {background:var(--db-bg);  border-color:var(--db-bdr);  color:var(--db);}
.lane-hdr:hover{filter:brightness(1.3);}
.lane-hdr .icon{font-size:1.1rem;display:block;margin-bottom:.2rem;}

/* ── DIAGRAM BODY ── */
.diagram{display:grid;grid-template-columns:80px repeat(6,1fr);gap:0;position:relative;}

/* vertical lane stripes */
.lane-col{border:1px solid var(--border);border-top:none;border-bottom:none;min-height:100%;position:relative;}
.lane-col.fe   {background:rgba(31,111,235,.03);}
.lane-col.api  {background:rgba(46,160,67,.03);}
.lane-col.auth {background:rgba(158,106,3,.04);}
.lane-col.svc  {background:rgba(187,128,9,.03);}
.lane-col.smtp {background:rgba(137,87,229,.04);}
.lane-col.db   {background:rgba(218,54,51,.03);}
.lane-col.num  {border-color:transparent;background:transparent;}

/* ── STEP ROWS ── */
.step-row{display:contents;}

.row-num{display:flex;align-items:center;justify-content:center;height:70px;}
.row-badge{width:28px;height:28px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:.72rem;font-weight:700;background:var(--surface2);color:var(--dim);border:1.5px solid var(--border);}

.cell{height:70px;display:flex;align-items:center;justify-content:center;position:relative;}

/* node box */
.node{
  position:relative;
  padding:.45rem .7rem;
  border-radius:8px;
  border:1.5px solid;
  font-size:.78rem;
  font-weight:600;
  text-align:center;
  cursor:pointer;
  transition:all .2s;
  line-height:1.3;
  max-width:140px;
  z-index:3;
